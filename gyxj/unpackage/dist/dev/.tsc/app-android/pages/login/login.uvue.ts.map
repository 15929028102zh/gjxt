<template>
	<view class="login-container">
		<view class="login-header">
			<image class="logo" src="/static/logo.png"></image>
			<text class="title">石油工业园区设备巡检系统</text>
			<text class="subtitle">请登录您的账号</text>
		</view>
		
		<view class="login-form">
			<view class="form-item">
				<view class="input-wrapper">
					<text class="icon">👤</text>
					<input 
						class="input" 
						type="text" 
						placeholder="请输入用户名" 
						v-model="form.username"
						maxlength="20"
					/>
				</view>
			</view>
			
			<view class="form-item">
				<view class="input-wrapper">
					<text class="icon">🔒</text>
					<input 
						class="input" 
						:type="showPassword ? 'text' : 'password'" 
						placeholder="请输入密码" 
						v-model="form.password"
						maxlength="20"
					/>
					<text class="eye-icon" @click="togglePassword">{{showPassword ? '👁️' : '👁️‍🗨️'}}</text>
				</view>
			</view>
			
			<button class="login-btn" @click="handleLogin" :disabled="loading">
				<text v-if="loading">登录中...</text>
				<text v-else>登录</text>
			</button>
			
			<view class="tips">
				<text class="tip-text">测试账号：admin / 123456</text>
			</view>
		</view>
	</view>
</template>

<script lang="uts">
	import { getApiUrl } from '@/config/api.uts'
	type LoginFormData = {
		username: string
		password: string
	}
	
	export default {
		data(): {
			form: LoginFormData,
			showPassword: boolean,
			loading: boolean
		} {
			return {
				form: {
					username: '',
					password: ''
				} as LoginFormData,
				showPassword: false,
				loading: false
			}
		},
		methods: {
			togglePassword() {
				this.showPassword = !this.showPassword
			},
			
			validateForm(): boolean {
			if (this.form.username.trim() == '') {
				uni.showToast({
					title: '请输入用户名',
					icon: 'none'
				})
				return false
			}
			if (this.form.password.trim() == '') {
				uni.showToast({
					title: '请输入密码',
					icon: 'none'
				})
				return false
			}
			return true
		},
			
			getUserInfo(token: string) {
		const apiUrl = getApiUrl(`/user/info?username=${this.form.username}`)
		console.log('获取用户信息API地址:', apiUrl)
		uni.request({
			url: apiUrl,
			method: 'GET',
			header: {
				'Content-Type': 'application/json',
				'Authorization': 'Bearer ' + token
			},
				success: (res) => {
					console.log('获取用户信息响应:', res)
					const data = res.data as UTSJSONObject
					console.log('响应数据:', data)
					
					if (res.statusCode == 200 && (data.getNumber('code') ?? 0) == 200) {
						const userInfo = data.getJSON('data')
						console.log('从后端获取的用户信息:', userInfo)
						
						if (userInfo != null) {
							console.log('保存用户信息到本地存储:', JSON.stringify(userInfo))
							uni.setStorageSync('userInfo', JSON.stringify(userInfo))
						}
					} else {
						console.log('获取用户信息失败，使用基本信息')
						// 如果获取用户信息失败，使用基本信息
						uni.setStorageSync('userInfo', JSON.stringify({ 
							id: 'temp_' + Date.now(),
							username: this.form.username,
							realName: this.form.username
						}))
					}
				},
				fail: (error) => {
					console.log('获取用户信息失败:', error)
					// 如果获取用户信息失败，使用基本信息
					uni.setStorageSync('userInfo', JSON.stringify({ 
						id: 'temp_' + Date.now(),
						username: this.form.username,
						realName: this.form.username
					}))
				}
			})
		},
			
		handleLogin() {
			if (!this.validateForm()) return
			
			this.loading = true
			const loginUrl = getApiUrl('/user/login')
			console.log('登录API地址:', loginUrl)
		
			uni.request({
				url: loginUrl,
				method: 'POST',
				header: {
					'Content-Type': 'application/json'
				},
				data: JSON.stringify(this.form),
				success: (res) => {
					const data = res.data as UTSJSONObject
					if (res.statusCode == 200 && (data.getNumber('code') ?? 0) == 200) {
						// 保存token
						const token = data.getString('data') ?? ''
						uni.setStorageSync('token', token)
						
						// 获取用户详细信息
						this.getUserInfo(token)
						
						uni.showToast({
							title: '登录成功',
							icon: 'success'
						})
						
						// 跳转到首页
						setTimeout(() => {
							uni.reLaunch({
								url: '/pages/home/home'
							})
						}, 1500) as number
					} else {
						uni.showToast({
							title: data.getString('message') ?? '登录失败',
							icon: 'none'
						})
					}
					this.loading = false
				},
				fail: (error) => {
					console.log('登录请求失败:', error)
					uni.showToast({
						title: '网络请求失败',
						icon: 'none'
					})
					this.loading = false
				}
			})
		}
		},
		
		onLoad() {
			// 检查是否已登录
			const token = uni.getStorageSync('token')
			if (token != null && token != '') {
				uni.reLaunch({
					url: '/pages/home/home'
				})
			}
		}
	}
</script>

