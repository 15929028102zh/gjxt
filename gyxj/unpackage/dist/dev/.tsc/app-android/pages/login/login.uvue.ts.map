	}
	
	.input-wrapper {
		position: relative;
		background: rgba(255, 255, 255, 0.9);
		border-radius: 12px;
		flex-direction: row;
		align-items: center;
		padding: 0 20px;
		height: 65px;
		width: 100%;
		box-sizing: border-box;
	}
	
	.icon {
		font-size: 18px;
		margin-right: 12px;
		color: #666;
		flex-shrink: 0;
	}
	
	.input {
		flex: 1;
		height: 100%;
		border: none;
