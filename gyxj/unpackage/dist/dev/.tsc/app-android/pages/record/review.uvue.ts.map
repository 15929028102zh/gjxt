<template>
	<scroll-view class="container" scroll-y="true" :style="{height: containerHeight + 'px'}" enable-back-to-top="true">
		<view v-if="loading" class="loading-state">
			<text class="loading-text">加载中...</text>
		</view>
		
		<view v-else-if="recordDetail" class="detail-content">
			<!-- 状态标题 -->
			<view class="status-header">
				<text class="page-title">复查记录</text>
				<text class="record-status" :class="getStatusClass(recordDetail?.status ?? 0)">
					{{getStatusText(recordDetail?.status ?? 0)}}
				</text>
			</view>
			
			<!-- 问题照片 -->
			<view class="form-item" v-if="imageList.length > 0">
				<text class="form-label">📷 问题照片 ({{imageList.length}}张)</text>
				<view class="image-upload">
					<view class="image-list">
						<view class="image-item" v-for="(image, index) in imageList" :key="index">
							<image 
								:src="image" 
								mode="aspectFill" 
								class="uploaded-image" 
								@click="previewImage(index)"
								@error="onImageError"
								@load="onImageLoad"
							></image>
						</view>
					</view>
				</view>
			</view>
			
			<!-- 问题描述 -->
			<view class="form-item">
				<text class="form-label">问题描述</text>
				<view class="form-input-wrapper">
					<text class="form-display-text">{{recordDetail?.problemDescription ?? ''}}</text>
				</view>
			</view>
			
			<!-- 整改效果描述（只读） -->
			<view class="form-item">
				<text class="form-label">整改效果描述</text>
				<view class="form-input-wrapper">
					<text class="form-display-text">{{recordDetail?.rectificationEffect ?? ''}}</text>
				</view>
			</view>
			
			<!-- 整改状态（只读） -->
			<view class="form-item">
				<text class="form-label">📋 整改状态</text>
				<view class="form-input-wrapper">
					<text class="form-display-text">{{getStatusText(recordDetail?.status ?? 0)}}</text>
				</view>
			</view>
			
			<!-- 整改图片（只读） -->
			<view class="form-item">
				<text class="form-label">📷 整改图片 ({{rectificationImages.length}}张)</text>
				<view class="image-upload">
					<view class="image-list" v-if="rectificationImages.length > 0">
						<view class="image-item" v-for="(image, index) in rectificationImages" :key="index">
							<image 
								:src="image" 
								mode="aspectFill" 
								class="uploaded-image" 
								@click="previewRectificationImage(index)"
								@error="onImageError"
								@load="onImageLoad"
							></image>
						</view>
					</view>
					<view v-else class="no-image-text">
						<text class="no-image-text-inner">暂无整改图片</text>
					</view>
				</view>
			</view>
			
			<!-- 责任单位 -->
			<view class="form-item">
				<text class="form-label">责任单位</text>
				<view class="form-input-wrapper">
					<text class="form-display-text">{{recordDetail?.responsibleUnit ?? ''}}</text>
				</view>
			</view>
			
			<!-- 责任人 -->
			<view class="form-item">
				<text class="form-label">责任人</text>
				<view class="form-input-wrapper">
					<text class="form-display-text">{{recordDetail?.responsiblePerson ?? ''}}</text>
				</view>
			</view>
			
			<!-- 性质界定 -->
			<view class="form-item">
				<text class="form-label">性质界定</text>
				<view class="form-input-wrapper">
					<text class="form-display-text">{{recordDetail?.natureName ?? ''}}</text>
				</view>
			</view>
			
			<!-- 考核情况 -->
			<view class="form-item">
				<text class="form-label">考核情况</text>
				<view class="form-input-wrapper">
					<text class="form-display-text">{{recordDetail?.assessmentSituation ?? ''}}</text>
				</view>
			</view>
			
			<!-- 考核金额 -->
			<view class="form-item">
				<text class="form-label">考核金额</text>
				<view class="form-input-wrapper">
					<text class="form-display-text">{{recordDetail?.assessmentAmount ?? ''}}元</text>
				</view>
			</view>
			
			<!-- 安全记分 -->
			<view class="form-item">
				<text class="form-label">安全记分</text>
				<view class="form-input-wrapper">
					<text class="form-display-text">{{recordDetail?.safetyScore ?? ''}}</text>
				</view>
			</view>
			
			<!-- 专业 -->
			<view class="form-item">
				<text class="form-label">专业</text>
				<view class="form-input-wrapper">
					<text class="form-display-text">{{recordDetail?.professionName ?? ''}}</text>
				</view>
			</view>
			
			<!-- 发生部位 -->
			<view class="form-item">
				<text class="form-label">发生部位</text>
				<view class="form-input-wrapper">
					<text class="form-display-text">{{recordDetail?.location ?? ''}}</text>
				</view>
			</view>
			
			<!-- 检查人 -->
			<view class="form-item">
				<text class="form-label">检查人</text>
				<view class="form-input-wrapper">
					<text class="form-display-text">{{recordDetail?.inspector ?? ''}}</text>
				</view>
			</view>
			
			<!-- 检查组组长 -->
			<view class="form-item">
				<text class="form-label">检查组组长</text>
				<view class="form-input-wrapper">
					<text class="form-display-text">{{recordDetail?.groupLeader ?? ''}}</text>
				</view>
			</view>
			
			<!-- 检查组副组长 -->
			<view class="form-item">
				<text class="form-label">检查组副组长</text>
				<view class="form-input-wrapper">
					<text class="form-display-text">{{recordDetail?.deputyLeader ?? ''}}</text>
				</view>
			</view>
			
			<!-- 所属部门 -->
			<view class="form-item">
				<text class="form-label">所属部门</text>
				<view class="form-input-wrapper">
					<text class="form-display-text">{{recordDetail?.departmentName ?? ''}}</text>
				</view>
			</view>
			
			<!-- 整改期限 -->
			<view class="form-item">
				<text class="form-label">整改期限</text>
				<view class="form-input-wrapper">
					<text class="form-display-text">{{formatDate(recordDetail?.rectificationDeadline ?? '') }}</text>
				</view>
			</view>
			
			
			
			<!-- 复查人（复查录入时为当前登录用户；查看时展示已保存复查人） -->
			<view class="form-item">
				<text class="form-label">复查人</text>
				<view class="form-input-wrapper">
					<text class="form-display-text">{{ (!isDelayed && !isReviewed) ? (currentUserName !== '' ? currentUserName : '当前登录用户') : ((recordDetail?.reviewerName ?? '') !== '' ? (recordDetail?.reviewerName ?? '') : '暂无') }}</text>
				</view>
			</view>

			<!-- 复查效果描述 -->
			<view class="form-item">
				<text class="form-label">复查效果描述</text>
				<view class="form-input-wrapper">
					<textarea 
						v-if="!isDelayed && !isReviewed"
						v-model="reviewEffect"
						class="form-textarea"
						placeholder="请描述复查效果..."
						maxlength="500"
						show-confirm-bar="false"
					></textarea>
					<text v-else class="form-display-text">{{reviewEffect.length > 0 ? reviewEffect : '暂无复查效果描述'}}</text>
				</view>
			</view>
			
			<!-- 复查图片 -->
			<view class="form-item">
				<text class="form-label">📷 复查图片 ({{reviewImages.length}}{{(isDelayed || isReviewed) ? '' : '/3'}})</text>
				<view class="image-upload">
					<view class="image-list" v-if="reviewImages.length > 0">
						<view class="image-item" v-for="(image, index) in reviewImages" :key="index">
							<image
								:src="image"
								mode="aspectFill"
								class="uploaded-image"
								@click="previewReviewImage(index)"
								@error="onImageError"
								@load="onImageLoad"
							></image>
							<view v-if="!isDelayed && !isReviewed" class="image-delete" @click="removeReviewImage(index)">
								<text>×</text>
							</view>
						</view>

						<view v-if="!isDelayed && !isReviewed && reviewImages.length < 3" class="image-add" @click="chooseReviewImage">
							<text class="add-icon">+</text>
							<text class="add-text">添加图片</text>
						</view>
					</view>
					<view v-else-if="isDelayed || isReviewed" class="no-image-text">
						<text class="no-image-text-inner">暂无复查图片</text>
					</view>
					<view v-else class="no-image-container">

						<view class="image-add" @click="chooseReviewImage">
							<text class="add-icon">+</text>
							<text class="add-text">添加图片</text>
						</view>
					</view>
				</view>
			</view>
			
			<!-- 确认复查按钮 -->
			<view v-if="!isDelayed && !isReviewed" class="save-button-wrapper">
				<button class="save-btn" @click="saveReviewInfo" :disabled="saving">
					{{saving ? '保存中...' : '确认复查'}}
				</button>
			</view>
		</view>
		
		<view v-else class="error-state">
			<text class="error-text">记录不存在或已被删除</text>
		</view>
	</scroll-view>
</template>
<script lang="uts">
	import { getApiUrl, apiConfig } from '@/config/api.uts'
	
	type RecordDetail = {
		id: string
		problemDescription: string
		responsibleUnit: string
		responsiblePerson: string
		natureId: string
		natureName: string
		assessmentSituation: string
		assessmentAmount: number
		safetyScore: number
		professionId: string  // 修改为string类型
		professionName: string
		location: string
		inspector: string
		groupLeader: string
		deputyLeader: string
		departmentId: string  // 修改为string类型
		departmentName: string
		rectificationDeadline: string
		status: number
		createTime: string
		updateTime: string
		problemImageUrls: string
		locationName: string
		severity: number
		taskName: string
		reporterName: string
		suggestions: string
		reporterId: string
		rectificationEffect: string
		rectificationImageUrls: string
		rectificationTime: string
		reviewEffect: string
		reviewImageUrls: string
		reviewerName: string
	}

	export default {
		data() {
			// 同步计算 scroll-view 高度:windowHeight + 200px 偏移确保底部图片完整显示
			// 必须 data() 同步执行避免 scroll-view 定型问题
			let containerHeight = 0
			try {
				const sysInfo = uni.getSystemInfoSync()
				containerHeight = sysInfo.windowHeight ?? 0
			} catch (e) {
				console.error('获取屏幕信息失败:', e)
			}
			return {
				recordId: '',
				recordDetail: null as RecordDetail | null,
				imageList: [] as Array<string>,
				rectificationImages: [] as Array<string>,
				loading: true,
				reviewEffect: '',
				reviewImages: [] as Array<string>,
				saving: false,
				containerHeight: containerHeight,
				// 延迟整改模式标识
				isDelayed: false,
				// 已复查记录标识
				isReviewed: false,
				// 是否为月检标识
				isMonthly: false,
				// 复查人：当前登录用户姓名（只读，确认复查时写库）
				currentUserName: ''
			}
		},
		onLoad(options: UTSJSONObject) {
			this.recordId = options.getString('id') ?? ''
			// 检查是否为延迟整改模式
			const delayedParam = options.getString('delayed')
			if (delayedParam != null && delayedParam == 'true') {
				this.isDelayed = true
			} else {
				this.isDelayed = false
			}

			// 检查是否为已复查记录模式
			const reviewedParam = options.getString('reviewed')
			if (reviewedParam != null && reviewedParam == 'true') {
				this.isReviewed = true
			} else {
				this.isReviewed = false
			}

			// 检查是否为月检记录
			const monthlyParam = options.getString('isMonthly')
			if (monthlyParam != null && monthlyParam == 'true') {
				this.isMonthly = true
			} else {
				this.isMonthly = false
			}

			this.checkLogin()
			this.loadCurrentUserName()
			this.loadRecordDetail()
		},
		methods: {
			checkLogin() {
				const token = uni.getStorageSync('token')
				if (token == null || token == '') {
					uni.reLaunch({
						url: '/pages/login/login'
					})
				}
			},

			// 复查人取当前登录用户真实姓名
			loadCurrentUserName() {
				const userInfoStr = uni.getStorageSync('userInfo') as string
				if (userInfoStr == null || userInfoStr == '') return
				try {
					const userInfo = JSON.parse(userInfoStr) as UTSJSONObject
					this.currentUserName = userInfo.getString('realName') ?? userInfo.getString('username') ?? ''
				} catch (e) {
					console.error('解析用户信息失败:', e)
				}
			},


			loadRecordDetail() {
				const token = uni.getStorageSync('token')
				const detailUrl = this.isMonthly
					? getApiUrl(`/monthly-inspection-record/${this.recordId}`)
					: getApiUrl(`/inspection-record/${this.recordId}`)
				uni.showLoading({ title: '加载中...' })
				uni.request({
					url: detailUrl,
					method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (response) => {
						uni.hideLoading()
						const data = response.data as UTSJSONObject
						if (response.statusCode === 200 && (data.getNumber('code') ?? 0) === 200) {
							const recordData = data.getJSON('data')
							if (recordData != null) {
								this.recordDetail = {
									id: recordData.getString('id') ?? '',
									problemDescription: recordData.getString('problemDescription') ?? '',
									responsibleUnit: recordData.getString('responsibleUnit') ?? '',
									responsiblePerson: recordData.getString('responsiblePerson') ?? '',
									natureId: recordData.getString('natureId') ?? '',
									natureName: recordData.getString('natureName') ?? recordData.getString('natureDefinition') ?? '',
									assessmentSituation: recordData.getString('assessmentSituation') ?? '',
									assessmentAmount: recordData.getNumber('assessmentAmount') ?? 0,
									safetyScore: recordData.getNumber('safetyScore') ?? 0,
									professionId: recordData.getString('professionId') ?? '',
									professionName: recordData.getString('professionName') ?? '',
									location: recordData.getString('location') ?? '',
									inspector: recordData.getString('inspector') ?? '',
									groupLeader: recordData.getString('groupLeader') ?? '',
									deputyLeader: recordData.getString('deputyLeader') ?? '',
									departmentId: recordData.getString('departmentId') ?? '',
									departmentName: recordData.getString('departmentName') ?? '',
									rectificationDeadline: recordData.getString('rectificationDeadline') ?? '',
									status: recordData.getNumber('status') ?? 0,
									createTime: recordData.getString('createTime') ?? '',
									updateTime: recordData.getString('updateTime') ?? '',
									problemImageUrls: recordData.getString('problemImageUrls') ?? '',
									locationName: recordData.getString('locationName') ?? '',
									severity: recordData.getNumber('severity') ?? 0,
									taskName: recordData.getString('taskName') ?? '',
									reporterName: recordData.getString('reporterName') ?? '',
									suggestions: recordData.getString('suggestions') ?? '',
									reporterId: recordData.getString('reporterId') ?? '',
									rectificationEffect: recordData.getString('rectificationEffect') ?? '',
									rectificationImageUrls: recordData.getString('rectificationImageUrls') ?? '',
									rectificationTime: recordData.getString('rectificationTime') ?? '',
									reviewEffect: recordData.getString('reviewEffect') ?? '',
									reviewImageUrls: recordData.getString('reviewImageUrls') ?? '',
									reviewerName: recordData.getString('reviewerName') ?? ''
								} as RecordDetail
								this.imageList = this.processImageUrls(this.recordDetail?.problemImageUrls ?? '')
								this.rectificationImages = this.processImageUrls(this.recordDetail?.rectificationImageUrls ?? '')
								if (this.isReviewed) {
									this.reviewEffect = this.recordDetail?.reviewEffect ?? ''
									this.reviewImages = this.processImageUrls(this.recordDetail?.reviewImageUrls ?? '')
								}
							}
						} else {
							uni.showToast({
								title: data.getString('message') ?? '加载失败',
								icon: 'none'
							})
						}
						this.loading = false
					},
					fail: (error) => {
						uni.hideLoading()
						console.error('加载记录详情失败:', error)
						uni.showToast({ title: '网络错误', icon: 'none' })
						this.loading = false
					}
				})
			},

			// 复查图片相关方法
				chooseReviewImage() {
					if (this.reviewImages.length >= 3) {
						uni.showToast({
							title: '最多只能上传3张图片',
							icon: 'none'
						})
						return
					}
					
					uni.chooseImage({
						count: 3 - this.reviewImages.length,
						sourceType: ['camera', 'album'],
						success: (res) => {
							const tempFilePaths = res.tempFilePaths
							for (let i = 0; i < tempFilePaths.length; i++) {
								this.reviewImages.push(tempFilePaths[i])
							}
						}
					})
				},
				
				previewReviewImage(index: number) {
					uni.previewImage({
						current: index,
						urls: this.reviewImages
					})
				},
				
				removeReviewImage(index: number) {
					this.reviewImages.splice(index, 1)
				},
							
				previewImage(index: number) {
					uni.previewImage({
						current: index,
						urls: this.imageList
					})
				},
							
				previewRectificationImage(index: number) {
					uni.previewImage({
						current: index,
						urls: this.rectificationImages
					})
				},
							
				formatDate(dateTimeStr: string): string {
					if (dateTimeStr == null || dateTimeStr == '') return ''
					// 如果是完整的日期时间格式，只取日期部分
					if (dateTimeStr.includes(' ')) {
						return dateTimeStr.split(' ')[0]
					}
					return dateTimeStr
				},
				
				onImageLoad(e: any) {
					// 图片加载成功
				},
				
				onImageError(e: any) {
					uni.showToast({
						title: '图片加载失败',
						icon: 'none'
					})
				},
				
				convertToHttpUrl(relativePath: string): string {
					if (relativePath == null || relativePath == '' || relativePath.trim() === '') {
						return ''
					}
					if (relativePath.startsWith('http://') || relativePath.startsWith('https://')) {
						return relativePath
					}
					const fullUrl = `${apiConfig.baseUrl}/api${relativePath}`
					return fullUrl
				},
				
				// 处理图片URL数组，支持JSON数组格式和逗号分隔字符串格式
      processImageUrls(imageUrls: string): string[] {
       if (imageUrls == null || imageUrls.trim() === '') {
						return []
					}
					
					try {
						// 尝试解析为JSON数组
						if (imageUrls.trim().startsWith('[') && imageUrls.trim().endsWith(']')) {
							const parsed = JSON.parse(imageUrls) as string[]
							return parsed.map(url => this.convertToHttpUrl(url)).filter(url => url !== '')
						}
					} catch (e) {
						console.log('JSON解析失败，尝试按逗号分隔处理:', e)
					}
					
					// 按逗号分隔处理
					return imageUrls.split(',')
						.map(url => url.trim())
						.filter(url => url !== '')
						.map(url => this.convertToHttpUrl(url))
				},
				
				async saveReviewInfo() {
					if (this.saving) return
					
					if (this.reviewEffect.trim().length === 0) {
						uni.showToast({
							title: '请填写复查效果',
							icon: 'none'
						})
						return
					}
					
					this.saving = true
					
					try {
						let reviewImageUrls: string[] = []
									
						// 上传复查图片
						if (this.reviewImages.length > 0) {
							uni.showLoading({
								title: '上传复查图片中...'
							})
							reviewImageUrls = await this.uploadReviewImages()
							uni.hideLoading()
						}
						
						// 获取当前登录用户信息
			const userInfoStr = uni.getStorageSync('userInfo') as string
			console.log('获取到的用户信息字符串:', userInfoStr)
			let currentUserId = ''
			if (userInfoStr != null && userInfoStr != '') {
				try {
					const userInfo = JSON.parse(userInfoStr) as UTSJSONObject
					console.log('解析后的用户信息对象:', userInfo)
					currentUserId = userInfo.getString('id') ?? ''
					console.log('当前复查人ID:', currentUserId)
					if (currentUserId === '') {
						console.log('用户信息对象:', JSON.stringify(userInfo))
					}
				} catch (e) {
					console.error('解析用户信息失败:', e)
				}
			} else {
				console.log('用户信息字符串为空或null')
			}
				
				const updateData = {
					id: this.recordDetail?.id ?? '',
					problemDescription: this.recordDetail?.problemDescription ?? '',
					responsibleUnit: this.recordDetail?.responsibleUnit ?? '',
					responsiblePerson: this.recordDetail?.responsiblePerson ?? '',
					// 性质界定：周检端不再支持编辑,直接使用 recordDetail.natureName
					natureDefinition: this.recordDetail?.natureName ?? '',
					rectificationEffect: this.recordDetail?.rectificationEffect ?? '',
					rectificationImageUrls: this.recordDetail?.rectificationImageUrls ?? '',
					reviewEffect: this.reviewEffect,
					reviewImageUrls: reviewImageUrls.join(','),
					reviewerId: currentUserId, // 设置复查人ID
					status: 2,
					reviewTime: new Date().toISOString().replace('T', ' ').substring(0, 19)
				}
						
						uni.showLoading({
							title: '保存中...'
						})
						
                        const token = uni.getStorageSync('token')
                        // 根据是否为月检选择对应的接口
                        const apiUrl = this.isMonthly 
                            ? getApiUrl(`/monthly-inspection-record/${this.recordDetail?.id ?? ''}/review`)
                            : getApiUrl(`/inspection-record/${this.recordDetail?.id ?? ''}/review`)
                        console.log('使用接口:', apiUrl, 'isMonthly:', this.isMonthly)
                        const payload = {
                            reviewSuggestion: this.reviewEffect,
                            reviewEffect: this.reviewEffect,
                            reviewImages: reviewImageUrls.join(','),
                            reviewerId: currentUserId,
                            reviewerName: this.currentUserName
                        }
                        uni.request({
                            url: apiUrl,
                            method: 'PUT',
                            header: {
                                'Authorization': `Bearer ${token}`,
                                'Content-Type': 'application/json'
                            },
                            data: payload,
                            success: (response) => {
                                uni.hideLoading()
                                const data = response.data as UTSJSONObject
                                if (response.statusCode === 200 && (data.getNumber('code') ?? 0) === 200) {
                                    uni.showToast({
                                        title: '复查成功',
                                        icon: 'success'
                                    })
                                    setTimeout(() => {
                                        uni.navigateBack()
                                    }, 1500)
                                } else {
                                    uni.showToast({
                                        title: data.getString('message') ?? '复查失败',
                                        icon: 'none'
                                    })
                                }
                                this.saving = false
                            },
							fail: (error) => {
								uni.hideLoading()
								console.error('保存复查信息失败:', error)
								uni.showToast({
									title: '网络错误',
									icon: 'none'
								})
								this.saving = false
							}
						})
					} catch (error) {
						uni.hideLoading()
						console.error('上传图片失败:', error)
						uni.showToast({
							title: '图片上传失败，请重试',
							icon: 'none'
						})
						this.saving = false
					}
				},
				
				async uploadReviewImages(): Promise<string[]> {
					if (this.reviewImages.length === 0) {
						return []
					}
					
					const token = uni.getStorageSync('token')
					const uploadPromises = this.reviewImages.map(imagePath => {
						return new Promise<string>((resolve, reject) => {
							uni.uploadFile({
								url: getApiUrl('/upload/image'),
								filePath: imagePath,
								name: 'file',
								header: {
									'Authorization': `Bearer ${token}`
								},
								success: (res) => {
									try {
										const data = JSON.parse(res.data) as UTSJSONObject
										if (res.statusCode === 200 && (data.getNumber('code') ?? 0) === 200) {
											const dataObj = data.getJSON('data')
											const imageUrl = dataObj?.getString('filePath') ?? ''
											if (imageUrl != null && imageUrl != '') {
												resolve(imageUrl)
											} else {
												reject(new Error('上传成功但未获取到图片URL'))
											}
										} else {
											reject(new Error(data.getString('message') ?? '上传失败'))
										}
									} catch (e) {
										reject(new Error('解析响应失败'))
									}
								},
								fail: (error) => {
									reject(new Error(`上传失败: ${error.errMsg ?? '网络错误'}`))
								}
							})
						})
					})
					
					try {
						const imageUrls = await Promise.all(uploadPromises)
						console.log('所有复查图片上传成功：', imageUrls)
						return imageUrls
					} catch (error) {
						console.error('复查图片上传失败:', error)
						throw error
					}
				},
				
				getStatusText(status: number): string {
					switch (status) {
						case 0: return '待整改'
						case 1: return '已整改'
						case 2: return '已复查'
						default: return '未知'
					}
				},
				
				getStatusClass(status: number): string {
					switch (status) {
						case 0: return 'status-pending'
						case 1: return 'status-completed'
						case 2: return 'status-reviewed'
						default: return 'status-unknown'
					}
				}
			}
		}
	</script>
	
	<style>
