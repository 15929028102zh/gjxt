<template>
	<scroll-view 
		class="container" 
		scroll-y="true" 
		:style="{height: containerHeight + 'px'}"
		enable-back-to-top="true"
		refresher-enabled="true"
		:refresher-triggered="isRefreshing"
		refresher-default-style="black"
		refresher-background="#f5f5f5"
		@refresherrefresh="onRefresh"
		@refresherrestore="onRefreshRestore"
	>
		<!-- 页面标题 -->
		<view class="header">
			<text class="title">问题列表</text>
			<text class="subtitle">共 {{totalCount}} 条{{getStatusTitle()}}问题</text>
		</view>
		
		<!-- 记录列表 -->
			<view class="record-item" v-for="record in recordList" :key="record.id" @click="goToDetail(record)" @longpress="showDeleteConfirm(record.id, record.problemDescription)">
				<view class="record-content">
					<!-- 左侧内容区域 -->
					<view class="left-content">
						<view class="name-problem-row">
							<text class="responsible-name">{{record.responsiblePerson}}</text>
						</view>
						
					</view>
					
					<!-- 右侧信息区域 -->
					<view class="right-info">
						<text class="inspector-info">检查人：{{record.inspectorName}}</text>
						<text class="date-text">{{record.createDate}}</text>
						<view class="status-tag" :class="getStatusClass(record.status)">
							<text class="status-text">{{getStatusText(record.status)}}</text>
						</view>
					</view>
					<text class="problem-text">{{record.problemDescription}}</text>
				</view>
			</view>
			
			<!-- 空状态 -->
			<view v-if="recordList.length === 0 && !loading" class="empty-state">
				<text class="empty-icon">📝</text>
				<text class="empty-text">暂无记录</text>
			</view>
			
			<!-- 加载状态 -->
			<view v-if="loading" class="loading-state">
				<text class="loading-text">加载中...</text>
			</view>
			
		<!-- 加载更多 -->
		<view v-if="hasMore && recordList.length > 0" class="load-more" @click="loadMore">
			<text class="load-more-text">{{loadingMore ? '加载中...' : '加载更多'}}</text>
		</view>

	</scroll-view>
</template>

<script lang="uts">
	import { getApiUrl } from '@/config/api.uts'
	type RecordStatusTab = {
		key: string
		label: string
		value: string
	}

	type InspectionRecord = {
		id: string
		problemDescription: string
		responsiblePerson: string
		inspectorName: string
		createDate: string
		status: number
	}
	
	export default {
		data() {
			return {
				recordList: [] as InspectionRecord[],
				loading: false,
				loadingMore: false,
				hasMore: true,
				totalCount: 0,
				pageNum: 1,
				pageSize: 20,
				status: '0', // 默认显示待整改记录
				isDelayed: false, // 是否是延迟整改
				isReviewed: false, // 是否是已复查记录
				isRefreshing: false, // 下拉刷新状态
				containerHeight: 0 // 容器高度
			}
		},
		onLoad(options: OnLoadOptions) {
				this.checkLogin()
				// 从URL参数获取status值
				if (options['status'] != null) {
					this.status = options['status'] as string
				}
				// 检查是否是延迟整改
				if (options['delayed'] != null && options['delayed'] == 'true') {
					this.isDelayed = true
				}
				// 检查是否是已复查记录
				if (options['type'] != null && options['type'] == 'reviewed') {
					this.isReviewed = true
					this.status = '2' // 设置状态为已复查
				}
				this.initContainerHeight()
				this.loadRecords()
			
			// 监听全局事件，当记录更新时刷新数据
			uni.$on('recordUpdated', this.handleRecordUpdated)
		},
		onShow() {
			// 页面显示时刷新数据，以便及时反映数据变化
			this.refreshRecords()
		},
		onUnload() {
			// 页面卸载时移除事件监听
			uni.$off('recordUpdated', this.handleRecordUpdated)
		},
		onPullDownRefresh() {
			this.refreshRecords()
		},
		onReachBottom() {
			if (this.hasMore && !this.loadingMore) {
				this.loadMore()
			}
		},
			methods: {
			checkLogin() {
				const tokenData = uni.getStorageSync('token')
				const token = tokenData != null ? tokenData as string : ''
				if (token == null || token == '') {
					uni.reLaunch({
						url: '/pages/login/login'
					})
				}
			},
			
			// 处理记录更新事件
			handleRecordUpdated() {
				console.log('接收到记录更新事件，开始刷新数据')
				this.refreshRecords()
			},
			
			// 初始化容器高度
			initContainerHeight() {
				uni.getSystemInfo({
					success: (res) => {
						this.containerHeight = res.windowHeight
					}
				})
			},

			
			async loadRecords() {
				if (this.pageNum === 1) {
					this.loading = true
				} else {
					this.loadingMore = true
				}
			
				const token = uni.getStorageSync('token')
				
				// 获取用户部门信息
				let departmentId = ''
				const userInfoData = uni.getStorageSync('userInfo')
				const userInfoStr = userInfoData != null ? userInfoData as string : ''
				if (userInfoStr != null && userInfoStr != '' && userInfoStr != 'null' && userInfoStr != 'undefined') {
					try {
					const parsedUserInfo = JSON.parse(userInfoStr) as UTSJSONObject
					departmentId = parsedUserInfo.getString('deptId') ?? ''
					} catch (error) {
						console.error('用户信息JSON解析失败:', error)
					}
				}
				
				// 根据是否是延迟整改选择不同的API
				let apiUrl = ''
				if (this.isDelayed) {
					apiUrl = getApiUrl(`/inspection-record/delayed?current=${this.pageNum}&size=${this.pageSize}${departmentId != null && departmentId != '' ? '&departmentId=' + departmentId : ''}`)
				} else {
					apiUrl = getApiUrl(`/inspection-record/page?current=${this.pageNum}&size=${this.pageSize}&status=${this.status}${departmentId != null && departmentId != '' ? '&departmentId=' + departmentId : ''}`)
				}
				
				uni.request({
					url: apiUrl,
					method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
						const responseData = res.data as UTSJSONObject
						if (res.statusCode === 200 && responseData.getNumber('code') === 200) {
							const dataObj = responseData.getJSON('data') as UTSJSONObject
							const records = dataObj?.getArray('records') as Array<UTSJSONObject>
							const newRecords: InspectionRecord[] = []
							
							if (records != null) {
								for (let i = 0; i < records.length; i++) {
									const item = records[i]
									// 打印原始数据对象，检查字段内容
									console.log('原始数据对象:', item)
									console.log('problemDescription字段:', item.getString('problemDescription'))
									
									const createTime = item.getString('createTime') ?? ''
									const record: InspectionRecord = {
										id: item.getString('id') ?? '',
										problemDescription: item.getString('problemDescription') ?? '',
										responsiblePerson: item.getString('responsiblePerson') ?? '',
										inspectorName: item.getString('inspector') ?? '',
										createDate: this.formatDate(createTime),
										status: item.getNumber('status') ?? 0
									}
									// 打印处理后的记录对象
									console.log('处理后的记录对象:', record)
									newRecords.push(record)
								}
							}
							
							if (this.pageNum === 1) {
								this.recordList = newRecords
							} else {
								this.recordList = this.recordList.concat(newRecords)
							}
							
							this.totalCount = dataObj?.getNumber('total') ?? newRecords.length
							this.hasMore = newRecords.length >= this.pageSize
				} else {
					const errorMessage = responseData.getString('message') ?? ''
					uni.showToast({
						title: errorMessage != '' ? errorMessage : '加载失败',
						icon: 'none'
					})
				}
					this.loading = false
					this.loadingMore = false
				},
				fail: (error) => {
					console.error('加载记录失败:', error)
					uni.showToast({
						title: '网络错误',
						icon: 'none'
					})
					this.loading = false
					this.loadingMore = false
				}
		})
	},
			
		getStatusText(status: number | null): string {
			if (status == null) return '未知'
			const statusMap: UTSJSONObject = {
				"0": '待整改',
				"1": '已整改',
				"2": '已复查'
			}
			const statusText = statusMap[status.toString()] as string
			return statusText != null ? statusText : '未知'
		},
		
		formatDate(dateTimeStr: string): string {
			if (dateTimeStr == null || dateTimeStr == '') return ''
			// 如果是完整的日期时间格式，只取日期部分
			if (dateTimeStr.includes(' ')) {
				return dateTimeStr.split(' ')[0]
			}
			return dateTimeStr
		},
			
		getStatusClass(status: number | null): string {
				if (status == null) return 'status-unknown'
				const classMap: UTSJSONObject = {
					"0": 'status-pending',
					"1": 'status-completed',
					"2": 'status-accepted'
				}
				const statusClass = classMap[status.toString()] as string
				return statusClass != null ? statusClass : 'status-unknown'
			},
			
			getStatusTitle(): string {
				if (this.isDelayed) return '延迟整改'
				if (this.status == '0') return '待整改'
				if (this.status == '1') return '已整改'
				if (this.status == '2') return '已复查'
				return ''
			},
			
			goToDetail(record: InspectionRecord) {
				// 根据页面模式和记录状态进行不同的跳转
				if (this.isDelayed) {
					// 延迟整改模式：跳转到detail.uvue页面进行整改效果录入
					uni.navigateTo({
						url: `/pages/record/detail?id=${record.id}&delayed=true`
					})
				} else if (this.isReviewed) {
					// 已复查记录模式：与延迟整改使用相同逻辑跳转到review.uvue页面
					uni.navigateTo({
						url: `/pages/record/review?id=${record.id}&reviewed=true`
					})
				} else if (record.status === 0) {
					// 待整改：跳转到detail页面
					uni.navigateTo({
						url: `/pages/record/detail?id=${record.id}`
					})
				} else if (record.status === 1) {
					// 已整改：跳转到review.uvue页面
					uni.navigateTo({
						url: `/pages/record/review?id=${record.id}`
					})
				} else {
					// 其他状态：跳转到review.uvue页面（只读模式）
					uni.navigateTo({
						url: `/pages/record/review?id=${record.id}`
					})
				}
			},
			
			refreshRecords() {
				this.pageNum = 1
				this.recordList = []
				this.hasMore = true
				this.loadRecords()
				uni.stopPullDownRefresh()
			},
			
			// 下拉刷新
			onRefresh() {
			this.isRefreshing = true
			this.refreshRecords()
			
			// 设置定时器，3秒后自动关闭刷新状态
			setTimeout(() => {
				if (this.isRefreshing) {
					this.isRefreshing = false
					uni.stopPullDownRefresh()
				}
			}, 1500)
		},
			
			// 下拉刷新恢复
			onRefreshRestore() {
				this.isRefreshing = false
			},
			
			loadMore() {
				if (this.loadingMore || !this.hasMore) {
					return
				}
				this.pageNum++
				this.loadRecords()
			},
			
			handleScrollToLower() {
				if (this.hasMore && !this.loadingMore) {
					this.loadMore()
				}
			},
			
			showDeleteConfirm(recordId: string, problemDescription: string) {
				uni.showModal({
					title: '确认删除',
					content: `确定要删除问题"${problemDescription}"吗？此操作不可恢复。`,
					confirmText: '删除',
					cancelText: '取消',
					confirmColor: '#ff4757',
					success: (res) => {
						if (res.confirm) {
							this.deleteRecord(recordId)
						}
					}
				})
			},
			
			deleteRecord(recordId: string) {
				const token = uni.getStorageSync('token')
				
				uni.showLoading({
					title: '删除中...'
				})
				
				uni.request({
					url: getApiUrl(`/inspection-record/${recordId}`),
					method: 'DELETE',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
						uni.hideLoading()
						const responseData = res.data as UTSJSONObject
						if (res.statusCode === 200 && responseData.getNumber('code') === 200) {
							// 删除成功，从本地列表中移除该记录
							this.recordList = this.recordList.filter(record => record.id !== recordId)
							this.totalCount = Math.max(0, this.totalCount - 1)
							
							uni.showToast({
								title: '删除成功',
								icon: 'success'
							})
						} else {
							const errorMessage = responseData.getString('message') ?? '删除失败'
							uni.showToast({
								title: errorMessage,
								icon: 'none'
							})
						}
					},
					fail: (error) => {
						uni.hideLoading()
						console.error('删除记录失败:', error)
						uni.showToast({
							title: '网络错误',
							icon: 'none'
						})
					}
				})
			}
		}
	}
</script>

<style>
