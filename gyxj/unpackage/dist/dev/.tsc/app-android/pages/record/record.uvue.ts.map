		background-color: #f5f5f5;
		width: 100%;
	}
	
	.header {
		padding: 20px;
		background: #fff;
		border-bottom: 1px solid #e0e0e0;
	}
	
	.title {
		font-size: 18px;
		font-weight: bold;
		color: #333;
		margin-bottom: 5px;
	}
	
	.subtitle {
		font-size: 14px;
		color: #666;
	}
	
	.record-item {
		background: #fff;
		margin: 10px;
		margin-bottom: 1px;
		padding: 15px 20px;
		border-bottom: 1px solid #f0f0f0;
		border-radius: 8px;
	}
	
	.record-content {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 10px;
		width: 100%;
	}
	
	.left-content {
		flex: 1;
		margin-right: 15px;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	
	.problem-text {
		font-size: 15px;
		color: #666;
		line-height: 1.3;
		font-weight: 400;
		margin-top: 2px;
	}
	
	.right-info {
		flex-shrink: 0;
		text-align: right;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		justify-content: flex-start;
		min-width: 120px;
		max-width: 150px;
		gap: 6px;
		margin-left: auto;
	}
	
	.inspector-info {
		font-size: 13px;
		color: #333;
		font-weight: 500;
		text-align: right;
	}
	
	.date-text {
		font-size: 13px;
		color: #666;
	}
	
	.status-row {
		margin-top: 8px;
	}
	
	.status-tag {
		padding: 3px 10px;
		border-radius: 12px;
		font-size: 12px;
		align-self: flex-end;
	}
	
	.status-text {
		color: #fff;
		font-size: 12px;
		font-weight: 500;
	}
	
	.status-pending {
		background: #ff6b6b;
	}
	
	.status-processing {
		background: #ffa726;
	}
	
	.status-completed {
