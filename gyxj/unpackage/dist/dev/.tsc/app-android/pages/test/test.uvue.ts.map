			}
		},
		methods: {
			testDelayedMode() {
				console.log('测试延迟整改模式')
				uni.navigateTo({
					url: `/pages/record/review?id=${this.testRecordId}&delayed=true`
				})
			},
			
			testNormalMode() {
				console.log('测试正常模式')
				uni.navigateTo({
					url: `/pages/record/review?id=${this.testRecordId}`
				})
			}
		}
	}
</script>

