<template>
	<view class="container">
		<!-- 顶部欢迎区域 -->
		<view class="header">
			<view class="welcome">
				<text class="welcome-text">月检统计</text>
				<text class="date-text">{{currentDate}}</text>
			</view>
			<image class="avatar" src="/static/avatar.png"></image>
		</view>
		
		<!-- 统计卡片 -->
		<view class="stats-container">
			<view class="stats-card" @click="goToPendingIssues">
				<text class="stats-number">{{statistics.monthlyPending}}</text>
				<text class="stats-label">本月待整改</text>
				<text class="stats-icon">⚠️</text>
			</view>
			<view class="stats-card" @click="goToCompletedIssues">
				<text class="stats-number">{{statistics.monthlyCompleted}}</text>
				<text class="stats-label">本月已整改</text>
				<text class="stats-icon">✅</text>
			</view>
			<view class="stats-card" @click="goToMonthlyReport">
				<text class="stats-number">{{statistics.monthlyTotal}}</text>
				<text class="stats-label">本月总记录</text>
				<text class="stats-icon">📊</text>
			</view>
		</view>
		
		<!-- 月度趋势图 -->
		<view class="trend-section">
			<text class="section-title">月度趋势</text>
			<view class="trend-chart">
				<view class="chart-placeholder">
					<text class="placeholder-text">月度趋势图</text>
					<text class="placeholder-desc">显示本月问题发现与整改趋势</text>
				</view>
			</view>
		</view>
		
		<!-- 快捷功能 -->
		<view class="quick-actions">
			<text class="section-title">快捷功能</text>
			<view class="actions-grid">
				<view class="action-item" @click="goToAddRecord">
					<view class="action-icon">➕</view>
					<text class="action-text">新增记录</text>
				</view>
				<view class="action-item" @click="goToMonthlyReport">
					<view class="action-icon">📊</view>
					<text class="action-text">月度报告</text>
				</view>
				<view class="action-item" @click="goToPendingIssues">
					<view class="action-icon">⚠️</view>
					<text class="action-text">待整改问题</text>
				</view>
				<view class="action-item" @click="goToCompletedIssues">
					<view class="action-icon">✅</view>
					<text class="action-text">已整改问题</text>
				</view>
			</view>
		</view>
		
		<!-- 本月记录 -->
		<view class="recent-records">
			<view class="section-header">
				<text class="section-title">本月记录</text>
				<text class="more-text" @click="goToRecords">查看更多</text>
			</view>
			<view class="records-list">
				<view class="record-item" v-for="record in monthlyRecords" :key="record.id">
					<view class="record-info">
						<text class="record-title">{{record.problemDescription}}</text>
						<text class="record-meta">{{record.locationName}} · {{record.createTime}}</text>
					</view>
					<view class="record-status" :class="getStatusClass(record.status)">
						<text>{{getStatusText(record.status)}}</text>
					</view>
				</view>
				<view v-if="monthlyRecords.length === 0" class="empty-state">
					<text class="empty-text">本月暂无记录</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script lang="uts">
	import { getApiUrl } from '@/config/api.uts'
	type MonthlyRecord = {
		id: string,
		problemDescription: string,
		locationName: string,
		createTime: string,
		status: string
	}

	type MonthlyStatistics = {
		monthlyPending: number,
		monthlyCompleted: number,
		monthlyTotal: number
	}

	export default {
		data() {
			return {
				userInfo: {} as UTSJSONObject,
				currentDate: '',
				statistics: {
					monthlyPending: 0,
					monthlyCompleted: 0,
					monthlyTotal: 0
				} as MonthlyStatistics,
				monthlyRecords: [] as MonthlyRecord[]
			}
		},
		onLoad(options: OnLoadOptions) {
			this.checkLogin()
			this.initData()
			this.loadStatistics()
			this.loadMonthlyRecords()
		},
		methods: {
			checkLogin() {
				const token = uni.getStorageSync('token')
				if (token == null || token == '') {
					uni.reLaunch({
						url: '/pages/login/login'
					})
					return
				}
				const userInfoStr = uni.getStorageSync('userInfo') as string
				if (userInfoStr != null && userInfoStr != '') {
					this.userInfo = JSON.parse(userInfoStr) as UTSJSONObject
				} else {
					this.userInfo = {} as UTSJSONObject
				}
			},
			
			initData() {
				const now = new Date()
				const year = now.getFullYear()
				const month = (now.getMonth() + 1).toString()
				const formattedMonth = month.length == 1 ? `0${month}` : month
				this.currentDate = `${year}年${formattedMonth}月`
			},
			
			loadStatistics() {
				const token = uni.getStorageSync('token')
				uni.request({
					url: getApiUrl('/statistics/overview'),
					method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
						const response = res.data as UTSJSONObject
						if (res.statusCode == 200 && (response.getNumber('code') ?? 0) == 200) {
							const data = response.getJSON('data') as UTSJSONObject
							// 暂时使用原有接口数据，后续可调整
							this.statistics = {
								monthlyPending: data.getNumber('totalTasks') ?? 0,
								monthlyCompleted: data.getNumber('todayRecords') ?? 0,
								monthlyTotal: data.getNumber('monthRecords') ?? 0
							}
						}
					},
					fail: (error) => {
						console.log('加载统计数据失败:', error)
					}
				})
			},
			
			loadMonthlyRecords() {
				const token = uni.getStorageSync('token')
				uni.request({
					url: getApiUrl('/inspection-record/page?pageNum=1&pageSize=10'),
					method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
						const response = res.data as UTSJSONObject
						if (res.statusCode == 200 && (response.getNumber('code') ?? 0) == 200) {
							const data = response.getJSON('data') as UTSJSONObject
							const records = data.getArray('records') as Array<UTSJSONObject>
							this.monthlyRecords = []
							for (let i = 0; i < records.length; i++) {
								const item = records[i]
								const record: MonthlyRecord = {
									id: item.getString('id') ?? '',
									problemDescription: item.getString('problemDescription') ?? '',
									locationName: item.getString('locationName') ?? '',
									createTime: item.getString('createTime') ?? '',
									status: item.getString('status') ?? ''
								}
								this.monthlyRecords.push(record)
							}
						}
					},
					fail: (error) => {
						console.log('加载月度记录失败:', error)
					}
				})
			},
			
			getStatusText(status: string): string {
				if (status == "0") return '待整改'
				if (status == "1") return '已整改'
				if (status == "2") return '已复查'
				return '未知'
			},
			
			getStatusClass(status: string): string {
				if (status == "0") return 'status-pending'
				if (status == "1") return 'status-completed'
				if (status == "2") return 'status-accepted'
				return 'status-unknown'
			},
			
			goToPendingIssues() {
				uni.navigateTo({
					url: '/pages/record/record?status=0'
				})
			},
			
			goToCompletedIssues() {
				uni.navigateTo({
					url: '/pages/record/record?status=1'
				})
			},
			
			goToMonthlyReport() {
				uni.navigateTo({
					url: '/pages/statistics/statistics'
				})
			},
			
			goToRecords() {
				uni.switchTab({
					url: '/pages/record/record'
				})
			},
			
			goToAddRecord() {
				uni.navigateTo({
					url: '/pages/record/add'
				})
			}
		}
	}
</script>

