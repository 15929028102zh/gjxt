export function refreshUserInfo(): Promise<boolean> {
    return new Promise<boolean>((resolve, _reject) => {
        const token = uni.getStorageSync('token');
        const tokenStr = token != null ? `${token}` : '';
        if (tokenStr == '' || tokenStr == 'null' || tokenStr == 'undefined') {
            resolve(false);
            return;
        }
        const cached = getCachedUserInfo();
        const username = cached.getString('username') ?? '';
        if (username == '') {
            resolve(false);
            return;
        }
        // avatar 是客户端由 imageUrl 换算出来的本地字段，服务端 SysUser 里没有，
        // 刷新时要保留，否则头像会退回默认图
        const cachedAvatar = cached.getString('avatar') ?? '';
        uni.request({
            url: getApiUrl(`/user/info?username=${username}`),
            method: 'GET',
            header: { 'Authorization': `Bearer ${tokenStr}` },
            success: (res) => {
                const data = res.data as UTSJSONObject;
                if (res.statusCode == 200 && (data.getNumber('code') ?? 0) == 200) {
                    const latest = data.getJSON('data');
                    if (latest != null) {
                        if ((latest.getString('avatar') ?? '') == '' && cachedAvatar != '') {
                            latest.set('avatar', cachedAvatar);
                        }
