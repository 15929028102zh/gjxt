const __sfc__ = defineComponent({
    data() {
        return {
            userInfo: {} as UTSJSONObject,
            userStats: {} as UTSJSONObject,
            showEditModal: false,
            showAvatarModal: false,
            editForm: {
                realName: '',
                phone: ''
            } as EditForm,
            loading: false
        };
    },
    onLoad() {
        this.checkLogin();
        this.loadUserInfo();
        this.loadUserStats();
    },
    methods: {
        checkLogin() {
            const token = uni.getStorageSync('token');
            if (token == null || token == '') {
                uni.reLaunch({
                    url: '/pages/login/login'
                });
            }
        },
        loadUserInfo() {
            const userInfoStr = uni.getStorageSync('userInfo') as string;
            console.log('从本地存储获取的用户信息字符串:', userInfoStr, " at pages/profile/profile.uvue:109");
            if (userInfoStr != null && userInfoStr != '') {
                const userInfo = UTSAndroid.consoleDebugError(JSON.parse(userInfoStr), " at pages/profile/profile.uvue:112") as UTSJSONObject;
                console.log('解析后的用户信息:', userInfo, " at pages/profile/profile.uvue:113");
                console.log('用户ID字段:', userInfo.getString('id'), " at pages/profile/profile.uvue:114");
                console.log('用户信息JSON字符串:', JSON.stringify(userInfo), " at pages/profile/profile.uvue:115");
                this.userInfo = userInfo;
                this.editForm.realName = userInfo.getString('realName') ?? '';
                this.editForm.phone = userInfo.getString('phone') ?? '';
            }
            else {
                console.log('本地存储中没有用户信息', " at pages/profile/profile.uvue:121");
            }
        },
        loadUserStats() {
            const token = uni.getStorageSync('token');
            uni.request({
                url: getApiUrl('/user/stats'),
                method: 'GET',
                header: {
                    'Authorization': `Bearer ${token}`
                },
                success: (res) => {
                    const data = res.data as UTSJSONObject;
                    if (res.statusCode == 200 && (data.getNumber('code') ?? 0) == 200) {
                        this.userStats = data.getJSON('data') as UTSJSONObject;
                    }
                },
                fail: (error) => {
                    console.log('加载用户统计失败:', error, " at pages/profile/profile.uvue:140");
                }
            });
        },
        getRoleText(role: number): string {
            if (role == 1) {
                return '管理员';
            }
            else if (role == 2) {
                return '超级管理员';
            }
            else {
                return '普通用户';
            }
        },
        showAvatarOptions() {
            this.showAvatarModal = true;
        },
        closeAvatarModal() {
            this.showAvatarModal = false;
        },
        changeAvatar() {
            this.closeAvatarModal();
            uni.chooseImage({
                count: 1,
                sizeType: ['compressed'],
                sourceType: ['album', 'camera'],
                success: (res) => {
                    const tempFilePath = res.tempFilePaths[0];
                    this.uploadAvatar(tempFilePath);
                },
                fail: (error) => {
                    console.log('选择图片失败:', error, " at pages/profile/profile.uvue:174");
                }
            });
        },
        uploadAvatar(filePath: string) {
            const token = uni.getStorageSync('token');
            // 先上传图片文件获取URL
            uni.uploadFile({
                url: getApiUrl('/upload/image'),
                filePath: filePath,
                name: 'file',
                header: {
                    'Authorization': `Bearer ${token}`
                },
                success: (res) => {
                    // 调试：打印上传响应
                    console.log('上传图片响应:', res, " at pages/profile/profile.uvue:191");
                    console.log('上传图片响应数据:', res.data, " at pages/profile/profile.uvue:192");
                    const data = UTSAndroid.consoleDebugError(JSON.parse(res.data), " at pages/profile/profile.uvue:194") as UTSJSONObject;
                    console.log('解析后的数据:', data, " at pages/profile/profile.uvue:195");
                    if (res.statusCode === 200 && data.getNumber('code') === 200) {
                        const dataObj = data.getJSON('data');
                        const imageUrl = dataObj?.getString('filePath') ?? '';
                        console.log('获取到的图片URL:', imageUrl, " at pages/profile/profile.uvue:200");
                        if (imageUrl == null || imageUrl == '') {
                            console.log('警告：图片URL为空', " at pages/profile/profile.uvue:203");
                            uni.showToast({
                                title: '上传成功但未获取到图片URL',
                                icon: 'none'
                            });
                            return;
                        }
                        // 调用设置头像接口更新数据库
                        this.updateUserAvatar(imageUrl);
                    }
                    else {
                        console.log('上传失败，状态码:', res.statusCode, '错误码:', data.getNumber('code'), " at pages/profile/profile.uvue:214");
                        uni.showToast({
                            title: data.getString('message') ?? '上传失败',
                            icon: 'none'
                        });
                    }
                },
                fail: (error) => {
                    console.log('上传头像失败:', error, " at pages/profile/profile.uvue:222");
                    uni.showToast({
                        title: '上传失败',
                        icon: 'none'
                    });
                }
            });
        },
        updateUserAvatar(imageUrl: string) {
            const token = uni.getStorageSync('token');
            // 调试：打印用户信息
            console.log('用户信息调试:', this.userInfo, " at pages/profile/profile.uvue:235");
            console.log('用户信息类型:', typeof this.userInfo, " at pages/profile/profile.uvue:236");
            console.log('用户信息字符串:', JSON.stringify(this.userInfo), " at pages/profile/profile.uvue:237");
            const username = this.userInfo.getString('username') ?? '';
            console.log('获取到的用户名:', username, " at pages/profile/profile.uvue:240");
            if (username == null || username == '') {
                uni.showToast({
                    title: '用户信息异常',
                    icon: 'none'
                });
                return;
            }
            uni.request({
                url: getApiUrl(`/user/${username}/update-avatar`),
                method: 'PUT',
                header: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                },
                data: {
                    imageUrl: imageUrl
                },
                success: (res) => {
                    const data = res.data as UTSJSONObject;
                    if (res.statusCode === 200 && data.getNumber('code') === 200) {
                        // 将物理路径转换为HTTP访问路径
                        const httpImageUrl = this.convertToHttpUrl(imageUrl);
                        // 更新本地用户信息
                        this.userInfo.set('avatar', httpImageUrl);
                        uni.setStorageSync('userInfo', JSON.stringify(this.userInfo));
                        uni.showToast({
                            title: '头像更新成功',
                            icon: 'success'
                        });
                    }
                    else {
                        uni.showToast({
                            title: data.getString('message') ?? '设置头像失败',
                            icon: 'none'
                        });
                    }
                },
                fail: (error) => {
                    console.log('设置头像失败:', error, " at pages/profile/profile.uvue:280");
                    uni.showToast({
                        title: '设置头像失败',
                        icon: 'none'
                    });
                }
            });
        },
        editProfile() {
            this.closeAvatarModal();
            this.showEditModal = true;
        },
        closeEditModal() {
            this.showEditModal = false;
            // 重置表单
            const realName = this.userInfo.getString('realName') ?? '';
            const phone = this.userInfo.getString('phone') ?? '';
            this.editForm.realName = realName != '' ? realName : '';
            this.editForm.phone = phone != '' ? phone : '';
        },
        async saveProfile(): Promise<void> {
            if (this.editForm.realName.trim() == '') {
                uni.showToast({
                    title: '请输入真实姓名',
                    icon: 'none'
                });
                return;
            }
            if (this.editForm.phone != '' && !/^1[3-9]\d{9}$/.test(this.editForm.phone)) {
                uni.showToast({
                    title: '请输入正确的手机号',
                    icon: 'none'
                });
                return;
            }
            if (this.loading)
                return;
            this.loading = true;
            const token = uni.getStorageSync('token');
            uni.request({
                url: getApiUrl('/user/profile'),
                method: 'PUT',
                header: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                },
                data: {
                    realName: this.editForm.realName,
                    phone: this.editForm.phone
                },
                success: (res) => {
                    const data = res.data as UTSJSONObject;
                    if (res.statusCode === 200 && data.getNumber('code') === 200) {
                        // 更新本地用户信息
                        this.userInfo.set('realName', this.editForm.realName);
                        this.userInfo.set('phone', this.editForm.phone);
                        uni.setStorageSync('userInfo', JSON.stringify(this.userInfo));
                        uni.showToast({
                            title: '保存成功',
                            icon: 'success'
                        });
                        this.closeEditModal();
                    }
                    else {
                        const message = data.getString('message') ?? '保存失败';
                        uni.showToast({
                            title: message,
                            icon: 'none'
                        });
                    }
                    this.loading = false;
                },
                fail: (error) => {
                    console.error('保存用户信息失败:', error, " at pages/profile/profile.uvue:360");
                    uni.showToast({
                        title: '保存失败',
                        icon: 'none'
                    });
                    this.loading = false;
                }
            });
        },
        goToMyRecords() {
            uni.navigateTo({
                url: '/pages/record/record?userId=' + (this.userInfo.getString('id') ?? '')
            });
        },
        goToMyTasks() {
            uni.navigateTo({
                url: '/pages/task/task?assigneeId=' + (this.userInfo.getString('id') ?? '')
            });
        },
        showSettings() {
            uni.showToast({
                title: '功能开发中',
                icon: 'none'
            });
        },
        showHelp() {
            uni.showModal({
                title: '帮助与反馈',
                content: '如有问题请联系管理员\n电话：400-123-4567\n邮箱：support@example.com',
                showCancel: false
            });
        },
        showAbout() {
            uni.showModal({
                title: '关于我们',
                content: '工业巡检系统 v1.0.0\n\n专业的工业设备巡检管理平台，提供任务管理、记录跟踪、数据分析等功能。',
                showCancel: false
            });
        },
        // 将相对路径转换为HTTP访问路径
        convertToHttpUrl(relativePath: string): string {
            console.log('相对路径:', relativePath, " at pages/profile/profile.uvue:407");
            // 如果已经是HTTP路径，直接返回
            if (relativePath.startsWith('http://') || relativePath.startsWith('https://')) {
                return relativePath;
            }
            // 直接拼接完整的HTTP URL
            // 后端已返回相对路径，如: /files/images/20250818/xxx.jpg
            const httpUrl = `${apiConfig.baseUrl}/api${relativePath}`;
            console.log('转换后的HTTP URL:', httpUrl, " at pages/profile/profile.uvue:416");
            return httpUrl;
        },
        logout() {
            uni.showModal({
                title: '确认退出',
                content: '确定要退出登录吗？',
                success: (res) => {
                    if (res.confirm) {
                        // 清除本地存储
                        uni.removeStorageSync('token');
                        uni.removeStorageSync('userInfo');
                        // 跳转到登录页
                        uni.reLaunch({
                            url: '/pages/login/login'
                        });
                    }
                }
            });
        }
    }
});
