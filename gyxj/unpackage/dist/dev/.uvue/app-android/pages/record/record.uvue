            return statusClass != null ? statusClass : 'status-unknown';
        },
        getStatusTitle(): string {
            if (this.isDelayed)
                return '延迟整改';
            if (this.status == '0')
                return '待整改';
            if (this.status == '1')
                return '已整改';
            if (this.status == '2')
                return '已复查';
            return '';
        },
        goToDetail(record: InspectionRecord) {
            // 根据页面模式和记录状态进行不同的跳转
            if (this.isDelayed) {
                // 延迟整改模式：跳转到review.uvue页面（只读模式）
                uni.navigateTo({
                    url: `/pages/record/review?id=${record.id}&delayed=true`
                });
            }
            else if (this.isReviewed) {
                // 已复查记录模式：与延迟整改使用相同逻辑跳转到review.uvue页面
                uni.navigateTo({
                    url: `/pages/record/review?id=${record.id}&reviewed=true`
                });
            }
            else if (record.status === 0) {
                // 待整改：跳转到detail页面
                uni.navigateTo({
                    url: `/pages/record/detail?id=${record.id}`
                });
            }
            else if (record.status === 1) {
                // 已整改：跳转到review.uvue页面
                uni.navigateTo({
                    url: `/pages/record/review?id=${record.id}`
                });
            }
            else {
                // 其他状态：跳转到review.uvue页面（只读模式）
                uni.navigateTo({
                    url: `/pages/record/review?id=${record.id}`
                });
            }
        },
        refreshRecords() {
            this.pageNum = 1;
            this.recordList = [];
            this.hasMore = true;
            this.loadRecords();
            uni.stopPullDownRefresh();
        },
        loadMore() {
            if (this.loadingMore || !this.hasMore) {
                return;
            }
            this.pageNum++;
