            this.refreshRecords();
        },
        async loadRecords(): Promise<void> {
            if (this.pageNum === 1) {
                this.loading = true;
            }
            else {
                this.loadingMore = true;
            }
            const token = uni.getStorageSync('token');
            // 根据是否是延迟整改选择不同的API
            let apiUrl = '';
