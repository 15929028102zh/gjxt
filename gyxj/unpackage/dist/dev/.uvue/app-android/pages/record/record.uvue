                            this.recordList = newRecords;
                        }
                        else {
                            this.recordList = this.recordList.concat(newRecords);
                        }
                        this.totalCount = dataObj?.getNumber('total') ?? newRecords.length;
                        this.hasMore = newRecords.length >= this.pageSize;
