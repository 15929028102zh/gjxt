            uni.showModal({
                title: '确认删除',
                content: `确定要删除问题"${problemDescription}"吗？此操作不可恢复。`,
                confirmText: '删除',
                cancelText: '取消',
                confirmColor: '#ff4757',
                success: (res) => {
                    if (res.confirm) {
                        this.deleteRecord(recordId);
                    }
                }
            });
        },
        deleteRecord(recordId: string) {
            const token = uni.getStorageSync('token');
            uni.showLoading({
                title: '删除中...'
            });
            uni.request({
                url: getApiUrl(`/inspection-record/${recordId}`),
                method: 'DELETE',
                header: {
                    'Authorization': `Bearer ${token}`
                },
                success: (res) => {
                    uni.hideLoading();
                    const responseData = res.data as UTSJSONObject;
                    if (res.statusCode === 200 && responseData.getNumber('code') === 200) {
                        // 删除成功，从本地列表中移除该记录
                        this.recordList = this.recordList.filter((record): boolean => record.id !== recordId);
                        this.totalCount = Math.max(0, this.totalCount - 1);
                        uni.showToast({
                            title: '删除成功',
                            icon: 'success'
                        });
                    }
                    else {
                        const errorMessage = responseData.getString('message') ?? '删除失败';
                        uni.showToast({
                            title: errorMessage,
                            icon: 'none'
                        });
                    }
                },
                fail: (error) => {
                    uni.hideLoading();
                    console.error('删除记录失败:', error, " at pages/record/record.uvue:364");
                    uni.showToast({
                        title: '网络错误',
                        icon: 'none'
                    });
                }
            });
        }
    }
