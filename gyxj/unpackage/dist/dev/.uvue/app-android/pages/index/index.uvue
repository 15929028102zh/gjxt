                pendingIssues: 0,
                completedIssues: 0,
                monthRecords: 0
            } as StatisticsData,
            recentRecords: [] as RecentRecord[]
        };
    },
    onLoad(options: OnLoadOptions) {
        this.checkLogin();
        this.initData();
