            const month = selectedMonth.toString(10).padStart(2, '0');
            const day = selectedDay.toString(10).padStart(2, '0');
            const newDate = `${year}-${month}-${day}`;
            console.log('确认日期选择:', {
                pickerValue: this.pickerValue,
                yearsArray: this.years,
                monthsArray: this.months,
                daysArray: this.days,
                selectedYear: selectedYear,
                selectedMonth: selectedMonth,
                selectedDay: selectedDay,
                formattedDate: newDate
            });
            this.formData.rectificationDate = newDate;
            this.hideDatePicker();
        }
    }
