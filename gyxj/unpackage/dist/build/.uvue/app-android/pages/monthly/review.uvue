import { getApiUrl, apiConfig } from '@/config/api.uts';
import { resolveCurrentDept, getCachedUserInfo, CurrentDept } from '@/utils/user.uts';
// V3:当前用户类型(对齐 Web:复查按钮只看 deptType,与 admin 无关)
type CurrentUser = {
    deptId: string;
    deptName: string;
    deptType: number | null; // 0=运行部门 1=管理部门 null=无部门(如管理员)
};
type MonthlyReviewDetail = {
    id: string;
    problemDescription: string;
    location: string;
    rectificationEffect: string;
    rectificationSuggestion: string;
    rectificationImages: string;
    rectificationDeadline: string;
    departmentName: string;
    professionalTypeName: string;
    responsibilityName: string;
    issueName: string;
    moduleName: string;
    inspector: string;
    responsiblePerson: string;
    responsibleUnit: string;
    qualityName: string;
    checkUnitName: string;
    natureModified: number;
    photos: string;
    taskId: string;
};
const __sfc__ = defineComponent({
    data() {
        return {
            id: '',
            detail: null as MonthlyReviewDetail | null,
            rectImages: [] as string[],
            reviewSuggestion: '',
            reviewEffect: '',
            reviewImages: [] as string[],
            loading: true,
            saving: false,
            problemImages: [] as string[],
            containerHeight: 0,
            // V3:当前用户(用于部门类型判断)
            currentUser: { deptId: '', deptName: '', deptType: null } as CurrentUser,
            // 复查人：当前登录用户姓名（只读）
            currentUserName: '',
            // V3:任务期阶段(仅保留兼容,复查可见性不再依赖 phase)
            taskPhase: 0
        };
    },
    onLoad(options: UTSJSONObject) {
        this.id = options.getString('id') ?? '';
        this.loadDetail().then(() => {
            // V3:详情加载完后,拉当前用户 + 任务 phase(用于按钮可见性判断)
            this.loadCurrentUser();
            this.loadTaskPhase();
        });
    },
    onReady() {
        uni.getSystemInfo({ success: (res) => { this.containerHeight = res.windowHeight; } });
    },
    methods: {
        convertToHttpUrl(path: string): string {
            if (path == null || path == '')
                return '';
            if (path.startsWith('http://') || path.startsWith('https://'))
                return path;
            return `${apiConfig.baseUrl}/api${path}`;
        },
        getDeductionScore(qualityName: string): string {
            if (qualityName === '观察')
                return '1';
            if (qualityName === '一般')
                return '3';
            if (qualityName === '重要')
                return '5';
            return '-';
        },
        displayValue(v: string): string {
            return v !== '' && v != null ? v : '暂无';
        },
        loadDetail(): Promise<void> {
            return new Promise((resolve, _reject) => {
                const token = uni.getStorageSync('token');
                uni.request({
                    url: getApiUrl(`/monthly-inspection-record/${this.id}`),
                    method: 'GET',
                    header: { 'Authorization': `Bearer ${token}` },
                    success: (res) => {
                        const data = res.data as UTSJSONObject;
                        if (res.statusCode === 200 && (data.getNumber('code') ?? 0) === 200) {
                            const d = data.getJSON('data') as UTSJSONObject | null;
                            if (d != null) {
                                this.detail = {
                                    id: d!!.getString('id') ?? '',
                                    problemDescription: d!!.getString('problemDescription') ?? '',
                                    location: d!!.getString('location') ?? '',
                                    rectificationEffect: (d!!.getString('rectificationEffect') ?? ''),
                                    rectificationSuggestion: (d!!.getString('rectificationSuggestion') ?? ''),
                                    rectificationImages: d!!.getString('rectificationImages') ?? '',
                                    rectificationDeadline: d!!.getString('rectificationDeadline') ?? '',
                                    departmentName: d!!.getString('departmentName') ?? '',
                                    professionalTypeName: d!!.getString('professionalTypeName') ?? '',
                                    responsibilityName: d!!.getString('responsibilityName') ?? '',
                                    issueName: d!!.getString('issueName') ?? '',
                                    moduleName: d!!.getString('moduleName') ?? '',
                                    inspector: d!!.getString('inspector') ?? '',
                                    responsiblePerson: d!!.getString('responsiblePerson') ?? '',
                                    responsibleUnit: d!!.getString('responsibleUnit') ?? '',
                                    qualityName: d!!.getString('qualityName') ?? '',
                                    checkUnitName: d!!.getString('checkUnitName') ?? '',
                                    natureModified: d!!.getNumber('natureModified') ?? 0,
                                    photos: d!!.getString('photos') ?? '',
                                    taskId: d!!.getString('taskId') ?? ''
                                } as MonthlyReviewDetail;
                                if (this.detail!.photos != null && this.detail!.photos != '') {
                                    const p = this.detail!.photos;
                                    if (p.trim().startsWith('[') && p.trim().endsWith(']')) {
                                        try {
                                            this.problemImages = (JSON.parse(p) as string[]);
                                        }
                                        catch (_: any) { }
                                    }
                                    else {
                                        this.problemImages = p.split(',').map((u): string => u.trim()).filter((u): boolean => u != '');
                                    }
                                }
                                const imgs = this.detail!.rectificationImages;
                                if (imgs != null && imgs != '') {
                                    if (imgs.trim().startsWith('[') && imgs.trim().endsWith(']')) {
                                        try {
                                            this.rectImages = (JSON.parse(imgs) as string[]);
                                        }
                                        catch (_: any) { }
                                    }
                                    else {
                                        this.rectImages = imgs.split(',').map((u): string => u.trim()).filter((u): boolean => u != '');
                                    }
                                }
                            }
                        }
                        else {
                            uni.showToast({ title: data.getString('message') ?? '加载失败', icon: 'none' });
                        }
                        this.loading = false;
                        resolve(void 0);
                    },
                    fail: (_) => {
                        this.loading = false;
                        uni.showToast({ title: '网络错误', icon: 'none' });
                        resolve(void 0);
                    }
                });
            });
        },
        // V3:加载当前用户(取 deptType 用于复查按钮可见性)
        // resolveCurrentDept 先刷新服务端 userInfo 再取部门类型，避免用登录时的旧 deptId 快照判定角色
        loadCurrentUser() {
            resolveCurrentDept().then((dept: CurrentDept) => {
                this.currentUser = { deptId: dept.deptId, deptName: dept.deptName, deptType: dept.deptType } as CurrentUser;
                // 复查人取当前登录用户真实姓名
                const info = getCachedUserInfo();
                this.currentUserName = info.getString('realName') ?? info.getString('username') ?? '';
            });
        },
        // V3:从 taskId 拉任务计算 phase
        loadTaskPhase() {
            if (this.detail == null)
                return;
            const token = uni.getStorageSync('token');
            uni.request({
                url: getApiUrl(`/monthly-inspection-task/${this.detail!.taskId ?? ''}`),
                method: 'GET',
                header: { 'Authorization': `Bearer ${token}` },
                success: (res) => {
                    const data = res.data as UTSJSONObject;
                    if (res.statusCode !== 200 || (data.getNumber('code') ?? 0) !== 200)
                        return;
                    const t = data.getJSON('data');
                    if (t == null)
                        return;
                    const tObj = t as UTSJSONObject;
                    const pubStartStr = tObj.getString('publicityStartTime') ?? '';
                    const pubEndStr = tObj.getString('publicityEndTime') ?? '';
                    const now = new Date();
                    const parseDt = (s: string): Date | null => {
                        if (s == null || s == '')
                            return null;
                        return new Date(s.replace(' ', 'T'));
                    };
                    const pubStart = parseDt(pubStartStr);
                    const pubEnd = parseDt(pubEndStr);
                    if (pubStart == null || pubEnd == null) {
                        this.taskPhase = 0;
                        return;
                    }
                    if (now < pubStart)
                        this.taskPhase = 2;
                    else if (now <= pubEnd)
                        this.taskPhase = 3;
                    else
                        this.taskPhase = 4;
                }
            });
        },
        // 对齐 Web showReviewButton:复查按钮仅由 deptType 决定(deptType !== 0),不受公示期限制
        isReviewVisible(): boolean {
            return this.currentUser.deptType !== 0;
        },
        previewRect(i: number) {
            uni.previewImage({ current: i, urls: this.rectImages.map((u): string => this.convertToHttpUrl(u)) });
        },
        previewProblemImage(i: number) {
            uni.previewImage({ current: i, urls: this.problemImages.map((u): string => this.convertToHttpUrl(u)) });
        },
        chooseReview() {
            if (this.reviewImages.length >= 3) {
                uni.showToast({ title: '最多3张', icon: 'none' });
                return;
            }
            uni.chooseImage({
                count: 3 - this.reviewImages.length,
                sourceType: ['camera', 'album'],
                success: (res) => {
                    const token = uni.getStorageSync('token');
                    res.tempFilePaths.forEach((p) => {
                        uni.uploadFile({
                            url: getApiUrl('/upload/image'),
                            filePath: p,
                            name: 'file',
                            header: { 'Authorization': `Bearer ${token}` },
                            success: (upRes) => {
                                try {
                                    const result = JSON.parse(upRes.data) as UTSJSONObject;
                                    if (upRes.statusCode === 200 && (result.getNumber('code') ?? 0) === 200) {
                                        const dataObj = result.getJSON('data');
                                        const url = dataObj?.getString('filePath') ?? '';
                                        if (url != '')
                                            this.reviewImages.push(url);
                                    }
                                    else {
                                        uni.showToast({ title: result.getString('message') ?? '上传失败', icon: 'none' });
                                    }
                                }
                                catch (_: any) {
                                    uni.showToast({ title: '上传失败', icon: 'none' });
                                }
                            },
                            fail: (_) => { uni.showToast({ title: '上传失败', icon: 'none' }); }
                        });
                    });
                }
            });
        },
        previewReview(i: number) {
            uni.previewImage({ current: i, urls: this.reviewImages.map((u): string => this.convertToHttpUrl(u)) });
        },
        removeReview(i: number) { this.reviewImages.splice(i, 1); },
        submitReview() {
            if (this.saving)
                return;
            if (this.reviewSuggestion.trim() == '') {
                uni.showToast({ title: '请填写复查建议', icon: 'none' });
                return;
            }
            if (this.reviewEffect.trim() == '') {
                uni.showToast({ title: '请填写复查效果', icon: 'none' });
                return;
            }
            this.saving = true;
            const token = uni.getStorageSync('token');
            // 对齐 Web ReviewDialog:复查提交仅含建议/效果/图片,不含责任人/单位
            const data = {
                reviewSuggestion: this.reviewSuggestion,
                reviewEffect: this.reviewEffect,
                reviewImages: this.reviewImages.join(','),
                // 复查人（当前登录用户）
                reviewerName: this.currentUserName
            } as UTSJSONObject;
            uni.request({
                url: getApiUrl(`/monthly-inspection-record/${this.id}/review`),
                method: 'PUT',
                header: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                data: data,
                success: (res) => {
                    const resp = res.data as UTSJSONObject;
                    if (res.statusCode === 200 && (resp.getNumber('code') ?? 0) === 200) {
                        uni.showToast({ title: '复查确认成功', icon: 'success' });
                        setTimeout(function () { uni.navigateBack(); }, 1200);
                    }
                    else {
                        uni.showToast({ title: resp.getString('message') ?? '提交失败', icon: 'none' });
                    }
                    this.saving = false;
                },
                fail: (_) => { this.saving = false; uni.showToast({ title: '网络错误', icon: 'none' }); }
            });
        }
    }
});
