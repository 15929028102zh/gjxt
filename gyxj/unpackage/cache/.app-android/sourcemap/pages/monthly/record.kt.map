<template>
	<scroll-view 
		class="container" 
		scroll-y="true" 
		:style="{height: containerHeight + 'px'}"
		enable-back-to-top="true"
		refresher-enabled="true"
		:refresher-triggered="isRefreshing"
		refresher-default-style="black"
		refresher-background="#f5f5f5"
		@refresherrefresh="onRefresh"
		@refresherrestore="onRefreshRestore"
	>
		<!-- 页面标题 -->
		<view class="header">
			<text class="title">月检记录</text>
			<text class="subtitle">共 {{totalCount}} 条{{getStatusTitle()}}记录</text>
		</view>
		
		<!-- 记录列表 -->
		<view class="record-item" v-for="record in recordList" :key="record.id" @click="goToDetail(record)">
			<view class="record-content">
				<!-- 左侧内容区域 -->
				<view class="left-content">
					<view class="name-problem-row">
						<text class="responsible-name">{{record.responsiblePerson}}</text>
					</view>
				</view>
				
				<!-- 右侧信息区域 -->
				<view class="right-info">
					<text class="inspector-info">检查人：{{record.inspectorName}}</text>
					<text class="date-text">{{record.createDate}}</text>
					<view class="status-tag" :class="getStatusClass(record.status)">
						<text class="status-text">{{getStatusText(record.status)}}</text>
					</view>
				</view>
				<text class="problem-text">{{record.problemDescription}}</text>
			</view>
		</view>
		
		<!-- 空状态 -->
		<view v-if="recordList.length === 0 && !loading" class="empty-state">
			<text class="empty-icon">📝</text>
			<text class="empty-text">暂无记录</text>
		</view>
		
		<!-- 加载状态 -->
		<view v-if="loading" class="loading-state">
			<text class="loading-text">加载中...</text>
		</view>
		
		<!-- 加载更多 -->
		<view v-if="hasMore && !loading && recordList.length > 0" class="load-more" @click="loadMore">
			<text class="load-more-text">加载更多</text>
		</view>
		
		<!-- 没有更多数据 -->
		<view v-if="!hasMore && recordList.length > 0" class="no-more">
			<text class="no-more-text">没有更多数据了</text>
		</view>
	</scroll-view>
</template>

<script>
	import { getApiUrl } from '@/config/api.uts'
	
	interface MonthlyRecord {
		id: number
		problemDescription: string
		responsiblePerson: string
		inspectorName: string
		createDate: string
		status: number
		departmentName: string
	}
	
	export default {
		data() {
			return {
				recordList: [] as MonthlyRecord[],
				loading: false,
				hasMore: true,
				totalCount: 0,
				pageNum: 1,
				pageSize: 10,
				status: null as number | null,
				isRefreshing: false,
				containerHeight: 0
			}
		},
		onLoad(options: any) {
			// 获取状态参数
			if (options.status !== undefined) {
				this.status = parseInt(options.status)
			}
			
			// 设置容器高度
			const systemInfo = uni.getSystemInfoSync()
			this.containerHeight = systemInfo.windowHeight
			
			this.loadRecords()
		},
		methods: {
			loadRecords() {
				if (this.loading) return
				
				this.loading = true
				const token = uni.getStorageSync('token')
				
				// 获取用户信息，包括部门和管理员权限
				let departmentId = ''
				let isAdmin = false
				const userInfoData = uni.getStorageSync('userInfo')
				const userInfoStr = userInfoData != null ? userInfoData as string : ''
				if (userInfoStr != null && userInfoStr != '' && userInfoStr != 'null' && userInfoStr != 'undefined') {
					try {
						const parsedUserInfo = JSON.parse(userInfoStr) as UTSJSONObject
						departmentId = parsedUserInfo.getString('deptId') ?? ''
						isAdmin = (parsedUserInfo.getNumber('isAdmin') ?? 0) === 1
					} catch (error) {
						console.error('用户信息JSON解析失败:', error)
					}
				}
				
				// 构建请求参数
				let params = `current=${this.pageNum}&size=${this.pageSize}`
				
				// 添加状态过滤
				if (this.status !== null) {
					params += `&status=${this.status}`
				}
				
				// 添加部门过滤 - 管理员用户不需要部门过滤
				if (!isAdmin && departmentId != null && departmentId != '') {
					params += `&departmentId=${departmentId}`
				}
				
				uni.request({
					url: getApiUrl(`/monthly-inspection-record/page?${params}`),
					method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
						this.loading = false
						this.isRefreshing = false
						
						const response = res.data as UTSJSONObject
						if (res.statusCode == 200 && (response.getNumber('code') ?? 0) == 200) {
							const data = response.getJSON('data') as UTSJSONObject
							const records = data.getArray('records') as UTSJSONObject[]
							
							// 处理记录数据
							const newRecords = records.map((record) => {
								return {
									id: record.getNumber('id') ?? 0,
									problemDescription: record.getString('problemDescription') ?? '',
									responsiblePerson: record.getString('responsiblePerson') ?? '',
									inspectorName: record.getString('inspectorName') ?? '',
									createDate: this.formatDate(record.getString('createTime') ?? ''),
									status: record.getNumber('status') ?? 0,
									departmentName: record.getString('departmentName') ?? ''
								} as MonthlyRecord
							})
							
							if (this.pageNum === 1) {
								this.recordList = newRecords
							} else {
								this.recordList = this.recordList.concat(newRecords)
							}
							
							this.totalCount = data.getNumber('total') ?? 0
							this.hasMore = this.recordList.length < this.totalCount
						} else {
							uni.showToast({
								title: '加载失败',
								icon: 'none'
							})
						}
					},
					fail: (error) => {
						this.loading = false
						this.isRefreshing = false
						console.log('加载月检记录失败:', error)
						uni.showToast({
							title: '网络错误',
							icon: 'none'
						})
					}
				})
			},
			
			loadMore() {
				if (this.hasMore && !this.loading) {
					this.pageNum++
					this.loadRecords()
				}
			},
			
			onRefresh() {
				this.isRefreshing = true
				this.pageNum = 1
				this.loadRecords()
			},
			
			onRefreshRestore() {
				this.isRefreshing = false
			},
			
			goToDetail(record: MonthlyRecord) {
				uni.navigateTo({
					url: `/pages/monthly/detail?id=${record.id}`
				})
			},
			
			getStatusTitle(): string {
				if (this.status === 0) return '待整改'
				if (this.status === 1) return '已整改'
				if (this.status === 2) return '已复查'
				return ''
			},
			
			getStatusText(status: number): string {
				switch (status) {
					case 0: return '待整改'
					case 1: return '已整改'
					case 2: return '已复查'
					default: return '未知'
				}
			},
			
			getStatusClass(status: number): string {
				switch (status) {
					case 0: return 'status-pending'
					case 1: return 'status-completed'
					case 2: return 'status-reviewed'
					default: return 'status-unknown'
				}
			},
			
			formatDate(dateStr: string): string {
				if (!dateStr) return ''
				try {
					const date = new Date(dateStr)
					const year = date.getFullYear()
					const month = String(date.getMonth() + 1).padStart(2, '0')
					const day = String(date.getDate()).padStart(2, '0')
					return `${year}-${month}-${day}`
				} catch (error) {
					return dateStr
				}
			}
		}
	}
</script>

<style scoped>
