<template>
  <scroll-view class="container" scroll-y="true" :style="{height: containerHeight + 'px'}">
    <view v-if="loading" class="loading">
      <text>加载中...</text>
    </view>
    <view v-else-if="detail != null" class="content">
      <view class="header">
        <text class="title">月检记录详情</text>
        <view class="status" :class="getStatusClass(detail.recordStatus)">
          <text>{{ getStatusText(detail.recordStatus) }}</text>
        </view>
      </view>

      <!-- 问题图片 -->
      <view class="photos" v-if="problemImages.length > 0">
        <text class="label">问题图片（{{problemImages.length}}张）</text>
        <view class="image-list">
          <image v-for="(img, idx) in problemImages" :key="idx" :src="img" class="photo" mode="aspectFill" @click="preview(img, problemImages)"></image>
        </view>
      </view>

      <!-- 整改信息（已整改或已复查状态才显示） -->
      <view v-if="detail.recordStatus >= 1">
        <view class="item">
          <text class="label">整改人</text>
          <text class="value">{{ displayValue(detail.rectifierName) }}</text>
        </view>
        <view class="item">
          <text class="label">整改建议</text>
          <text class="value">{{ displayValue(detail.rectificationSuggestion) }}</text>
        </view>
        <view class="item">
          <text class="label">整改效果</text>
          <text class="value">{{ displayValue(detail.rectificationEffect) }}</text>
        </view>
        <view class="photos" v-if="rectificationImages.length > 0">
          <text class="label">整改图片（{{rectificationImages.length}}张）</text>
          <view class="image-list">
            <image v-for="(img, idx) in rectificationImages" :key="idx" :src="img" class="photo" mode="aspectFill" @click="preview(img, rectificationImages)"></image>
          </view>
        </view>
      </view>

      <!-- 复查信息（已复查状态才显示） -->
      <view v-if="detail.recordStatus >= 2">
        <view class="item">
          <text class="label">复查人</text>
          <text class="value">{{ displayValue(detail.reviewerName) }}</text>
        </view>
        <view class="item">
          <text class="label">复查建议</text>
          <text class="value">{{ displayValue(detail.reviewSuggestion) }}</text>
        </view>
        <view class="item">
          <text class="label">复查效果</text>
          <text class="value">{{ displayValue(detail.reviewEffect) }}</text>
        </view>
        <view class="photos" v-if="reviewImages.length > 0">
          <text class="label">复查图片（{{reviewImages.length}}张）</text>
          <view class="image-list">
            <image v-for="(img, idx) in reviewImages" :key="idx" :src="img" class="photo" mode="aspectFill" @click="preview(img, reviewImages)"></image>
          </view>
        </view>
      </view>

      <!-- 基本信息（与月检 AddDialog 字段统一） -->
      <view class="item">
        <text class="label">问题描述</text>
        <text class="value">{{ detail.problemDescription }}</text>
      </view>

      <view class="item">
        <text class="label">专业类别</text>
        <text class="value">{{ detail.professionalTypeName }}</text>
      </view>

      <view class="item">
        <text class="label">基本模块</text>
        <text class="value">{{ detail.moduleName }}</text>
      </view>

      <view class="item">
        <text class="label">责任要素</text>
        <text class="value">{{ detail.responsibilityName }}</text>
      </view>

      <view class="item">
        <text class="label">检查内容</text>
        <text class="value">{{ detail.issueName }}</text>
      </view>

      <view class="item">
        <text class="label">性质界定</text>
        <text class="value">{{ detail.qualityName }}</text>
      </view>

      <view class="item">
        <text class="label">扣分值</text>
        <text class="value">{{ getDeductionScore(detail.qualityName) }}</text>
      </view>

      <view class="item">
        <text class="label">发现位置</text>
        <text class="value">{{ detail.location }}</text>
      </view>

      <view class="item">
        <text class="label">受检单位</text>
        <text class="value">{{ displayValue(detail.departmentName) }}</text>
      </view>

      <view class="item">
        <text class="label">检查人</text>
        <text class="value">{{ detail.inspector }}</text>
      </view>

      <view class="item">
        <text class="label">责任人</text>
        <text class="value">{{ detail.responsiblePerson }}</text>
      </view>

      <view class="item">
        <text class="label">责任单位</text>
        <text class="value">{{ detail.responsibleUnit }}</text>
      </view>

      <view class="item">
        <text class="label">整改期限</text>
        <text class="value">{{ detail.rectificationDeadline }}</text>
      </view>


    </view>
    <view v-else class="empty"><text>记录不存在</text></view>
  </scroll-view>
</template>

<script lang="uts">
  import { getApiUrl, apiConfig } from '@/config/api.uts'

  type MonthlyDetail = {
    id: string
    recordStatus: number
    problemDescription: string
    professionalTypeName: string
    moduleName: string
    responsibilityName: string
    issueName: string
    qualityName: string
    location: string
    departmentName: string
    inspector: string
    responsibleUnit: string
    responsiblePerson: string
    rectificationSuggestion: string
    rectificationEffect: string
    rectifierName: string
    reviewSuggestion: string
    reviewEffect: string
    reviewerName: string
    photos: string
    rectificationImages: string
    reviewImages: string
    rectificationDeadline: string
  }

  export default {
    data() {
      return {
        id: '',
        detail: null as MonthlyDetail | null,
        loading: true,
        containerHeight: 0,
        problemImages: [] as string[],
        rectificationImages: [] as string[],
        reviewImages: [] as string[]
      }
    },
    onLoad(options: UTSJSONObject) {
      this.id = options.getString('id') ?? ''
      this.initContainer()
      this.loadDetail()
    },
    methods: {
      initContainer() {
        uni.getSystemInfo({
          success: (res) => { this.containerHeight = res.windowHeight }
        })
      },
      loadDetail() {
        const token = uni.getStorageSync('token')
        uni.request({
          url: getApiUrl(`/monthly-inspection-record/${this.id}`),
          method: 'GET',
          header: { 'Authorization': `Bearer ${token}` },
          success: (res) => {
            const data = res.data as UTSJSONObject
            if (res.statusCode === 200 && (data.getNumber('code') ?? 0) === 200) {
              const d = data.getJSON('data')
              if (d != null) {
                this.detail = {
                  id: d.getString('id') ?? '',
                  recordStatus: d.getNumber('recordStatus') ?? 0,
                  problemDescription: d.getString('problemDescription') ?? '',
                  professionalTypeName: d.getString('professionalTypeName') ?? '',
                  moduleName: d.getString('moduleName') ?? '',
                  responsibilityName: d.getString('responsibilityName') ?? '',
                  issueName: d.getString('issueName') ?? '',
                  qualityName: d.getString('qualityName') ?? '',
                  location: d.getString('location') ?? '',
                  departmentName: d.getString('departmentName') ?? '',
                  inspector: d.getString('inspector') ?? '',
                  responsibleUnit: d.getString('responsibleUnit') ?? '',
                  responsiblePerson: d.getString('responsiblePerson') ?? '',
                  rectificationSuggestion: d.getString('rectificationSuggestion') ?? '',
                  rectificationEffect: d.getString('rectificationEffect') ?? '',
                  rectifierName: d.getString('rectifierName') ?? '',
                  reviewSuggestion: d.getString('reviewSuggestion') ?? '',
                  reviewEffect: d.getString('reviewEffect') ?? '',
                  reviewerName: d.getString('reviewerName') ?? '',
                  photos: d.getString('photos') ?? '',
                  rectificationImages: d.getString('rectificationImages') ?? '',
                  reviewImages: d.getString('reviewImages') ?? '',
                  rectificationDeadline: d.getString('rectificationDeadline') ?? ''
                }
                this.problemImages = this.parseImages(this.detail.photos)
                this.rectificationImages = this.parseImages(this.detail.rectificationImages)
                this.reviewImages = this.parseImages(this.detail.reviewImages)
              }
            }
            this.loading = false
          },
          fail: (_) => { this.loading = false }
        })
      },
      parseImages(s: string): string[] {
        if (s == null || s.trim() === '') return []
        try {
          if (s.trim().startsWith('[') && s.trim().endsWith(']')) {
            const arr = JSON.parse(s) as string[]
            return arr.map(u => this.toUrl(u)).filter(u => u !== '')
          }
        } catch (_) {}
        return s.split(',').map(u => u.trim()).filter(u => u !== '').map(u => this.toUrl(u))
      },
      toUrl(p: string): string {
        if (p == null || p.trim() === '') return ''
        if (p.startsWith('http://') || p.startsWith('https://')) return p
        return `${apiConfig.baseUrl}/api${p}`
      },
      getDeductionScore(qualityName: string): string {
        if (qualityName === '观察') return '1'
        if (qualityName === '一般') return '3'
        if (qualityName === '重要') return '5'
        return '-'
      },
      displayValue(v: string): string {
        return v !== '' && v != null ? v : '暂无'
      },
      preview(current: string, urls: string[]) {
        uni.previewImage({ current, urls })
      },
      getStatusText(s: number): string {
        if (s === 0) return '待整改'
        if (s === 1) return '已整改'
        if (s === 2) return '已复查'
        return '未知'
      },
      getStatusClass(s: number): string {
        if (s === 0) return 'status-pending'
        if (s === 1) return 'status-completed'
        if (s === 2) return 'status-reviewed'
        return 'status-unknown'
      }
    }
  }
</script>

<style>
.container { background: #f1f5f9; }
.loading { padding: 40rpx; text-align: center; color: #475569; font-size: 28rpx; }
.content { padding: 32rpx; }
.header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; padding: 32rpx; background: #ffffff; border-radius: 20rpx; box-shadow: 0 8rpx 24rpx rgba(30, 64, 175, 0.08); border-top: 4rpx solid #1e40af; }
.title { font-size: 36rpx; font-weight: 600; color: #1e40af; }
.status { padding: 8rpx 20rpx; border-radius: 12rpx; font-size: 26rpx; font-weight: 500; }
.status-pending { background: #f59e0b; color: #ffffff; }
.status-completed { background: #16a34a; color: #ffffff; }
.status-reviewed { background: #2563eb; color: #ffffff; }
.status-unknown { background: #94a3b8; color: #ffffff; }
.item { background: #ffffff; margin-bottom: 16rpx; padding: 24rpx; border-radius: 16rpx; box-shadow: 0 8rpx 24rpx rgba(30, 64, 175, 0.08); border-left: 6rpx solid #2563eb; }
.label { font-size: 28rpx; color: #1e293b; margin-bottom: 12rpx; font-weight: 600; }
.value { font-size: 28rpx; color: #0a2540; font-weight: 600; }
.photos { background: #ffffff; margin-bottom: 16rpx; padding: 24rpx; border-radius: 16rpx; box-shadow: 0 8rpx 24rpx rgba(30, 64, 175, 0.08); }
.image-list { display: flex; flex-wrap: wrap; }
.image-list .photo { margin: 8rpx; }
.photo { width: 200rpx; height: 200rpx; border-radius: 12rpx; border: 2rpx solid #dbeafe; }
.empty { padding: 40rpx; text-align: center; color: #475569; font-size: 28rpx; }
</style>