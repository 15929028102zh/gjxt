<template>
  <view class="container">
    <!-- 导航栏 -->
    <view class="nav-bar">
      <view class="nav-left" @click="goBack">
        <text class="nav-icon">‹</text>
      </view>
      <text class="nav-title">确认复查</text>
      <view class="nav-right"></view>
    </view>
    
    <!-- 内容区域 -->
    <scroll-view 
      class="content" 
      scroll-y="true" 
      :style="{ height: containerHeight + 'px' }"
      @scrolltolower="onScrollToLower"
    >
      <!-- 问题信息 -->
      <view class="section">
        <view class="section-title">问题信息</view>
        <view class="info-card problem-info">
          <view class="info-item">
            <text class="label">问题描述：</text>
            <text class="value">{{ recordDetail['problemDescription'] ?? '暂无' }}</text>
          </view>
          <view class="info-item">
            <text class="label">责任人：</text>
            <text class="value">{{ recordDetail['responsiblePerson'] ?? '暂无' }}</text>
          </view>
          <view class="info-item">
            <text class="label">责任单位：</text>
            <text class="value">{{ recordDetail['responsibleUnit'] ?? '暂无' }}</text>
          </view>
          <view class="info-item">
            <text class="label">发现位置：</text>
            <text class="value">{{ recordDetail['location'] ?? '暂无' }}</text>
          </view>
          <view class="info-item">
            <text class="label">检查人：</text>
            <text class="value">{{ recordDetail['inspector'] ?? '暂无' }}</text>
          </view>
          <view class="info-item">
            <text class="label">整改时间：</text>
              <text class="value">{{ formatDateTime(recordDetail['rectificationTime']) }}</text>
          </view>
        </view>
        
        <!-- 问题图片 -->
        <view v-if="problemImages.length > 0" class="image-section">
          <view class="image-title">问题照片</view>
          <view class="image-grid">
            <image 
              v-for="(image, index) in problemImages" 
              :key="index"
              :src="image" 
              class="problem-image"
              mode="aspectFill"
              @click="previewImage(image, problemImages)"
              @error="onImageError"
              @load="onImageLoad"
            />
          </view>
        </view>
      </view>

      <!-- 整改情况 -->
      <view class="section">
        <view class="section-title">整改情况</view>
        <view class="info-card rectification-info">
          <view class="info-item">
            <text class="label">性质界定：</text>
            <text class="value">{{ recordDetail['natureDefinition'] ?? '暂无' }}</text>
          </view>
          <view class="info-item">
            <text class="label">专业：</text>
            <text class="value">{{ recordDetail['professionName'] ?? '暂无' }}</text>
          </view>
          <view class="info-item">
            <text class="label">所属部门：</text>
            <text class="value">{{ recordDetail['departmentName'] ?? '暂无' }}</text>
          </view>
          <view class="info-item">
            <text class="label">整改建议：</text>
            <text class="value">{{ recordDetail['rectificationSuggestion'] ?? '暂无' }}</text>
          </view>
          <view class="info-item">
            <text class="label">整改效果：</text>
            <text class="value">{{ recordDetail['rectificationEffect'] ?? '暂无' }}</text>
          </view>
        </view>
        
        <!-- 整改图片 -->
        <view v-if="rectificationImages.length > 0" class="image-section">
          <view class="image-title">整改图片</view>
          <view class="image-grid">
            <image 
              v-for="(image, index) in rectificationImages" 
              :key="index"
              :src="image" 
              class="problem-image"
              mode="aspectFill"
              @click="previewImage(image, rectificationImages)"
              @error="onImageError"
              @load="onImageLoad"
            />
          </view>
        </view>
      </view>

      <!-- 复查信息表单 -->
      <view class="section">
        <view class="section-title">复查信息</view>
        <view class="form-card">
          <!-- 复查建议 -->
          <view class="form-item">
            <view class="form-label">
              <text class="required">*</text>
              <text>复查建议</text>
            </view>
            <textarea 
                v-model="reviewForm['reviewSuggestion']"
              class="form-textarea"
              placeholder="请输入复查建议..."
              maxlength="500"
              :show-count="true"
              auto-height
            />
          </view>

          <!-- 复查效果描述 -->
          <view class="form-item">
            <view class="form-label">
              <text class="required">*</text>
              <text>复查效果描述</text>
            </view>
            <textarea 
                v-model="reviewForm['reviewEffect']"
              class="form-textarea"
              placeholder="请描述复查效果..."
              maxlength="500"
              :show-count="true"
              auto-height
            />
          </view>

          <!-- 复查图片上传 -->
          <view class="form-item">
            <view class="form-label">复查图片</view>
            <view class="upload-container">
              <view class="uploaded-images" v-if="reviewImages.length > 0">
                <view 
                  v-for="(image, index) in reviewImages" 
                  :key="index"
                  class="uploaded-image-item"
                >
                <image 
                  :src="image.url" 
                  class="uploaded-image"
                  mode="aspectFill"
                  @click="previewImage(image.url, reviewImages.map((img: ReviewImageType) => img.url))"
                  />
                  <view class="delete-btn" @click="removeImage(index)">
                    <text class="delete-icon">×</text>
                  </view>
                </view>
              </view>
              
              <view 
                v-if="reviewImages.length < 3"
                class="upload-btn" 
                @click="chooseImage"
              >
                <text class="upload-icon">+</text>
                <text class="upload-text">添加图片</text>
              </view>
            </view>
            <view class="upload-tip">
              支持jpg、png、gif格式，单个文件不超过2MB，最多上传3张图片
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 底部操作按钮 -->
    <view class="footer">
      <button class="btn btn-cancel" @click="goBack">取消</button>
      <button 
        class="btn btn-confirm" 
        :disabled="!canSubmit || submitting"
        @click="handleConfirm"
      >
        {{ submitting ? '提交中...' : '确认复查' }}
      </button>
    </view>

    <!-- 加载状态 -->
    <view v-if="loading" class="loading-container">
      <text class="loading-text">加载中...</text>
    </view>
  </view>
</template>

<script>
type ReviewImageType = {
  url: string
  file: string
}

type ReviewFormType = {
  reviewSuggestion: string
  reviewEffect: string
}

export default {
  data() {
    return {
      recordId: '',
      loading: false,
      submitting: false,
      containerHeight: 0,
      recordDetail: {},
      problemImages: [],
      rectificationImages: [],
      reviewForm: {
        reviewSuggestion: '',
        reviewEffect: ''
      } as ReviewFormType,
      reviewImages: [] as ReviewImageType[],
      problemImages: [] as string[],
      rectificationImages: [] as string[]
    }
  },
  
  computed: {
    canSubmit() {
      return this.reviewForm.reviewSuggestion.trim().length > 0 && 
             this.reviewForm.reviewEffect.trim().length > 0
    }
  },
  
      onLoad(options: UTSJSONObject) {
      const id = options['id'] as string | null
      this.recordId = id != null ? id : ''
      this.initPage()
    },
  
  onReady() {
    this.calculateContainerHeight()
  },
  
  methods: {
    initPage() {
        if (this.recordId != null && this.recordId != '') {
        this.loadRecordDetail()
      }
    },
    
    calculateContainerHeight() {
      const systemInfo = uni.getSystemInfoSync()
      const navHeight = 44 // 导航栏高度
      const footerHeight = 80 // 底部按钮高度
      this.containerHeight = systemInfo.windowHeight - navHeight - footerHeight
    },
    
    async loadRecordDetail() {
      this.loading = true
      try {
        const response = await uni.request({
          url: `${this.$baseUrl}/monthly-inspection-record/${this.recordId}`,
          method: 'GET',
          header: {
            'Authorization': `Bearer ${uni.getStorageSync('token')}`
          }
        })
        
        if (response.data.code === 200) {
          this.recordDetail = response.data.data
          this.parseProblemImages()
          this.parseRectificationImages()
          this.initReviewForm()
        } else {
          uni.showToast({
            title: response.data.message || '获取详情失败',
            icon: 'none'
          })
        }
      } catch (error) {
        console.error('获取月检记录详情失败:', error)
        uni.showToast({
          title: '网络错误，请重试',
          icon: 'none'
        })
      } finally {
        this.loading = false
      }
    },
    
    parseProblemImages() {
      if (this.recordDetail.problemImages) {
        try {
          this.problemImages = JSON.parse(this.recordDetail.problemImages)
        } catch (error) {
          console.error('解析问题图片失败:', error)
          this.problemImages = []
        }
      }
    },
    
    parseRectificationImages() {
      if (this.recordDetail.rectificationImages) {
        try {
          this.rectificationImages = JSON.parse(this.recordDetail.rectificationImages)
        } catch (error) {
          console.error('解析整改图片失败:', error)
          this.rectificationImages = []
        }
      }
    },
    
    initReviewForm() {
      // 如果已有复查信息，回填表单
      if (this.recordDetail.reviewSuggestion) {
        this.reviewForm.reviewSuggestion = this.recordDetail.reviewSuggestion
      }
      if (this.recordDetail.reviewEffect) {
        this.reviewForm.reviewEffect = this.recordDetail.reviewEffect
      }
      
      // 解析复查图片
      if (this.recordDetail.reviewImages) {
        try {
          const images = JSON.parse(this.recordDetail.reviewImages)
          this.reviewImages = images.map(url => ({ url, file: url }))
        } catch (error) {
          console.error('解析复查图片失败:', error)
          this.reviewImages = []
        }
      }
    },
    
    chooseImage() {
      uni.chooseImage({
        count: 3 - this.reviewImages.length,
        sizeType: ['compressed'],
        sourceType: ['album', 'camera'],
        success: (res) => {
          res.tempFilePaths.forEach(tempFilePath => {
            // 检查文件大小
            const fileManager = uni.getFileSystemManager()
            fileManager.getFileInfo({
              filePath: tempFilePath,
              success: (res: UTSJSONObject) => {
                  const fileInfo = res as UTSJSONObject
                  const size = fileInfo['size'] as number
                  if (size > 2 * 1024 * 1024) {
                  uni.showToast({
                    title: '图片大小不能超过2MB',
                    icon: 'none'
                  })
                  return
                }
                
                this.reviewImages.push({
                  url: tempFilePath,
                  file: tempFilePath
                })
              }
            })
          })
        }
      })
    },
    
    removeImage(index) {
      this.reviewImages.splice(index, 1)
    },
    
    async handleConfirm() {
      if (!this.canSubmit) {
        uni.showToast({
          title: '请填写完整的复查信息',
          icon: 'none'
        })
        return
      }
      
      try {
        await uni.showModal({
          title: '确认复查',
          content: '确认提交复查信息吗？提交后将更新记录状态为"已复查"。',
          confirmText: '确认',
          cancelText: '取消'
        })
        
        this.submitting = true
        
        // 上传图片
        const uploadedImages = []
        for (const image of this.reviewImages) {
          try {
            const uploadResult = await this.uploadImage(image.file)
            uploadedImages.push(uploadResult)
          } catch (error) {
            console.error('图片上传失败:', error)
          }
        }
        
        // 提交复查信息
        const response = await uni.request({
          url: `${this.$baseUrl}/monthly-inspection-record/confirm-review/${this.recordId}`,
          method: 'POST',
          header: {
            'Authorization': `Bearer ${uni.getStorageSync('token')}`,
            'Content-Type': 'application/json'
          },
          data: {
            reviewSuggestion: this.reviewForm.reviewSuggestion,
            reviewEffect: this.reviewForm.reviewEffect,
            reviewImages: JSON.stringify(uploadedImages),
            status: 2 // 已复查
          }
        })
        
        if (response.data.code === 200) {
          uni.showToast({
            title: '复查确认成功',
            icon: 'success'
          })
          
          setTimeout(() => {
            this.goBack()
          }, 1500)
        } else {
          uni.showToast({
            title: response.data.message || '复查确认失败',
            icon: 'none'
          })
        }
      } catch (error) {
        if (error.errMsg !== 'showModal:fail cancel') {
          console.error('复查确认失败:', error)
          uni.showToast({
            title: '网络错误，请重试',
            icon: 'none'
          })
        }
      } finally {
        this.submitting = false
      }
    },
    
    uploadImage(filePath) {
      return new Promise((resolve, reject) => {
        uni.uploadFile({
          url: `/file/upload`,
          filePath: filePath,
          name: 'file',
          header: {
            'Authorization': `Bearer ${uni.getStorageSync('token')}`
          },
          success: (res) => {
            try {
              const data = JSON.parse(res.data)
              if (data.code === 200) {
                resolve(data.data)
              } else {
                reject(new Error(data.message || '上传失败'))
              }
            } catch (error) {
              reject(error)
            }
          },
          fail: (error) => {
            reject(error)
          }
        })
      })
    },
    
    formatDateTime(dateTime) {
      if (!dateTime) return '暂无'
      const date = new Date(dateTime)
      return date.toLocaleString('zh-CN')
    },
    
    previewImage(current, urls) {
      uni.previewImage({
        current: current,
        urls: urls || [current]
      })
    },
    
    onImageError(e) {
      console.error('图片加载失败:', e)
    },
    
    onImageLoad(e) {
      console.log('图片加载成功:', e)
    },
    
    onScrollToLower() {
      // 滚动到底部处理
    },
    
    goBack() {
      uni.navigateBack()
    }
  }
}
</script>

