<template>
  <view class="container">
    <!-- 导航栏 -->
    <view class="nav-bar">
      <view class="nav-left" @click="goBack">
        <text class="nav-icon">‹</text>
      </view>
      <view class="nav-title">
        <text>确认整改</text>
      </view>
      <view class="nav-right"></view>
    </view>
    
    <!-- 内容区域 -->
    <scroll-view 
      class="content" 
      scroll-y="true" 
      :style="{ height: containerHeight + 'px' }"
      @scrolltolower="onScrollToLower"
    >
      <!-- 基本信息 -->
      <view class="section">
        <view class="section-title">基本信息</view>
        <view class="info-card">
          <view class="info-item">
            <text class="label">任务编号：</text>
            <text class="value">{{ recordDetail['taskNo'] != null ? recordDetail['taskNo'] as string : '暂无' }}</text>
          </view>
          <view class="info-item">
            <text class="label">月检时间：</text>
            <text class="value">{{ formatDateTime(recordDetail['inspectionTime'] != null ? recordDetail['inspectionTime'] as string : '') }}</text>
          </view>
          <view class="info-item">
            <text class="label">检查部门：</text>
            <text class="value">{{ recordDetail['departmentName'] != null ? recordDetail['departmentName'] as string : '暂无' }}</text>
          </view>
          <view class="info-item">
            <text class="label">检查人：</text>
            <text class="value">{{ recordDetail['inspector'] != null ? recordDetail['inspector'] as string : '暂无' }}</text>
          </view>
          <view class="info-item">
            <text class="label">问题描述：</text>
            <text class="value">{{ recordDetail['problemDescription'] != null ? recordDetail['problemDescription'] as string : '暂无' }}</text>
          </view>
          <view class="info-item">
            <text class="label">发现位置：</text>
            <text class="value">{{ recordDetail['location'] != null ? recordDetail['location'] as string : '暂无' }}</text>
          </view>
          <view class="info-item">
            <text class="label">整改期限：</text>
              <text class="value">{{ formatDateTime(recordDetail['rectificationDeadline'] != null ? recordDetail['rectificationDeadline'] as string : '') }}</text>
          </view>
          <view class="info-item">
            <text class="label">状态：</text>
              <text :class="['status-tag', getStatusClass(recordDetail['recordStatus'] as number)]">
                {{ getStatusText(recordDetail['recordStatus'] as number) }}
            </text>
          </view>
        </view>
      </view>

      <!-- 问题图片 -->
      <view class="section" v-if="problemImages.length > 0">
        <view class="section-title">问题图片</view>
        <view class="image-grid">
          <image 
            v-for="(image, index) in problemImages" 
            :key="index"
            :src="image" 
            class="problem-image"
            mode="aspectFill"
            @click="previewImage(image as string, problemImages as string[])"
            @error="onImageError"
            @load="onImageLoad"
          />
        </view>
      </view>

      <!-- 整改信息表单 -->
      <view class="section">
        <view class="section-title">整改信息</view>
        <view class="form-card">
          <!-- 整改建议 -->
          <view class="form-item">
            <view class="form-label">
              <text class="required">*</text>
              <text>整改建议</text>
            </view>
            <textarea 
              v-model="rectificationForm.rectificationSuggestion"
              class="form-textarea"
              placeholder="请输入整改建议（至少10个字符）"
              maxlength="500"
              :show-count="true"
              auto-height
            />
          </view>

          <!-- 整改图片上传 -->
          <view class="form-item">
            <view class="form-label">整改图片</view>
            <view class="upload-container">
              <view class="uploaded-images" v-if="rectificationImages.length > 0">
                <view 
                  v-for="(image, index) in rectificationImages" 
                  :key="index"
                  class="uploaded-image-item"
                >
                    <image 
                      :src="image.url" 
                    class="uploaded-image"
                    mode="aspectFill"
                    @click="previewImage(image.url, rectificationImages.map(img => img.url))"
                  />
                  <view class="delete-btn" @click="removeImage(index)">
                    <text class="delete-icon">×</text>
                  </view>
                </view>
              </view>
              
              <view 
                v-if="rectificationImages.length < 3"
                class="upload-btn" 
                @click="chooseImage"
              >
                <text class="upload-icon">+</text>
                <text class="upload-text">添加图片</text>
              </view>
            </view>
            <view class="upload-tip">
              支持jpg、png、gif格式，单个文件不超过2MB，最多上传3张图片
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 底部操作按钮 -->
    <view class="footer">
      <button class="btn btn-cancel" @click="goBack">取消</button>
      <button 
        class="btn btn-confirm" 
        :disabled="!canSubmit || submitting"
        @click="handleConfirm"
      >
        {{ submitting ? '提交中...' : '确认整改' }}
      </button>
    </view>

    <!-- 加载状态 -->
    <view v-if="loading" class="loading-overlay">
      <view class="loading-content">
        <text>加载中...</text>
      </view>
    </view>
  </view>
</template>

<script>
type RectificationImage = {
  url: string,
  file: string
}

export default {
  data() {
    return {
      recordId: '',
      loading: false,
      submitting: false,
      containerHeight: 0,
      recordDetail: {} as UTSJSONObject,
      problemImages: [] as string[],
      rectificationForm: {
        'rectificationSuggestion': '',
        'rectificationImages': [] as string[]
      } as UTSJSONObject,
      rectificationImages: [] as RectificationImage[]
    }
  },
  
  computed: {
    canSubmit() {
      return (this.rectificationForm['rectificationSuggestion'] as string).trim().length >= 10
    }
  },
  
      onLoad(options: UTSJSONObject) {
        const id = options['id'] as string | null
        this.recordId = id != null ? id : ''
        this.initPage()
      },
  
  onReady() {
    this.calculateContainerHeight()
  },
  
  methods: {
    async getFileSize(filePath: string): Promise<number> {
      return new Promise<number>((resolve) => {

        const file = new java.io.File(filePath)
        resolve(file.length())






      })
    },
    initPage() {
      if (this.recordId != null && this.recordId != '') {
        this.loadRecordDetail()
      }
    },
    
    calculateContainerHeight() {
      const systemInfo = uni.getSystemInfoSync()
      const navHeight = 44 // 导航栏高度
      const footerHeight = 80 // 底部按钮高度
      this.containerHeight = systemInfo.windowHeight - navHeight - footerHeight
    },
    
    async loadRecordDetail() {
      this.loading = true
      try {
        const response = await uni.request({
          url: `/monthly-inspection-record/${this.recordId}`,
          method: 'GET',
          header: {
            'Authorization': `Bearer ${uni.getStorageSync('token')}`
          }
        }) as RequestTask
        
              const resData = (response as UTSJSONObject)['data'] as UTSJSONObject
        if (resData['code'] as number === 200) {
          this.recordDetail = resData['data'] as UTSJSONObject
          this.parseProblemImages()
        } else {
          const message = resData['message'] != null ? resData['message'] as string : '获取详情失败'
          uni.showToast({
            title: message,
            icon: 'none'
          })
        }
      } catch (error) {
        console.error('获取月检记录详情失败:', error)
        uni.showToast({
          title: '网络错误，请重试',
          icon: 'none'
        })
      } finally {
        this.loading = false
      }
    },
    
    parseProblemImages() {
      const problemImages = this.recordDetail.problemImages as string | null
      if (problemImages != null) {
        try {
          this.problemImages = JSON.parse(problemImages) as string[]
        } catch (error) {
          console.error('解析问题图片失败:', error)
          this.problemImages = []
        }
      }
    },
    
    chooseImage() {
      uni.chooseImage({
        count: 3 - this.rectificationImages.length,
        sizeType: ['compressed'],
        sourceType: ['album', 'camera'],
          success: (res) => {
              const tempFilePaths = res.tempFilePaths
              for (const tempFilePath of tempFilePaths) {
                // 检查文件大小

                const file = tempFilePath
                this.getFileSize(file).then((fileSize) => {
                  if (fileSize > 2 * 1024 * 1024) {




                    uni.showToast({
                      title: '图片大小不能超过2MB',
                      icon: 'none'
                    })
                  } else {
                    this.rectificationImages.push({
                      url: tempFilePath,
                      file: tempFilePath
                    })
                  }
                })
              }
            },
        })
      },
    
    removeImage(index: number) {
      this.rectificationImages.splice(index, 1)
    },
    
    async handleConfirm() {
      if (!this.canSubmit) {
        uni.showToast({
          title: '请输入至少10个字符的整改建议',
          icon: 'none'
        })
        return
      }
      
      try {
        await uni.showModal({
          title: '确认整改',
          content: '确认提交整改信息吗？提交后将更新记录状态为"已整改"。',
          confirmText: '确认',
          cancelText: '取消'
        })
        
        this.submitting = true
        
        // 上传图片
        const uploadedImages = [] as string[]
        for (const image of this.rectificationImages) {
          try {
            const uploadResult = await this.uploadImage(image.file as string)
            uploadedImages.push(uploadResult)
          } catch (error) {
            console.error('图片上传失败:', error)
          }
        }
        
        // 提交整改信息
        const response = await uni.request({
            url: `/monthly-inspection-record/confirm-rectification/${this.recordId}`,
          method: 'POST',
          header: {
            'Authorization': `Bearer ${uni.getStorageSync('token')}`,
            'Content-Type': 'application/json'
          },
          data: {
            rectificationSuggestion: this.rectificationForm.rectificationSuggestion,
            rectificationImages: JSON.stringify(uploadedImages),
            status: 1 // 已整改
          }
        })
        
              const resData = (response as UTSJSONObject)['data'] as UTSJSONObject
          if (resData['code'] as number === 200) {
          uni.showToast({
            title: '整改确认成功',
            icon: 'success'
          })
          
          setTimeout(() => {
            this.goBack()
          }, 1500)
        } else {
          uni.showToast({
              title: (resData['message'] != null ? resData['message'] as string : '整改确认失败'),
            icon: 'none'
          })
        }
      } catch (error) {
          if ((error as UTSJSONObject)['errMsg'] !== 'showModal:fail cancel') {
          console.error('整改确认失败:', error)
          uni.showToast({
            title: '网络错误，请重试',
            icon: 'none'
          })
        }
      } finally {
        this.submitting = false
      }
    },
    
    uploadImage(filePath: string): Promise<string> {
      return new Promise((resolve, reject) => {
        uni.uploadFile({
            url: `/file/upload`,
          filePath: filePath,
          name: 'file',
          header: {
            'Authorization': `Bearer ${uni.getStorageSync('token')}`
          },
          success: (res) => {
            try {
              const data = JSON.parse(res.data)
                if ((data as UTSJSONObject)['code'] as number === 200) {
                  resolve((data as UTSJSONObject)['data'] as string)
              } else {
                    reject(new Error((data as UTSJSONObject)['message'] as string ?? '上传失败'))
              }
            } catch (error) {
              reject(error)
            }
          },
          fail: (error) => {
            reject(error)
          }
        })
      })
    },
    
    getStatusText(status: number): string {
      const statusMap = new Map<number, string>([
        [0, '待整改'],
        [1, '已整改'],
        [2, '已复查']
      ])
      return statusMap.get(status) ?? '未知'
    },
    
    getStatusClass(status: number): string {
      const classMap = new Map<number, string>([
        [0, 'status-pending'],
        [1, 'status-rectified'],
        [2, 'status-reviewed']
      ])
      return classMap.get(status) ?? ''
    },
    
    formatDateTime(dateTime: string): string {
      if (dateTime == '') return '暂无'
      const date = new Date(dateTime)
        return date.toLocaleString()
    },
    
    previewImage(current: string, urls: string[]) {
      uni.previewImage({
        current: current,
          urls: urls != null ? urls : [current]
      })
    },
    
    onImageError(e: any) {
      console.error('图片加载失败:', e)
    },
    
    onImageLoad(e: any) {
      console.log('图片加载成功:', e)
    },
    
    onScrollToLower() {
      // 滚动到底部处理
    },
    
    goBack() {
      uni.navigateBack()
    }
  }
}
</script>

