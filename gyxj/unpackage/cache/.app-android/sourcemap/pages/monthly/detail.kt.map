<template>
	<scroll-view class="container" scroll-y="true" :scroll-top="scrollTop" :style="{height: containerHeight + 'px'}" enable-back-to-top="true">
		<view v-if="loading" class="loading-state">
			<text class="loading-text">加载中...</text>
		</view>
		
		<view v-else-if="recordDetail" class="detail-content">
			<!-- 状态标题 -->
			<view class="status-header">
				<text class="page-title">月检记录详情</text>
				<view class="record-status" :class="getStatusClass(recordDetail?.status ?? 0)">
					<text>{{getStatusText(recordDetail?.status ?? 0)}}</text>
				</view>
			</view>
			
			<!-- 问题照片 -->
			<view class="form-item" v-if="imageList.length > 0">
				<text class="form-label">📷 问题照片 ({{imageList.length}}张)</text>
				<view class="image-upload">
					<view class="image-list">
						<view class="image-item" v-for="(image, index) in imageList" :key="index">
							<image 
								:src="image" 
								mode="aspectFill" 
								class="uploaded-image" 
								@click="previewImage(index)"
								@error="onImageError"
								@load="onImageLoad"
							></image>
						</view>
					</view>
				</view>
			</view>
			
			<!-- 问题描述 -->
			<view class="form-item">
				<text class="form-label">问题描述</text>
				<view class="form-input-wrapper">
					<view class="form-display-text">{{recordDetail?.problemDescription ?? ''}}</view>
				</view>
			</view>
			
			<!-- 责任单位 -->
			<view class="form-item">
				<text class="form-label">责任单位</text>
				<view class="form-input-wrapper">
					<view class="form-display-text">{{recordDetail?.responsibleUnit ?? ''}}</view>
				</view>
			</view>
			
			<!-- 责任人 -->
			<view class="form-item">
				<text class="form-label">责任人</text>
				<view class="form-input-wrapper">
					<view class="form-display-text">{{recordDetail?.responsiblePerson ?? ''}}</view>
				</view>
			</view>
			
			<!-- 检查人 -->
			<view class="form-item">
				<text class="form-label">检查人</text>
				<view class="form-input-wrapper">
					<view class="form-display-text">{{recordDetail?.inspectorName ?? ''}}</view>
				</view>
			</view>
			
			<!-- 所属部门 -->
			<view class="form-item">
				<text class="form-label">所属部门</text>
				<view class="form-input-wrapper">
					<view class="form-display-text">{{recordDetail?.departmentName ?? ''}}</view>
				</view>
			</view>
			
			<!-- 创建时间 -->
			<view class="form-item">
				<text class="form-label">创建时间</text>
				<view class="form-input-wrapper">
					<view class="form-display-text">{{formatDateTime(recordDetail?.createTime ?? '')}}</view>
				</view>
			</view>
			
			<!-- 整改时间 -->
			<view class="form-item" v-if="recordDetail?.rectificationTime">
				<text class="form-label">整改时间</text>
				<view class="form-input-wrapper">
					<view class="form-display-text">{{formatDateTime(recordDetail?.rectificationTime ?? '')}}</view>
				</view>
			</view>
			
			<!-- 复查时间 -->
			<view class="form-item" v-if="recordDetail?.reviewTime">
				<text class="form-label">复查时间</text>
				<view class="form-input-wrapper">
					<view class="form-display-text">{{formatDateTime(recordDetail?.reviewTime ?? '')}}</view>
				</view>
			</view>
			
			<!-- 操作按钮 -->
			<view class="action-buttons" v-if="showActionButtons()">
				<button 
					v-if="recordDetail?.status === 0" 
					class="action-btn confirm-btn" 
					@click="goToConfirmRectification"
				>
					确认整改
				</button>
				<button 
					v-if="recordDetail?.status === 1" 
					class="action-btn review-btn" 
					@click="goToConfirmReview"
				>
					确认复查
				</button>
			</view>
		</view>
		
		<view v-else class="error-state">
			<text class="error-text">记录不存在或已被删除</text>
		</view>
	</scroll-view>
</template>

<script>
	import { getApiUrl } from '@/config/api.uts'
	
	interface MonthlyRecordDetail {
		id: number
		problemDescription: string
		responsibleUnit: string
		responsiblePerson: string
		inspectorName: string
		departmentName: string
		status: number
		createTime: string
		rectificationTime: string
		reviewTime: string
		images: string[]
	}
	
	export default {
		data() {
			return {
				recordDetail: null as MonthlyRecordDetail | null,
				loading: true,
				recordId: 0,
				imageList: [] as string[],
				scrollTop: 0,
				containerHeight: 0
			}
		},
		onLoad(options: any) {
			if (options.id) {
				this.recordId = parseInt(options.id)
			}
			
			// 设置容器高度
			const systemInfo = uni.getSystemInfoSync()
			this.containerHeight = systemInfo.windowHeight
			
			this.loadRecordDetail()
		},
		methods: {
			loadRecordDetail() {
				const token = uni.getStorageSync('token')
				
				uni.request({
					url: getApiUrl(`/monthly-inspection-record/${this.recordId}`),
					method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
						this.loading = false
						const response = res.data as UTSJSONObject
						if (res.statusCode == 200 && (response.getNumber('code') ?? 0) == 200) {
							const data = response.getJSON('data') as UTSJSONObject
							this.recordDetail = {
								id: data.getNumber('id') ?? 0,
								problemDescription: data.getString('problemDescription') ?? '',
								responsibleUnit: data.getString('responsibleUnit') ?? '',
								responsiblePerson: data.getString('responsiblePerson') ?? '',
								inspectorName: data.getString('inspectorName') ?? '',
								departmentName: data.getString('departmentName') ?? '',
								status: data.getNumber('status') ?? 0,
								createTime: data.getString('createTime') ?? '',
								rectificationTime: data.getString('rectificationTime') ?? '',
								reviewTime: data.getString('reviewTime') ?? '',
								images: []
							}
							
							// 处理图片
							const images = data.getArray('images') as string[]
							if (images && images.length > 0) {
								this.imageList = images.map(img => getApiUrl(`/uploads/images/${img}`))
							}
						} else {
							uni.showToast({
								title: '加载失败',
								icon: 'none'
							})
						}
					},
					fail: (error) => {
						this.loading = false
						console.log('加载月检记录详情失败:', error)
						uni.showToast({
							title: '网络错误',
							icon: 'none'
						})
					}
				})
			},
			
			showActionButtons(): boolean {
				if (!this.recordDetail) return false
				
				// 检查用户权限
				const userInfoData = uni.getStorageSync('userInfo')
				const userInfoStr = userInfoData != null ? userInfoData as string : ''
				if (userInfoStr != null && userInfoStr != '' && userInfoStr != 'null' && userInfoStr != 'undefined') {
					try {
						const parsedUserInfo = JSON.parse(userInfoStr) as UTSJSONObject
						const role = parsedUserInfo.getString('role') ?? ''
						return role === 'ADMIN' || role === 'SUPER_ADMIN'
					} catch (error) {
						return false
					}
				}
				return false
			},
			
			goToConfirmRectification() {
				// 跳转到确认整改页面
				uni.navigateTo({
					url: `/pages/monthly/confirm-rectification?id=${this.recordId}`
				})
			},
			
			goToConfirmReview() {
				// 跳转到确认复查页面
				uni.navigateTo({
					url: `/pages/monthly/confirm-review?id=${this.recordId}`
				})
			},
			
			getStatusText(status: number): string {
				switch (status) {
					case 0: return '待整改'
					case 1: return '已整改'
					case 2: return '已复查'
					default: return '未知'
				}
			},
			
			getStatusClass(status: number): string {
				switch (status) {
					case 0: return 'status-pending'
					case 1: return 'status-completed'
					case 2: return 'status-reviewed'
					default: return 'status-unknown'
				}
			},
			
			formatDateTime(dateStr: string): string {
				if (!dateStr) return ''
				try {
					const date = new Date(dateStr)
					const year = date.getFullYear()
					const month = String(date.getMonth() + 1).padStart(2, '0')
					const day = String(date.getDate()).padStart(2, '0')
					const hours = String(date.getHours()).padStart(2, '0')
					const minutes = String(date.getMinutes()).padStart(2, '0')
					return `${year}-${month}-${day} ${hours}:${minutes}`
				} catch (error) {
					return dateStr
				}
			},
			
			previewImage(index: number) {
				uni.previewImage({
					urls: this.imageList,
					current: index
				})
			},
			
			onImageError() {
				console.log('图片加载失败')
			},
			
			onImageLoad() {
				console.log('图片加载成功')
			}
		}
	}
</script>

