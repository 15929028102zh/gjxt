			// 加载性质界定详情（扣分值和安全记分关联项）
			loadQualityDetails(qualityId: string) {
				// 模拟API调用
				setTimeout(() => {
					switch (qualityId) {
						case 'quality1':
							this.formData.deductionScore = '5'
							this.formData.safetyScoreItem = '一般安全记分'
							break
						case 'quality2':
							this.formData.deductionScore = '10'
							this.formData.safetyScoreItem = '严重安全记分'
							break
						case 'quality3':
							this.formData.deductionScore = '20'
							this.formData.safetyScoreItem = '重大安全记分'
							break
						default:
							this.formData.deductionScore = ''
							this.formData.safetyScoreItem = ''
					}
			}, 100)
			},
			
			// 根据选择的问题自动填充问题性质和对应分数
			autoFillIssueDetails(issueId: string, issueName: string) {
				console.log('开始自动填充问题详情:', issueId, issueName)
				
				// 首先加载性质界定选项（如果还没有加载）
				if (this.qualityOptions.length === 0) {
					this.loadQualityOptions()
				}
				
				// 根据问题名称智能匹配问题性质和分数
      const issueMapping = this.getIssueQualityMapping(issueName) as UTSJSONObject | null
      
      if (issueMapping != null) {
       // 设置问题性质
       this.formData.quality = issueMapping.getString('quality') ?? ''
       // 查找对应的性质界定索引
       const qualityIndex = this.qualityOptions.findIndex((item: OptionItem) => item.name === (issueMapping.getString('quality') ?? ''))
       if (qualityIndex !== -1) {
        this.selectedQualityIndex = qualityIndex
       }
       
       // 设置扣分值和安全记分关联项
       this.formData.deductionScore = issueMapping.getString('deductionScore') ?? ''
       this.formData.safetyScoreItem = issueMapping.getString('safetyScoreItem') ?? ''
					
					console.log('自动填充完成:', {
						quality: this.formData.quality,
						deductionScore: this.formData.deductionScore,
						safetyScoreItem: this.formData.safetyScoreItem
					})
					
					// 显示提示信息
					uni.showToast({
						title: `已自动填充：${issueMapping.quality}，扣${issueMapping.deductionScore}分`,
						icon: 'success',
						duration: 2000
					})
				} else {
					console.log('未找到匹配的问题映射规则')
				}
			},
			
			// 获取问题与性质界定的映射关系
  getIssueQualityMapping(issueName: string): UTSJSONObject {
    // 定义问题与性质界定的映射规则
    const mappingRules = [
      // 严重问题类型
      { keywords: ['违章', '违规', '严重', '重大', '危险', '安全隐患'], quality: '严重问题', deductionScore: '15', safetyScoreItem: '严重安全记分' },
      { keywords: ['火灾', '爆炸', '中毒', '触电', '高空坠落'], quality: '重大问题', deductionScore: '25', safetyScoreItem: '重大安全记分' },
      
      // 一般问题类型
      { keywords: ['轻微', '一般', '小问题', '不规范', '不完善'], quality: '一般问题', deductionScore: '5', safetyScoreItem: '一般安全记分' },
      { keywords: ['标识', '标牌', '记录', '台账', '文档'], quality: '一般问题', deductionScore: '3', safetyScoreItem: '一般安全记分' },
      
      // 中等问题类型
      { keywords: ['设备', '工具', '防护', '操作', '流程'], quality: '中等问题', deductionScore: '10', safetyScoreItem: '中等安全记分' },
      { keywords: ['环境', '卫生', '整理', '整顿'], quality: '中等问题', deductionScore: '8', safetyScoreItem: '中等安全记分' }
    ] as UTSJSONObject[]
				
      // 查找匹配的规则
      for (let i = 0; i < mappingRules.length; i++) {
       const rule = mappingRules[i] as UTSJSONObject
       const keywords = rule.getArray('keywords') as string[]
       for (let j = 0; j < keywords.length; j++) {
        const keyword = keywords[j]
        if (issueName.includes(keyword)) {
         return {
								quality: rule.quality,
								deductionScore: rule.deductionScore,
								safetyScoreItem: rule.safetyScoreItem
							}
						}
					}
				}
				
				// 如果没有匹配到，返回默认值
				return {
					quality: '一般问题',
					deductionScore: '5',
					safetyScoreItem: '一般安全记分'
				}
			},
			
			// 添加照片
			addPhoto() {
				uni.chooseImage({
					count: 3 - this.formData.photos.length,
					sizeType: ['compressed'],
					sourceType: ['camera', 'album'],
					success: (res) => {
						this.formData.photos.push(...res.tempFilePaths)
				}
			})
		},
			
			// 删除照片
			deletePhoto(index: number) {
				this.formData.photos.splice(index, 1)
			},
			
			// 预览照片
			previewPhoto(photo: string) {
				uni.previewImage({
					current: photo,
					urls: this.formData.photos
				})
			},
			
			// 保存记录
			saveRecord() {
				// 表单验证
			if (this.formData.problemType == '') {
					uni.showToast({ title: '请选择问题类型', icon: 'none' })
					return
				}
				
			if (this.formData.problemLevel == '') {
					uni.showToast({ title: '请选择问题等级', icon: 'none' })
					return
				}
				
			if (this.formData.problemDescription.trim() == '') {
					uni.showToast({ title: '请输入问题描述', icon: 'none' })
					return
				}
				
			if (this.formData.location.trim() == '') {
					uni.showToast({ title: '请输入发现位置', icon: 'none' })
					return
				}
				
				try {
					uni.showLoading({ title: '保存中...' })
					
					// 模拟API调用
					uni.request({
						url: '/api/monthly/problem/save',
						method: 'POST',
						data: {
							taskId: this.taskInfo.taskNumber,
							...this.formData
						},
						success: (res) => {
							uni.hideLoading()
							const respdate=res.data as UTSJSONObject
							if (respdate.getNumber('code') == 200) {
								uni.showToast({ title: '保存成功', icon: 'success' })
								setTimeout(() => {
									uni.navigateBack()
								}, 1500)
							} else {
								const msg = respdate.getString('message')
								uni.showToast({ title: msg != null ? msg : '保存失败', icon: 'none' })
							}
						},
						fail: (error) => {
							uni.hideLoading()
							console.error('保存失败:', error)
							uni.showToast({ title: '保存失败', icon: 'none' })
						}
					})
				} catch (error) {
					uni.hideLoading()
					console.error('保存失败:', error)
					uni.showToast({ title: '保存失败', icon: 'none' })
				}
			}
		}
	}
</script>

