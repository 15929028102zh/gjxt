			// 自动填充性质界定
			autoFillProfession() {
				console.log('开始自动填充性质界定')
				console.log('taskInfo:', this.taskInfo)
				console.log('typeOptions:', this.typeOptions)
				
				if (this.taskInfo != null && this.taskInfo.profession != '' && this.typeOptions.length > 0) {
					console.log('查找性质界定:', this.taskInfo.profession)
					const index = this.typeOptions.findIndex((item: OptionItem) => item.name === this.taskInfo.profession)
					console.log('找到的性质界定索引:', index)
					
					if (index !== -1) {
						this.selectedTypeIndex = index
						console.log('已设置性质界定索引:', this.selectedTypeIndex)
						// 自动加载模块选项
						this.loadModuleOptions((this.typeOptions[index] as OptionItem).id)
					} else {
						console.warn('未找到匹配的性质界定:', this.taskInfo.profession)
						// 尝试模糊匹配
						const fuzzyIndex = this.typeOptions.findIndex((item: OptionItem) => 
							item.name.includes(this.taskInfo.profession) || this.taskInfo.profession.includes(item.name)
						)
						if (fuzzyIndex !== -1) {
							this.selectedTypeIndex = fuzzyIndex
							console.log('模糊匹配到性质界定索引:', this.selectedTypeIndex)
							this.loadModuleOptions((this.typeOptions[fuzzyIndex] as OptionItem).id)
						}
					}
				} else {
					if (this.taskInfo == null) {
						console.log('taskInfo为空，等待任务信息加载')
					} else if (this.taskInfo.profession == '') {
						console.log('专业信息为空')
					} else if (this.typeOptions.length === 0) {
						console.log('性质界定选项未加载，等待加载完成')
					}
				}
				
				// 自动加载对应性质界定的岗检标准项
				this.loadGjbzDataByProfession()
			},
			
			// 加载专业类别选项
			loadTypeOptions() {
				const token = uni.getStorageSync('token')
				uni.request({
					url: getApiUrl('/gjbz-data/options/types'),
					method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
						const respdata = res.data as UTSJSONObject
						if (respdata.getNumber('code') === 200) {
							const data = respdata.getArray('data')
							console.log("获取到的专业类别数据",data)
							if (data != null) {
								const options: OptionItem[] = []
								for (let i = 0; i < data.length; i++) {
           const item = data[i] as string
           options.push({
            id: (i + 1).toString(),
            name: item
           } as OptionItem)
