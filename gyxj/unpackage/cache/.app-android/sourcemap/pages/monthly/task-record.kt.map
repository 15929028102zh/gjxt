		// 加载问题等级选项
		loadProblemLevels() {
			const token = uni.getStorageSync('token')
			uni.request({
				url: getApiUrl('/dictionary/items/问题等级'),
				method: 'GET',
				header: {
					'Authorization': `Bearer ${token}`
				},
				success: (res) => {
					const respdata = res.data as UTSJSONObject
					if (respdata.getNumber('code') === 200) {
						const data = respdata.getArray('data')
						console.log("获取到的问题等级数据", data)
						if (data != null) {
							const levels: any[] = []
							for (let i = 0; i < data.length; i++) {
								const item = data[i] as UTSJSONObject
							const desc = item.getString('description')
							levels.push({
								value: item.getString('value'),
								name: item.getString('label'),
								desc: desc != null ? desc : ''
							} as UTSJSONObject)
							}
							this.problemLevels = levels
							console.log("问题等级选项已加载:", this.problemLevels)
						}
					} else {
						console.error('加载问题等级失败:', respdata.getString('message'))
						this.loadFallbackProblemLevels()
					}
				},
				fail: (error) => {
					console.error('加载问题等级失败:', error)
					this.loadFallbackProblemLevels()
				}
			})
		},
		
		// 加载备用问题等级数据
		loadFallbackProblemLevels() {
			this.problemLevels = [
				{ value: 'critical', name: '严重', desc: '可能造成重大安全事故' },
				{ value: 'major', name: '重要', desc: '可能造成一般安全事故' },
				{ value: 'minor', name: '一般', desc: '需要及时整改' },
				{ value: 'suggestion', name: '建议', desc: '改进建议' }
			]
			console.log("使用备用问题等级数据:", this.problemLevels)
		},
		
		// 根据专业信息加载岗检标准项
			loadGjbzDataByProfession() {
				if (this.taskInfo == null || this.taskInfo.profession === '') {
					return
				}
				
				const token = uni.getStorageSync('token')
				uni.request({
					url: getApiUrl(`/gjbz-data/by-profession/${encodeURIComponent(this.taskInfo.profession)}`),
					method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
						const respdata = res.data as UTSJSONObject
						if (respdata.getNumber('code') === 200) {
							const data = respdata.getArray('data')
							if (data != null && data.length > 0) {
								console.log(`找到${data.length}个与专业"${this.taskInfo.profession}"相关的岗检标准项`)
								// 这里可以将数据存储到组件的数据中，供后续使用
								// 例如：this.gjbzDataList = data
							} else {
								console.log(`未找到与专业"${this.taskInfo.profession}"相关的岗检标准项`)
							}
						} else {
							console.error('加载岗检标准项失败:', respdata.getString('message'))
						}
					},
					fail: (error) => {
						console.error('加载岗检标准项失败:', error)
					}
				})
			},
			
