<template>
	<scroll-view class="container" scroll-y="true" :scroll-top="scrollTop" :style="{height: containerHeight + 'px'}" enable-back-to-top="true">
		<!-- 头部 -->
		<view class="header">
			<view class="header-left" @click="goBack">
				
			</view>
			<text class="header-title">月检任务录入</text>
			<view class="header-right">
				<!-- 保存按钮已移至页面底部 -->
			</view>
		</view>
		
		<!-- 任务信息 -->
		<view class="task-info">
			<view class="info-item">
				<text class="info-label">任务编号:</text>
				<text class="info-value">{{taskInfo != null ? taskInfo.taskNumber : ''}}</text>
			</view>
			<view class="info-item">
				<text class="info-label">月检时间:</text>
				<text class="info-value">{{taskInfo != null ? taskInfo.inspectionDate : ''}}</text>
			</view>
			<view class="info-item">
				<text class="info-label">检查部门:</text>
				<text class="info-value">{{taskInfo != null ? taskInfo.department : ''}}</text>
			</view>
			<view class="info-item">
				<text class="info-label">检查专业:</text>
				<text class="info-value">{{taskInfo != null ? taskInfo.profession : ''}}</text>
			</view>
			<view class="info-item">
				<text class="info-label">检查组长:</text>
				<text class="info-value">{{taskInfo != null ? taskInfo.groupLeader : ''}}</text>
			</view>
			<view class="info-item">
				<text class="info-label">检查副组长:</text>
				<text class="info-value">{{taskInfo.deputyLeader}}</text>
			</view>
		</view>
		
		<!-- 问题录入表单 -->
		<view class="form-section">
			<view class="section-title">
				<text class="title-text">问题录入</text>
				<text class="required-mark">*</text>
			</view>
			
			<!-- 专业类别（第1级联选择框） -->
			<view class="form-item">
				<text class="form-label-left">专业类别</text>
				<view class="custom-picker-full" @click="showTypePicker" :class="{disabled: typeOptions.length === 0}">
					<text class="picker-text-full" :class="{placeholder: selectedTypeIndex === -1}">
						{{selectedTypeIndex === -1 ? '请选择专业类别' : (selectedTypeIndex < typeOptions.length ? (typeOptions[selectedTypeIndex] as OptionItem).name : '请选择专业类别')}}
					</text>
				</view>
			</view>
			
			<!-- 模块（第2级联选择框） -->
			<view class="form-item">
				<text class="form-label-left">模块</text>
				<view class="custom-picker-full" @click="showModulePicker" :class="{disabled: moduleOptions.length === 0}">
					<text class="picker-text-full" :class="{placeholder: selectedModuleIndex === -1}">
						{{selectedModuleIndex === -1 ? '请选择模块' : (selectedModuleIndex < moduleOptions.length ? (moduleOptions[selectedModuleIndex] as OptionItem).name : '请选择模块')}}
					</text>
				</view>
			</view>
			
			<!-- 责任（第3级联选择框） -->
			<view class="form-item">
				<text class="form-label-left">责任</text>
				<view class="custom-picker-full" @click="showResponsibilityPicker" :class="{disabled: responsibilityOptions.length === 0}">
					<text class="picker-text-full" :class="{placeholder: selectedResponsibilityIndex === -1}">
						{{selectedResponsibilityIndex === -1 ? '请选择责任' : (selectedResponsibilityIndex < responsibilityOptions.length ? (responsibilityOptions[selectedResponsibilityIndex] as OptionItem).name : '请选择责任')}}
					</text>
				</view>
			</view>
			
			<!-- 问题（第4级联选择框） -->
			<view class="form-item">
				<text class="form-label-left">问题</text>
				<view class="custom-picker-full" @click="showIssuePicker" :class="{disabled: issueOptions.length === 0}">
					<text class="picker-text-full" :class="{placeholder: selectedIssueIndex === -1}">
						{{selectedIssueIndex === -1 ? '请选择问题' : (selectedIssueIndex < issueOptions.length ? (issueOptions[selectedIssueIndex] as OptionItem).name : '请选择问题')}}
					</text>
				</view>
			</view>
			
			<!-- 性质界定 -->
			<view class="form-item">
				<text class="form-label-left">性质界定</text>
				<view class="custom-picker-full" @click="showQualityPicker" :class="{disabled: qualityOptions.length === 0}">
					<text class="picker-text-full" :class="{placeholder: selectedQualityIndex === -1}">
						{{selectedQualityIndex === -1 ? '请选择性质界定' : (selectedQualityIndex < qualityOptions.length ? (qualityOptions[selectedQualityIndex] as OptionItem).name : '请选择性质界定')}}
					</text>
				</view>
			</view>
			
			<!-- 安全记分 -->
			<view class="form-item">
				<text class="form-label-left">安全记分</text>
				<input class="form-input" 
					   v-model="formData.safetyScore" 
					   placeholder="自动带出安全记分"
					   readonly />
			</view>
			

			
			<!-- 问题描述 -->
			<view class="form-item">
				<text class="form-label">问题描述</text>
				<textarea class="textarea-input" 
						  v-model="formData.problemDescription" 
						  placeholder="请详细描述发现的问题"
						  maxlength="500"></textarea>
				<text class="char-count">{{formData.problemDescription.length}}/500</text>
			</view>
			
			<!-- 发现位置 -->
			<view class="form-item">
				<text class="form-label-left">发现位置</text>
				<input class="form-input" 
					   v-model="formData.location" 
					   placeholder="请输入问题发现的具体位置" />
			</view>
			
			<!-- 整改期限 -->
			<view class="form-item">
				<text class="form-label-left">整改期限</text>
				<view class="picker-container" @click="showDatePicker">
					<text class="picker-text-full" :class="{placeholder: formData.rectificationDate === ''}">
						{{formData.rectificationDate !== '' ? formData.rectificationDate : '请选择整改期限'}}
					</text>
				</view>
				<!-- 日期选择器弹窗 -->
				<view v-if="datePickerVisible" class="date-picker-modal" @click="hideDatePicker">
					<view class="date-picker-content" @click.stop>
						<view class="date-picker-header">
							<text class="date-picker-cancel" @click="hideDatePicker">取消</text>
							<text class="date-picker-title">选择日期</text>
							<text class="date-picker-confirm" @click="confirmDatePicker">确定</text>
						</view>
						<picker-view class="date-picker-view" :value="pickerValue" @change="onPickerChange" indicator-style="height: 70px; top: 20%; margin-top: -20px;">
							<picker-view-column>
								<view v-for="(year, index) in years" :key="index" class="picker-item" :class="{selected: index === pickerValue[0]}">
									{{year}}年
								</view>
							</picker-view-column>
							<picker-view-column>
								<view v-for="(month, index) in months" :key="index" class="picker-item" :class="{selected: index === pickerValue[1]}">
									{{month}}月
								</view>
							</picker-view-column>
							<picker-view-column>
								<view v-for="(day, index) in days" :key="index" class="picker-item" :class="{selected: index === pickerValue[2]}">
									{{day}}日
								</view>
								<!-- 添加空白项目，让最后的日期可以滚动到选择区域 -->
								<view v-for="i in 2" :key="'empty-day-' + i" class="picker-item picker-item-spacer"></view>
							</picker-view-column>
						</picker-view>
					</view>
				</view>
			</view>
			
			<!-- 检查人 -->
			<view class="form-item">
				<text class="form-label-left">检查人</text>
				<input class="form-input" 
					   v-model="formData.inspector" 
					   placeholder="请输入检查人姓名" />
			</view>
			
			<!-- 照片上传 -->
			<view class="form-item">
				<text class="form-label">问题照片</text>
				<view class="photo-upload">
					<view v-for="(photo, index) in formData.photos" :key="index" class="photo-item">
						<image :src="convertToHttpUrl(photo)" class="photo-preview" @click="previewPhoto(photo)"></image>
						<view class="photo-delete" @click="deletePhoto(index)">
							<text class="delete-icon">×</text>
						</view>
					</view>
					<view v-if="formData.photos.length < 3" class="photo-add" @click="addPhoto">
						<text class="add-icon">+</text>
						<text class="add-text">添加照片</text>
					</view>
				</view>
				<text class="photo-tip">最多可上传3张照片</text>
			</view>
		</view>
		
		<!-- 底部保存按钮 -->
		<view class="bottom-save-container">
			<view class="bottom-save-btn" @click="saveRecord">
				<text class="bottom-save-text">保存</text>
			</view>
		</view>
		
		<!-- 问题类型选择器 -->
		<view v-if="showProblemTypeModal" class="picker-modal" @click="hideProblemTypePicker">
			<view class="picker-content" @click.stop>
				<view class="picker-header">
					<text class="picker-cancel" @click="hideProblemTypePicker">取消</text>
					<text class="picker-title">选择问题类型</text>
					<text class="picker-confirm" @click="confirmProblemType">确定</text>
				</view>
				<view class="picker-list">
					<view v-for="(type, index) in problemTypes" :key="index" 
						  class="picker-item" 
						  :class="{selected: selectedProblemType === type}"
						  @click="selectProblemType(type)">
						<text class="picker-item-text">{{type}}</text>
						<text v-if="selectedProblemType === type" class="picker-check">✓</text>
					</view>
				</view>
			</view>
		</view>
		

		
		<!-- 专业类别选择弹窗 -->
		<view v-if="showTypePopup" class="popup-overlay" @click="hideTypePicker">
			<view class="popup-content" @click.stop>
				<view class="popup-header">
					<text class="popup-title">选择专业类别</text>
					<text class="popup-close" @click="hideTypePicker">×</text>
				</view>
				<view class="popup-search">
					<input class="search-input" v-model="typeSearchKeyword" placeholder="搜索专业类别..." />
				</view>
				<scroll-view class="popup-list" scroll-y="true">
					<view v-if="filteredTypeOptions.length === 0" class="popup-empty">
						<text class="empty-text">暂无匹配的专业类别</text>
					</view>
					<view v-else v-for="(item, index) in filteredTypeOptions" :key="(item as OptionItem).id" 
					  :class="['popup-item', selectedTypeIndex >= 0 && typeOptions[selectedTypeIndex] != null && typeOptions[selectedTypeIndex].id === (item as OptionItem).id ? 'popup-item-selected' : '']" 
					  @click="selectTypeFromFiltered(item)">
						<text class="popup-item-text">{{(item as OptionItem).name}}</text>
        <text v-if="selectedTypeIndex >= 0 && typeOptions[selectedTypeIndex] != null && typeOptions[selectedTypeIndex].id === (item as OptionItem).id" class="popup-item-check">✓</text>
					</view>
				</scroll-view>
			</view>
		</view>
		
		<!-- 模块选择弹窗 -->
		<view v-if="showModulePopup" class="popup-overlay" @click="hideModulePicker">
			<view class="popup-content" @click.stop>
				<view class="popup-header">
					<text class="popup-title">选择模块</text>
					<text class="popup-close" @click="hideModulePicker">×</text>
				</view>
				<view class="popup-search">
					<input class="search-input" v-model="moduleSearchKeyword" placeholder="搜索模块..." />
				</view>
				<scroll-view class="popup-list" scroll-y="true">
					<view v-if="moduleOptions.length === 0" class="popup-loading">
						<text class="loading-text">加载中...</text>
					</view>
					<view v-else-if="filteredModuleOptions.length === 0" class="popup-empty">
						<text class="empty-text">暂无匹配的模块</text>
					</view>
					<view v-else v-for="(item, index) in filteredModuleOptions" :key="(item as OptionItem).id" 
         :class="['popup-item', selectedModuleIndex >= 0 && moduleOptions[selectedModuleIndex] != null && moduleOptions[selectedModuleIndex].id === (item as OptionItem).id ? 'popup-item-selected' : '']" 
					  @click="selectModuleFromFiltered(item)">
					<text class="popup-item-text">{{(item as OptionItem).name}}</text>
       <text v-if="selectedModuleIndex >= 0 && moduleOptions[selectedModuleIndex] != null && moduleOptions[selectedModuleIndex].id === (item as OptionItem).id" class="popup-item-check">✓</text>
				</view>
				</scroll-view>
			</view>
		</view>
		
		<!-- 责任选择弹窗 -->
		<view v-if="showResponsibilityPopup" class="popup-overlay" @click="hideResponsibilityPicker">
			<view class="popup-content" @click.stop>
				<view class="popup-header">
					<text class="popup-title">选择责任</text>
					<text class="popup-close" @click="hideResponsibilityPicker">×</text>
				</view>
				<view class="popup-search">
					<input class="search-input" v-model="responsibilitySearchKeyword" placeholder="搜索责任部门..." />
				</view>
				<scroll-view class="popup-list" scroll-y="true">
					<view v-if="responsibilityOptions.length === 0" class="popup-loading">
						<text class="loading-text">加载中...</text>
					</view>
					<view v-else-if="filteredResponsibilityOptions.length === 0" class="popup-empty">
						<text class="empty-text">暂无匹配的责任部门</text>
					</view>
					<view v-else v-for="(item, index) in filteredResponsibilityOptions" :key="(item as OptionItem).id" 
         :class="['popup-item', selectedResponsibilityIndex >= 0 && responsibilityOptions[selectedResponsibilityIndex] != null && responsibilityOptions[selectedResponsibilityIndex].id === (item as OptionItem).id ? 'popup-item-selected' : '']" 
					  @click="selectResponsibilityFromFiltered(item)">
					<text class="popup-item-text">{{(item as OptionItem).name}}</text>
       <text v-if="selectedResponsibilityIndex >= 0 && responsibilityOptions[selectedResponsibilityIndex] != null && responsibilityOptions[selectedResponsibilityIndex].id === (item as OptionItem).id" class="popup-item-check">✓</text>
				</view>
				</scroll-view>
			</view>
		</view>
		
		<!-- 问题选择弹窗 -->
		<view v-if="showIssuePopup" class="popup-overlay" @click="hideIssuePicker">
			<view class="popup-content" @click.stop>
				<view class="popup-header">
					<text class="popup-title">选择问题</text>
					<text class="popup-close" @click="hideIssuePicker">×</text>
				</view>
				<view class="popup-search">
					<input class="search-input" v-model="issueSearchKeyword" placeholder="搜索问题..." />
				</view>
				<scroll-view class="popup-list" scroll-y="true">
					<view v-if="issueOptions.length === 0" class="popup-loading">
						<text class="loading-text">加载中...</text>
					</view>
					<view v-else-if="filteredIssueOptions.length === 0" class="popup-empty">
						<text class="empty-text">暂无匹配的问题</text>
					</view>
      <view v-else v-for="(item, index) in filteredIssueOptions" :key="(item as OptionItem).id" 
        :class="['popup-item', selectedIssueIndex !== -1 && issueOptions[selectedIssueIndex] != null && issueOptions[selectedIssueIndex].id === (item as OptionItem).id ? 'popup-item-selected' : '']" 
        @click="selectIssueFromFiltered(item)">
      <text class="popup-item-text">{{(item as OptionItem).name}}</text>
      <text v-if="selectedIssueIndex !== -1 && issueOptions[selectedIssueIndex] != null && issueOptions[selectedIssueIndex].id === (item as OptionItem).id" class="popup-item-check">✓</text>
				</view>
				</scroll-view>
			</view>
		</view>
		
		<!-- 性质界定选择弹窗 -->
		<view v-if="showQualityPopup" class="popup-overlay" @click="hideQualityPicker">
			<view class="popup-content" @click.stop>
				<view class="popup-header">
					<text class="popup-title">选择性质界定</text>
					<text class="popup-close" @click="hideQualityPicker">×</text>
				</view>
				<view class="popup-search">
					<input class="search-input" v-model="qualitySearchKeyword" placeholder="搜索性质界定..." />
				</view>
				<scroll-view class="popup-list" scroll-y="true">
					<view v-if="qualityOptions.length === 0" class="popup-loading">
						<text class="loading-text">加载中...</text>
					</view>
					<view v-else-if="filteredQualityOptions.length === 0" class="popup-empty">
						<text class="empty-text">暂无匹配的性质界定</text>
					</view>
      <view v-else v-for="(item, index) in filteredQualityOptions" :key="(item as OptionItem).id" 
        :class="['popup-item', selectedQualityIndex !== -1 && qualityOptions[selectedQualityIndex] != null && qualityOptions[selectedQualityIndex].id === (item as OptionItem).id ? 'popup-item-selected' : '']" 
        @click="selectQualityFromFiltered(item)">
      <text class="popup-item-text">{{(item as OptionItem).name}}</text>
      <text v-if="selectedQualityIndex !== -1 && qualityOptions[selectedQualityIndex] != null && qualityOptions[selectedQualityIndex].id === (item as OptionItem).id" class="popup-item-check">✓</text>
				</view>
				</scroll-view>
			</view>
		</view>
	</scroll-view>
</template>

<script lang="uts">
	import { getApiUrl, apiConfig } from '@/config/api.uts'
	
	type TaskInfo = {
		taskNumber: string
		inspectionDate: string
		department: string
		profession: string
		groupLeader: string
		deputyLeader: string
	}
	
	type FormData = {
		problemType: string
		problemDescription: string
		location: string
		photos: string[]
		safetyScore: string
		rectificationDate: string
		module: string
		responsibility: string
		issue: string
		quality: string
		inspector: string
	}
	
	type OptionItem = {
		id: string
		name: string
		value?: string
	}
	
	export default {
		data(): {
			taskInfo: TaskInfo
			formData: FormData
			containerHeight: number
			scrollTop: number
			showProblemTypeModal: boolean
			selectedProblemType: string
			problemTypes: any[]
			// 级联选择器相关
			showTypePopup: boolean
			showModulePopup: boolean
			showResponsibilityPopup: boolean
			showIssuePopup: boolean
			showQualityPopup: boolean
			typeOptions: OptionItem[]
			moduleOptions: OptionItem[]
			responsibilityOptions: OptionItem[]
			issueOptions: OptionItem[]
			qualityOptions: OptionItem[]
			selectedTypeIndex: number
			selectedModuleIndex: number
			selectedResponsibilityIndex: number
			selectedIssueIndex: number
			selectedQualityIndex: number
			// 搜索关键字
			typeSearchKeyword: string
			moduleSearchKeyword: string
			responsibilitySearchKeyword: string
			issueSearchKeyword: string
			qualitySearchKeyword: string
			// 日期选择器相关
			datePickerVisible: boolean
			pickerValue: number[]
			years: number[]
			months: number[]
			days: number[]
			selectedYear: number
			selectedMonth: number
			selectedDay: number
			pickerDebounceTimer: number | null
		} {
			// 计算默认整改时间（当前日期往后推7天）
			const defaultDate = new Date()
			defaultDate.setDate(defaultDate.getDate() + 7)
			const defaultDateStr = `${defaultDate.getFullYear()}-${(defaultDate.getMonth() + 1).toString().padStart(2, '0')}-${defaultDate.getDate().toString().padStart(2, '0')}`
			
			return {
				taskInfo: {
					taskNumber: '',
					inspectionDate: '',
					department: '',
					profession: '',
					groupLeader: '',
					deputyLeader: ''
				} as TaskInfo,
				formData: {
			problemType: '',
			problemDescription: '',
			location: '',
			photos: [],
			safetyScore: '',
			rectificationDate: defaultDateStr,
			module: '',
			responsibility: '',
			issue: '',
			quality: '',
			inspector: ''
		} as FormData,
				containerHeight: 0,
				scrollTop: 0,
				showProblemTypeModal: false,
			selectedProblemType: '',
				problemTypes: [
					'安全隐患',
					'设备故障',
					'环境问题',
					'操作违规',
					'制度缺失',
					'其他问题'
			],
				// 级联选择器相关
				showTypePopup: false,
				showModulePopup: false,
				showResponsibilityPopup: false,
				showIssuePopup: false,
				showQualityPopup: false,
				typeOptions: [] as OptionItem[],
				moduleOptions: [] as OptionItem[],
				responsibilityOptions: [] as OptionItem[],
				issueOptions: [] as OptionItem[],
				qualityOptions: [] as OptionItem[],
				selectedTypeIndex: -1,
				selectedModuleIndex: -1,
				selectedResponsibilityIndex: -1,
				selectedIssueIndex: -1,
				selectedQualityIndex: -1,
				// 搜索关键字初始值
				typeSearchKeyword: '',
				moduleSearchKeyword: '',
				responsibilitySearchKeyword: '',
				issueSearchKeyword: '',
				qualitySearchKeyword: '',
				// 日期选择器相关
				datePickerVisible: false,
				pickerValue: [0, 0, 0],
				years: [] as number[],
				months: [] as number[],
				days: [] as number[],
				selectedYear: (() => {
					const tempDate = new Date()
					tempDate.setDate(tempDate.getDate() + 7)
					return tempDate.getFullYear()
				})() as number,
				selectedMonth: (() => {
					const tempDate = new Date()
					tempDate.setDate(tempDate.getDate() + 7)
					return tempDate.getMonth() + 1
				})() as number,
				selectedDay: (() => {
					const tempDate = new Date()
					tempDate.setDate(tempDate.getDate() + 7)
					return tempDate.getDate()
				})() as number,
				// 防抖定时器
				pickerDebounceTimer: null as number | null
			}
		},
		

	

	// 预览照片
	previewPhoto(photo: string) {
		uni.previewImage({
			current: this.convertToHttpUrl(photo),
			urls: this.formData.photos.map((p: string) => this.convertToHttpUrl(p)) as string[]
		})
	},

	onLoad(options : UTSJSONObject) {
			const taskId = options.getString('taskId')
			console.log(taskId)
			
			if (taskId != null && taskId != '') {
				this.loadTaskInfo(taskId)
			}
			// 初始化级联选择器数据
			this.loadTypeOptions()
			// 初始化日期选择器数据
			this.initDateArrays()
		},
		onReady() {
			this.initContainerHeight()
		},
		computed: {
			// 过滤后的专业类别选项
			filteredTypeOptions(): OptionItem[] {
     if (this.typeSearchKeyword == '') {
					return this.typeOptions
				}
				return this.typeOptions.filter(item => 
					item.name.toLowerCase().includes(this.typeSearchKeyword.toLowerCase())
				)
			},
			// 过滤后的模块选项
     filteredModuleOptions(): OptionItem[] {
      if (this.moduleSearchKeyword == '') {
       return this.moduleOptions
