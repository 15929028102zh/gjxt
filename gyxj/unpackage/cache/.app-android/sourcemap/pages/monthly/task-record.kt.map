		// 根据专业信息加载岗检标准项
			loadGjbzDataByProfession() {
				if (this.taskInfo == null || this.taskInfo.profession === '') {
					return
				}
				
				const token = uni.getStorageSync('token')
				uni.request({
					url: getApiUrl(`/gjbz-data/by-profession/${encodeURIComponent(this.taskInfo.profession)}`),
					method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
						const respdata = res.data as UTSJSONObject
						if (respdata.getNumber('code') === 200) {
							const data = respdata.getArray('data')
							if (data != null && data.length > 0) {
								console.log(`找到${data.length}个与专业"${this.taskInfo.profession}"相关的岗检标准项`)
								// 这里可以将数据存储到组件的数据中，供后续使用
								// 例如：this.gjbzDataList = data
							} else {
								console.log(`未找到与专业"${this.taskInfo.profession}"相关的岗检标准项`)
							}
						} else {
							console.error('加载岗检标准项失败:', respdata.getString('message'))
						}
					},
					fail: (error) => {
						console.error('加载岗检标准项失败:', error)
					}
				})
			},
			
