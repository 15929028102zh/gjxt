<template>
	<scroll-view 
		class="container" 
		scroll-y="true" 
		:scroll-top="scrollTop" 
		:style="{height: containerHeight + 'px'}" 
		enable-back-to-top="true"
		refresher-enabled="true"
		:refresher-triggered="isRefreshing"
		refresher-default-style="black"
		refresher-background="#f5f5f5"
		@refresherrefresh="onRefresh"
		@refresherrestore="onRefreshRestore"
	>
		<!-- 顶部欢迎区域 -->
		<view class="header">
			<view class="welcome">
				<text class="greeting">欢迎回来，{{userName}}</text>
				<text class="app-name">{{currentDate}}</text>
			</view>
			<image class="avatar" :src="userInfo != null && (userInfo.getString('avatar') ?? '') != '' ? (userInfo.getString('avatar') ?? '') : '/static/default-avatar.svg'" mode="aspectFill"></image>
		</view>
			<!-- 操作按钮 -->
		<view class="action-buttons">
			<view class="action-button" @click="goToAddRecord">
				<view class="button-icon">➕</view>
				<text class="button-text">周检</text>
				<text class="button-text-sub">每周安全检查</text>
			</view>
			<view class="action-button delayed-button" @click="goToDelayedRecord">
				<view class="button-icon">⏰</view>
				<text class="button-text">延迟整改</text>
				<text class="button-text-sub">延期问题处理</text>
			</view>
		</view>
		<!-- 统计卡片 -->
		<view class="stats-container">
			<view class="stats-card" @click="goToPendingIssues">
				<text class="stats-number">{{statistics.pendingIssues}}</text>
				<text class="stats-label">待整改</text>
				<text class="stats-icon">⚠️</text>
			</view>
			<view class="stats-card" @click="goToCompletedIssues">
				<text class="stats-number">{{statistics.completedIssues}}</text>
				<text class="stats-label">已整改</text>
				<text class="stats-icon">✅</text>
			</view>
			<view class="stats-card" @click="goToReviewedRecords">
				<text class="stats-number">{{statistics.reviewedCount}}</text>
				<text class="stats-label">已复查数量</text>
				<text class="stats-icon">✅</text>
			</view>
		</view>
		
	
		
		
	</scroll-view>
</template>

<script lang="uts">
	import { getApiUrl } from '@/config/api.uts'
	import { isWeeklyAdmin } from '@/utils/permission.uts'
	import { refreshUserInfo } from '@/utils/user.uts'
	
	type RecentRecord = {
		id: string,
		problemDescription: string,
		locationName: string,
		createTime: string,
		status: string
	}

	type StatisticsData = {
		pendingIssues: number,
		completedIssues: number,
		reviewedCount: number
	}

	export default {
		data() {
			return {
				userInfo: {} as UTSJSONObject,
				userName: '用户', // 简化的用户姓名变量
				currentDate: '',
				scrollTop: 0,
				containerHeight: 0,
				// 下拉刷新相关
				isRefreshing: false,
				statistics: {
					pendingIssues: 0,
					completedIssues: 0,
					reviewedCount: 0
				} as StatisticsData,
				recentRecords: [] as RecentRecord[]
			}
		},
		onLoad() {
			if (!this.checkLogin()) return
			this.initContainerHeight()
			// 先刷新服务端 userInfo(部门/角色可能已被后台调整)，再按最新 deptId 过滤与展示
			refreshUserInfo().then(() => {
				this.loadUserInfo()
				this.initData()
				this.loadStatistics()
				this.loadRecentRecords()
			})
		},
		methods: {
			checkLogin() {
				const token = uni.getStorageSync('token')
				if (token == null || token == '') {
					uni.reLaunch({
						url: '/pages/login/login'
					})
					return false
				}
				return true
			},
			
			// 加载用户信息
			loadUserInfo() {
				const userInfoData = uni.getStorageSync('userInfo')
				const userInfoStr = userInfoData != null ? userInfoData as string : ''
				
				if (userInfoStr != null && userInfoStr != '' && userInfoStr != 'null' && userInfoStr != 'undefined') {
					try {
						const parsedUserInfo = JSON.parse(userInfoStr) as UTSJSONObject
						this.userInfo = parsedUserInfo
						// 设置简化的用户姓名
						const realNameValue = parsedUserInfo.getString('realName')
						this.userName = realNameValue != null ? realNameValue : '用户'
					} catch (error) {
						console.error('用户信息JSON解析失败:', error)
						this.userInfo = {} as UTSJSONObject
						this.userName = '解析失败用户'
					}
				} else {
					this.userInfo = {} as UTSJSONObject
					this.userName = '默认用户'
				}
			},
			
			initData() {
				const now = new Date()
				const year = now.getFullYear()
				const month = (now.getMonth() + 1).toString()
				const formattedMonth = month.length == 1 ? `0${month}` : month
				const day = now.getDate().toString()
				const formattedDay = day.length == 1 ? `0${day}` : day
				const weekdays = ['日', '一', '二', '三', '四', '五', '六']
				const weekday = weekdays[now.getDay()]
				this.currentDate = `${year}年${formattedMonth}月${formattedDay}日 星期${weekday}`
			},
			
			loadStatistics() {
				console.log('开始加载统计数据')
				const token = uni.getStorageSync('token')
				
				// 获取用户信息：部门 ID + 周检管理员标志
				let departmentId = ''
				// 周检域管理员用 isWeeklyAdmin()(对齐 Web permission.js:老 isAdmin=1 或 isWeeklyAdmin=1)
				const isAdmin = isWeeklyAdmin()
				const userInfoData = uni.getStorageSync('userInfo')
				const userInfoStr = userInfoData != null ? userInfoData as string : ''
				if (userInfoStr != null && userInfoStr != '' && userInfoStr != 'null' && userInfoStr != 'undefined') {
					try {
					const parsedUserInfo = JSON.parse(userInfoStr) as UTSJSONObject
					departmentId = parsedUserInfo.getString('deptId') ?? ''
					console.log("获取到的部门id",departmentId)
					console.log("是否为管理员",isAdmin)
					} catch (error) {
						console.error('用户信息JSON解析失败:', error)
					}
				}
				
				// 构建部门过滤参数 - 管理员用户不需要部门过滤
				const deptParam = (!isAdmin && departmentId != null && departmentId != '') ? `&departmentId=${departmentId}` : ''
				
				// 获取待整改数量（状态为0）- 使用分页查询API获取准确数量
				const pendingUrl = getApiUrl(`/inspection-record/page?current=1&size=1&status=0${deptParam}`)
				console.log('待整改数量请求URL:', pendingUrl)
				uni.request({
					url: pendingUrl,
					method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
						console.log('待整改数量请求成功:', res)
						const response = res.data as UTSJSONObject
						if (res.statusCode == 200 && (response.getNumber('code') ?? 0) == 200) {
							const data = response.getJSON('data') as UTSJSONObject
							this.statistics.pendingIssues = data.getNumber('total') ?? 0
							console.log('待整改数量:', this.statistics.pendingIssues)
						} else {
							console.log('待整改数量请求失败:', response)
						}
					},
					fail: (error) => {
						console.log('待整改数量请求错误:', error)
					}
				})
				
				// 获取已整改数量（状态为1）- 使用分页查询API获取准确数量
				const completedUrl = getApiUrl(`/inspection-record/page?current=1&size=1&status=1${deptParam}`)
				console.log('已整改数量请求URL:', completedUrl)
				uni.request({
					url: completedUrl,
					method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
						console.log('已整改数量请求成功:', res)
						const response = res.data as UTSJSONObject
						if (res.statusCode == 200 && (response.getNumber('code') ?? 0) == 200) {
							const data = response.getJSON('data') as UTSJSONObject
							this.statistics.completedIssues = data.getNumber('total') ?? 0
							console.log('已整改数量:', this.statistics.completedIssues)
						} else {
							console.log('已整改数量请求失败:', response)
						}
					},
					fail: (error) => {
						console.log('已整改数量请求错误:', error)
					}
				})
				
				// 获取已复查数量（状态为2）- 使用分页查询API获取准确数量
				const reviewedUrl = getApiUrl(`/inspection-record/page?current=1&size=1&status=2${deptParam}`)
				console.log('已复查数量请求URL:', reviewedUrl)
				uni.request({
					url: reviewedUrl,
					method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
						console.log('已复查数量请求成功:', res)
						const response = res.data as UTSJSONObject
						if (res.statusCode == 200 && (response.getNumber('code') ?? 0) == 200) {
							const data = response.getJSON('data') as UTSJSONObject
							this.statistics.reviewedCount = data.getNumber('total') ?? 0
							console.log('已复查数量:', this.statistics.reviewedCount)
						} else {
							console.log('已复查数量请求失败:', response)
						}
					},
					fail: (error) => {
						console.log('已复查数量请求错误:', error)
					}
				})
			},
			
			loadRecentRecords() {
				const token = uni.getStorageSync('token')
				
				// 获取用户信息：部门 ID + 周检管理员标志
				let departmentId = ''
				// 周检域管理员用 isWeeklyAdmin()(对齐 Web permission.js)
				const isAdmin = isWeeklyAdmin()
				const userInfoData = uni.getStorageSync('userInfo')
				const userInfoStr = userInfoData != null ? userInfoData as string : ''
				if (userInfoStr != null && userInfoStr != '' && userInfoStr != 'null' && userInfoStr != 'undefined') {
					try {
						const parsedUserInfo = JSON.parse(userInfoStr) as UTSJSONObject
						departmentId = parsedUserInfo.getString('deptId') ?? ''
					} catch (error) {
						console.error('用户信息JSON解析失败:', error)
					}
				}
				
				// 构建部门过滤参数 - 管理员用户不需要部门过滤
				const deptParam = (!isAdmin && departmentId != null && departmentId != '') ? `&departmentId=${departmentId}` : ''
				
				const apiUrl = getApiUrl(`/inspection-record/page?current=1&size=5&status=0${deptParam}`)
				console.log('请求URL:', apiUrl)
				uni.request({
				url: apiUrl,
					method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
						const response = res.data as UTSJSONObject
						if (res.statusCode == 200 && (response.getNumber('code') ?? 0) == 200) {
							const data = response.getJSON('data') as UTSJSONObject
							const records = data.getArray('records') as Array<UTSJSONObject>
							this.recentRecords = []
							for (let i = 0; i < records.length; i++) {
								const item = records[i]
								const record: RecentRecord = {
									id: item.getString('id') ?? '',
									problemDescription: item.getString('problemDescription') ?? '',
									locationName: item.getString('locationName') ?? '',
									createTime: item.getString('createTime') ?? '',
									status: item.getString('status') ?? ''
								}
								this.recentRecords.push(record)
							}
						}
					},
					fail: (error) => {
						console.log('加载最近记录失败:', error)
					}
				})
			},
			
			getStatusText(status: string | null): string {
				if (status == null) return '未知'
				if (status == "0") return '待整改'
				if (status == "1") return '已整改'
				if (status == "2") return '已复查'
				return '未知'
			},
			
			getStatusClass(status: string | null): string {
				if (status == null) return 'status-unknown'
				if (status == "0") return 'status-pending'
				if (status == "1") return 'status-completed'
				if (status == "2") return 'status-accepted'
				return 'status-unknown'
			},
			
			goToPendingIssues() {
				uni.navigateTo({
					url: '/pages/record/record?status=0'
				})
			},
			
			goToCompletedIssues() {
				uni.navigateTo({
					url: '/pages/record/record?status=1'
				})
			},
			
			goToReviewedRecords() {
				uni.navigateTo({
					url: '/pages/record/record?type=reviewed'
				})
			},
			
			goToRecords() {
				uni.switchTab({
					url: '/pages/record/record'
				})
			},
			
			goToAddRecord() {
				uni.navigateTo({
					url: '/pages/record/add'
				})
			},
			
			goToDelayedRecord() {
				// 延迟整改是指超过整改期限但仍未整改的记录
				// 这些记录的状态是0（待整改），但已经超过了整改期限
				uni.navigateTo({
					url: '/pages/record/record?status=0&delayed=true'
				})
			},
			
			goToRecordDetail(recordId: string) {
				uni.navigateTo({
					url: `/pages/record/detail?id=${recordId}`
				})
			},
			
			// 下拉刷新事件处理
			onRefresh() {
				console.log('开始下拉刷新')
				this.isRefreshing = true
				
				// 重新加载数据
				this.reloadAllData()
			},
			
			// 刷新恢复事件处理
			onRefreshRestore() {
				console.log('刷新恢复')
				this.isRefreshing = false
			},
			
			// 重新加载所有数据
			reloadAllData() {
				console.log('重新加载所有数据')
				
				try {
					// 重新初始化时间
					this.initData()
					
					// 重新加载用户信息
					this.loadUserInfo()
					
					// 重新加载统计数据和记录
					this.loadStatistics()
					this.loadRecentRecords()
					
					console.log('数据加载完成')
					
				} catch (error) {
					console.error('数据加载失败:', error)
				} finally {
					// 无论成功还是失败，都要关闭刷新动画
					setTimeout(() => {
						console.log('关闭刷新动画')
						this.isRefreshing = false
					}, 1000) // 1秒后关闭刷新动画
				}
			},
			
			initContainerHeight() {
				const res = uni.getSystemInfoSync()
				this.containerHeight = res.windowHeight
			}
		}
	}
</script>

