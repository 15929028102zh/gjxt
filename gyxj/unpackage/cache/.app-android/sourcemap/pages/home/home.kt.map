<template>
	<scroll-view 
		class="container" 
		scroll-y="true" 
		:scroll-top="scrollTop" 
		:style="{height: containerHeight + 'px'}" 
		enable-back-to-top="true"
		refresher-enabled="true"
		:refresher-triggered="isRefreshing"
		refresher-default-style="black"
		refresher-background="#f5f5f5"
		@refresherrefresh="onRefresh"
		@refresherrestore="onRefreshRestore"
	>
		<!-- 顶部欢迎区域 -->
		<view class="header">
			<view class="welcome">
				<text class="greeting">欢迎回来，{{userName}}</text>
				<text class="app-name">{{currentDate}}</text>
			</view>
			<image class="avatar" :src="(userInfo.getString('avatar') ?? '') != '' ? (userInfo.getString('avatar') ?? '') : '/static/default-avatar.svg'" mode="aspectFill"></image>
		</view>

		<!-- 周检统计区域 -->
		<view class="section">
			<view class="section-title">
				<text class="title-text">周检统计</text>
			</view>
			
			<!-- 周检统计卡片 -->
			<view class="stats-container">
				<view class="stat-card" @click="goToWeeklyPending">
					<text class="stat-number">{{ weeklyStats.pending }}</text>
					<text class="stat-label">待整改数</text>
				</view>
				<view class="stat-card" @click="goToWeeklyCompleted">
					<text class="stat-number">{{ weeklyStats.completed }}</text>
					<text class="stat-label">已整改数</text>
				</view>
				<view class="stat-card" @click="goToWeeklyReviewed">
					<text class="stat-number">{{ weeklyStats.reviewed }}</text>
					<text class="stat-label">已复查数</text>
				</view>
			</view>

			<!-- 周检饼图 -->
			<view class="chart-container">
				<view class="chart-title">
					<text class="chart-title-text">周检记录总数: {{ weeklyStats.total }}</text>
				</view>
				<view class="chart-wrapper">
					<tui-xechars 
						ref="weeklyChart"
						style="height:350px;width:100%;min-width:280px;"
						class="chart-canvas"
						@initFinished="onWeeklyChartInit"
					/>
				</view>
			</view>
		</view>

		<!-- 月检统计区域 -->
		<view class="section">
			<view class="section-title">
				<text class="title-text">月检统计</text>
			</view>
			
			<!-- 月检统计卡片 -->
			<view class="stats-container">
				<view class="stat-card" @click="goToMonthlyPending">
					<text class="stat-number">{{ monthlyStats.pending }}</text>
					<text class="stat-label">待整改数</text>
				</view>
				<view class="stat-card" @click="goToMonthlyCompleted">
					<text class="stat-number">{{ monthlyStats.completed }}</text>
					<text class="stat-label">已整改数</text>
				</view>
				<view class="stat-card" @click="goToMonthlyReviewed">
					<text class="stat-number">{{ monthlyStats.reviewed }}</text>
					<text class="stat-label">已复查数</text>
				</view>
			</view>

			<!-- 月检饼图 -->
			<view class="chart-container">
				<view class="chart-title">
					<text class="chart-title-text">月检记录总数: {{ monthlyStats.total }}</text>
				</view>
				<view class="chart-wrapper">
					<tui-xechars 
						ref="monthlyChart"
						style="height:350px;width:100%;min-width:280px;"
						class="chart-canvas"
						@initFinished="onMonthlyChartInit"
					/>
				</view>
			</view>
		</view>
		
        
	</scroll-view>
</template>

<script setup lang="uts">
	import { ref, onMounted, onUnmounted, nextTick, reactive } from 'vue'
	import { getApiUrl } from '@/config/api.uts'
	import { isWeeklyAdmin } from '@/utils/permission.uts'
	import { refreshUserInfo } from '@/utils/user.uts'
	import { TuiCharts, TuiDrawCharts } from '@/uni_modules/tui-xechars'

	// 定义统计数据类型
	type StatsData = {
		total: number
		pending: number
		completed: number
		reviewed: number
	}

	// 定义uni.request响应类型
	type UniRequestResponse = {
		statusCode: number
		data: any
		header: any
		cookies?: string[]
	}


	
	// 用户信息
	const userInfo = ref({} as UTSJSONObject)
	const userName = ref('用户') // 简化的用户姓名变量
	const currentDate = ref('加载中...')

	// 统计数据
	const weeklyStats = ref({
		total: 45,
		pending: 12,
		completed: 28,
		reviewed: 5
	} as StatsData)

	const monthlyStats = ref({
		total: 156,
		pending: 23,
		completed: 108,
		reviewed: 25
	} as StatsData)

	// 图表实例
	let weeklyChartInstance : TuiCharts | null = null
	let monthlyChartInstance : TuiCharts | null = null
	
	// 图表配置选项
	const weeklyChartOption = ref({} as UTSJSONObject)
	const monthlyChartOption = ref({} as UTSJSONObject)
	
	// 图表引用
	const weeklyChart = ref(null)
	const monthlyChart = ref(null)
	
	// 趋势图表数据类型
	
	// 滚动相关
	const scrollTop = ref(0)
	const containerHeight = ref(0)
	
	// 下拉刷新相关
	const isRefreshing = ref(false)




	// 更新周检图表数据
	const updateWeeklyChart = () : void => {
		if (weeklyChartInstance != null) {
			const weeklyPieChart = weeklyChartInstance!.getDrawCharts(0)
			if (weeklyPieChart != null) {
				weeklyPieChart.update({
					series: [
						{
							name: '待整改',
							data: [
								{
									value: weeklyStats.value.pending
								}
							]
						},
						{
							name: '已整改',
							data: [
								{
									value: weeklyStats.value.completed
								}
							]
						},
						{
							name: '已复查',
							data: [
								{
									value: weeklyStats.value.reviewed
								}
							]
						}
					]
				})
			}
		}
	}

	// 更新月检图表数据
	const updateMonthlyChart = () : void => {
		if (monthlyChartInstance != null) {
			const monthlyPieChart = monthlyChartInstance!.getDrawCharts(0)
			if (monthlyPieChart != null) {
				monthlyPieChart.update({
					series: [
						{
							name: '待整改',
							data: [
								{
									value: monthlyStats.value.pending
								}
							]
						},
						{
							name: '已整改',
							data: [
								{
									value: monthlyStats.value.completed
								}
							]
						},
						{
							name: '已复查',
							data: [
								{
									value: monthlyStats.value.reviewed
								}
							]
						}
					]
				})
			}
		}
	}

	// 加载周检统计数据
	const loadWeeklyStats = async () : Promise<void> => {
		try {
			const token = uni.getStorageSync('token')
			
			// 获取用户信息：部门 ID + 周检管理员标志
			let departmentId = ''
			// 周检域管理员用 isWeeklyAdmin()(对齐 Web permission.js:老 isAdmin=1 或 isWeeklyAdmin=1)
			const isAdmin = isWeeklyAdmin()
			const userInfoData = uni.getStorageSync('userInfo')
			const userInfoStr = userInfoData != null ? userInfoData as string : ''
			if (userInfoStr != null && userInfoStr != '' && userInfoStr != 'null' && userInfoStr != 'undefined') {
				try {
					const parsedUserInfo = JSON.parse(userInfoStr) as UTSJSONObject
					departmentId = parsedUserInfo.getString('deptId') ?? ''
				} catch (error) {
					console.error('用户信息JSON解析失败:', error)
				}
			}
			
			// 解析响应数据
			let pending = 0, completed = 0, reviewed = 0, total = 0
			let completedRequests = 0
			const totalRequests = 4
			
			// 更新统计数据
			const updateWeeklyStats = () => {
				weeklyStats.value = {
					total: total,
					pending: pending,
					completed: completed,
					reviewed: reviewed
				} as StatsData
				
				// 在数据更新后重新更新图表
				updateWeeklyChart()
			}
			
			// 如果没有token，使用模拟数据
			if (token == null || token == '') {
				weeklyStats.value = {
					total: 45,
					pending: 12,
					completed: 28,
					reviewed: 5
				} as StatsData
				updateWeeklyChart()
				return
			}
			
			// 构建部门过滤参数 - 管理员用户不需要部门过滤
			const deptParam = (!isAdmin && departmentId != null && departmentId != '') ? `&departmentId=${departmentId}` : ''
			
			// 获取待整改数量（状态为0）- 使用分页查询API获取准确数量
			const pendingUrl = getApiUrl(`/inspection-record/page?current=1&size=1&status=0${(!isAdmin && departmentId != null && departmentId != '') ? '&departmentId=' + departmentId : ''}`)
			uni.request({
				url: pendingUrl,
				method: 'GET',
				header: {
					'Authorization': `Bearer ${token}`
				},
				success: (res) => {
					if (res.statusCode === 200 && res.data != null) {
						const response = res.data as UTSJSONObject
						if ((response.getNumber('code') ?? 0) === 200) {
							const data = response.getJSON('data') as UTSJSONObject
							pending = data.getNumber('total') ?? 0
						}
					}
					completedRequests++
					if (completedRequests === totalRequests) {
						updateWeeklyStats()
					}
				},
				fail: (error) => {
					console.error('获取待整改数量失败:', error)
					completedRequests++
					if (completedRequests === totalRequests) {
						updateWeeklyStats()
					}
				}
			})
			
			// 获取已整改数量（状态为1）- 使用分页查询API获取准确数量
			const completedUrl = getApiUrl(`/inspection-record/page?current=1&size=1&status=1${(!isAdmin && departmentId != null && departmentId != '') ? '&departmentId=' + departmentId : ''}`)
			uni.request({
				url: completedUrl,
				method: 'GET',
				header: {
					'Authorization': `Bearer ${token}`
				},
				success: (res) => {
					if (res.statusCode === 200 && res.data != null) {
						const response = res.data as UTSJSONObject
						if ((response.getNumber('code') ?? 0) === 200) {
							const data = response.getJSON('data') as UTSJSONObject
							completed = data.getNumber('total') ?? 0
						}
					}
					completedRequests++
					if (completedRequests === totalRequests) {
						updateWeeklyStats()
					}
				},
				fail: (error) => {
					console.error('获取已整改数量失败:', error)
					completedRequests++
					if (completedRequests === totalRequests) {
						updateWeeklyStats()
					}
				}
			})
			
			// 获取已复查数量（状态为2）- 使用分页查询API获取准确数量
			const reviewedUrl = getApiUrl(`/inspection-record/page?current=1&size=1&status=2${(!isAdmin && departmentId != null && departmentId != '') ? '&departmentId=' + departmentId : ''}`)
			uni.request({
				url: reviewedUrl,
				method: 'GET',
				header: {
					'Authorization': `Bearer ${token}`
				},
				success: (res) => {
					if (res.statusCode === 200 && res.data != null) {
						const response = res.data as UTSJSONObject
						if ((response.getNumber('code') ?? 0) === 200) {
							const data = response.getJSON('data') as UTSJSONObject
							reviewed = data.getNumber('total') ?? 0
						}
					}
					completedRequests++
					if (completedRequests === totalRequests) {
						updateWeeklyStats()
					}
				},
				fail: (error) => {
					console.error('获取已复查数量失败:', error)
					completedRequests++
					if (completedRequests === totalRequests) {
						updateWeeklyStats()
					}
				}
			})
			
			// 获取总记录数量 - 使用分页查询API获取准确数量
			const totalUrl = getApiUrl(`/inspection-record/page?current=1&size=1${(!isAdmin && departmentId != null && departmentId != '') ? '&departmentId=' + departmentId : ''}`)
			uni.request({
				url: totalUrl,
				method: 'GET',
				header: {
					'Authorization': `Bearer ${token}`
				},
				success: (res) => {
					if (res.statusCode === 200 && res.data != null) {
						const response = res.data as UTSJSONObject
						if ((response.getNumber('code') ?? 0) === 200) {
							const data = response.getJSON('data') as UTSJSONObject
							total = data.getNumber('total') ?? 0
						}
					}
					completedRequests++
					if (completedRequests === totalRequests) {
						updateWeeklyStats()
					}
				},
				fail: (error) => {
					console.error('获取总记录数量失败:', error)
					completedRequests++
					if (completedRequests === totalRequests) {
						updateWeeklyStats()
					}
				}
			})
			
		} catch (error) {
			console.error('加载周检统计数据失败:', error)
			// 使用模拟数据作为后备
			weeklyStats.value = {
				total: 45,
				pending: 12,
				completed: 28,
				reviewed: 5
			} as StatsData
			updateWeeklyChart()
		}
	}

	// 加载月检统计数据
    const loadMonthlyStats = async () : Promise<void> => {
        try {
            const token = uni.getStorageSync('token')
            // 部门隔离由后端按登录用户强制处理，前端不再传部门参数(对齐 Web:月检统计无客户端权限分支)
            const deptParam = ''
            let pending = 0, completed = 0, reviewed = 0
            let finished = 0
            const totalReq = 3
            const updateMonthly = () => {
                monthlyStats.value = {
                    total: pending + completed + reviewed,
                    pending: pending,
                    completed: completed,
                    reviewed: reviewed
                } as StatsData
                updateMonthlyChart()
            }
            const req = (status: number, assign: (n:number)=>void) => {
                uni.request({
                    url: getApiUrl(`/monthly-inspection-record/page?current=1&size=1&recordStatus=${status}${deptParam}`),
                    method: 'GET',
                    header: { 'Authorization': `Bearer ${token}` },
                    success: (res) => {
                        const resp = res.data as UTSJSONObject
                        if (res.statusCode === 200 && (resp.getNumber('code') ?? 0) === 200) {
                            const d = resp.getJSON('data') as UTSJSONObject
                            assign(d.getNumber('total') ?? 0)
                        }
                        finished++
                        if (finished === totalReq) updateMonthly()
                    },
                    fail: (_) => { finished++; if (finished === totalReq) updateMonthly() }
                })
            }
            req(0, (n: number) => { pending = n })
            req(1, (n: number) => { completed = n })
            req(2, (n: number) => { reviewed = n })
        } catch (error) {
            console.error('加载月检统计数据失败:', error)
            monthlyStats.value = { total: 0, pending: 0, completed: 0, reviewed: 0 } as StatsData
            updateMonthlyChart()
        }
    }



	// 检查登录状态
	const checkLogin = () : boolean => {
		const token = uni.getStorageSync('token')
		if (token == null || token == '') {
			console.log('未登录，跳转到登录页面')
			uni.reLaunch({
				url: '/pages/login/login'
			})
			return false
		}
		return true
	}
	
	// 加载用户信息
	const loadUserInfo = () : void => {
		console.log('=== 开始加载用户信息 ===')
		
		// 检查本地存储
		const userInfoStr = uni.getStorageSync('userInfo') as string
		console.log('本地存储原始数据:', userInfoStr)
		
		if (userInfoStr != null && userInfoStr != '' && userInfoStr != 'null' && userInfoStr != 'undefined') {
			try {
				const parsedUserInfo = JSON.parse(userInfoStr) as UTSJSONObject
				console.log('解析后的对象:', parsedUserInfo)
				
				// 检查realName字段
				const realName = parsedUserInfo.getString('realName')
				console.log('realName字段值:', realName)
				console.log('realName类型:', typeof realName)
				
				// 设置用户信息
				userInfo.value = parsedUserInfo
				// 同时设置简化的用户姓名
				const realNameValue = parsedUserInfo.getString('realName')
				userName.value = realNameValue != null ? realNameValue : '用户'
				console.log('设置后的 userInfo.value:', userInfo.value)
				console.log('设置后的 userName.value:', userName.value)
				
				// 验证设置结果
				const testRealName = userInfo.value.getString('realName')
				console.log('验证: 设置后的realName:', testRealName)
				
				// 强制触发界面更新
				nextTick(() => {
					console.log('界面更新后检查:', userInfo.value.getString('realName'))
					// 强制触发响应式更新
					userInfo.value = {...userInfo.value}
				})
				
			} catch (error) {
				console.error('用户信息JSON解析失败:', error)
				userInfo.value = {
					realName: '解析失败用户'
				} as UTSJSONObject
			}
		} else {
			console.log('本地存储中没有有效的用户信息')
			// 设置默认用户信息
			userInfo.value = {
				realName: '默认用户',
				avatar: ''
			} as UTSJSONObject
			userName.value = '默认用户'
		}
		
		console.log('=== 用户信息加载完成 ===')
	}
	
	// 初始化当前日期
	const initCurrentDate = () : void => {
		const now = new Date()
		const year = now.getFullYear()
		const month = (now.getMonth() + 1).toString().padStart(2, '0')
		const day = now.getDate().toString().padStart(2, '0')
		const hours = now.getHours().toString().padStart(2, '0')
		const minutes = now.getMinutes().toString().padStart(2, '0')
		currentDate.value = `${year}-${month}-${day} ${hours}:${minutes}`
	}
	
	// 定时器ID
	const timeInterval = ref<number | null>(null)
	
	// 开始时间更新定时器
	const startTimeUpdate = () : void => {
		initCurrentDate()
		timeInterval.value = setInterval(() => {
			initCurrentDate()
		}, 60000) // 每分钟更新一次
	}
	
	// 停止时间更新定时器
	const stopTimeUpdate = () : void => {
		const intervalId = timeInterval.value
		if (intervalId !== null) {
			clearInterval(intervalId)
			timeInterval.value = null
		}
	}

	// 初始化容器高度
	const initContainerHeight = () : void => {
		uni.getSystemInfo({
			success: (res) => {
				containerHeight.value = res.windowHeight
			}
		})
	}
	
	// 重新加载所有数据
	const reloadAllData = async () : Promise<void> => {
		console.log('重新加载所有数据')
		
		try {
			// 重新初始化时间
			initCurrentDate()
			
			// 重新加载用户信息
			loadUserInfo()
			
			// 并发加载统计数据
			await Promise.all([
				loadWeeklyStats(),
				new Promise<void>((resolve) => {
					loadMonthlyStats()
					// 给月检数据加载一个短暂的延时
					setTimeout(() => {
						resolve()
					}, 800)
				})
			])
			
			console.log('所有数据加载完成')
			
		} catch (error) {
			console.error('数据加载失败:', error)
		} finally {
			// 无论成功还是失败，都要关闭刷新动画
			setTimeout(() => {
				console.log('关闭刷新动画')
				isRefreshing.value = false
			}, 500) // 稍微延迟一下，让用户看到加载效果
		}
	}
	
	// 下拉刷新事件处理
	const onRefresh = () : void => {
		console.log('开始下拉刷新')
		isRefreshing.value = true
		
		// 重新加载数据
		reloadAllData()
	}
	
	// 刷新恢复事件处理
	const onRefreshRestore = () : void => {
		console.log('刷新恢复')
		isRefreshing.value = false
	}
	
	// 页面挂载时初始化
	onMounted(() => {
		// 检查登录状态
		const loginStatus = checkLogin()
		if (loginStatus == false) {
			return
		}
		
		// 立即初始化日期显示
		initCurrentDate()

		// 启动时间更新
		startTimeUpdate()

		// 初始化容器高度
		initContainerHeight()

		// 先刷新服务端 userInfo(部门/角色可能已被后台调整)，再按最新 deptId 加载用户信息与统计
		refreshUserInfo().then(() => {
			loadUserInfo()
			// 等待DOM渲染完成后加载数据
			nextTick(() => {
				// 加载数据，图表会在initFinished回调中初始化
				loadWeeklyStats()
				loadMonthlyStats()
			})
		})
	})
	
	// 页面卸载时清理
	onUnmounted(() => {
		stopTimeUpdate()
	})





	// 图表初始化回调函数
	const onWeeklyChartInit = (chartInstance : TuiCharts) : void => {
		weeklyChartInstance = chartInstance
		
		// 创建饼图
		const pieOption = {
			type: 'pie',
			animation: true,
			dataLabel: true,
			fontSize: 12,
			padding: [15, 15, 15, 15],
			title: {
				name: '周检统计分布',
				fontSize: 14,
				color: '#2c3e50',
				offsetY: 5
			},
			extra: {
				pie: {
					activeOpacity: 0.5,
					activeRadius: 8,
					offsetAngle: 0,
					labelWidth: 15,
					border: true,
					borderWidth: 2,
					borderColor: '#FFFFFF',
					linearType: 'custom'
				},
				tooltip: {
					show: true
				}
			},
			series: [
				{
					name: '待整改',
					data: [
						{
							value: weeklyStats.value.pending
						}
					]
				},
				{
					name: '已整改',
					data: [
						{
							value: weeklyStats.value.completed
						}
					]
				},
				{
					name: '已复查',
					data: [
						{
							value: weeklyStats.value.reviewed
						}
					]
				}
			],
			xAxis: {
				disableGrid: true
			},
			yAxis: {
				data: [
					{
						min: 0
					}
				]
			}
		} as UTSJSONObject
		
		const weeklyPieChart = chartInstance.add(0, pieOption)
		weeklyPieChart.setCoordinates({ height: 280, width: 260, xOffset: 15, yOffset: 35 })
		weeklyPieChart.draw()
	}
	
	const onMonthlyChartInit = (chartInstance : TuiCharts) : void => {
		monthlyChartInstance = chartInstance
		
		// 创建饼图
		const pieOption = {
			type: 'pie',
			animation: true,
			dataLabel: true,
			fontSize: 12,
			padding: [15, 15, 15, 15],
			title: {
				name: '月检统计分布',
				fontSize: 14,
				color: '#2c3e50',
				offsetY: 5
			},
			extra: {
				pie: {
					activeOpacity: 0.5,
					activeRadius: 8,
					offsetAngle: 0,
					labelWidth: 15,
					border: true,
					borderWidth: 2,
					borderColor: '#FFFFFF',
					linearType: 'custom'
				},
				tooltip: {
					show: true
				}
			},
			series: [
				{
					name: '待整改',
					data: [
						{
							value: monthlyStats.value.pending
						}
					]
				},
				{
					name: '已整改',
					data: [
						{
							value: monthlyStats.value.completed
						}
					]
				},
				{
					name: '已复查',
					data: [
						{
							value: monthlyStats.value.reviewed
						}
					]
				}
			],
			xAxis: {
				disableGrid: true
			},
			yAxis: {
				data: [
					{
						min: 0
					}
				]
			}
		} as UTSJSONObject
		
		const monthlyPieChart = chartInstance.add(0, pieOption)
		monthlyPieChart.setCoordinates({ height: 280, width: 260, xOffset: 15, yOffset: 35 })
		monthlyPieChart.draw()
	}
	

	// 最终的跳转方法
	const goToWeeklyPending = () : void => {
		uni.navigateTo({
			url: '/pages/weekly/weekly?status=pending'
		})
	}

	const goToWeeklyCompleted = () : void => {
