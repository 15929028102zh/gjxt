<template>
	<view class="chart-page">
		<view class="chart-section">
			<text class="section-title">折线图示例</text>
			<view class="chart-wrapper">
				<tui-xechars 
					ref="lineChart"
					:option="lineChartOption"
					:width="350"
					:height="300"
					@initFinished="onLineChartInit"
				/>
			</view>
		</view>

		<view class="chart-section">
			<text class="section-title">柱状图示例</text>
			<view class="chart-wrapper">
				<tui-xechars 
					ref="barChart"
					:option="barChartOption"
					:width="350"
					:height="300"
					@initFinished="onBarChartInit"
				/>
			</view>
		</view>

		<view class="chart-section">
			<text class="section-title">饼图示例</text>
			<view class="chart-wrapper">
				<tui-xechars 
					ref="pieChart"
					:option="pieChartOption"
					:width="350"
					:height="300"
					@initFinished="onPieChartInit"
				/>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, onMounted } from 'vue'

	// 图表引用
	const lineChart = ref(null)
	const barChart = ref(null)
	const pieChart = ref(null)

	// 折线图配置
	const lineChartOption = ref({
		type: 'line',
		color: ['#36CFC9', '#6B7280'],
		title: {
			name: '产品销量趋势',
			fontSize: 16,
			color: '#333333'
		},
		subtitle: {
			name: '月度对比',
			fontSize: 12,
			color: '#999999'
		},
		categories: ['1月', '2月', '3月', '4月', '5月', '6月'],
		series: [
			{
				name: '产品A',
				data: [120, 150, 130, 180, 160, 200]
			},
			{
				name: '产品B',
				data: [90, 120, 140, 130, 170, 190]
			}
		],
		extra: {
			line: {
				type: 'straight',
				width: 2,
				activeType: 'solid'
			}
		}
	} as UTSJSONObject)

	// 柱状图配置
	const barChartOption = ref({
		type: 'column',
		color: ['#4F46E5'],
		title: {
			name: '月度销量统计',
			fontSize: 16,
			color: '#333333'
		},
		subtitle: {
			name: '单位：件',
			fontSize: 12,
			color: '#999999'
		},
		categories: ['1月', '2月', '3月', '4月', '5月', '6月'],
		series: [
			{
				name: '销量',
				data: [1200, 1900, 1500, 2400, 1800, 2800]
			}
		],
		extra: {
			column: {
				type: 'group',
				width: 30,
				activeBgColor: '#000000',
				activeBgOpacity: 0.08
			}
		}
	} as UTSJSONObject)

	// 饼图配置
	const pieChartOption = ref({
		type: 'pie',
		color: ['#FF6B6B', '#4ECDC4', '#45B7D1', '#96CEB4'],
		title: {
			name: '产品分类占比',
			fontSize: 16,
			color: '#333333'
		},
		subtitle: {
			name: '总计：100%',
			fontSize: 12,
			color: '#999999'
		},
		extra: {
			pie: {
				activeOpacity: 0.5,
				activeRadius: 10,
				offsetAngle: 0,
				labelWidth: 15,
				border: true,
				borderWidth: 2,
				borderColor: '#FFFFFF'
			}
		},
		series: [
			{
				name: '电子产品',
				value: 45,
				color: '#FF6B6B'
			},
			{
				name: '服装',
				value: 25,
				color: '#4ECDC4'
			},
			{
				name: '食品',
				value: 20,
				color: '#45B7D1'
			},
			{
				name: '其他',
				value: 10,
				color: '#96CEB4'
			}
		]
	} as UTSJSONObject)

	// 图表初始化回调函数
	const onLineChartInit = () : void => {
		console.log('折线图初始化完成')
	}

	const onBarChartInit = () : void => {
		console.log('柱状图初始化完成')
	}

	const onPieChartInit = () : void => {
		console.log('饼图初始化完成')
	}

	// 更新图表数据的方法示例
	const updateLineChart = () : void => {
		// 更新折线图数据
		lineChartOption.value = {
			...lineChartOption.value,
			series: [
				{
					name: '产品A',
					data: [140, 170, 150, 200, 180, 220]
				},
				{
					name: '产品B',
					data: [110, 140, 160, 150, 190, 210]
				}
			]
		} as UTSJSONObject
	}

	const updateBarChart = () : void => {
		// 更新柱状图数据
		barChartOption.value = {
			...barChartOption.value,
			series: [
				{
					name: '销量',
					data: [1400, 2100, 1700, 2600, 2000, 3000]
				}
			]
		} as UTSJSONObject
	}

	const updatePieChart = () : void => {
		// 更新饼图数据
		pieChartOption.value = {
			...pieChartOption.value,
			series: [
				{
					name: '电子产品',
					value: 50,
					color: '#FF6B6B'
				},
				{
					name: '服装',
					value: 30,
					color: '#4ECDC4'
				},
				{
					name: '食品',
					value: 15,
					color: '#45B7D1'
				},
				{
					name: '其他',
					value: 5,
					color: '#96CEB4'
				}
			]
		} as UTSJSONObject
	}

	onMounted(() => {
		console.log('图表页面加载完成')
		
		// 示例：3秒后更新数据
		setTimeout(() => {
			console.log('更新图表数据')
			updateLineChart()
			updateBarChart()
			updatePieChart()
		}, 3000)
	})
</script>

<style scoped>
	.chart-page {
		padding: 30rpx;
		background-color: #F9FAFB;
		min-height: 100%;
	}

	.chart-section {
		background-color: #FFFFFF;
		border-radius: 16rpx;
		padding: 30rpx;
		margin-bottom: 30rpx;
		box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
	}

	.section-title {
		font-size: 32rpx;
		font-weight: bold;
		color: #1F2937;
		margin-bottom: 20rpx;
		display: block;
	}

	.chart-wrapper {
		width: 100%;
		display: flex;
		justify-content: center;
		align-items: center;
		background-color: #FAFAFA;
		border-radius: 12rpx;
		padding: 20rpx;
		margin-top: 20rpx;
	}
</style>