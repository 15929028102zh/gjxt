				</view>
				
				<view class="image-grid">
					<view class="image-item" v-for="(image, index) in problemImages" :key="index">
						<image 
							:src="image" 
							mode="aspectFill" 
							class="problem-image" 
							@click="previewImage(index, problemImages)"
						></image>
					</view>
				</view>
			</view>
			
			<!-- 整改图片 -->
			<view class="section" v-if="rectificationImages.length > 0">
				<view class="section-title">
					<text class="section-icon">🔧</text>
					<text class="section-text">整改图片 ({{rectificationImages.length}}张)</text>
				</view>
				
				<view class="image-grid">
					<view class="image-item" v-for="(image, index) in rectificationImages" :key="index">
						<image 
							:src="image" 
							mode="aspectFill" 
							class="rectification-image" 
							@click="previewImage(index, rectificationImages)"
						></image>
