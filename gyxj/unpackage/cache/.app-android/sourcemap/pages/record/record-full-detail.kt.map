				</view>
				
				<view class="info-item">
					<text class="info-label">记录ID</text>
					<text class="info-value">{{recordDetail?.id ?? ''}}</text>
				</view>
				
				<view class="info-item">
					<text class="info-label">创建人</text>
					<text class="info-value">{{recordDetail?.createBy ?? ''}}</text>
				</view>
				
				<view class="info-item">
					<text class="info-label">更新人</text>
