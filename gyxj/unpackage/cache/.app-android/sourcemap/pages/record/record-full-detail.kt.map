					<text class="info-value">{{recordDetail?.problemDescription ?? ''}}</text>
				</view>
				
				<view class="info-item">
					<text class="info-label">发生部位</text>
					<text class="info-value">{{recordDetail?.location ?? ''}}</text>
				</view>
				
				<view class="info-item">
					<text class="info-label">创建时间</text>
					<text class="info-value">{{formatDateTime(recordDetail?.createTime)}}</text>
				</view>
				
				<view class="info-item">
					<text class="info-label">更新时间</text>
					<text class="info-value">{{formatDateTime(recordDetail?.updateTime)}}</text>
				</view>
			</view>
			
			<!-- 责任信息 -->
			<view class="section">
				<view class="section-title">
					<text class="section-icon">👥</text>
					<text class="section-text">责任信息</text>
				</view>
				
				<view class="info-item">
					<text class="info-label">责任单位</text>
					<text class="info-value">{{recordDetail?.responsibleUnit ?? ''}}</text>
				</view>
				
				<view class="info-item">
