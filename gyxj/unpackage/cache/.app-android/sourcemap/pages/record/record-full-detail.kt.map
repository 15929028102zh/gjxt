		<view v-else class="error-state">
			<text class="error-text">记录不存在或已被删除</text>
		</view>
	</scroll-view>
</template>

<script lang="uts">
	import { getApiUrl } from '@/config/api.uts'
	
	type InspectionRecordDetail = {
		id: string
		recordNumber: string
		problemDescription: string
		location: string
		responsibleUnit: string
		responsiblePerson: string
		inspectorName: string
		groupLeader: string
		deputyLeader: string
		professionName: string
		reviewerName: string
		departmentName: string
		natureName: string
		problemLevel: number
		assessmentSituation: string
		assessmentAmount: string
		safetyScore: string
		rectificationDeadline: string
		rectificationTime: string
		rectificationEffect: string
		status: number
		createTime: string
		updateTime: string
		createBy: string
		updateBy: string
		problemImages: string
		rectificationImages: string
	}
	
	export default {
		data() {
			return {
				recordDetail: null as InspectionRecordDetail | null,
				loading: false,
				recordId: '',
				scrollTop: 0,
				containerHeight: 0,
				problemImages: [] as string[],
				rectificationImages: [] as string[]
			}
		},
		onLoad(options: OnLoadOptions) {
			this.checkLogin()
			if (options['id'] != null) {
				this.recordId = options['id'] as string
				this.loadRecordDetail()
			}
			
			// 获取系统信息设置容器高度
			const systemInfo = uni.getSystemInfoSync()
			this.containerHeight = systemInfo.windowHeight
		},
		methods: {
			checkLogin() {
				const tokenData = uni.getStorageSync('token')
				const token = tokenData != null ? tokenData as string : ''
				if (token == null || token == '') {
					uni.reLaunch({
						url: '/pages/login/login'
					})
				}
			},
			
			async loadRecordDetail() {
				this.loading = true
				const token = uni.getStorageSync('token')
				
				uni.request({
					url: getApiUrl(`/inspection-record/${this.recordId}`),
					method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
					const responseData = res.data as UTSJSONObject
					if (res.statusCode === 200 && responseData.getNumber('code') === 200) {
						const data = responseData.getJSON('data') as UTSJSONObject
						if (data != null) {
								this.recordDetail = {
									id: data.getString('id') ?? '',
									recordNumber: data.getString('recordNo') ?? '',
									problemDescription: data.getString('problemDescription') ?? '',
									location: data.getString('location') ?? '',
									responsibleUnit: data.getString('responsibleUnit') ?? '',
									responsiblePerson: data.getString('responsiblePerson') ?? '',
									inspectorName: data.getString('inspectorName') ?? data.getString('inspector') ?? '',
									groupLeader: data.getString('groupLeaderName') ?? '',
									deputyLeader: data.getString('deputyLeaderName') ?? '',
									professionName: data.getString('professionName') ?? '',
									reviewerName: data.getString('reviewerName') ?? '',
									departmentName: data.getString('departmentName') ?? '',
									natureName: data.getString('natureDefinition') ?? '',
									problemLevel: data.getNumber('problemLevel') ?? 0,
									assessmentSituation: data.getString('assessmentSituation') ?? '',
									assessmentAmount: data.getString('assessmentAmount') ?? '',
									safetyScore: data.getString('safetyScore') ?? '',
									rectificationDeadline: data.getString('rectificationDeadline') ?? '',
									rectificationTime: data.getString('rectificationTime') ?? '',
									rectificationEffect: data.getString('rectificationEffect') ?? '',
									status: data.getNumber('status') ?? 0,
									createTime: data.getString('createTime') ?? '',
									updateTime: data.getString('updateTime') ?? '',
									createBy: data.getString('createBy') ?? '',
									updateBy: data.getString('updateBy') ?? '',
									problemImages: data.getString('problemImageUrls') ?? '',
									rectificationImages: data.getString('rectificationImageUrls') ?? ''
								}
								
								// 处理图片数据
								this.processProblemImages()
								this.processRectificationImages()
							}
						} else {
							const errorMessage = responseData.getString('message') ?? ''
							uni.showToast({
								title: errorMessage != '' ? errorMessage : '加载失败',
								icon: 'none'
							})
						}
						this.loading = false
					},
					fail: (error) => {
						console.error('加载记录详情失败:', error)
						uni.showToast({
							title: '网络错误',
							icon: 'none'
						})
						this.loading = false
					}
				})
			},
			
			processProblemImages() {
				if (this.recordDetail?.problemImages != null && this.recordDetail.problemImages != '') {
					try {
						const images = JSON.parse(this.recordDetail.problemImages) as string[]
						this.problemImages = images
					} catch (e) {
						console.error('解析问题图片失败:', e)
						this.problemImages = []
					}
				} else {
					this.problemImages = []
				}
			},
			
			processRectificationImages() {
				if (this.recordDetail?.rectificationImages != null && this.recordDetail.rectificationImages != '') {
					try {
						const images = JSON.parse(this.recordDetail.rectificationImages) as string[]
						this.rectificationImages = images
					} catch (e) {
						console.error('解析整改图片失败:', e)
						this.rectificationImages = []
					}
				} else {
					this.rectificationImages = []
				}
			},
			
			getStatusText(status: number | null): string {
				if (status == null) return '未知'
				const statusMap: UTSJSONObject = {
					"0": '待整改',
					"1": '已整改',
					"2": '已复查'
				}
				const statusText = statusMap[status.toString()] as string
				return statusText != null ? statusText : '未知'
			},
			
			getStatusClass(status: number | null): string {
				if (status == null) return 'status-unknown'
				const classMap: UTSJSONObject = {
					"0": 'status-pending',
					"1": 'status-completed',
					"2": 'status-reviewed'
				}
				const statusClass = classMap[status.toString()] as string
				return statusClass != null ? statusClass : 'status-unknown'
			},
			
			getProblemLevelText(level: number | null): string {
				if (level == null) return '未知等级'
				const levelMap: UTSJSONObject = {
					"1": '一般问题',
					"2": '重要问题',
					"3": '严重问题'
				}
				const levelText = levelMap[level.toString()] as string
				return levelText != null ? levelText : '未知等级'
			},
			
			formatDateTime(dateTimeStr: string | null): string {
				if (dateTimeStr == null || dateTimeStr == '') return ''
				return dateTimeStr
			},
			
			previewImage(index: number, images: string[]) {
				uni.previewImage({
					current: index,
					urls: images
				})
			}
		}
	}
</script>

