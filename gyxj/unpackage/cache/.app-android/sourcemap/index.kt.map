<template>
	<scroll-view class="container" scroll-y="true" :scroll-top="scrollTop" :style="{height: containerHeight + 'px'}" enable-back-to-top="true">
		<form>
			<!-- 问题照片 -->
			<view class="form-item">
				<text class="form-label">📷 问题照片 ({{imageList.length}}/3)</text>
				<view class="image-upload">
					<view class="image-list">
						<view class="image-item" v-for="(image, index) in imageList" :key="index">
							<image :src="image" mode="aspectFill" class="uploaded-image" @click="previewImage(index)"></image>
							<view class="image-delete" @click="removeImage(index)">
								<text>×</text>
							</view>
						</view>
						
						<view class="image-add" v-if="imageList.length < 3" @click="chooseImage">
							<text class="add-icon">+</text>
							<text class="add-text">添加照片</text>
						</view>
					</view>
				</view>
			</view>

				<!-- 问题描述 -->
			<view class="form-item">
				<text class="form-label">问题描述</text>
				<view class="form-input-wrapper">
					<textarea 
						v-model="formData.problemDescription"
						class="form-textarea"
						placeholder="请详细描述问题情况..."
						maxlength="500"
						show-confirm-bar="false"
					></textarea>
				</view>
			</view>
			<!-- 责任单位 -->
			<view class="form-item">
				<text class="form-label">责任单位</text>
				<view class="form-input-wrapper">
					<input 
						v-model="formData.responsibleUnit"
						class="form-input"
						placeholder="请输入责任单位"
					/>
				</view>
			</view>
			
			<!-- 责任人 -->
			<view class="form-item">
				<text class="form-label">责任人</text>
				<view class="form-input-wrapper">
					<input 
						v-model="formData.responsiblePerson"
						class="form-input"
						placeholder="请输入责任人姓名"
					/>
				</view>
			</view>
			
			<!-- 性质界定 -->
			<view class="form-item">
				<text class="form-label-left">性质界定</text>
				<view class="custom-picker-full" @click="showNaturePicker" :class="{disabled: natureOptions.length === 0}">
					<text class="picker-text-full" :class="{placeholder: selectedNatureIndex === -1}">
						{{selectedNatureIndex === -1 ? '请选择问题性质' : (selectedNatureIndex < natureOptions.length ? natureOptions[selectedNatureIndex].name : '请选择问题性质')}}
					</text>
				</view>
			</view>
			
			<!-- 性质界定选择弹窗 -->
			<view v-if="showNaturePopup" class="popup-overlay" @click="hideNaturePicker">
				<view class="popup-content" @click.stop>
					<view class="popup-header">
						<text class="popup-title">选择性质界定</text>
						<text class="popup-close" @click="hideNaturePicker">×</text>
					</view>
					<view class="popup-list">
						<view v-for="(item, index) in natureOptions" :key="item.id" class="popup-item" @click="selectNature(index)">
							<text class="popup-item-text">{{item.name}}</text>
							<text v-if="selectedNatureIndex === index" class="popup-item-check">✓</text>
						</view>
					</view>
				</view>
			</view>
			
			<!-- 考核情况 -->
			<view class="form-item">
				<text class="form-label-left">考核情况</text>
				<view class="custom-picker-full" @click="showAssessmentPicker" :class="{disabled: assessmentOptions.length === 0}">
					<text class="picker-text-full" :class="{placeholder: selectedAssessmentIndex === -1}">
						{{selectedAssessmentIndex === -1 ? '请选择考核情况' : (selectedAssessmentIndex < assessmentOptions.length ? assessmentOptions[selectedAssessmentIndex].label : '请选择考核情况')}}
					</text>
				</view>
			</view>
			
			<!-- 考核情况选择弹窗 -->
			<view v-if="showAssessmentPopup" class="popup-overlay" @click="hideAssessmentPicker">
				<view class="popup-content" @click.stop>
					<view class="popup-header">
						<text class="popup-title">选择考核情况</text>
						<text class="popup-close" @click="hideAssessmentPicker">×</text>
					</view>
					<view class="popup-list">
						<view v-for="(item, index) in assessmentOptions" :key="item.id" class="popup-item" @click="selectAssessment(index)">
							<text class="popup-item-text">{{item.label}}</text>
							<text v-if="selectedAssessmentIndex === index" class="popup-item-check">✓</text>
						</view>
					</view>
				</view>
			</view>
			
			<!-- 考核金额 -->
			<view class="form-item">
				<text class="form-label">考核金额</text>
				<view class="form-input-wrapper">
					<input 
						v-model="formData.assessmentAmount"
						class="form-input"
						placeholder="请输入金额"
						type="number"
					/>
					<text class="input-suffix">元</text>
				</view>
			</view>
			
			<!-- 安全积分 -->
			<view class="form-item">
				<text class="form-label">安全记分</text>
				<view class="form-input-wrapper">
					<input 
						v-model="formData.safetyScore"
						class="form-input"
						placeholder="请输入安全记分"
						type="number"
					/>
				</view>
			</view>
			
		
			
			<!-- 专业 -->
			<view class="form-item">
				<text class="form-label-left">专业</text>
				<view class="custom-picker-full" @click="showProfessionPicker" :class="{disabled: professionOptions.length === 0}">
					<text class="picker-text-full" :class="{placeholder: selectedProfessionIndex === -1}">
						{{selectedProfessionIndex === -1 ? '请选择专业' : (selectedProfessionIndex < professionOptions.length ? professionOptions[selectedProfessionIndex].name : '请选择专业')}}
					</text>
				</view>
			</view>
			
			<!-- 专业选择弹窗 -->
			<view v-if="showProfessionPopup" class="popup-overlay" @click="hideProfessionPicker">
				<view class="popup-content" @click.stop>
					<view class="popup-header">
						<text class="popup-title">选择专业</text>
						<text class="popup-close" @click="hideProfessionPicker">×</text>
					</view>
					<view class="popup-list">
						<view v-for="(item, index) in professionOptions" :key="item.id" class="popup-item" @click="selectProfession(index)">
							<text class="popup-item-text">{{item.name}}</text>
							<text v-if="selectedProfessionIndex === index" class="popup-item-check">✓</text>
						</view>
					</view>
				</view>
			</view>
			
		
			
			<!-- 发生部位 -->
			<view class="form-item">
				<text class="form-label">发生部位</text>
				<view class="form-input-wrapper">
					<input 
						v-model="formData.location"
						class="form-input"
						placeholder="请输入发生部位"
					/>
				</view>
			</view>
			
			<!-- 检查人 -->
			<view class="form-item">
				<text class="form-label-left">检查人</text>
				<view class="custom-picker-full" @click="showInspectorPicker" :class="{disabled: inspectorOptions.length === 0}">
					<text class="picker-text-full" :class="{placeholder: selectedInspectorIndex === -1}">
						{{selectedInspectorIndex === -1 ? '请选择检查人' : (selectedInspectorIndex < inspectorOptions.length ? inspectorOptions[selectedInspectorIndex].name : '请选择检查人')}}
					</text>
				</view>
			</view>
			
			<!-- 检查人选择弹窗 -->
			<view v-if="showInspectorPopup" class="popup-overlay" @click="hideInspectorPicker">
				<view class="popup-content" @click.stop>
					<view class="popup-header">
						<text class="popup-title">选择检查人</text>
						<text class="popup-close" @click="hideInspectorPicker">×</text>
					</view>
					<view class="popup-list">
						<view v-for="(item, index) in inspectorOptions" :key="item.id" class="popup-item" @click="selectInspector(index)">
							<text class="popup-item-text">{{item.name}}</text>
							<text v-if="selectedInspectorIndex === index" class="popup-item-check">✓</text>
						</view>
					</view>
				</view>
			</view>
			
			<!-- 检查组组长 -->
			<view class="form-item">
				<text class="form-label">检查组组长</text>
				<view class="form-input-wrapper">
					<input 
						v-model="formData.groupLeader"
						class="form-input"
						placeholder="请输入检查组组长姓名"
					/>
				</view>
			</view>
			
			<!-- 检查组副组长 -->
			<view class="form-item">
				<text class="form-label">检查组副组长</text>
				<view class="form-input-wrapper">
					<input 
						v-model="formData.deputyLeader"
						class="form-input"
						placeholder="请输入检查组副组长姓名"
					/>
				</view>
			</view>
			
			<!-- 所属部门 -->
			<view class="form-item">
				<text class="form-label-left">所属部门</text>
				<view class="custom-picker-full" @click="showDepartmentPicker" :class="{disabled: departmentOptions.length === 0}">
					<text class="picker-text-full" :class="{placeholder: selectedDepartmentIndex === -1}">
						{{selectedDepartmentIndex === -1 ? '请选择所属部门' : (selectedDepartmentIndex < departmentOptions.length ? departmentOptions[selectedDepartmentIndex].name : '请选择所属部门')}}
					</text>
				</view>
			</view>
			
			<!-- 所属部门选择弹窗 -->
			<view v-if="showDepartmentPopup" class="popup-overlay" @click="hideDepartmentPicker">
				<view class="popup-content" @click.stop>
					<view class="popup-header">
						<text class="popup-title">选择所属部门</text>
						<text class="popup-close" @click="hideDepartmentPicker">×</text>
					</view>
					<view class="popup-list">
						<view v-for="(item, index) in departmentOptions" :key="item.id" class="popup-item" @click="selectDepartment(index)">
							<text class="popup-item-text">{{item.name}}</text>
							<text v-if="selectedDepartmentIndex === index" class="popup-item-check">✓</text>
						</view>
					</view>
				</view>
			</view>
			
			<!-- 整改时间 -->
			<view class="form-item">
				<text class="form-label-left">整改时间</text>
				<view class="picker-container" @click="showDatePicker">
					<text class="picker-text-full" :class="{placeholder: formData.rectificationDate === ''}">
						{{formData.rectificationDate !== '' ? formData.rectificationDate : '请选择整改时间'}}
					</text>
				</view>
				<!-- 日期选择器弹窗 -->
				<view v-if="datePickerVisible" class="date-picker-modal" @click="hideDatePicker">
					<view class="date-picker-content" @click.stop>
						<view class="date-picker-header">
							<text class="date-picker-cancel" @click="hideDatePicker">取消</text>
							<text class="date-picker-title">选择日期</text>
							<text class="date-picker-confirm" @click="confirmDatePicker">确定</text>
						</view>
						<picker-view class="date-picker-view" :value="pickerValue" @change="onPickerChange" indicator-style="height: 70px; top: 20%; margin-top: -20px;">
							<picker-view-column>
								<view v-for="(year, index) in years" :key="index" class="picker-item" :class="{selected: index === pickerValue[0]}">
									{{year}}年
								</view>
							</picker-view-column>
							<picker-view-column>
								<view v-for="(month, index) in months" :key="index" class="picker-item" :class="{selected: index === pickerValue[1]}">
									{{month}}月
								</view>
							</picker-view-column>
							<picker-view-column>
								<view v-for="(day, index) in days" :key="index" class="picker-item" :class="{selected: index === pickerValue[2]}">
									{{day}}日
								</view>
								<!-- 添加空白项目，让最后的日期可以滚动到选择区域 -->
								<view v-for="i in 2" :key="'empty-day-' + i" class="picker-item picker-item-spacer"></view>
							</picker-view-column>
						</picker-view>
					</view>
				</view>
			</view>
			
			<!-- 提交按钮 -->
			<view class="submit-section">
				<button class="submit-btn" type="button" :disabled="submitting" @click="submitRecord">
					<text>{{submitting ? '提交中...' : '提交检查'}}</text>
				</button>
			</view>
		</form>
	</scroll-view>
</template>

<script lang="uts">
	import { getApiUrl, apiConfig } from '@/config/api.uts'
	// import CalendarPicker from '@/components/CalendarPicker.uvue'
	
	type NatureOption = {
		id: string
		name: string
	}
	
	type AssessmentOption = {
		id: string
		label: string
		value: string
	}
	
	type ProfessionOption = {
		id: string
		name: string
	}
	
	type DepartmentOption = {
		id: string
		name: string
	}
	
	type InspectorOption = {
		id: string
		name: string
	}
	

	type RecordFormData = {
		responsibleUnit: string
		responsiblePerson: string
		natureId: string
		scoreId: string
		assessmentAmount: string
		safetyScore: string
		professionId: string
		problemDescription: string
		location: string
		inspector: string
		groupLeader: string
		deputyLeader: string
		departmentId: string
		rectificationDate: string
	}
	
	export default {
		components: {
			// CalendarPicker
		},
		data(): {
			formData: RecordFormData
			natureOptions: NatureOption[]
			assessmentOptions: AssessmentOption[]
			professionOptions: ProfessionOption[]
			departmentOptions: DepartmentOption[]
			selectedNatureIndex: number
			selectedAssessmentIndex: number
			selectedProfessionIndex: number
			selectedDepartmentIndex: number
			selectedInspectorIndex: number
			showNaturePopup: boolean
			showAssessmentPopup: boolean
			showProfessionPopup: boolean
			showInspectorPopup: boolean
			showDepartmentPopup: boolean
			showDatePopup: boolean
			tempDate: string
			imageList: string[]
			submitting: boolean
			scrollTop: number
			containerHeight: number
			inspectorOptions: InspectorOption[]
			datePickerVisible: boolean
			pickerValue: number[]
			years: number[]
			months: number[]
			days: number[]
			selectedYear: number
			selectedMonth: number
			selectedDay: number

		} {
			// 计算默认整改时间（当前日期往后推三天）
			const defaultDate = new Date()
			defaultDate.setDate(defaultDate.getDate() + 3)
			const defaultDateStr = `${defaultDate.getFullYear()}-${(defaultDate.getMonth() + 1).toString().padStart(2, '0')}-${defaultDate.getDate().toString().padStart(2, '0')}`
			
			return {
				formData: {
				responsibleUnit: '',
				responsiblePerson: '',
				natureId: '',
				scoreId: '',
				assessmentAmount: '',
				safetyScore: '',
				professionId: '',
				problemDescription: '',
				location: '',
				inspector: '',
				groupLeader: '',
				deputyLeader: '',
				departmentId: '',
				rectificationDate: defaultDateStr
			} as RecordFormData,
			natureOptions: [] as NatureOption[],
			assessmentOptions: [
				{id: '1', label: '提出警告', value: '提出警告'},
				{id: '2', label: '-50', value: '-50'},
				{id: '3', label: '-100', value: '-100'},
				{id: '4', label: '-200', value: '-200'},
				{id: '5', label: '-300', value: '-300'}
			] as AssessmentOption[],
			professionOptions: [] as ProfessionOption[],
			departmentOptions: [] as DepartmentOption[],
			inspectorOptions: [] as InspectorOption[],
			selectedNatureIndex: -1,
			selectedAssessmentIndex: -1,
			selectedProfessionIndex: -1,
			selectedDepartmentIndex: -1,
			selectedInspectorIndex: -1,
			showNaturePopup: false,
			showAssessmentPopup: false,
			showProfessionPopup: false,
			showInspectorPopup: false,
			showDepartmentPopup: false,
			showDatePopup: false,
			tempDate: '',
			imageList: [] as string[],
			choosingImage: false,
			submitting: false,
			scrollTop: 0,
			containerHeight: 0,
			datePickerVisible: false,
			pickerValue: [0, 0, 0],
			years: [] as number[],
			months: [] as number[],
			days: [] as number[],
			selectedYear: (() => {
				const tempDate = new Date()
				tempDate.setDate(tempDate.getDate() + 3)
				return tempDate.getFullYear()
			})() as number,
			selectedMonth: (() => {
				const tempDate = new Date()
				tempDate.setDate(tempDate.getDate() + 3)
				return tempDate.getMonth() + 1
			})() as number,
			selectedDay: (() => {
				const tempDate = new Date()
				tempDate.setDate(tempDate.getDate() + 3)
				return tempDate.getDate()
			})() as number,
			// 防抖定时器
			pickerDebounceTimer: null as number | null
			}
		},
		onLoad(options: UTSJSONObject) {
			this.checkLogin()
			this.loadNatureOptions()
			this.loadProfessionOptions()
			this.loadDepartments()
			this.loadInspectorOptions()
			this.initDateArrays()
			// setCurrentUserAsInspector 将在 loadInspectorOptions 成功后调用
		},
		onReady() {
			this.initContainerHeight()
		},
		methods: {
			checkLogin() {
				const token = uni.getStorageSync('token')
				if (token == null || token == '') {
					uni.reLaunch({
						url: '/pages/login/login'
					})
				}
			},
			
			// 初始化容器高度
			initContainerHeight() {
				uni.getSystemInfo({
					success: (res) => {
						this.containerHeight = res.windowHeight
					}
				})
			},
			
			loadNatureOptions() {
				// 从API获取性质界定数据
				const token = uni.getStorageSync('token')
				uni.request({
				url: getApiUrl('/dictionary/type/性质界定'),
					method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`,
						'Content-Type': 'application/json'
					},
					success: (res) => {
					const data = res.data as UTSJSONObject
					const code = data.getNumber('code')
					if (res.statusCode === 200 && code === 200) {
						// 将API返回的字典数据转换为选择器需要的格式
						// 使用dictValue作为显示值，id作为实际值
						const dataArray = data.getArray('data')
						if (dataArray != null) {
							this.natureOptions = []
							for (let i = 0; i < dataArray.length; i++) {
								const item = dataArray[i] as UTSJSONObject
								const id = item.getString('id') ?? ''
								const dictValue = item.getString('dictValue') ?? ''
								const dictLabel = item.getString('dictLabel') ?? ''
								const name = dictValue !== '' ? dictValue : dictLabel
								this.natureOptions.push({ id: id, name: name })
							}
						}
						console.log('性质界定数据加载成功:', this.natureOptions)
						} else {
						const message = data.getString('message') ?? '未知错误'
						console.error('获取性质界定数据失败:', message)
							// 使用默认数据作为备选
							this.natureOptions = [
								{ id: '1', name: '一般问题' },
								{ id: '2', name: '较大问题' },
								{ id: '3', name: '严重问题' },
								{ id: '4', name: '重大问题' }
							]
						}
					},
					fail: (error) => {
						console.error('请求性质界定数据失败:', error)
						// 使用默认数据作为备选
						this.natureOptions = [
							{ id: '1', name: '一般问题' },
							{ id: '2', name: '较大问题' },
							{ id: '3', name: '严重问题' },
							{ id: '4', name: '重大问题' }
						]
					}
				})
			},
		

		loadProfessionOptions() {
			// 从API获取专业数据
			const token = uni.getStorageSync('token')
			uni.request({
				url: getApiUrl('/dictionary/type/专业'),
				method: 'GET',
				header: {
					'Authorization': `Bearer ${token}`,
					'Content-Type': 'application/json'
				},
				success: (res) => {
					const data = res.data as UTSJSONObject
					const code = data.getNumber('code')
					if (res.statusCode === 200 && code === 200) {
						// 将API返回的字典数据转换为选择器需要的格式
						// 使用dictValue作为显示值，id作为实际值
						const dataArray = data.getArray('data')
						if (dataArray != null) {
							this.professionOptions = []
							for (let i = 0; i < dataArray.length; i++) {
								const item = dataArray[i] as UTSJSONObject
								const id = item.getString('id') ?? ''
								const dictValue = item.getString('dictValue') ?? ''
								const dictLabel = item.getString('dictLabel') ?? ''
								const name = dictValue !== '' ? dictValue : dictLabel
								this.professionOptions.push({ id: id, name: name })
							}
						}
						console.log('专业数据加载成功:', this.professionOptions)
					} else {
						const message = data.getString('message') ?? '未知错误'
						console.error('获取专业数据失败:', message)
						// 使用默认数据作为备选
						this.professionOptions = [
							{ id: '1', name: '机械' },
							{ id: '2', name: '电气' },
							{ id: '3', name: '仪表' },
							{ id: '4', name: '工艺' },
							{ id: '5', name: '安全' },
							{ id: '6', name: '环保' }
						]
					}
				},
				fail: (error) => {
					console.error('请求专业数据失败:', error)
					// 使用默认数据作为备选
					this.professionOptions = [
						{ id: '1', name: '机械' },
						{ id: '2', name: '电气' },
						{ id: '3', name: '仪表' },
						{ id: '4', name: '工艺' },
						{ id: '5', name: '安全' },
						{ id: '6', name: '环保' }
					]
				}
			})
		},
		
		// 加载检查人选项
		loadInspectorOptions() {
			const token = uni.getStorageSync('token')
			if (token == null || token == '') {
				console.error('未找到token')
				return
			}
			
			// 获取当前用户信息以确定部门
			const userInfoStr = uni.getStorageSync('userInfo') as string
			if (userInfoStr == null || userInfoStr == '') {
				console.error('未找到用户信息')
				return
			}
			
			const userInfo = JSON.parse(userInfoStr) as UTSJSONObject
			
			// 获取当前用户的部门信息
			console.log('当前用户信息:', userInfo)
			let deptId = userInfo.getString('deptId') ?? userInfo.getString('dept_id') ?? ''
			if (deptId === '') {
				// 如果字符串获取失败，尝试数字类型
				const deptIdNum = userInfo.getNumber('deptId') ?? userInfo.getNumber('dept_id')
				if (deptIdNum != null) {
					deptId = deptIdNum.toString()
				}
			}
			console.log('用户部门ID:', deptId)
			
			if (deptId == '') {
				console.warn('当前用户没有部门信息，将获取所有用户')
				// 如果没有部门信息，调用获取所有用户的接口
				uni.request({
					url: getApiUrl('/user/page?current=1&size=100'),
					method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
						const response = res.data as UTSJSONObject
						if (res.statusCode == 200 && (response.getNumber('code') ?? 0) == 200) {
							const data = response.getJSON('data') as UTSJSONObject
							const records = data.getArray('records')
							if (records != null) {
								this.inspectorOptions = []
								for (let i = 0; i < records.length; i++) {
									const item = records[i] as UTSJSONObject
									const id = item.getString('id') ?? ''
									const realName = item.getString('realName') ?? ''
									if (id != '' && realName != '') {
										this.inspectorOptions.push({ id: id, name: realName } as InspectorOption)
									}
								}
							}
						console.log('所有用户数据加载成功:', this.inspectorOptions)
						// 数据加载完成后设置当前用户为默认检查人
						this.setCurrentUserAsInspector()
					} else {
						const message = response.getString('message') ?? '未知错误'
						console.error('获取用户列表失败:', message)
						// 使用默认数据作为备选
						this.inspectorOptions = [
							{ id: '1', name: '张三' } as InspectorOption,
							{ id: '2', name: '李四' } as InspectorOption,
							{ id: '3', name: '王五' } as InspectorOption,
							{ id: '4', name: '赵六' } as InspectorOption
						]
						// 使用默认数据后也设置当前用户
						this.setCurrentUserAsInspector()
					}
					},
					fail: (error) => {
					console.error('请求用户列表失败:', error)
					// 使用默认数据作为备选
					this.inspectorOptions = [
						{ id: '1', name: '张三' } as InspectorOption,
						{ id: '2', name: '李四' } as InspectorOption,
						{ id: '3', name: '王五' } as InspectorOption,
						{ id: '4', name: '赵六' } as InspectorOption
					]
					// 使用默认数据后也设置当前用户
					this.setCurrentUserAsInspector()
				}
				})
				return
			}
			
			// 从后台API按部门ID获取用户列表
			uni.request({
				url: getApiUrl(`/user/by-department?deptId=${encodeURIComponent(deptId)}`),
				method: 'GET',
				header: {
					'Authorization': `Bearer ${token}`
				},
				success: (res) => {
					const response = res.data as UTSJSONObject
					if (res.statusCode == 200 && (response.getNumber('code') ?? 0) == 200) {
						const data = response.getArray('data')
						if (data != null) {
							this.inspectorOptions = []
							for (let i = 0; i < data.length; i++) {
								const item = data[i] as UTSJSONObject
								const id = item.getString('id') ?? ''
								const realName = item.getString('realName') ?? ''
								if (id != '' && realName != '') {
									this.inspectorOptions.push({ id: id, name: realName } as InspectorOption)
								}
							}
						}
					console.log(`部门ID${deptId}的检查人数据加载成功:`, this.inspectorOptions)
					// 数据加载完成后设置当前用户为默认检查人
					this.setCurrentUserAsInspector()
				} else {
					const message = response.getString('message') ?? '未知错误'
					console.error('获取部门用户列表失败:', message)
					// 使用默认数据作为备选
					this.inspectorOptions = [
						{ id: '1', name: '张三' } as InspectorOption,
						{ id: '2', name: '李四' } as InspectorOption,
						{ id: '3', name: '王五' } as InspectorOption,
						{ id: '4', name: '赵六' } as InspectorOption
					]
					// 使用默认数据后也设置当前用户
					this.setCurrentUserAsInspector()
				}
				},
				fail: (error) => {
				console.error('请求部门用户列表失败:', error)
				// 使用默认数据作为备选
				this.inspectorOptions = [
					{ id: '1', name: '张三' } as InspectorOption,
					{ id: '2', name: '李四' } as InspectorOption,
					{ id: '3', name: '王五' } as InspectorOption,
					{ id: '4', name: '赵六' } as InspectorOption
				]
				// 使用默认数据后也设置当前用户
