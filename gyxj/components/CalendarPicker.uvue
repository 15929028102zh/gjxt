间\"\n                    v-model=\"queryParam.startTime\"\n                  ></j-date>\n                </a-form-item>\n              </a-col>\n              <a-col :xl=\"6\" :lg=\"7\" :md=\"8\" :sm=\"24\">\n                <a-form-item label=\"结束时间\">\n                  <j-date\n                    :show-time=\"true\"\n                    date-format=\"YYYY-MM-DD HH:mm:ss\"\n                    placeholder=\"请选择结束时间\"\n                    v-model=\"queryParam.endTime\"\n                  ></j-date>\n                </a-form-item>\n              </a-col>\n            <template v-if=\"toggleSearchStatus\">\n              <a-col :xl=\"6\" :lg=\"7\" :md=\"8\" :sm=\"24\">\n                <a-form-item label=\"状态\">\n                  <j-dict-select-tag placeholder=\"请选择状态\" v-model=\"queryParam.code\" dictCode=\"applyStatus\" />\n                </a-form-item>\n              </a-col>\n              <a-col :xl=\"6\" :lg=\"7\" :md=\"8\" :sm=\"24\">\n                <a-form-item label=\"提交人\">\n                  <a-input placeholder=\"请输入提交人\" v-model=\"queryParam.assgin\"></a-input>\n                </a-form-item>\n              </a-col>\n            </template>\n            <a-col :xl=\"6\" :lg=\"7\" :md=\"8\" :sm=\"24\">\n              <span style=\"float: left;overflow: hidden;\" class=\"table-page-search-submitButtons\">\n                <a-button type=\"primary\" @click=\"searchQuery\" icon=\"search\">查询</a-button>\n                <a-button type=\"primary\" @click=\"searchReset\" icon=\"reload\" style=\"margin-left: 8px\">重置</a-button>\n                <a @click=\"handleToggleSearch\" style=\"margin-left: 8px\">\n                  {{ toggleSearchStatus ? '收起' : '展开' }}\n                  <a-icon :type=\"toggleSearchStatus ? 'up' : 'down'\" />\n                </a>\n              </span>\n            </a-col>\n          </a-row>\n        </a-form>\n      </div>\n      <!-- 查询区域-END -->\n      <j-modal\n        title=\"驳回申请\"\n        width=\"700px\"\n        :visible=\"sqvisible\"\n        switchFullscreen\n        @ok=\"handleApplRefuse()\"\n        @cancel=\"sqvisible = false\"\n        cancelText=\"关闭\"\n      >\n        <!-- <psu-instructioninfo-form ref=\"realForm\" @ok=\"submitCallback\" :disabled=\"disableSubmit\"></psu-instructioninfo-form> -->\n        <!-- <DvtnChart></DvtnChart> -->\n        <a-textarea\n          :auto-size=\"{ minRows: 5, maxRows: 20 }\"\n          v-model=\"minsReason\"\n          placeholder=\"填写驳回原因\"\n        ></a-textarea>\n        <!-- <a-form-item label=\"附件\">\n          <j-upload v-model=\"otherFile\" :trigger-change=\"true\"></j-upload>\n        </a-form-item> -->\n      </j-modal>\n      <!-- 操作按钮区域 -->\n      <div class=\"table-operator\">\n        <a-button @click=\"handleApplyAgree\" v-if=\"selectedRowKeys.length > 0\" type=\"primary\" icon=\"plus\"\n          >批准</a-button\n        >\n        <a-button @click=\"sqvisible = true\" v-if=\"selectedRowKeys.length > 0\" type=\"primary\" icon=\"plus\"\n          >驳回</a-button\n        >\n        <!-- <a-button @click=\"handleAdd\" type=\"primary\" icon=\"plus\">新增</a-button>\n    <a-button type=\"primary\" icon=\"download\" @click=\"handleExportXls('偏差剔除管理')\">导出</a-button>\n    <a-upload name=\"file\" :showUploadList=\"false\" :multiple=\"false\" :headers=\"tokenHeader\" :action=\"importExcelUrl\" @change=\"handleImportExcel\">\n      <a-button type=\"primary\" icon=\"import\">导入</a-button>\n    </a-upload> -->\n        <!-- 高级查询区域 -->\n        <j-super-query\n          :fieldList=\"superFieldList\"\n          ref=\"superQueryModal\"\n          @handleSuperQuery=\"handleSuperQuery\"\n        ></j-super-query>\n        <a-dropdown v-if=\"selectedRowKeys.length > 0\">\n          <a-menu slot=\"overlay\">\n            <a-menu-item key=\"1\" @click=\"batchDel\"><a-icon type=\"delete\" />删除</a-menu-item>\n          </a-menu>\n          <a-button style=\"margin-left: 8px\"> 批量操作 <a-icon type=\"down\"/></a-button>\n        </a-dropdown>\n      </div>\n\n      <!-- table区域-begin -->\n      <div>\n        <div class=\"ant-alert ant-alert-info\" style=\"margin-bottom: 16px;\">\n          <i class=\"anticon anticon-info-circle ant-alert-icon\"></i> 已选择\n          <a style=\"font-weight: 600\">{{ selectedRowKeys.length }}</a\n          >项\n          <a style=\"margin-left: 24px\" @click=\"onClearSelected\">清空</a>\n        </div>\n\n        <a-table\n          ref=\"table\"\n          size=\"middle\"\n          :scroll=\"{ x: true }\"\n          bordered\n          rowKey=\"id\"\n          :columns=\"columns\"\n          :dataSource=\"dataSource\"\n          :pagination=\"ipagination\"\n          :loading=\"loading\"\n          :rowSelection=\"{ selectedRowKeys: selectedRowKeys, onChange: onSelectChange }\"\n          class=\"j-table-force-nowrap\"\n          @change=\"handleTableChange\"\n        >\n          <template slot=\"htmlSlot\" slot-scope=\"text\">\n            <div v-html=\"text\"></div>\n          </template>\n          <!-- <template slot=\"coledit\" slot-scope=\"record\">\n        \n      </template> -->\n          <template slot=\"imgSlot\" slot-scope=\"text\">\n            <span v-if=\"!text\" style=\"font-size: 12px;font-style: italic;\">无图片</span>\n            <img\n              v-else\n              :src=\"getImgView(text)\"\n              height=\"25px\"\n              alt=\"\"\n              style=\"max-width:80px;font-size: 12px;font-style: italic;\"\n            />\n          </template>\n          <template slot=\"fileSlot\" slot-scope=\"text\">\n            <span v-if=\"!text\" style=\"font-size: 12px;font-style: italic;\">无文件</span>\n            <a-button v-else :ghost=\"true\" type=\"primary\" icon=\"download\" size=\"small\" @click=\"downloadFile(text)\">\n              下载\n            </a-button>\n          </template>\n          <span slot=\"colEdit\" slot-scope=\"text, record\">\n            <span\n              v-if=\"text == '' || text == null || (record.code != 'FINISHED' && record.code != 'ABORT')\"\n            >\n              <a-input placeholder=\"请填写原因\" @keyup.enter=\"e => colEdit(e.target.value, record)\"></a-input\n            ></span>\n            <span v-else>{{ text }}</span>\n          </span>\n          <span slot=\"action\" slot-scope=\"text, record\">\n            <a @click=\"handleDetail(record)\">详情</a>\n            <div v-if=\"record.code != 'FINISHED' && record.code != 'ABORT'\">\n              <a-divider type=\"vertical\" />\n              <a @click=\"handleApplyAgree(record)\">批准</a>\n              <a-divider type=\"vertical\" />\n              <a @click=\"handleEdit(record)\">驳回</a>\n            </div>\n          </span>\n          <!-- <span slot=\"action\" slot-scope=\"text, record\">\n             <a @click=\"handleDetail(record)\">详情</a>\n        <a @click=\"handleEdit(record)\">编辑</a>\n\n        <a-divider type=\"vertical\" />\n        <a-dropdown>\n          <a class=\"ant-dropdown-link\">更多 <a-icon type=\"down\" /></a>\n          <a-menu slot=\"overlay\">\n            <a-menu-item>\n              <a @click=\"handleDetail(record)\">详情</a>\n            </a-menu-item>\n            <a-menu-item>\n              <a-popconfirm title=\"确定删除吗?\" @confirm=\"() => handleDelete(record.id)\">\n                <a>删除</a>\n              </a-popconfirm>\n            </a-menu-item>\n          </a-menu>\n        </a-dropdown>\n      </span> -->\n        </a-table>\n      </div>\n\n      <phdapp-trgt-apply-modal ref=\"modalForm\" @ok=\"modalFormOk\"></phdapp-trgt-apply-modal>\n    </a-card>\n  </a-col>\n</a-row>\n",null]}␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀