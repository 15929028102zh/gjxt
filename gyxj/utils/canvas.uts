/**
 * UniAppX Canvas 工具类
 * 处理 UniAppX 环境下的 canvas 上下文获取
 */
export function getContext(canvas: any) {
  // UniAppX 中获取 2D 上下文的方式
  const context = canvas.getContext('2d')
  
  // 适配 ECharts 需要的 canvas 接口
  const canvasProxy = {
    getContext: () => context,
    width: canvas.width,
    height: canvas.height,
    style: {
      width: canvas.width + 'px',
      height: canvas.height + 'px'
    },
    addEventListener: () => {},
    removeEventListener: () => {},
    dispatchEvent: () => {}
  }
  
  return canvasProxy
}

// 处理尺寸转换
export function px2rpx(px: number): number {
  const sysInfo = uni.getSystemInfoSync()
  return px * (750 / sysInfo.screenWidth)
}
    