<template>
	<scroll-view class="container" scroll-y="true" :scroll-top="scrollTop" :style="{height: containerHeight + 'px'}" enable-back-to-top="true">
		<view v-if="loading" class="loading-state">
			<text class="loading-text">加载中...</text>
		</view>
		
		<view v-else-if="recordDetail" class="detail-content">
			<!-- 状态标题 -->
			<view class="status-header">
				<text class="page-title">{{isDelayed ? '延迟整改录入' : '问题详情'}}</text>
				<view class="record-status" :class="getStatusClass(recordDetail?.status ?? 0)">
					<text>{{isDelayed ? '延迟整改' : getStatusText(recordDetail?.status ?? 0)}}</text>
				</view>
			</view>
			
			<!-- 问题照片 -->
			<view class="form-item" v-if="imageList.length > 0">
				<text class="form-label">📷 问题照片 ({{imageList.length}}张)</text>
				<view class="image-upload">
					<view class="image-list">
						<view class="image-item" v-for="(image, index) in imageList" :key="index">
							<image 
								:src="image" 
								mode="aspectFill" 
								class="uploaded-image" 
								@click="previewImage(index)"
								@error="onImageError"
								@load="onImageLoad"
							></image>
						</view>
					</view>
				</view>
			</view>
			
		
			
			<!-- 问题描述 -->
			<view class="form-item">
				<text class="form-label">问题描述</text>
				<view class="form-input-wrapper">
					<view class="form-display-text">{{recordDetail?.problemDescription ?? ''}}</view>
				</view>
			</view>
			
			<!-- 责任单位 -->
			<view class="form-item">
				<text class="form-label">责任单位</text>
				<view class="form-input-wrapper">
					<view class="form-display-text">{{recordDetail?.responsibleUnit ?? ''}}</view>
				</view>
			</view>
			
			<!-- 责任人 -->
			<view class="form-item">
				<text class="form-label">责任人</text>
				<view class="form-input-wrapper">
					<view class="form-display-text">{{recordDetail?.responsiblePerson ?? ''}}</view>
				</view>
			</view>
			
			<!-- 性质界定 -->
			<view class="form-item">
				<text class="form-label">性质界定</text>
				<view class="custom-picker-full" @click="showNaturePicker" :class="{disabled: natureOptions.length === 0}">
					<text class="picker-text-full" :class="{placeholder: selectedNatureIndex === -1}">
						{{selectedNatureIndex === -1 ? '请选择问题性质' : (selectedNatureIndex < natureOptions.length ? natureOptions[selectedNatureIndex].name : '请选择问题性质')}}
					</text>
				</view>
			</view>
			
			<!-- 性质界定选择弹窗 -->
			<view v-if="showNaturePopup" class="popup-overlay" @click="hideNaturePicker">
				<view class="popup-content" @click.stop>
					<view class="popup-header">
						<text class="popup-title">选择性质界定</text>
						<text class="popup-close" @click="hideNaturePicker">×</text>
					</view>
					<view class="popup-list">
						<view v-for="(item, index) in natureOptions" :key="item.id" class="popup-item" @click="selectNature(index)">
							<text class="popup-item-text">{{item.name}}</text>
							<text v-if="selectedNatureIndex === index" class="popup-item-check">✓</text>
						</view>
					</view>
				</view>
			</view>
			
			<!-- 考核情况 -->
			<view class="form-item">
				<text class="form-label">考核情况</text>
				<view class="form-input-wrapper">
					<view class="form-display-text">{{recordDetail?.assessmentSituation ?? ''}}</view>
				</view>
			</view>
			
			<!-- 考核金额 -->
			<view class="form-item">
				<text class="form-label">考核金额</text>
				<view class="form-input-wrapper">
					<view class="form-display-text">{{recordDetail?.assessmentAmount ?? ''}}元</view>
				</view>
			</view>
			
			<!-- 安全记分 -->
			<view class="form-item">
				<text class="form-label">安全记分</text>
				<view class="form-input-wrapper">
					<view class="form-display-text">{{recordDetail?.safetyScore ?? ''}}</view>
				</view>
			</view>
			
			<!-- 专业 -->
			<view class="form-item">
				<text class="form-label">专业</text>
				<view class="custom-picker-full" @click="showProfessionPicker" :class="{disabled: professionOptions.length === 0}">
					<text class="picker-text-full" :class="{placeholder: selectedProfessionIndex === -1}">
						{{selectedProfessionIndex === -1 ? '请选择专业' : (selectedProfessionIndex < professionOptions.length ? professionOptions[selectedProfessionIndex].name : '请选择专业')}}
					</text>
				</view>
			</view>
			
			<!-- 专业选择弹窗 -->
			<view v-if="showProfessionPopup" class="popup-overlay" @click="hideProfessionPicker">
				<view class="popup-content" @click.stop>
					<view class="popup-header">
						<text class="popup-title">选择专业</text>
						<text class="popup-close" @click="hideProfessionPicker">×</text>
					</view>
					<view class="popup-list">
						<view v-for="(item, index) in professionOptions" :key="item.id" class="popup-item" @click="selectProfession(index)">
							<text class="popup-item-text">{{item.name}}</text>
							<text v-if="selectedProfessionIndex === index" class="popup-item-check">✓</text>
						</view>
					</view>
				</view>
			</view>
			
			<!-- 发生部位 -->
			<view class="form-item">
				<text class="form-label">发生部位</text>
				<view class="form-input-wrapper">
					<view class="form-display-text">{{recordDetail?.location ?? ''}}</view>
				</view>
			</view>
			
			<!-- 检查人 -->
			<view class="form-item">
				<text class="form-label">检查人</text>
				<view class="form-input-wrapper">
					<view class="form-display-text">{{recordDetail?.inspector ?? ''}}</view>
				</view>
			</view>
			
			<!-- 检查组组长 -->
			<view class="form-item">
				<text class="form-label">检查组组长</text>
				<view class="form-input-wrapper">
					<view class="form-display-text">{{recordDetail?.groupLeader ?? ''}}</view>
				</view>
			</view>
			
			<!-- 检查组副组长 -->
			<view class="form-item">
				<text class="form-label">检查组副组长</text>
				<view class="form-input-wrapper">
					<view class="form-display-text">{{recordDetail?.deputyLeader ?? ''}}</view>
				</view>
			</view>
			
			<!-- 所属部门 -->
			<view class="form-item">
				<text class="form-label">所属部门</text>
				<view class="custom-picker-full" @click="showDepartmentPicker" :class="{disabled: departmentOptions.length === 0}">
					<text class="picker-text-full" :class="{placeholder: selectedDepartmentIndex === -1}">
						{{selectedDepartmentIndex === -1 ? '请选择所属部门' : (selectedDepartmentIndex < departmentOptions.length ? departmentOptions[selectedDepartmentIndex].name : '请选择所属部门')}}
					</text>
				</view>
			</view>
			
			<!-- 所属部门选择弹窗 -->
			<view v-if="showDepartmentPopup" class="popup-overlay" @click="hideDepartmentPicker">
				<view class="popup-content" @click.stop>
					<view class="popup-header">
						<text class="popup-title">选择所属部门</text>
						<text class="popup-close" @click="hideDepartmentPicker">×</text>
					</view>
					<view class="popup-list">
						<view v-for="(item, index) in departmentOptions" :key="item.id" class="popup-item" @click="selectDepartment(index)">
							<text class="popup-item-text">{{item.name}}</text>
							<text v-if="selectedDepartmentIndex === index" class="popup-item-check">✓</text>
						</view>
					</view>
				</view>
			</view>
			
			<!-- 整改期限 -->
			<view class="form-item">
				<text class="form-label">整改期限</text>
				<view class="form-input-wrapper">
					<view class="form-display-text">{{formatDate(recordDetail?.rectificationDate) ?? ''}}</view>
				</view>
			</view>
			
			<!-- 整改效果描述 -->
			<view class="form-item">
				<text class="form-label">整改效果描述</text>
				<view class="form-input-wrapper">
					<textarea 
						v-model="rectificationEffect"
						class="form-textarea"
						placeholder="请描述整改效果..."
						maxlength="500"
						show-confirm-bar="false"
					></textarea>
				</view>
			</view>
			
			<!-- 整改状态 -->
			<view class="form-item">
				<text class="form-label">📋 整改状态</text>
				<view class="status-selector">
					<view class="status-option pending" :class="{active: rectificationStatus === 0}" @click="setRectificationStatus(0)">
						⏳ 未整改
					</view>
					<view class="status-option completed" :class="{active: rectificationStatus === 1}" @click="setRectificationStatus(1)">
						✅ 已整改
					</view>
				</view>
			</view>
			
			<!-- 整改图片 -->
			<view class="form-item">
				<text class="form-label">📷 整改图片 ({{rectificationImages.length}}/3)</text>
				<view class="image-upload">
					<view class="image-list">
						<view class="image-item" v-for="(image, index) in rectificationImages" :key="index">
							<image 
								:src="image" 
								mode="aspectFill" 
								class="uploaded-image" 
								@click="previewRectificationImage(index)"
								@error="onImageError"
								@load="onImageLoad"
							></image>
							<view class="image-delete" @click="removeRectificationImage(index)">
								<text>×</text>
							</view>
						</view>
						
						<view class="image-add" v-if="rectificationImages.length < 3" @click="chooseRectificationImage">
							<text class="add-icon">+</text>
							<text class="add-text">添加图片</text>
						</view>
					</view>
				</view>
			</view>
			
			
			<!-- 保存整改信息按钮 -->
			<view class="save-button-wrapper">
				<button class="save-btn" @click="saveRectificationInfo" :disabled="saving">
					{{saving ? (isDelayed ? '确认中...' : '保存中...') : (isDelayed ? '确认整改' : '保存整改信息')}}
				</button>
			</view>
		</view>
		
		<view v-else class="error-state">
			<text class="error-text">记录不存在或已被删除</text>
		</view>
	</scroll-view>
</template>

<script lang="uts">
	import { getApiUrl, apiConfig } from '@/config/api.uts'
	
	type NatureOption = {
		id: string
		name: string
	}
	
	type ProfessionOption = {
		id: string
		name: string
	}
	
	type DepartmentOption = {
		id: string
		name: string
	}
	
	type RecordDetail = {
		id: string
		problemDescription: string
		responsibleUnit: string
		responsiblePerson: string
		natureId: string  // 修改为string类型，但会从 natureName 字段映射
		natureName: string
		assessmentSituation: string
		assessmentAmount: number
		safetyScore: number
		professionId: string  // 修改为string类型
		professionName: string
		location: string
		inspector: string
		groupLeader: string
		deputyLeader: string
		departmentId: string  // 修改为string类型
		departmentName: string
		rectificationDate: string
		status: number
		createTime: string
		updateTime: string
		problemImageUrls: string
		locationName: string
		severity: number
		taskName: string
		reporterName: string
		suggestions: string
		reporterId: string
		rectificationEffect: string
		rectificationImageUrls: string
		rectificationTime: string
	}

	export default {
		data() {
			return {
				recordId: '',
				recordDetail: null as RecordDetail | null,
				imageList: [] as Array<string>,
				loading: true,
				canOperate: false,
				rectificationEffect: '',
				rectificationImages: [] as Array<string>,
				rectificationStatus: 0,
				saving: false,
				scrollTop: 0,
				containerHeight: 0,
				isDelayed: false, // 是否为延迟整改模式
				// 下拉选择框相关数据
				natureOptions: [] as NatureOption[],
				professionOptions: [] as ProfessionOption[],
				departmentOptions: [] as DepartmentOption[],
				selectedNatureIndex: -1,
				selectedProfessionIndex: -1,
				selectedDepartmentIndex: -1,
				showNaturePopup: false,
				showProfessionPopup: false,
				showDepartmentPopup: false,
			// 数据加载状态跟踪
			loadedDataCount: 0,
			totalDataCount: 4 // 总共需要加载4类数据
		}
	},
		onLoad(options: UTSJSONObject) {
			this.recordId = options.getString('id') ?? ''
			this.isDelayed = options.getString('delayed') === 'true' // 检查是否为延迟整改模式
			this.checkLogin()
			// 重置数据加载计数器
			this.loadedDataCount = 0
			// 并发加载所有数据
			this.loadRecordDetail()
			this.loadNatureOptions()
			this.loadProfessionOptions()
			this.loadDepartments()
		},
		onReady() {
			this.initContainerHeight()
		},
		methods: {
			checkLogin() {
				const token = uni.getStorageSync('token')
				if (token == null || token == '') {
					uni.reLaunch({
						url: '/pages/login/login'
					})
				}
			},
			
			// 初始化容器高度
			initContainerHeight() {
				uni.getSystemInfo({
					success: (res) => {
						this.containerHeight = res.windowHeight
					}
				})
			},
			
			// 检查所有数据是否加载完成
			checkAllDataLoaded() {
				this.loadedDataCount++
				console.log(`数据加载进度: ${this.loadedDataCount}/${this.totalDataCount}`)
				
				if (this.loadedDataCount >= this.totalDataCount) {
					console.log('所有数据加载完成，开始回写选中值')
					console.log('当前数据状态:', {
						recordDetail: this.recordDetail,
						natureOptionsLength: this.natureOptions.length,
						professionOptionsLength: this.professionOptions.length,
						departmentOptionsLength: this.departmentOptions.length
					})
					// 所有数据加载完成，延迟100ms回写选中值，确保数据已经更新到界面
					setTimeout(() => {
						console.log('开始执行 initSelectedValues')
						this.initSelectedValues()
						this.loading = false
						console.log('加载状态设置为 false')
					}, 100)
				}
			},
			
			loadRecordDetail() {
				const token = uni.getStorageSync('token')
				uni.request({
					url: getApiUrl(`/inspection-record/${this.recordId}`),
					method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
				const data = res.data as UTSJSONObject
				if (res.statusCode === 200 && data.getNumber('code') === 200) {
					const recordData = data.getJSON('data')

					if (recordData != null) {
								this.recordDetail = {
				id: recordData.getString('id') ?? '',
				problemDescription: recordData.getString('problemDescription') ?? '',
				locationName: recordData.getString('locationName') ?? '',
				severity: recordData.getNumber('severity') ?? 1,
				taskName: recordData.getString('taskName') ?? '',
				reporterName: recordData.getString('reporterName') ?? '',
				createTime: recordData.getString('createTime') ?? '',
				updateTime: recordData.getString('updateTime') ?? '',
				status: recordData.getNumber('status') ?? 0,
				problemImageUrls: recordData.getString('problemImageUrls') ?? '',
				suggestions: recordData.getString('suggestions') ?? '',
				reporterId: recordData.getString('reporterId') ?? '',
				responsibleUnit: recordData.getString('responsibleUnit') ?? '',
				responsiblePerson: recordData.getString('responsiblePerson') ?? '',
				// 性质界定：检查数据库返回值的类型
				natureId: '', // 将在后面根据数据类型确定
				natureName: '', // 名称通过匹配获得
				assessmentSituation: recordData.getString('assessmentSituation') ?? '',
				assessmentAmount: recordData.getNumber('assessmentAmount') ?? 0,
				safetyScore: recordData.getNumber('safetyScore') ?? 0,
				// 专业ID使用字符串类型
				professionId: recordData.getString('professionId') ?? '',
				professionName: recordData.getString('professionName') ?? '',
				inspector: recordData.getString('inspectorName') ?? '',
					groupLeader: recordData.getString('groupLeaderName') ?? '',
					deputyLeader: recordData.getString('deputyLeaderName') ?? '',
				// 部门ID使用字符串类型
				departmentId: recordData.getString('departmentId') ?? '',
				departmentName: recordData.getString('departmentName') ?? '',
				rectificationDate: recordData.getString('rectificationDeadline') ?? '',
				location: recordData.getString('location') ?? '',
				rectificationEffect: recordData.getString('rectificationEffect') ?? '',
				rectificationImageUrls: recordData.getString('rectificationImageUrls') ?? '',
				rectificationTime: recordData.getString('rectificationTime') ?? ''
			} as RecordDetail
										
			// 处理性质界定字段映射
			const natureDefinitionValue = recordData.getString('natureDefinition') ?? ''
			console.log('natureDefinition原始值:', natureDefinitionValue)
										
			// 判断返回值是ID还是名称，然后正确映射
			// 如果是32位的ID格式，则作为ID处理；否则作为名称处理
			if (natureDefinitionValue.length === 32 && /^[a-f0-9]+$/i.test(natureDefinitionValue)) {
				// 这是ID，直接赋值
				this.recordDetail.natureId = natureDefinitionValue
				console.log('检测到ID格式，作为ID处理:', natureDefinitionValue)
			} else {
				// 这是名称，需要转换为ID
				this.recordDetail.natureName = natureDefinitionValue
				console.log('检测到名称格式，作为名称处理:', natureDefinitionValue)
				// natureId会在字典加载完成后通过名称匹配设置
			}
						
						// 回写整改信息到表单
						this.rectificationEffect = this.recordDetail?.rectificationEffect ?? ''
						// 根据记录状态和整改效果来判断整改状态
						if (this.recordDetail?.rectificationEffect != null && this.recordDetail?.rectificationEffect != '') {
							this.rectificationStatus = 1  // 已整改
						} else {
							this.rectificationStatus = 0  // 未整改
						}
						
						// 处理整改图片
								const rectificationImages = this.recordDetail?.rectificationImageUrls
								if (rectificationImages != null && rectificationImages != '') {
									this.rectificationImages = this.processImageUrls(rectificationImages as string)
								}
						
						// 处理图片URL
						const imageUrls = this.recordDetail?.problemImageUrls
						if (imageUrls != null && imageUrls != '') {
							this.imageList = this.processImageUrls(imageUrls as string)
						} else {
							this.imageList = []
						}
						
						// 检查是否可以操作（简单权限控制）
						const userInfoStr = uni.getStorageSync('userInfo') as string
						let userInfo: UTSJSONObject | null = null
						if (userInfoStr != null && userInfoStr != '') {
							try {
								userInfo = JSON.parse(userInfoStr) as UTSJSONObject
							} catch (e) {
								console.error('解析用户信息失败:', e)
							}
						}
						this.canOperate = userInfo != null && (userInfo.getString('role') === 'ADMIN' || userInfo.getString('id') === (this.recordDetail?.reporterId ?? ''))
						
						// 设置页面标题
						uni.setNavigationBarTitle({
							title: this.isDelayed ? '延迟整改录入' : '记录详情'
						})
						
						// 记录详情加载完成
						this.checkAllDataLoaded()
					}
				} else {
					uni.showToast({
						title: data.getString('message') ?? '加载失败',
						icon: 'none'
					})
				}
				// 不管成功还是失败，都要调用检查方法
				this.checkAllDataLoaded()
				},
				fail: (error) => {
				console.error('加载记录详情失败:', error)
				uni.showToast({
					title: '网络错误',
					icon: 'none'
				})
				// 加载失败也要调用检查方法
				this.checkAllDataLoaded()
			}
		})
		},
		
		previewImage(index: number) {
			uni.previewImage({
				current: index,
				urls: this.imageList
			})
		},
		
		onImageLoad(e: any) {
			// 图片加载成功
		},
		
		onImageError(e: any) {
			uni.showToast({
				title: '图片加载失败',
				icon: 'none'
			})
		},
		
		updateRecordStatus(status: number, actionName: string) {
		uni.showModal({
			title: '确认操作',
			content: `确定要${actionName}吗？`,
			success: (res) => {
				if (res.confirm) {
					const token = uni.getStorageSync('token')
					uni.request({
						url: getApiUrl(`/inspection-record/${this.recordId}/status`),
						method: 'PUT',
						header: {
							'Authorization': `Bearer ${token}`,
							'Content-Type': 'application/json'
						},
						data: {
							status: status
						},
						success: (response) => {
							const data = response.data as UTSJSONObject
							if (response.statusCode === 200 && (data.getNumber('code') ?? 0) === 200) {
								uni.showToast({
									title: `${actionName}成功`,
									icon: 'success'
								})
								this.loadRecordDetail()
							} else {
					uni.showToast({
						title: data.getString('message') ?? '操作失败',
						icon: 'none'
					})
				}
						},
						fail: (error) => {
							console.error(`${actionName}失败:`, error)
							uni.showToast({
								title: '网络错误',
								icon: 'none'
							})
						}
					})
					}
			}
		})
		},
		
		startRectification() {
			this.updateRecordStatus(1, '开始整改')
		},
		
		completeRectification() {
			this.updateRecordStatus(2, '完成整改')
		},
		
		acceptRectification() {
			this.updateRecordStatus(3, '验收通过')
		},
		
		getStatusText(status: number): string {
			switch (status) {
				case 0: return '待整改'
				case 1: return '整改中'
				case 2: return '已整改'
				case 3: return '已验收'
				default: return '未知'
			}
		},
		
		getStatusClass(status: number): string {
			switch (status) {
				case 0: return 'status-pending'
				case 1: return 'status-processing'
				case 2: return 'status-completed'
				case 3: return 'status-accepted'
				default: return 'status-unknown'
			}
		},
		
		getSeverityText(severity: number): string {
			switch (severity) {
				case 1: return '低'
				case 2: return '中'
				case 3: return '高'
				case 4: return '紧急'
				default: return '未知'
			}
		},
		
		// 整改图片相关方法
		chooseRectificationImage() {
			if (this.rectificationImages.length >= 3) {
				uni.showToast({
					title: '最多只能上传3张图片',
					icon: 'none'
				})
				return
			}
			
			uni.chooseImage({
				count: 3 - this.rectificationImages.length,
				sourceType: ['camera', 'album'],
				success: (res) => {
					const tempFilePaths = res.tempFilePaths
					// 直接存储本地文件路径，不立即上传
					for (let i = 0; i < tempFilePaths.length; i++) {
						this.rectificationImages.push(tempFilePaths[i])
					}
				}
			})
		},
		

		
		previewRectificationImage(index: number) {
			uni.previewImage({
				current: index,
				urls: this.rectificationImages
			})
		},
		
		removeRectificationImage(index: number) {
			this.rectificationImages.splice(index, 1)
		},
		
		setRectificationStatus(status: number) {
			this.rectificationStatus = status
		},
		
		// 将相对路径转换为HTTP访问路径
		convertToHttpUrl(relativePath: string): string {
			if (relativePath == null || relativePath == '' || relativePath.trim() === '') {
				return ''
			}
			
			// 如果已经是完整的HTTP/HTTPS URL，直接返回
			if (relativePath.startsWith('http://') || relativePath.startsWith('https://')) {
				return relativePath
			}
			
			// 直接拼接完整的HTTP URL
			// 后端已返回相对路径，如: /files/images/20250818/xxx.jpg
			const fullUrl = `${apiConfig.baseUrl}/api${relativePath}`
			return fullUrl
		},
		
		// 处理图片URL数组，支持JSON数组格式和逗号分隔字符串格式
    processImageUrls(imageUrls: string): string[] {
     if (imageUrls == null || imageUrls.trim() === '') {
				return []
			}
			
			try {
				// 尝试解析为JSON数组
				if (imageUrls.trim().startsWith('[') && imageUrls.trim().endsWith(']')) {
					const parsed = JSON.parse(imageUrls) as string[]
					return parsed.map(url => this.convertToHttpUrl(url)).filter(url => url !== '')
				}
			} catch (e) {
				console.log('JSON解析失败，尝试按逗号分隔处理:', e)
			}
			
			// 按逗号分隔处理
			return imageUrls.split(',')
				.map(url => url.trim())
				.filter(url => url !== '')
				.map(url => this.convertToHttpUrl(url))
		},

		async saveRectificationInfo() {
			if (this.saving) return
			
			if (this.rectificationEffect.trim().length === 0) {
				uni.showToast({
					title: '请填写整改效果',
					icon: 'none'
				})
				return
			}
			
			this.saving = true
			
			try {
				// 1. 先上传整改图片获取URL
				let imageUrls: string[] = []
				if (this.rectificationImages.length > 0) {
					uni.showLoading({
						title: '上传图片中...'
					})
					imageUrls = await this.uploadRectificationImages()
					uni.hideLoading()
				}
				
				// 2. 组织全页数据 - 保持原有字段不变，更新整改相关字段
				const updateData = {
					// 保持原有记录的所有字段
					id: this.recordDetail?.id ?? '',
					problemDescription: this.recordDetail?.problemDescription ?? '',
					responsibleUnit: this.recordDetail?.responsibleUnit ?? '',
					responsiblePerson: this.recordDetail?.responsiblePerson ?? '',
					// 性质界定：因为数据库存储的是名称，所以保存名称
					natureDefinition: this.selectedNatureIndex !== -1 ? this.natureOptions[this.selectedNatureIndex].name : (this.recordDetail?.natureName ?? ''),
					assessmentSituation: this.recordDetail?.assessmentSituation ?? '',
					assessmentAmount: this.recordDetail?.assessmentAmount ?? 0,
					safetyScore: this.recordDetail?.safetyScore ?? 0,
					professionId: this.selectedProfessionIndex !== -1 ? this.professionOptions[this.selectedProfessionIndex].id : (this.recordDetail?.professionId ?? ''),
					location: this.recordDetail?.location ?? '',
					inspector: this.recordDetail?.inspector ?? '',
					groupLeader: this.recordDetail?.groupLeader ?? '',
					deputyLeader: this.recordDetail?.deputyLeader ?? '',
					departmentId: this.selectedDepartmentIndex !== -1 ? this.departmentOptions[this.selectedDepartmentIndex].id : (this.recordDetail?.departmentId ?? ''),
					rectificationDeadline: this.recordDetail?.rectificationDate ?? '',
					problemImageUrls: this.recordDetail?.problemImageUrls ?? '',
					reporterId: this.recordDetail?.reporterId ?? '',
					
					// 更新整改相关字段
					rectificationEffect: this.rectificationEffect,
					rectificationImageUrls: imageUrls.join(','), // 使用上传后的URL，以逗号分隔的字符串存储
					status: this.rectificationStatus, // 整改状态更新到status字段：0=未整改，1=已整改
					rectificationTime: new Date().toISOString().replace('T', ' ').substring(0, 19) // 当前时间，格式: yyyy-MM-dd HH:mm:ss
				}
				
				// 3. 调用updateRecord接口
				uni.showLoading({
					title: '保存中...'
				})
				
				// 添加调试信息
				console.log('准备保存的数据:', updateData)
				console.log('性质界定保存值:', {
					selectedNatureIndex: this.selectedNatureIndex,
					natureDefinition: updateData.natureDefinition,
					natureOptions: this.natureOptions
				})
				
				const token = uni.getStorageSync('token')
				uni.request({
					url: getApiUrl('/inspection-record'),
					method: 'PUT',
					header: {
						'Authorization': `Bearer ${token}`,
						'Content-Type': 'application/json'
					},
					data: updateData,
					success: (response) => {
						uni.hideLoading()
						const data = response.data as UTSJSONObject
						if (response.statusCode === 200 && (data.getNumber('code') ?? 0) === 200) {
							uni.showToast({
								title: this.isDelayed ? '确认整改成功' : '保存成功',
								icon: 'success',
								duration: 1500
							})
							// 延迟返回，让用户看到成功提示
							setTimeout(() => {
								// 返回到record页面并触发刷新
								const pages = getCurrentPages()
								if (pages.length >= 2) {
									// 获取上一个页面实例
									const prevPage = pages[pages.length - 2]
									// 检查上一个页面是否是record页面
									if (prevPage.route != null && prevPage.route.includes('/pages/record/record')) {
										// 通过eventChannel通知上一个页面刷新
										uni.navigateBack({
											delta: 1,
											success: () => {
												// 通过$emit触发全局事件通知record页面刷新
												uni.$emit('recordUpdated')
											}
										})
									} else {
										// 如果上一个页面不是record页面，直接返回
										uni.navigateBack()
									}
								} else {
									// 如果没有上一个页面，跳转到record页面
									uni.redirectTo({
										url: '/pages/record/record?status=0'
									})
								}
							}, 1600)
						} else {
							uni.showToast({
								title: data.getString('message') ?? '保存失败',
								icon: 'none'
							})
						}
						this.saving = false
					},
					fail: (error) => {
						uni.hideLoading()
						console.error('保存整改信息失败:', error)
						uni.showToast({
							title: '网络错误',
							icon: 'none'
						})
						this.saving = false
					}
				})
			} catch (error) {
				uni.hideLoading()
				console.error('上传图片失败:', error)
				uni.showToast({
					title: '图片上传失败，请重试',
					icon: 'none'
				})
				this.saving = false
			}
		},
		
		// 批量上传整改图片
		async uploadRectificationImages(): Promise<string[]> {
			if (this.rectificationImages.length === 0) {
				return []
			}
			
			const token = uni.getStorageSync('token')
			const uploadPromises = this.rectificationImages.map(imagePath => {
				return new Promise<string>((resolve, reject) => {
					uni.uploadFile({
						url: getApiUrl('/upload/image'),
						filePath: imagePath,
						name: 'file',
						header: {
							'Authorization': `Bearer ${token}`
						},
						success: (res) => {
							try {
								const data = JSON.parse(res.data) as UTSJSONObject
								if (res.statusCode === 200 && (data.getNumber('code') ?? 0) === 200) {
									const dataObj = data.getJSON('data')
									const imageUrl = dataObj?.getString('filePath') ?? ''
									if (imageUrl != null && imageUrl != '') {
										resolve(imageUrl)
									} else {
										reject(new Error('上传成功但未获取到图片URL'))
									}
								} else {
									reject(new Error(data.getString('message') ?? '上传失败'))
								}
							} catch (e) {
								reject(new Error('解析响应失败'))
							}
						},
						fail: (error) => {
							reject(new Error(`上传失败: ${error.errMsg ?? '网络错误'}`))
						}
					})
				})
			})
			
			try {
				const imageUrls = await Promise.all(uploadPromises)
				console.log('所有整改图片上传成功，返回URL数量:', imageUrls.length)
				console.log('上传成功的图片URLs:', imageUrls)
				return imageUrls
			} catch (error) {
				console.error('整改图片上传失败:', error)
				throw error
			}
		},
		
		formatDate(dateStr: string | null): string {
		if (dateStr == null || dateStr == '') return ''
		// 如果是完整的日期时间格式，只取日期部分
		if (dateStr.includes(' ')) {
			return dateStr.split(' ')[0]
		}
		// 如果是ISO格式，转换为日期
		if (dateStr.includes('T')) {
			return dateStr.split('T')[0]
		}
		return dateStr
		},
		
		getSeverityClass(severity: number): string {
			switch (severity) {
				case 1: return 'severity-low'
				case 2: return 'severity-medium'
				case 3: return 'severity-high'
				case 4: return 'severity-urgent'
				default: return 'severity-unknown'
			}
		},
					
		// 初始化选中值（数据加载完成后调用）
		initSelectedValues() {
			console.log('开始初始化选中值')
			if (this.recordDetail == null) {
				console.log('recordDetail为空，无法初始化选中值')
				return
			}
			
			console.log('记录详情数据:', this.recordDetail)
			console.log('字典数据状态:', {
				natureOptions: this.natureOptions,
				professionOptions: this.professionOptions,
				departmentOptions: this.departmentOptions
			})
					
			// 回写性质界定（支持ID或名称匹配）
			const natureId = this.recordDetail.natureId ?? ''
			const natureName = this.recordDetail.natureName ?? ''
			console.log('性质界定数据:', { natureId, natureName })
			
			if (natureId !== '') {
				// 有ID值，使用ID匹配
				console.log('使用ID匹配:', natureId)
				for (let i = 0; i < this.natureOptions.length; i++) {
					console.log(`性质界定ID比较: ${this.natureOptions[i].id} == ${natureId}`)
					if (this.natureOptions[i].id == natureId) {
						this.selectedNatureIndex = i
						this.recordDetail.natureName = this.natureOptions[i].name
						console.log('性质界定ID匹配成功，索引:', i, 'ID:', this.natureOptions[i].id, '名称:', this.natureOptions[i].name)
						break
					}
				}
				if (this.selectedNatureIndex === -1) {
					console.log('性质界定ID在字典中未找到匹配项:', natureId)
				}
			} else if (natureName !== '') {
				// 没有ID但有名称，使用名称匹配
				console.log('使用名称匹配:', natureName)
				for (let i = 0; i < this.natureOptions.length; i++) {
					console.log(`性质界定名称比较: ${this.natureOptions[i].name} == ${natureName}`)
					if (this.natureOptions[i].name == natureName) {
						this.selectedNatureIndex = i
						this.recordDetail.natureId = this.natureOptions[i].id
						console.log('性质界定名称匹配成功，索引:', i, 'ID:', this.natureOptions[i].id, '名称:', this.natureOptions[i].name)
						break
					}
				}
				if (this.selectedNatureIndex === -1) {
					console.log('性质界定名称在字典中未找到匹配项:', natureName)
				}
			} else {
				console.log('性质界定ID和名称都为空，跳过匹配')
			}
			
			if (this.selectedNatureIndex === -1) {
				console.log('可用的字典选项:', this.natureOptions.map(item => `${item.name}(${item.id})`))
			}
					
			// 回写专业（使用字符串类型ID）
			const professionId = this.recordDetail.professionId ?? ''
			console.log('专业ID:', professionId)
			if (professionId !== '') {
				for (let i = 0; i < this.professionOptions.length; i++) {
					console.log(`专业比较: ${this.professionOptions[i].id} == ${professionId}`)
					if (this.professionOptions[i].id == professionId) {
						this.selectedProfessionIndex = i
						console.log('专业匹配成功，索引:', i, '名称:', this.professionOptions[i].name)
						break
					}
				}
			} else {
				console.log('专业ID为空，跳过匹配')
			}
					
			// 回写部门（使用字符串类型ID）
			const departmentId = this.recordDetail.departmentId ?? ''
			console.log('部门ID:', departmentId)
			if (departmentId !== '') {
				for (let i = 0; i < this.departmentOptions.length; i++) {
					console.log(`部门比较: ${this.departmentOptions[i].id} == ${departmentId}`)
					if (this.departmentOptions[i].id == departmentId) {
						this.selectedDepartmentIndex = i
						console.log('部门匹配成功，索引:', i, '名称:', this.departmentOptions[i].name)
						break
					}
				}
			} else {
				console.log('部门ID为空，跳过匹配')
			}
					
			console.log('回写选中值完成:', {
				natureId, selectedNatureIndex: this.selectedNatureIndex,
				professionId, selectedProfessionIndex: this.selectedProfessionIndex,
				departmentId, selectedDepartmentIndex: this.selectedDepartmentIndex
			})
		},
					
		// 加载性质界定字典数据
		loadNatureOptions() {
			const token = uni.getStorageSync('token')
			uni.request({
				url: getApiUrl('/dictionary/type/性质界定'),
				method: 'GET',
				header: {
					'Authorization': `Bearer ${token}`,
					'Content-Type': 'application/json'
				},
				success: (res) => {
					const data = res.data as UTSJSONObject
					const code = data.getNumber('code')
					if (res.statusCode === 200 && code === 200) {
						const dataArray = data.getArray('data')
						if (dataArray != null) {
							this.natureOptions = []
							for (let i = 0; i < dataArray.length; i++) {
								const item = dataArray[i] as UTSJSONObject
								const id = item.getString('id') ?? ''
								const dictValue = item.getString('dictValue') ?? ''
								const dictLabel = item.getString('dictLabel') ?? ''
								const name = dictValue !== '' ? dictValue : dictLabel
								this.natureOptions.push({ id: id, name: name })
							}
						}
						console.log('性质界定数据加载成功:', this.natureOptions)
					} else {
						const message = data.getString('message') ?? '未知错误'
						console.error('获取性质界定数据失败:', message)
						this.natureOptions = [
							{ id: '1', name: '一般问题' },
							{ id: '2', name: '较大问题' },
							{ id: '3', name: '严重问题' },
							{ id: '4', name: '重大问题' }
						]
					}
					// 无论成功还是失败，都调用数据加载完成检查
					this.checkAllDataLoaded()
				},
				fail: (error) => {
					console.error('请求性质界定数据失败:', error)
					this.natureOptions = [
						{ id: '1', name: '一般问题' },
						{ id: '2', name: '较大问题' },
						{ id: '3', name: '严重问题' },
						{ id: '4', name: '重大问题' }
					]
					// 加载失败也要调用数据加载完成检查
					this.checkAllDataLoaded()
				}
			})
		},
					
