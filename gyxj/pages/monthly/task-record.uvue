			// 加载专业类别选项
			loadTypeOptions() {
				const token = uni.getStorageSync('token')
				uni.request({
					url: getApiUrl('/gjbz-data/options/types' + (this.formData.departmentId != '' ? '?departmentId=' + encodeURIComponent(this.formData.departmentId) : '')),
					method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
						const respdata = res.data as UTSJSONObject
						if (respdata.getNumber('code') === 200) {
							const data = respdata.getArray('data')
							console.log("获取到的专业类别数据",data)
							if (data != null) {
								const options: OptionItem[] = []
								for (let i = 0; i < data.length; i++) {
           const item = data[i] as string
           options.push({
            id: (i + 1).toString(),
            name: item
           } as OptionItem)
								}
								this.typeOptions = options
								console.log("专业类别选项已加载:", this.typeOptions)
								// 自动填充专业类别
								this.autoFillProfession()
							}
						} else {
						console.error('加载专业类别失败:', respdata.getString('message'))
						this.loadFallbackTypeOptions()
					}
				},
				fail: (error) => {
					console.error('加载专业类别失败:', error)
					this.loadFallbackTypeOptions()
				}
			})
		},
		
