<template>
	<scroll-view class="container" scroll-y="true" :scroll-top="scrollTop" :style="{height: containerHeight + 'px'}" enable-back-to-top="true">
		<!-- 头部 -->
		<view class="header">
			<view class="header-left" @click="goBack">
				
			</view>
			<text class="header-title">{{isEditMode ? '月检记录编辑' : '月检任务录入'}}</text>
			<view class="header-right">
				<!-- 保存按钮已移至页面底部 -->
			</view>
		</view>
		
		<!-- 任务信息 -->
		<view class="task-info">
			<view class="info-item">
				<text class="info-label">任务名称:</text>
				<text class="info-value">{{taskInfo != null ? taskInfo.taskName : ''}}</text>
			</view>
			<view class="info-item">
				<text class="info-label">任务编号:</text>
				<text class="info-value">{{taskInfo != null ? taskInfo.taskNumber : ''}}</text>
			</view>
			<view class="info-item">
				<text class="info-label">月检时间:</text>
				<text class="info-value">{{taskInfo != null ? taskInfo.inspectionDate : ''}}</text>
			</view>
			<view class="info-item">
				<text class="info-label">公示时间:</text>
				<text class="info-value">{{taskInfo != null ? taskInfo.publicityDate : ''}}</text>
			</view>
		</view>

		<!-- V3:编辑模式下展示上一次的 modification_snapshot（只读） -->
		<view v-if="isEditMode && originalSnapshot != ''" class="snapshot-panel">
			<view class="snapshot-title-row">
				<text class="snapshot-title">上次修改对比（仅参考）</text>
				<text class="snapshot-edit-badge">编辑模式</text>
			</view>
			<text class="snapshot-content">{{originalSnapshot}}</text>
		</view>

		<!-- 问题录入表单 -->
		<view class="form-section">
			<view class="section-title">
				<text class="title-text">问题录入</text>
				<text class="required-mark">*</text>
			</view>
			
			<!-- 问题照片 -->
			<view class="form-item">
				<text class="form-label">问题照片</text>
				<view class="photo-upload">
					<view v-for="(photo, index) in formData.photos" :key="index" class="photo-item">
						<image :src="convertToHttpUrl(photo)" class="photo-preview" @click="previewPhoto(photo)"></image>
						<view class="photo-delete" @click="deletePhoto(index)">
							<text class="delete-icon">×</text>
						</view>
					</view>
					<view v-if="formData.photos.length < 3" class="photo-add" @click="addPhoto">
						<text class="add-icon">+</text>
						<text class="add-text">添加照片</text>
					</view>
				</view>
				<text class="photo-tip">最多可上传3张照片，单张不超过5MB</text>
			</view>

			<!-- 受检单位（运行部门下拉，存 id）——变更时按标准组重载岗检标准级联 -->
			<view class="form-item">
				<text class="form-label-left">受检单位</text>
				<view class="custom-picker-full" @click="showInspectedUnitPicker" :class="{disabled: deptOptions.length === 0}">
					<text class="picker-text-full" :class="{placeholder: formData.departmentId === ''}">
						{{selectedInspectedUnitName !== '' ? selectedInspectedUnitName : '请选择受检单位'}}
					</text>
				</view>
			</view>

			<!-- 发现位置 -->
			<view class="form-item">
				<text class="form-label-left">发现位置</text>
				<input class="form-input" v-model="formData.location" placeholder="请输入问题发现的具体位置" />
			</view>

			<!-- 问题描述 -->
			<view class="form-item">
				<text class="form-label">问题描述</text>
				<textarea class="textarea-input" v-model="formData.problemDescription" placeholder="请详细描述发现的问题" maxlength="500"></textarea>
				<text class="char-count">{{formData.problemDescription.length}}/500</text>
			</view>

			<!-- 专业类别（第1级联选择框） -->
			<view class="form-item">
				<text class="form-label-left">专业类别</text>
				<view class="custom-picker-full" @click="showTypePicker" :class="{disabled: typeOptions.length === 0}">
					<text class="picker-text-full" :class="{placeholder: selectedTypeIndex === -1}">
						{{selectedTypeIndex === -1 ? '请选择专业类别' : (selectedTypeIndex < typeOptions.length ? (typeOptions[selectedTypeIndex] as OptionItem).name : '请选择专业类别')}}
					</text>
				</view>
			</view>
			
			<!-- 模块（第2级联选择框） -->
			<view class="form-item">
				<text class="form-label-left">基本模块</text>
				<view class="custom-picker-full" @click="showModulePicker" :class="{disabled: moduleOptions.length === 0}">
					<text class="picker-text-full" :class="{placeholder: selectedModuleIndex === -1}">
						{{selectedModuleIndex === -1 ? '请选择基本模块' : (selectedModuleIndex < moduleOptions.length ? (moduleOptions[selectedModuleIndex] as OptionItem).name : '请选择基本模块')}}
					</text>
				</view>
			</view>

			<!-- 责任（第3级联选择框） -->
			<view class="form-item">
				<text class="form-label-left">责任要素</text>
				<view class="custom-picker-full" @click="showResponsibilityPicker" :class="{disabled: responsibilityOptions.length === 0}">
					<text class="picker-text-full" :class="{placeholder: selectedResponsibilityIndex === -1}">
						{{selectedResponsibilityIndex === -1 ? '请选择责任要素' : (selectedResponsibilityIndex < responsibilityOptions.length ? (responsibilityOptions[selectedResponsibilityIndex] as OptionItem).name : '请选择责任要素')}}
					</text>
				</view>
			</view>

			<!-- 问题（第4级联选择框） -->
			<view class="form-item">
				<text class="form-label-left">检查内容</text>
				<view class="custom-picker-full" @click="showIssuePicker" :class="{disabled: issueOptions.length === 0}">
					<text class="picker-text-full" :class="{placeholder: selectedIssueIndex === -1}">
						{{selectedIssueIndex === -1 ? '请选择检查内容' : (selectedIssueIndex < issueOptions.length ? (issueOptions[selectedIssueIndex] as OptionItem).name : '请选择检查内容')}}
					</text>
				</view>
			</view>
			
			<!-- 性质界定 -->
			<view class="form-item">
				<text class="form-label-left">性质界定</text>
				<view class="custom-picker-full" @click="showQualityPicker" :class="{disabled: qualityOptions.length === 0}">
					<text class="picker-text-full" :class="{placeholder: selectedQualityIndex === -1}">
						{{selectedQualityIndex === -1 ? '请选择性质界定' : (selectedQualityIndex < qualityOptions.length ? (qualityOptions[selectedQualityIndex] as OptionItem).name : '请选择性质界定')}}
					</text>
				</view>
			</view>

			<!-- 性质界定是否人工修改（对齐 web AddDialog.vue：natureModified===1 → "是(已修改)"） -->
			<view class="form-item">
				<text class="form-label-left">是否人工修改</text>
				<view class="custom-picker-full readonly-display">
					<text class="picker-text-full" :class="{'nature-modified-yes': formData.natureModified === 1}">
						{{formData.natureModified === 1 ? '是(已修改)' : '否(未修改)'}}
					</text>
				</view>
			</view>

			<!-- 扣分值（根据性质界定自动显示，不入库） -->
			<view class="form-item">
				<text class="form-label-left">扣分值</text>
				<view class="custom-picker-full readonly-display" :class="{placeholder: selectedQualityIndex === -1}">
					<text class="picker-text-full" :class="{placeholder: selectedQualityIndex === -1}">
						{{selectedQualityIndex === -1 ? '选择性质界定后自动显示' : (selectedQualityIndex < qualityOptions.length ? ((qualityOptions[selectedQualityIndex] as OptionItem).score ?? '') : '选择性质界定后自动显示')}}
					</text>
				</view>
			</view>

			<!-- 检查单位(管理部门)——只读,锁定为当前用户所属部门 -->
			<view class="form-item">
				<text class="form-label-left">检查单位</text>
				<view class="custom-picker-full readonly-display">
					<text class="picker-text-full" :class="{placeholder: formData.checkUnitName === ''}">
						{{formData.checkUnitName !== '' ? formData.checkUnitName : '当前用户部门未设置'}}
					</text>
				</view>
			</view>

			<!-- 检查人（可多选） -->
			<view class="form-item">
				<text class="form-label-left">检查人</text>
				<view class="custom-picker-full" @click="showInspectorPicker" :class="{disabled: inspectorOptions.length === 0}">
					<text class="picker-text-full" :class="{placeholder: formData.inspector.length === 0}">
						{{formData.inspector.length > 0 ? formData.inspector.join('、') : '请选择检查人（可多选）'}}
					</text>
				</view>
			</view>

			<!-- 责任人（从用户列表取值，可多选） -->
			<view class="form-item">
				<text class="form-label-left">责任人</text>
				<view class="custom-picker-full" @click="showResponsiblePersonPicker" :class="{disabled: inspectorOptions.length === 0}">
					<text class="picker-text-full" :class="{placeholder: formData.responsiblePerson.length === 0}">
						{{formData.responsiblePerson.length > 0 ? formData.responsiblePerson.join('、') : '请选择责任人（可多选）'}}
					</text>
				</view>
			</view>

			<!-- 责任单位（从部门字典取值，可多选） -->
			<view class="form-item">
				<text class="form-label-left">责任单位</text>
				<view class="custom-picker-full" @click="showResponsibleUnitPicker" :class="{disabled: deptOptions.length === 0}">
					<text class="picker-text-full" :class="{placeholder: formData.responsibleUnit.length === 0}">
						{{formData.responsibleUnit.length > 0 ? formData.responsibleUnit.join('、') : '请选择责任单位（可多选）'}}
					</text>
				</view>
			</view>
			
			<!-- 整改期限 -->
			<view class="form-item">
				<text class="form-label-left">整改期限</text>
				<view class="picker-container" @click="showDatePicker">
					<text class="picker-text-full" :class="{placeholder: formData.rectificationDate === ''}">
						{{formData.rectificationDate !== '' ? formData.rectificationDate : '请选择整改期限'}}
					</text>
				</view>
				<!-- 日期选择器弹窗 -->
				<view v-if="datePickerVisible" class="date-picker-modal" @click="hideDatePicker">
					<view class="date-picker-content" @click.stop>
						<view class="date-picker-header">
							<text class="date-picker-cancel" @click="hideDatePicker">取消</text>
							<text class="date-picker-title">选择日期</text>
							<text class="date-picker-confirm" @click="confirmDatePicker">确定</text>
						</view>
						<picker-view class="date-picker-view" :value="pickerValue" @change="onPickerChange" indicator-style="height: 70px; top: 20%; margin-top: -20px;">
							<picker-view-column>
								<view v-for="(year, index) in years" :key="index" class="picker-item" :class="{selected: index === pickerValue[0]}">
									{{year}}年
								</view>
							</picker-view-column>
							<picker-view-column>
								<view v-for="(month, index) in months" :key="index" class="picker-item" :class="{selected: index === pickerValue[1]}">
									{{month}}月
								</view>
							</picker-view-column>
							<picker-view-column>
								<view v-for="(day, index) in days" :key="index" class="picker-item" :class="{selected: index === pickerValue[2]}">
									{{day}}日
								</view>
								<!-- 添加空白项目，让最后的日期可以滚动到选择区域 -->
								<view v-for="i in 2" :key="'empty-day-' + i" class="picker-item picker-item-spacer"></view>
							</picker-view-column>
						</picker-view>
					</view>
				</view>
			</view>

		</view>
		
		<!-- 底部保存按钮 -->
		<view class="bottom-save-container">
			<view class="bottom-save-btn" @click="saveRecord">
				<text class="bottom-save-text">保存</text>
			</view>
		</view>
		
		<!-- 问题类型选择器 -->
		<view v-if="showProblemTypeModal" class="picker-modal" @click="hideProblemTypePicker">
			<view class="picker-content" @click.stop>
				<view class="picker-header">
					<text class="picker-cancel" @click="hideProblemTypePicker">取消</text>
					<text class="picker-title">选择问题类型</text>
					<text class="picker-confirm" @click="confirmProblemType">确定</text>
				</view>
				<view class="picker-list">
					<view v-for="(type, index) in problemTypes" :key="index" 
						  class="picker-item" 
						  :class="{selected: selectedProblemType === type}"
						  @click="selectProblemType(type)">
						<text class="picker-item-text">{{type}}</text>
						<text v-if="selectedProblemType === type" class="picker-check">✓</text>
					</view>
				</view>
			</view>
		</view>
		

		
		<!-- 专业类别选择弹窗 -->
		<view v-if="showTypePopup" class="popup-overlay" @click="hideTypePicker">
			<view class="popup-content" @click.stop>
				<view class="popup-header">
					<text class="popup-title">选择专业类别</text>
					<text class="popup-close" @click="hideTypePicker">×</text>
				</view>
				<view class="popup-search">
					<input class="search-input" v-model="typeSearchKeyword" placeholder="搜索专业类别..." />
				</view>
				<scroll-view class="popup-list" scroll-y="true">
					<view v-if="filteredTypeOptions.length === 0" class="popup-empty">
						<text class="empty-text">暂无匹配的专业类别</text>
					</view>
					<view v-else v-for="(item, index) in filteredTypeOptions" :key="(item as OptionItem).id" 
					  :class="['popup-item', selectedTypeIndex >= 0 && typeOptions[selectedTypeIndex] != null && typeOptions[selectedTypeIndex].id === (item as OptionItem).id ? 'popup-item-selected' : '']" 
					  @click="selectTypeFromFiltered(item)">
						<text class="popup-item-text">{{(item as OptionItem).name}}</text>
        <text v-if="selectedTypeIndex >= 0 && typeOptions[selectedTypeIndex] != null && typeOptions[selectedTypeIndex].id === (item as OptionItem).id" class="popup-item-check">✓</text>
					</view>
				</scroll-view>
			</view>
		</view>
		
		<!-- 模块选择弹窗 -->
		<view v-if="showModulePopup" class="popup-overlay" @click="hideModulePicker">
			<view class="popup-content" @click.stop>
				<view class="popup-header">
					<text class="popup-title">选择基本模块</text>
					<text class="popup-close" @click="hideModulePicker">×</text>
				</view>
				<view class="popup-search">
					<input class="search-input" v-model="moduleSearchKeyword" placeholder="搜索模块..." />
				</view>
				<scroll-view class="popup-list" scroll-y="true">
					<view v-if="moduleOptions.length === 0" class="popup-loading">
						<text class="loading-text">加载中...</text>
					</view>
					<view v-else-if="filteredModuleOptions.length === 0" class="popup-empty">
						<text class="empty-text">暂无匹配的模块</text>
					</view>
					<view v-else v-for="(item, index) in filteredModuleOptions" :key="(item as OptionItem).id" 
         :class="['popup-item', selectedModuleIndex >= 0 && moduleOptions[selectedModuleIndex] != null && moduleOptions[selectedModuleIndex].id === (item as OptionItem).id ? 'popup-item-selected' : '']" 
					  @click="selectModuleFromFiltered(item)">
					<text class="popup-item-text">{{(item as OptionItem).name}}</text>
       <text v-if="selectedModuleIndex >= 0 && moduleOptions[selectedModuleIndex] != null && moduleOptions[selectedModuleIndex].id === (item as OptionItem).id" class="popup-item-check">✓</text>
				</view>
				</scroll-view>
			</view>
		</view>
		
		<!-- 责任选择弹窗 -->
		<view v-if="showResponsibilityPopup" class="popup-overlay" @click="hideResponsibilityPicker">
			<view class="popup-content" @click.stop>
				<view class="popup-header">
					<text class="popup-title">选择责任要素</text>
					<text class="popup-close" @click="hideResponsibilityPicker">×</text>
				</view>
				<view class="popup-search">
					<input class="search-input" v-model="responsibilitySearchKeyword" placeholder="搜索责任部门..." />
				</view>
				<scroll-view class="popup-list" scroll-y="true">
					<view v-if="responsibilityOptions.length === 0" class="popup-loading">
						<text class="loading-text">加载中...</text>
					</view>
					<view v-else-if="filteredResponsibilityOptions.length === 0" class="popup-empty">
						<text class="empty-text">暂无匹配的责任部门</text>
					</view>
					<view v-else v-for="(item, index) in filteredResponsibilityOptions" :key="(item as OptionItem).id" 
         :class="['popup-item', selectedResponsibilityIndex >= 0 && responsibilityOptions[selectedResponsibilityIndex] != null && responsibilityOptions[selectedResponsibilityIndex].id === (item as OptionItem).id ? 'popup-item-selected' : '']" 
					  @click="selectResponsibilityFromFiltered(item)">
					<text class="popup-item-text">{{(item as OptionItem).name}}</text>
       <text v-if="selectedResponsibilityIndex >= 0 && responsibilityOptions[selectedResponsibilityIndex] != null && responsibilityOptions[selectedResponsibilityIndex].id === (item as OptionItem).id" class="popup-item-check">✓</text>
				</view>
				</scroll-view>
			</view>
		</view>
		
		<!-- 问题选择弹窗 -->
		<view v-if="showIssuePopup" class="popup-overlay" @click="hideIssuePicker">
			<view class="popup-content" @click.stop>
				<view class="popup-header">
					<text class="popup-title">选择检查内容</text>
					<text class="popup-close" @click="hideIssuePicker">×</text>
				</view>
				<view class="popup-search">
					<input class="search-input" v-model="issueSearchKeyword" placeholder="搜索问题..." />
				</view>
				<scroll-view class="popup-list" scroll-y="true">
					<view v-if="issueOptions.length === 0" class="popup-loading">
						<text class="loading-text">加载中...</text>
					</view>
					<view v-else-if="filteredIssueOptions.length === 0" class="popup-empty">
						<text class="empty-text">暂无匹配的问题</text>
					</view>
      <view v-else v-for="(item, index) in filteredIssueOptions" :key="(item as OptionItem).id" 
        :class="['popup-item', selectedIssueIndex !== -1 && issueOptions[selectedIssueIndex] != null && issueOptions[selectedIssueIndex].id === (item as OptionItem).id ? 'popup-item-selected' : '']" 
        @click="selectIssueFromFiltered(item)">
      <text class="popup-item-text">{{(item as OptionItem).name}}</text>
      <text v-if="selectedIssueIndex !== -1 && issueOptions[selectedIssueIndex] != null && issueOptions[selectedIssueIndex].id === (item as OptionItem).id" class="popup-item-check">✓</text>
				</view>
				</scroll-view>
			</view>
		</view>
		
		<!-- 性质界定选择弹窗 -->
		<view v-if="showQualityPopup" class="popup-overlay" @click="hideQualityPicker">
			<view class="popup-content" @click.stop>
				<view class="popup-header">
					<text class="popup-title">选择性质界定</text>
					<text class="popup-close" @click="hideQualityPicker">×</text>
				</view>
				<view class="popup-search">
					<input class="search-input" v-model="qualitySearchKeyword" placeholder="搜索性质界定..." />
				</view>
				<scroll-view class="popup-list" scroll-y="true">
					<view v-if="qualityOptions.length === 0" class="popup-loading">
						<text class="loading-text">加载中...</text>
					</view>
					<view v-else-if="filteredQualityOptions.length === 0" class="popup-empty">
						<text class="empty-text">暂无匹配的性质界定</text>
					</view>
      <view v-else v-for="(item, index) in filteredQualityOptions" :key="(item as OptionItem).id"
        :class="['popup-item', selectedQualityIndex !== -1 && qualityOptions[selectedQualityIndex] != null && qualityOptions[selectedQualityIndex].id === (item as OptionItem).id ? 'popup-item-selected' : '']"
        @click="selectQualityFromFiltered(item)">
      <text class="popup-item-text">{{(item as OptionItem).name}}</text>
      <text v-if="selectedQualityIndex !== -1 && qualityOptions[selectedQualityIndex] != null && qualityOptions[selectedQualityIndex].id === (item as OptionItem).id" class="popup-item-check">✓</text>
				</view>
				</scroll-view>
			</view>
		</view>

		<!-- 检查人选择弹窗（多选） -->
		<view v-if="showInspectorPopup" class="popup-overlay" @click="hideInspectorPicker">
			<view class="popup-content" @click.stop>
				<view class="popup-header">
					<text class="popup-title">选择检查人（可多选）</text>
					<text class="popup-close" @click="hideInspectorPicker">×</text>
				</view>
				<view class="popup-search">
					<input class="search-input" v-model="inspectorSearchKeyword" placeholder="搜索检查人..." />
				</view>
				<scroll-view class="popup-list" scroll-y="true">
					<view v-if="inspectorOptions.length === 0" class="popup-loading">
						<text class="loading-text">加载中...</text>
					</view>
					<view v-else-if="filteredInspectorOptions.length === 0" class="popup-empty">
						<text class="empty-text">暂无匹配的人员</text>
					</view>
					<view v-else v-for="(item, index) in filteredInspectorOptions" :key="(item as OptionItem).id"
						:class="['popup-item', formData.inspector.indexOf((item as OptionItem).displayName ?? (item as OptionItem).name) !== -1 ? 'popup-item-selected' : '']"
						@click="toggleInspectorFromFiltered(item)">
						<text class="popup-item-text">{{(item as OptionItem).displayName ?? (item as OptionItem).name}}</text>
						<text v-if="formData.inspector.indexOf((item as OptionItem).displayName ?? (item as OptionItem).name) !== -1" class="popup-item-check">✓</text>
					</view>
				</scroll-view>
				<view class="popup-footer">
					<text class="popup-btn popup-btn-cancel" @click="hideInspectorPicker">取消</text>
					<text class="popup-btn popup-btn-confirm" @click="confirmInspectorPicker">确定（{{formData.inspector.length}}）</text>
				</view>
			</view>
		</view>

		<!-- 责任人选择弹窗（多选） -->
		<view v-if="showResponsiblePersonPopup" class="popup-overlay" @click="hideResponsiblePersonPicker">
			<view class="popup-content" @click.stop>
				<view class="popup-header">
					<text class="popup-title">选择责任人（可多选）</text>
					<text class="popup-close" @click="hideResponsiblePersonPicker">×</text>
				</view>
				<view class="popup-search">
					<input class="search-input" v-model="inspectorSearchKeyword" placeholder="搜索责任人..." />
				</view>
				<scroll-view class="popup-list" scroll-y="true">
					<view v-if="inspectorOptions.length === 0" class="popup-loading">
						<text class="loading-text">加载中...</text>
					</view>
					<view v-else-if="filteredResponsiblePersonOptions.length === 0" class="popup-empty">
						<text class="empty-text">暂无匹配的人员</text>
					</view>
					<view v-else v-for="(item, index) in filteredResponsiblePersonOptions" :key="(item as OptionItem).id"
						:class="['popup-item', formData.responsiblePerson.indexOf((item as OptionItem).displayName ?? (item as OptionItem).name) !== -1 ? 'popup-item-selected' : '']"
						@click="toggleResponsiblePersonFromFiltered(item)">
						<text class="popup-item-text">{{(item as OptionItem).displayName ?? (item as OptionItem).name}}</text>
						<text v-if="formData.responsiblePerson.indexOf((item as OptionItem).displayName ?? (item as OptionItem).name) !== -1" class="popup-item-check">✓</text>
					</view>
				</scroll-view>
				<view class="popup-footer">
					<text class="popup-btn popup-btn-cancel" @click="hideResponsiblePersonPicker">取消</text>
					<text class="popup-btn popup-btn-confirm" @click="confirmResponsiblePersonPicker">确定（{{formData.responsiblePerson.length}}）</text>
				</view>
			</view>
		</view>

		<!-- 受检单位选择弹窗 -->
		<view v-if="showInspectedUnitPopup" class="popup-overlay" @click="hideInspectedUnitPicker">
			<view class="popup-content" @click.stop>
				<view class="popup-header">
					<text class="popup-title">选择受检单位</text>
					<text class="popup-close" @click="hideInspectedUnitPicker">×</text>
				</view>
				<view class="popup-search">
					<input class="search-input" v-model="deptSearchKeyword" placeholder="搜索部门..." />
				</view>
				<scroll-view class="popup-list" scroll-y="true">
					<view v-if="deptOptions.length === 0" class="popup-loading">
						<text class="loading-text">加载中...</text>
					</view>
					<view v-else-if="filteredDeptOptions.length === 0" class="popup-empty">
						<text class="empty-text">暂无匹配的部门</text>
					</view>
					<view v-else v-for="(item, index) in filteredDeptOptions" :key="(item as OptionItem).id"
						:class="['popup-item', selectedDeptIndex !== -1 && deptOptions[selectedDeptIndex] != null && deptOptions[selectedDeptIndex].id === (item as OptionItem).id ? 'popup-item-selected' : '']"
						@click="selectInspectedUnitFromFiltered(item)">
						<text class="popup-item-text">{{(item as OptionItem).name}}</text>
						<text v-if="selectedDeptIndex !== -1 && deptOptions[selectedDeptIndex] != null && deptOptions[selectedDeptIndex].id === (item as OptionItem).id" class="popup-item-check">✓</text>
					</view>
				</scroll-view>
			</view>
		</view>

		<!-- 责任单位选择弹窗（多选） -->
		<view v-if="showResponsibleUnitPopup" class="popup-overlay" @click="hideResponsibleUnitPicker">
			<view class="popup-content" @click.stop>
				<view class="popup-header">
					<text class="popup-title">选择责任单位（可多选）</text>
					<text class="popup-close" @click="hideResponsibleUnitPicker">×</text>
				</view>
				<view class="popup-search">
					<input class="search-input" v-model="responsibleUnitSearchKeyword" placeholder="搜索部门..." />
				</view>
				<scroll-view class="popup-list" scroll-y="true">
					<view v-if="deptOptions.length === 0" class="popup-loading">
						<text class="loading-text">加载中...</text>
					</view>
					<view v-else-if="filteredResponsibleUnitOptions.length === 0" class="popup-empty">
						<text class="empty-text">暂无匹配的部门</text>
					</view>
					<view v-else v-for="(item, index) in filteredResponsibleUnitOptions" :key="(item as OptionItem).id"
						:class="['popup-item', formData.responsibleUnit.indexOf((item as OptionItem).name) !== -1 ? 'popup-item-selected' : '']"
						@click="toggleResponsibleUnitFromFiltered(item)">
						<text class="popup-item-text">{{(item as OptionItem).name}}</text>
						<text v-if="formData.responsibleUnit.indexOf((item as OptionItem).name) !== -1" class="popup-item-check">✓</text>
					</view>
				</scroll-view>
				<view class="popup-footer">
					<text class="popup-btn popup-btn-cancel" @click="hideResponsibleUnitPicker">取消</text>
					<text class="popup-btn popup-btn-confirm" @click="confirmResponsibleUnitPicker">确定（{{formData.responsibleUnit.length}}）</text>
				</view>
			</view>
		</view>
	</scroll-view>
</template>

<script lang="uts">
	import { getApiUrl, apiConfig } from '@/config/api.uts'
	import { isMonthlyAdmin } from '@/utils/permission.uts'
	import { resolveCurrentDept, getCachedUserInfo, CurrentDept } from '@/utils/user.uts'
	
type TaskInfo = {
    taskId: string
    taskNumber: string
    taskName: string
    inspectionDate: string
    publicityDate: string
    // 原始 ISO 时间戳,用于提交前校验录入期,与 web 端 handleTaskSelectConfirm 一致
    inspectionStartTime: string
    inspectionEndTime: string
}

type IssueQualityMap = Map<string, string>
	
  type FormData = {
		problemType: string
		problemDescription: string
		location: string
		photos: string[]
		safetyScore: string
		rectificationDate: string
		module: string
		responsibility: string
		issue: string
    quality: string
    inspector: string[]
    responsibleUnit: string[]
    responsiblePerson: string[]
    departmentId: string
    // V3:检查单位(管理部门)信息 — 锁定为当前用户所属部门
    checkUnitId: string
    checkUnitName: string
    // V3:性质界定是否被人工改动(0=否 1=是),由前端 watch qualityId 维护
    natureModified: number
  }

  type CurrentUser = {
    id: string
    realName: string
    deptId: string
    deptName: string
    deptType: number  // 0=运行部门 1=管理部门
    isMonthlyAdmin: boolean
  }
	
	type OptionItem = {
		id: string
		name: string
		value?: string
		code?: string
		score?: string
		displayName?: string
	}

	// 性质界定字典码→中文标签的兜底映射（仅当 dictValue 仍是旧的 1/2/3 数字码时用）
	// 注意：字典数据现已调整为 dictValue 存中文(观察/一般/重要)、dictLabel 存数字码，
	// 显示值必须直接取接口的 dictValue，否则会把 dictLabel 的数字码当成名称显示。
	const QUALITY_LABEL_MAP: Map<string, string> = new Map<string, string>([
		['1', '观察'],
		['2', '一般'],
		['3', '重要']
	])
	function resolveQualityLabel(dictValue: string, dictLabel: string): string {
		// 与 web 端 AddDialog.vue 保持一致：dictValue 优先。
		// 现在接口返回的 dictValue 就是中文，直接取值；
		// 若 dictValue 是旧的数字码(1/2/3)则翻译成中文；两者都没有才回退 dictLabel
		if (dictValue != '') {
			const mapped = QUALITY_LABEL_MAP.get(dictValue)
			if (mapped != null) return mapped
			return dictValue
		}
		return dictLabel
	}

	// UTS 严格模式下 String.trim() 不可用,自行实现首尾空白去除
	function stripOuterWhitespace(s: string): string {
		return s.replace(/^\s+|\s+$/g, '')
	}

	// 性质界定中文名→扣分值(观察1/一般3/重要5),与 web AddDialog.vue 一致。
	// 构建 qualityOptions 时就把分值预存进选项的 score 字段,
	// 让模板能像「性质界定」那样直接读 qualityOptions[idx].score(直接数据路径,uvue 下可响应式刷新)。
	function qualityScoreOf(label: string): string {
		const n = stripOuterWhitespace(label)
		if (n.indexOf('观察') !== -1) return '1'
		if (n.indexOf('一般') !== -1) return '3'
		if (n.indexOf('重要') !== -1) return '5'
		return ''
	}
	
	export default {
		data() {
			// 计算默认整改时间（当前日期往后推7天）
			const defaultDate = new Date()
			defaultDate.setDate(defaultDate.getDate() + 7)
			const defaultDateStr = `${defaultDate.getFullYear()}-${(defaultDate.getMonth() + 1).toString().padStart(2, '0')}-${defaultDate.getDate().toString().padStart(2, '0')}`
			
        return {
            taskInfo: {
                taskId: '',
                taskNumber: '',
                taskName: '',
                inspectionDate: '',
                publicityDate: '',
                inspectionStartTime: '',
                inspectionEndTime: ''
            } as TaskInfo,
          formData: {
			problemType: '',
			problemDescription: '',
			location: '',
			photos: [],
			rectificationDate: defaultDateStr,
			module: '',
			responsibility: '',
			issue: '',
            quality: '',
            inspector: [],
            responsibleUnit: [],
            responsiblePerson: [],
            departmentId: '',
            checkUnitId: '',
            checkUnitName: '',
            natureModified: 0,
            safetyScore: ''
          } as FormData,
				containerHeight: 0,
				scrollTop: 0,
				showProblemTypeModal: false,
			selectedProblemType: '',
				problemTypes: [
					'安全隐患',
					'设备故障',
					'环境问题',
					'操作违规',
					'制度缺失',
					'其他问题'
			],
				// 级联选择器相关
				showTypePopup: false,
				showModulePopup: false,
				showResponsibilityPopup: false,
				showIssuePopup: false,
				showQualityPopup: false,
				showInspectorPopup: false,
				showResponsiblePersonPopup: false,
				typeOptions: [] as OptionItem[],
				moduleOptions: [] as OptionItem[],
				responsibilityOptions: [] as OptionItem[],
				issueOptions: [] as OptionItem[],
				qualityOptions: [] as OptionItem[],
				inspectorOptions: [] as OptionItem[],
				// 受检单位（部门字典）选项与弹窗
				deptOptions: [] as OptionItem[],
				showDeptPopup: false,
				showInspectedUnitPopup: false,
				showResponsibleUnitPopup: false,
				selectedDeptIndex: -1,
				deptSearchKeyword: '',
				responsibleUnitSearchKeyword: '',
				selectedTypeIndex: -1,
				selectedModuleIndex: -1,
				selectedResponsibilityIndex: -1,
				selectedIssueIndex: -1,
				selectedQualityIndex: -1,
				// 搜索关键字初始值
				typeSearchKeyword: '',
				moduleSearchKeyword: '',
				responsibilitySearchKeyword: '',
				issueSearchKeyword: '',
				qualitySearchKeyword: '',
				// 性质界定已选项（中文名，提到顶层；扣分值由 syncDeductionScore 显式回写）
				selectedQualityName: '',
				// 扣分值显示文本（不入库）：由 syncDeductionScore 显式赋值，规避 uvue computed 在异步回调中不刷新
				deductionScoreDisplay: '',
				inspectorSearchKeyword: '',
				// 日期选择器相关
				datePickerVisible: false,
				pickerValue: [0, 0, 0],
				years: [] as number[],
				months: [] as number[],
				days: [] as number[],
				selectedYear: (() => {
					const tempDate = new Date()
					tempDate.setDate(tempDate.getDate() + 7)
					return tempDate.getFullYear()
				})() as number,
				selectedMonth: (() => {
					const tempDate = new Date()
					tempDate.setDate(tempDate.getDate() + 7)
					return tempDate.getMonth() + 1
				})() as number,
				selectedDay: (() => {
					const tempDate = new Date()
					tempDate.setDate(tempDate.getDate() + 7)
					return tempDate.getDate()
				})() as number,
				// 防抖定时器
				pickerDebounceTimer: null as number | null,
				// 检查内容 -> 性质界定 映射
				issueQualityMap: new Map<string, string>() as IssueQualityMap,
				// Map 对应的键数组,UTS 严格模式下 Array.from(map.keys()) 类型退化成 MutableSet,
				// 用单独的 string[] 做遍历以绕过类型限制
				issueQualityKeys: [] as string[],
				// V3:当前登录用户(含 deptId / deptType),用于判断录入权限和锁定检查单位
				currentUser: {
					id: '',
					realName: '',
					deptId: '',
					deptName: '',
					deptType: 0,
					isMonthlyAdmin: false
				} as CurrentUser,
				// V3:自动带出的性质界定 ID(后台根据 issue 计算),用户改了 → nature_modified=1
				autoFilledQualityId: '',
				// V3:编辑模式(recordId 触发)— 来自 record.uvue 长按菜单「编辑」
				isEditMode: false,
				recordId: '',
				// V3:从后端拉回来的 modification_snapshot,顶部 readonly 展示
				originalSnapshot: ''
			}
		},
		

	

	onLoad(options: UTSJSONObject) {
			const taskId = options.getString('taskId') ?? ''
			const recordId = options.getString('recordId') ?? ''
			const mode = options.getString('mode') ?? ''
			console.log('task-record onLoad: taskId=', taskId, ' recordId=', recordId, ' mode=', mode)

			// V3:加载当前用户(用于权限判定 + 锁定检查单位)
			this.loadCurrentUser().then(() => {
				// 运行部门(0)用户没有录入/编辑权限,toast 提示并返回
				if (!this.currentUser.isMonthlyAdmin && this.currentUser.deptType === 0) {
					uni.showToast({ title: '您的部门为运行部门，无录入权限', icon: 'none', duration: 2000 })
					setTimeout(() => {
						uni.navigateBack()
					}, 1800)
					return
				}
				// 管理部门(1):默认检查单位 = 当前用户所属部门
				this.formData.checkUnitId = this.currentUser.deptId
				this.formData.checkUnitName = this.currentUser.deptName

				// 初始化级联选择器数据 + 字典(无论新增/编辑都得用,先加载)
				this.loadTypeOptions()
				this.loadInspectorOptions()
				this.loadDeptOptions()
				this.loadIssueQualityMap()
				this.initDateArrays()

				// V3:编辑模式:从 record.uvue 长按菜单「编辑」传来
				if (recordId != '' && mode === 'edit') {
					this.isEditMode = true
					this.recordId = recordId
					// 编辑模式跳过录入期校验,在 PUT 时服务端再校验
					this.loadRecordForEdit(recordId)
					return
				}

				if (taskId != null && taskId != '') {
					this.loadTaskInfo(taskId)
				}
			})
		},

		onReady() {
			this.initContainerHeight()
		},
		// 页面卸载时清理未触发的防抖定时器,避免 setTimeout 闭包持有页面实例导致内存泄漏
		onUnload() {
			const timer = this.pickerDebounceTimer
			if (timer !== null) {
				clearTimeout(timer)
				this.pickerDebounceTimer = null
			}
		},
		computed: {
			// 过滤后的专业类别选项
			filteredTypeOptions(): OptionItem[] {
     if (this.typeSearchKeyword == '') {
					return this.typeOptions
				}
				return this.typeOptions.filter(item => 
					item.name.toLowerCase().includes(this.typeSearchKeyword.toLowerCase())
				)
			},
			// 过滤后的模块选项
     filteredModuleOptions(): OptionItem[] {
      if (this.moduleSearchKeyword == '') {
       return this.moduleOptions
      }
				return this.moduleOptions.filter(item => 
					item.name.toLowerCase().includes(this.moduleSearchKeyword.toLowerCase())
				)
			},
			// 过滤后的责任选项
     filteredResponsibilityOptions(): OptionItem[] {
      if (this.responsibilitySearchKeyword == '') {
       return this.responsibilityOptions
      }
				return this.responsibilityOptions.filter(item => 
					item.name.toLowerCase().includes(this.responsibilitySearchKeyword.toLowerCase())
				)
			},
			// 过滤后的问题选项
     filteredIssueOptions(): OptionItem[] {
      if (this.issueSearchKeyword == '') {
       return this.issueOptions
      }
				return this.issueOptions.filter(item => 
					item.name.toLowerCase().includes(this.issueSearchKeyword.toLowerCase())
				)
			},
			// 过滤后的性质界定选项
     filteredQualityOptions(): OptionItem[] {
      if (this.qualitySearchKeyword == '') {
       return this.qualityOptions
      }
				return this.qualityOptions.filter(item =>
					item.name.toLowerCase().includes(this.qualitySearchKeyword.toLowerCase())
				)
			},
     // 过滤后的检查人选项
     filteredInspectorOptions(): OptionItem[] {
      if (this.inspectorSearchKeyword == '') {
       return this.inspectorOptions
      }
				const kw = this.inspectorSearchKeyword.toLowerCase()
				return this.inspectorOptions.filter(item =>
					item.name.toLowerCase().includes(kw) || ((item.displayName ?? '').toLowerCase().includes(kw))
				)
			},
			// 过滤后的责任人选项（支持按昵称或用户名匹配）
			filteredResponsiblePersonOptions(): OptionItem[] {
				if (this.inspectorSearchKeyword == '') {
					return this.inspectorOptions
				}
				const kw = this.inspectorSearchKeyword.toLowerCase()
				return this.inspectorOptions.filter(item =>
					item.name.toLowerCase().includes(kw) || ((item.displayName ?? '').toLowerCase().includes(kw))
				)
			},
			// 过滤后的部门选项
			filteredDeptOptions(): OptionItem[] {
				if (this.deptSearchKeyword == '') {
					return this.deptOptions
				}
				return this.deptOptions.filter(item =>
					item.name.toLowerCase().includes(this.deptSearchKeyword.toLowerCase())
				)
			},
			// 过滤后的责任单位（按部门名）选项
			filteredResponsibleUnitOptions(): OptionItem[] {
				if (this.responsibleUnitSearchKeyword == '') {
					return this.deptOptions
				}
				return this.deptOptions.filter(item =>
					item.name.toLowerCase().includes(this.responsibleUnitSearchKeyword.toLowerCase())
				)
			},
			// 当前选中的受检单位名称
			selectedInspectedUnitName(): string {
				if (this.selectedDeptIndex === -1) return ''
				const opt = this.deptOptions[this.selectedDeptIndex]
				return opt != null ? opt.name : ''
			},
		},
		methods: {
			// 扣分值同步（不入库）：根据性质界定中文名显式回写到 deductionScoreDisplay 数据字段。
			// 规避 uvue 中 computed 依赖在 uni.request 异步回调里被赋值时不重新求值的问题
			// （现象：性质界定自动回写成功、扣分值却仍为空）。观察→1 一般→3 重要→5，与 web AddDialog.vue 一致。
			syncDeductionScore() {
				// 直接取「性质界定选择框显示所用的同一数据源」qualityOptions[selectedQualityIndex].name：
				// 既然该处能正常显示出中文名,这里就能拿到同样的值,避免 selectedQualityName 未同步导致漏判。
				let name = ''
				if (this.selectedQualityIndex !== -1 && this.selectedQualityIndex < this.qualityOptions.length) {
					const opt = this.qualityOptions[this.selectedQualityIndex] as OptionItem
					name = opt.name
				}
				if (name === '') {
					name = this.selectedQualityName
				}
				// 归一:数字码(1/2/3)翻译成中文;再用包含匹配兼容「一般问题」等带后缀写法
				const trimmed = stripOuterWhitespace(name)
				const normalized = resolveQualityLabel(trimmed, trimmed)
				if (normalized.indexOf('观察') !== -1) {
					this.deductionScoreDisplay = '1'
				} else if (normalized.indexOf('一般') !== -1) {
					this.deductionScoreDisplay = '3'
				} else if (normalized.indexOf('重要') !== -1) {
					this.deductionScoreDisplay = '5'
				} else {
					this.deductionScoreDisplay = ''
				}
				const optScore = (this.selectedQualityIndex !== -1 && this.selectedQualityIndex < this.qualityOptions.length) ? ((this.qualityOptions[this.selectedQualityIndex] as OptionItem).score ?? '<null>') : '<no-index>'
				console.log('syncDeductionScore: name=[' + name + '] normalized=[' + normalized + '] display=[' + this.deductionScoreDisplay + '] optScore=[' + optScore + '] optsLen=' + this.qualityOptions.length)
			},
			// V3:编辑模式 — GET 单条记录,回填表单 + 顶部 readonly 显示 modification_snapshot
			loadRecordForEdit(recordId: string) {
				const token = uni.getStorageSync('token')
				uni.request({
					url: getApiUrl(`/monthly-inspection-record/${recordId}`),
					method: 'GET',
					header: { 'Authorization': `Bearer ${token}` },
					success: (res) => {
						const body = res.data as UTSJSONObject
						if (res.statusCode !== 200 || (body.getNumber('code') ?? 0) !== 200) {
							uni.showToast({ title: body.getString('message') ?? '加载记录失败', icon: 'none' })
							setTimeout(() => { uni.navigateBack() }, 1500)
							return
						}
						const d = body.getJSON('data')
						if (d == null) {
							uni.showToast({ title: '记录不存在', icon: 'none' })
							setTimeout(() => { uni.navigateBack() }, 1500)
							return
						}
						const dObj = d as UTSJSONObject
						// modification_snapshot 字段(若后端已支持)— 顶部 readonly 展示
						const snap = dObj.getString('modificationSnapshot') ?? ''
						this.originalSnapshot = snap
						// 回填表单字段
						this.formData.problemDescription = dObj.getString('problemDescription') ?? ''
						this.formData.location = dObj.getString('location') ?? ''
						const photos = dObj.getString('photos') ?? ''
						if (photos != '' && photos != null) {
							const photoArr = photos.split(',').map(s => stripOuterWhitespace(s)).filter(s => s != '')
							this.formData.photos = photoArr
						}
						const rectDate = dObj.getString('rectificationDate') ?? dObj.getString('rectificationDeadline') ?? ''
						if (rectDate != '' && rectDate != null) {
							const norm = rectDate.length >= 10 ? rectDate.substring(0, 10) : rectDate
							this.formData.rectificationDate = norm
						}
						const insp = dObj.getString('inspector') ?? ''
						if (insp != '' && insp != null) {
							const parts = insp.split(/[、,]/).map(s => stripOuterWhitespace(s)).filter(s => s != '')
							this.formData.inspector = parts
						}
						const ru = dObj.getString('responsibleUnit') ?? ''
						if (ru != '' && ru != null) {
							const parts = ru.split(/[、,]/).map(s => stripOuterWhitespace(s)).filter(s => s != '')
							this.formData.responsibleUnit = parts
						}
						const rp = dObj.getString('responsiblePerson') ?? ''
						if (rp != '' && rp != null) {
							const parts = rp.split(/[、,]/).map(s => stripOuterWhitespace(s)).filter(s => s != '')
							this.formData.responsiblePerson = parts
						}
						this.formData.departmentId = dObj.getString('departmentId') ?? ''
						this.formData.checkUnitId = dObj.getString('checkUnitId') ?? this.currentUser.deptId
						this.formData.checkUnitName = dObj.getString('checkUnitName') ?? this.currentUser.deptName
						// 级联 id 直接存的就是 name(与现有约定一致)— 等字典加载完后用 watch 同步索引
						this.formData.problemType = dObj.getString('professionalTypeName') ?? dObj.getString('professionalCategory') ?? ''
						this.formData.module = dObj.getString('moduleName') ?? ''
						this.formData.responsibility = dObj.getString('responsibilityName') ?? ''
						this.formData.issue = dObj.getString('issueName') ?? ''
						this.formData.quality = dObj.getString('qualityName') ?? ''
						this.formData.safetyScore = ''
						this.formData.natureModified = (dObj.getNumber('natureModified') ?? 0) as number
						this.taskInfo.taskId = dObj.getString('taskId') ?? ''
						uni.showToast({ title: '已进入编辑模式', icon: 'none', duration: 1500 })
					},
					fail: () => {
						uni.showToast({ title: '网络错误', icon: 'none' })
						setTimeout(() => { uni.navigateBack() }, 1500)
					}
				})
			},
			// V3:加载当前登录用户(含 deptType),用于权限判定
			// resolveCurrentDept 先刷新服务端 userInfo 再取部门类型，避免用登录时的旧 deptId 快照判定角色
			loadCurrentUser(): Promise<void> {
				return new Promise<void>((resolve) => {
					resolveCurrentDept().then((dept: CurrentDept) => {
						const info = getCachedUserInfo()
						// 月检管理员判断必须放在刷新之后，isMonthlyAdmin() 读的是刷新后的本地快照
						const admin = isMonthlyAdmin()
						this.currentUser = {
							id: info.getString('id') ?? '',
							realName: info.getString('realName') ?? info.getString('username') ?? '',
							deptId: dept.deptId,
							deptName: dept.deptName,
							deptType: dept.deptType ?? 0,
							isMonthlyAdmin: admin
						} as CurrentUser
						resolve()
					})
				})
			},

// 预览照片
			previewPhoto(photo: string) {
				uni.previewImage({
					current: this.convertToHttpUrl(photo),
					urls: this.formData.photos.map((p: string) => this.convertToHttpUrl(p)) as string[]
				})
			},
			// 获取默认整改期限（当前日期往后推三个月）
			getDefaultRectificationDate(): string {
				const now = new Date()
				const year = now.getFullYear()
				const month = (now.getMonth() + 1).toString()
				const day = now.getDate().toString()
				// 手动补零
				const padZero = (num: string): string => {
					return num.length < 2 ? `0${num}` : num
				}
				return `${year}-${padZero(month)}-${padZero(day)}`
			},
			// 将相对路径转换为HTTP访问路径
			convertToHttpUrl(relativePath: string): string {
				console.log('相对路径:', relativePath)
				// 如果已经是HTTP路径，直接返回
				if (relativePath.startsWith('http://') || relativePath.startsWith('https://')) {
					return relativePath
				}
				
				// 直接拼接完整的HTTP URL
				// 后端已返回相对路径，如: /files/images/20250818/xxx.jpg
				const httpUrl = `${apiConfig.baseUrl}/api${relativePath}`
				console.log('转换后的HTTP URL:', httpUrl)
				return httpUrl
			},
			// 初始化容器高度
			initContainerHeight() {
				const systemInfo = uni.getSystemInfoSync()
				this.containerHeight = systemInfo.windowHeight
			},
			
			// 加载任务信息
			loadTaskInfo(taskId: string) {
				try {
					const token = uni.getStorageSync('token')
					console.log('接收到的taskId参数:', taskId)
					// 使用task-no接口根据任务编号获取任务详情
					uni.request({
						url: getApiUrl(`/monthly-inspection-task/task-no/${taskId}`),
						method: 'GET',
						header: {
							'Authorization': `Bearer ${token}`
						},
						success: (res) => {
							const respdata=res.data as UTSJSONObject;
                            if ( respdata.getNumber('code')=== 200) {
                                const taskInfo = respdata.getJSON('data')
                                console.log("获取到的任务数据:",taskInfo)
                                if (taskInfo != null) {
                                    // 后端字段是 inspectionStartTime/inspectionEndTime/publicityStartTime/publicityEndTime
                                    // 显示形如 "2026-08-01 ~ 2026-08-31"
                                    const startStr = taskInfo.getString('inspectionStartTime') ?? ''
                                    const endStr = taskInfo.getString('inspectionEndTime') ?? ''
                                    const pStartStr = taskInfo.getString('publicityStartTime') ?? ''
                                    const pEndStr = taskInfo.getString('publicityEndTime') ?? ''
                                    const joinDateRange = (a: string, b: string): string => {
                                        if (a == '' && b == '') return ''
                                        if (a == '') return b
                                        if (b == '' || a == b) return a
                                        return `${a} ~ ${b}`
                                    }
                                    this.taskInfo = {
                                        taskId: taskInfo.getString('id') ?? '',
                                        taskNumber: taskInfo.getString('taskNo') ?? '',
                                        taskName: taskInfo.getString('taskName') ?? '',
                                        inspectionDate: joinDateRange(startStr, endStr),
                                        publicityDate: joinDateRange(pStartStr, pEndStr),
                                        inspectionStartTime: startStr,
                                        inspectionEndTime: endStr
                                    }
									// 自动填充性质界定
									this.autoFillProfession()
								}
							}
						},
						fail: (error) => {
							console.error('加载任务信息失败:', error)
							// 模拟数据
                        this.taskInfo = {
                            taskId: '',
                            taskNumber: 'YJ202401001',
                            taskName: '示例月检任务',
                            inspectionDate: '2024年1月',
                            publicityDate: '2024年1月',
                            inspectionStartTime: '',
                            inspectionEndTime: ''
                        }
						}
					})
				} catch (error) {
					console.error('加载任务信息失败:', error)
					// 模拟数据
                    this.taskInfo = {
                        taskId: '',
                        taskNumber: 'YJ202401001',
                        taskName: '示例月检任务',
                        inspectionDate: '2024年1月',
                        publicityDate: '2024年1月',
                        inspectionStartTime: '',
                        inspectionEndTime: ''
                    }
				}
			},
			
