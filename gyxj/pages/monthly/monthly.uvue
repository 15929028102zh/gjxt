<template>
	<scroll-view 
		class="container" 
		scroll-y="true" 
		:scroll-top="scrollTop" 
		:style="{height: containerHeight + 'px'}" 
		enable-back-to-top="true"
		refresher-enabled="true"
		:refresher-triggered="isRefreshing"
		refresher-default-style="black"
		refresher-background="#f5f5f5"
		@refresherrefresh="onRefresh"
		@refresherrestore="onRefreshRestore"
	>
		<!-- 顶部欢迎区域 -->
		<view class="header">
			<view class="welcome">
				<text class="greeting">欢迎回来，{{userName}}</text>
				<text class="app-name">{{currentDate}}</text>
				<!-- 通知图标：点击打开通知弹窗 -->
				<view class="notification-icon-wrapper" @click="showNotifications">
					<text class="icon-bell">🔔</text>
					<!-- 角标：未读数量小于等于99 -->
					<view v-if="notificationCount > 0 && notificationCount <= 99" class="notification-badge">
						<text class="badge-text">{{notificationCount}}</text>
					</view>
					<!-- 超过99显示99+ -->
					<view v-else-if="notificationCount > 99" class="notification-badge">
						<text class="badge-text">99+</text>
					</view>
				</view>
			</view>
			<view class="header-right">
				<view class="user-avatar" @click="goToProfile">
					<image v-if="userInfo != null && (userInfo.getString('avatar') ?? '') != ''" 
						   class="avatar-image" 
						   :src="userInfo.getString('avatar') ?? ''" 
						   mode="aspectFill">
					</image>
					<text v-else class="avatar-placeholder">{{userName.charAt(0)}}</text>
				</view>
			</view>
		</view>
		
		<!-- 快捷功能区 -->
		<view class="action-buttons">
			<!-- 与 Web 端一致：新增/问题录入入口恒显示（Web monthly/index.vue 的新增按钮无 v-if）；
			     非月检管理员进入录入表单后，受检单位由后端按其部门隔离 -->
			<view class="action-button" @click="goToAddRecord">
				<view class="button-icon">➕</view>
				<text class="button-text">问题录入</text>
				<text class="button-text-sub">选择任务后录入问题</text>
			</view>
			<view class="action-button delayed-button" @click="goToDelayedRecord">
				<view class="button-icon">⏰</view>
				<text class="button-text">延迟整改</text>
				<text class="button-text-sub">延期问题处理</text>
			</view>
		</view>
		
		<!-- 数据统计区 -->
		<view class="stats-container">
			<view class="stats-card" @click="goToPendingIssues">
				<text class="stats-number">{{statistics.monthlyPending}}</text>
				<text class="stats-label">待整改</text>
				<text class="stats-icon">⚠️</text>
			</view>
			<view class="stats-card" @click="goToCompletedIssues">
				<text class="stats-number">{{statistics.monthlyCompleted}}</text>
				<text class="stats-label">已整改</text>
				<text class="stats-icon">✅</text>
			</view>
			<view class="stats-card" @click="goToReviewedRecords">
				<text class="stats-number">{{statistics.reviewedCount}}</text>
				<text class="stats-label">已复查数量</text>
				<text class="stats-icon">✅</text>
			</view>
		</view>
		
				<!-- 通知消息弹窗 -->
		<view v-if="showNotificationModal" class="notification-modal" @click="hideNotifications">
			<view class="notification-content" @click.stop>
				<view class="notification-header">
					<text class="notification-title">通知消息</text>
					<view class="notification-actions">
						<text class="close-btn" @click="hideNotifications">×</text>
					</view>
				</view>
				
				<!-- 通知分类标签 -->
				<view class="notification-tabs">
					<view class="tab-item" 
						  :class="{active: activeNotificationTab === 'system'}"
						  @click="switchNotificationTab('system')">
						<text class="tab-text">系统通知</text>
					</view>
					<view class="tab-item" 
						  :class="{active: activeNotificationTab === 'tasks'}"
						  @click="switchNotificationTab('tasks')">
						<text class="tab-text">月检任务</text>
					</view>
				</view>
				
				<!-- 系统通知列表 -->
				<view v-if="activeNotificationTab === 'system'" class="tab-content">
					<view class="tab-header">
						<text class="mark-all-read" @click="markAllAsRead">全部已读</text>
					</view>
					<scroll-view class="notification-list" 
								 scroll-y="true" 
								 :show-scrollbar="true"
								 :enable-back-to-top="false">
						<view v-if="notifications.length === 0" class="empty-notifications">
							<text class="empty-text">暂无通知</text>
						</view>
						<view v-for="notification in notifications" :key="notification.id" 
							  class="notification-item" 
							  :class="{unread: !notification.isRead}"
							  @click="handleNotificationClick(notification)">
							<view class="notification-dot" v-if="!notification.isRead"></view>
							<view class="notification-info">
								<text class="notification-item-title">{{notification.title}}</text>
								<text class="notification-item-content">{{notification.content}}</text>
								<text class="notification-time">{{notification.createTime}}</text>
							</view>
							<text class="notification-arrow">›</text>
						</view>
					</scroll-view>
				</view>
				
				<!-- 月检任务通知列表 -->
				<view v-if="activeNotificationTab === 'tasks'" class="tab-content">
					<view class="tab-header">
							<text class="refresh-btn" @click="refreshTaskNotifications">刷新</text>
					</view>
					<scroll-view class="notification-list" 
								 scroll-y="true" 
								 :show-scrollbar="true"
								 :enable-back-to-top="false">
						<view v-if="taskNotifications.length === 0" class="empty-notifications">
								<text class="empty-text">暂无已通知的月检任务</text>
						</view>
						<view v-for="taskNotification in taskNotifications" :key="taskNotification.id" 
							  class="notification-item task-notification"
							  @click="handleTaskNotificationClick(taskNotification)">
							<view class="task-status-badge" :class="getTaskStatusClass(taskNotification.status)">
								<text class="status-text">{{getTaskStatusText(taskNotification.status)}}</text>
							</view>
							<view class="notification-info">
								<text class="notification-item-title">{{taskNotification.title}}</text>
								<text class="notification-item-content">
										任务编号：{{taskNotification.taskNo}}
										月检时间：{{taskNotification.inspectionMonth}}
										任务状态：{{getTaskStatusText(taskNotification.status)}}
									{{taskNotification.content}}
								</text>
								<text class="notification-time">{{taskNotification.createTime}}</text>
							</view>
							<text class="notification-arrow">›</text>
						</view>
					</scroll-view>
				</view>
			</view>
		</view>

		<!-- 任务选择器弹窗 -->
		<view v-if="showTaskPickerModal" class="task-picker-overlay" @click="closeTaskPicker">
			<view class="task-picker" @click.stop>
				<view class="task-picker-header">
					<text class="task-picker-title">选择月检任务</text>
					<text class="task-picker-close" @click="closeTaskPicker">×</text>
				</view>
				<view class="task-picker-search">
					<input class="search-input" v-model="taskPickerKeyword" placeholder="搜索任务名称或编号" />
				</view>
				<view class="task-picker-body">
						<view v-if="taskPickerLoading" class="empty-tasks">加载中...</view>
						<view v-else-if="filteredTaskPickerList.length === 0" class="empty-tasks">暂无匹配任务</view>
					<view v-else>
						<view class="task-item" v-for="t in filteredTaskPickerList" :key="t.getString('id')" @click="pickTaskAndGo(t)">
								<text class="task-title">{{ t.getString('taskName') ?? '月检任务' }}</text>
								<text class="task-sub">任务编号：{{ t.getString('taskNo') ?? '' }}  月检时间：{{ formatTaskDateRange(t) }}</text>
						</view>
					</view>
				</view>
			</view>
		</view>
	</scroll-view>
</template>

<script lang="uts">
	import { getApiUrl, apiConfig } from '@/config/api.uts'
	import { wsClient } from '@/utils/ws-client.uts'
	import { notificationStore, fetchFromServer as fetchNotificationsFromStore, markRead as storeMarkRead, markAllRead as storeMarkAllRead, NotificationItem } from '@/stores/notification.uts'
	import { isMonthlyAdmin } from '@/utils/permission.uts'
	import { resolveCurrentDept, CurrentDept } from '@/utils/user.uts'
	// V3：根据当前用户权限(deptType/isMonthlyAdmin)加载对应数据模板
	// deptType 与 admin 解耦(对齐 Web)：deptType=部门真实角色(1=管理/检查单位 0=运行/受检单位)，
	// isMonthlyAdmin=月检管理员(严格 isMonthlyAdmin===1)，管理员看全部数据、不受 deptType 过滤
	type CurrentUser = {
		deptId: string
		deptName: string
		deptType: number
		isMonthlyAdmin: boolean
	}
	type MonthlyRecord = {
		id: string,
		problemDescription: string,
		locationName: string,
		createTime: string,
		status: string
	}

	type MonthlyStatistics = {
		monthlyPending: number,
		monthlyCompleted: number,
		reviewedCount: number
	}

	type Notification = {
		id: string,
		taskId: string,
		taskNo: string,
		title: string,
		content: string,
		createTime: string,
		isRead: boolean
	}

	type TaskNotification = {
		id: string,
		taskId: string,
		taskNo: string,
		title: string,
		content: string,
		createTime: string,
		status: string,
		inspectionMonth: string
	}

	export default {
		data() {
			return {
					userInfo: {} as UTSJSONObject,
					userName: '用户', // 简化的用户名称（首字符头像）
					currentDate: '',
					statistics: {
						monthlyPending: 0,
						monthlyCompleted: 0,
						reviewedCount: 0
					} as MonthlyStatistics,
					monthlyRecords: [] as MonthlyRecord[],
					notifications: [] as Notification[],
					taskNotifications: [] as TaskNotification[],
					notificationCount: 0,
				showNotificationModal: false,
			activeNotificationTab: 'system', // 系统通知/任务通知 tab
				showTaskPickerModal: false,
				taskPickerLoading: false,
				taskPickerList: [] as Array<UTSJSONObject>,
				taskPickerLoaded: false,
				taskPickerKeyword: '',
					// WebSocket 连接已迁移到全局 wsClient(@/utils/ws-client.uts)
				// 通知状态由 notificationStore(@/stores/notification.uts) 全局维护

					scrollTop: 0,
					containerHeight: 0,
				// 是否下拉刷新中
				isRefreshing: false,
				// 下拉刷新定时器(用于 onHide/onUnload 清理,避免 setTimeout 闭包持有页面导致内存泄漏)
				refreshTimer: null as number | null,
				// V3：deptType(0=运行部门 1=管理部门) 与 isMonthlyAdmin 解耦，共同决定可见功能与数据范围
					currentUser: {
						deptId: '',
						deptName: '',
						deptType: 0,
						isMonthlyAdmin: false
					} as CurrentUser
				}
			},
		onLoad(options: OnLoadOptions) {
			this.checkLogin()
			this.initData()
			this.initContainerHeight()
		// V3：先加载当前用户信息(deptType/isMonthlyAdmin)，再据此拉取统计与记录；
		// 否则 currentUser 为默认值会导致部门过滤失效(管理员应看全部、非管理员按 deptType 过滤)
				this.loadCurrentUser().then(() => {
					this.loadStatistics()
					this.loadMonthlyRecords()
					this.loadNotifications()
				})
		},
		
	// 初始化页面时建立 WebSocket 连接
		onShow() {
			console.log('页面显示，同步通知')
			this.syncNotificationsFromStore()
			// 新增/编辑返回时刷新记录与统计：navigateBack 不触发 onLoad，仅 onShow，
			// 否则 task-record 保存成功的记录不会出现在列表里，给人"没保存"的错觉
			this.loadStatistics()
			this.loadMonthlyRecords()
		},
		
	// 页面关闭时清理 WebSocket
		onHide() {
			console.log('页面隐藏')
			if (this.refreshTimer !== null) { clearTimeout(this.refreshTimer!); this.refreshTimer = null }
			this.disconnectWebSocket()
		},
		
	// 页面隐藏时清理 WebSocket
		onUnload() {
			console.log('页面卸载')
			if (this.refreshTimer !== null) { clearTimeout(this.refreshTimer!); this.refreshTimer = null }
			this.disconnectWebSocket()
		},
		computed: {
			filteredTaskPickerList(): Array<UTSJSONObject> {
				const kw = this.taskPickerKeyword.trim().toLowerCase()
				if (kw == '') return this.taskPickerList
				return this.taskPickerList.filter(t => {
					const no = (t.getString('taskNo') ?? '').toLowerCase()
					const name = (t.getString('taskName') ?? '').toLowerCase()
					return no.includes(kw) || name.includes(kw)
				})
			}
		},
		methods: {
			checkLogin() {
				const token = uni.getStorageSync('token')
				if (token == null || token == '') {
					uni.reLaunch({
						url: '/pages/login/login'
					})
					return
				}
				// 校验 token 是否已过期(与后端24小时有效期一致)：过期则清除并跳转登录，
				// 否则带着僵尸token会让后续所有需认证接口静默返回403（本次问题根因）
				const expiresData = uni.getStorageSync('tokenExpires')
				const expiresStr = expiresData != null ? `${expiresData}` : ''
				if (expiresStr != '' && expiresStr != 'null' && expiresStr != 'undefined') {
					const expiresAt = parseInt(expiresStr)
					if (!isNaN(expiresAt) && Date.now() >= expiresAt) {
						uni.removeStorageSync('token')
						uni.removeStorageSync('tokenExpires')
						uni.showToast({ title: '登录已过期，请重新登录', icon: 'none' })
						uni.reLaunch({ url: '/pages/login/login' })
						return
					}
				}
				const userInfoStr = uni.getStorageSync('userInfo') as string
				if (userInfoStr != null && userInfoStr != '') {
					this.userInfo = JSON.parse(userInfoStr) as UTSJSONObject
				// 提取真实姓名
					const realName = this.userInfo.getString('realName') ?? ''
					this.userName = realName != '' ? realName : '用户'
				} else {
					this.userInfo = {} as UTSJSONObject
					this.userName = '用户'
				}
			},

			// 统一的认证失败处理：后端对过期/无效token的未认证请求返回403（无自定义EntryPoint），
			// 命中时清除本地token并跳转登录页，避免僵尸token导致所有接口静默403。返回是否已处理。
			handleAuthFailure(statusCode: number): boolean {
				if (statusCode == 401 || statusCode == 403) {
					uni.removeStorageSync('token')
					uni.removeStorageSync('tokenExpires')
					uni.showToast({ title: '登录已失效，请重新登录', icon: 'none' })
					uni.reLaunch({ url: '/pages/login/login' })
					return true
				}
				return false
			},

			// V3：加载当前用户 deptType(真实部门角色) 与 isMonthlyAdmin(月检管理员)，二者解耦(对齐 Web)
			// 管理员不再被强制置 deptType=1；deptType 始终取部门真实类型，isMonthlyAdmin 决定是否看全部
			// resolveCurrentDept 先刷新服务端 userInfo 再取部门类型，避免用登录时的旧 deptId 快照判定角色
			loadCurrentUser(): Promise<void> {
				return new Promise<void>((resolve) => {
					resolveCurrentDept().then((dept: CurrentDept) => {
						// 月检管理员判断必须放在刷新之后，isMonthlyAdmin() 读的是刷新后的本地快照
						const admin = isMonthlyAdmin()
						this.currentUser = {
							deptId: dept.deptId,
							deptName: dept.deptName,
							deptType: dept.deptType ?? 0,
							isMonthlyAdmin: admin
						}
						resolve()
					})
				})
			},

			// V3：月检管理员看全部(不加部门过滤，对齐 Web applyDeptFilter 仅对非管理员生效)；
			// 非管理员按真实 deptType 过滤：管理部门(1)→checkUnitId，运行部门(0)→departmentId
			buildDeptFilter(): string {
				if (this.currentUser.isMonthlyAdmin) return ''
				const deptId = this.currentUser.deptId
				if (deptId == '') return ''
				const deptType = this.currentUser.deptType
				if (deptType === 1) return `&checkUnitId=${deptId}`
				if (deptType === 0) return `&departmentId=${deptId}`
				return ''
			},
			
			initData() {
				const now = new Date()
				const year = now.getFullYear()
				const month = (now.getMonth() + 1).toString()
				const formattedMonth = month.length == 1 ? `0${month}` : month
				const day = now.getDate().toString()
				const formattedDay = day.length == 1 ? `0${day}` : day
				const weekdays = ['日', '一', '二', '三', '四', '五', '六']
				const weekday = weekdays[now.getDay()]
				this.currentDate = `${year}年${formattedMonth}月${formattedDay}日 星期${weekday}`
			},
			
			loadStatistics() {
				const token = uni.getStorageSync('token')

			// V3：部门过滤统一由 buildDeptFilter() 决定(管理员看全部/非管理员按 deptType)，不再读取已废弃的 isAdmin
                const deptParam = this.buildDeptFilter()

			// 一次性请求所有月份的统计数据，避免循环请求
				let pendingCount = 0
				let completedCount = 0
				let reviewedCount = 0
				let completedRequests = 0
				const totalRequests = 3

				const updateStatistics = () => {
					this.statistics = {
						monthlyPending: pendingCount,
						monthlyCompleted: completedCount,
						reviewedCount: reviewedCount
					}
				}

			// 遍历数据，累加待整改数量(月份0)
				uni.request({
                    url: getApiUrl(`/monthly-inspection-record/page?current=1&size=1&recordStatus=0${deptParam}`),
                    method: 'GET',
                    header: {
                        'Authorization': `Bearer ${token}`
                    },
                    success: (res) => {
                        const response = res.data as UTSJSONObject
                        if (res.statusCode === 200 && (response.getNumber('code') ?? 0) === 200) {
                            const data = response.getJSON('data') as UTSJSONObject
                            pendingCount = data.getNumber('total') ?? 0
                        }
                        completedRequests++
                        if (completedRequests === totalRequests) {
                            updateStatistics()
                        }
                    },
					fail: (error) => {
						console.log('待整改数量请求错误:', error)
						completedRequests++
						if (completedRequests === totalRequests) {
							updateStatistics()
						}
					}
				})
				
			// 遍历数据，累加已整改数量(月份1)
				uni.request({
                    url: getApiUrl(`/monthly-inspection-record/page?current=1&size=1&recordStatus=1${deptParam}`),
                    method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
						const response = res.data as UTSJSONObject
						if (res.statusCode === 200 && (response.getNumber('code') ?? 0) === 200) {
							const data = response.getJSON('data') as UTSJSONObject
							completedCount = data.getNumber('total') ?? 0
						}
						completedRequests++
						if (completedRequests === totalRequests) {
							updateStatistics()
						}
					},
					fail: (error) => {
						console.log('已整改数量请求错误:', error)
						completedRequests++
						if (completedRequests === totalRequests) {
							updateStatistics()
						}
					}
				})
				
			// 遍历数据，累加已审核数量
				uni.request({
                    url: getApiUrl(`/monthly-inspection-record/page?current=1&size=1&recordStatus=2${deptParam}`),
                    method: 'GET',
                    header: {
                        'Authorization': `Bearer ${token}`
                    },
                    success: (res) => {
                        const response = res.data as UTSJSONObject
                        if (res.statusCode === 200 && (response.getNumber('code') ?? 0) === 200) {
                            const data = response.getJSON('data') as UTSJSONObject
                            reviewedCount = data.getNumber('total') ?? 0
                        }
				// 倒序遍历找到第一个已完成或已审核的月检，作为'最近一次有效检查'
                        const now = new Date()
                        const y = now.getFullYear()
                        const m = now.getMonth() + 1
                        const d = now.getDate()
                        const mm = m < 10 ? ('0' + m) : ('' + m)
                        const dd = d < 10 ? ('0' + d) : ('' + d)
                        const today = `${y}-${mm}-${dd}`
                        uni.request({
                            url: getApiUrl(`/monthly-inspection-record/page?current=1&size=1&recordStatus=0&rectificationDeadlineBefore=${today}${this.buildDeptFilter()}`),
                            method: 'GET',
                            header: { 'Authorization': `Bearer ${token}` },
                            success: (res2) => {
                                const resp2 = res2.data as UTSJSONObject
                                if (res2.statusCode === 200 && (resp2.getNumber('code') ?? 0) === 200) {
                                    const data2 = resp2.getJSON('data') as UTSJSONObject
                                    const delayedCount = data2.getNumber('total') ?? 0
					// 找到有效月检，跳出循环
                                    //pendingCount = Math.max(0, pendingCount - delayedCount)
                                }
                                completedRequests++
                                if (completedRequests === totalRequests) {
                                    updateStatistics()
                                }
                            },
                            fail: (_) => {
                                completedRequests++
                                if (completedRequests === totalRequests) {
                                    updateStatistics()
                                }
                            }
                        })
                    },
                    fail: (error) => {
                        console.log('已复查数量请求错误:', error)
                        completedRequests++
                        if (completedRequests === totalRequests) {
                            updateStatistics()
                        }
                    }
                })
			},
			
			loadMonthlyRecords() {
				const token = uni.getStorageSync('token')

			// V3：根据 deptType 与筛选条件决定 checkUnitId / departmentId 参数
				const deptParam = this.buildDeptFilter()

                uni.request({
                    url: getApiUrl(`/monthly-inspection-record/page?current=1&size=10${deptParam}`),
                    method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
						const response = res.data as UTSJSONObject
						if (res.statusCode === 200 && (response.getNumber('code') ?? 0) === 200) {
							const data = response.getJSON('data') as UTSJSONObject
							const records = data.getArray('records') as Array<UTSJSONObject>
							this.monthlyRecords = []
							for (let i = 0; i < records.length; i++) {
								const item = records[i]
								const record: MonthlyRecord = {
									id: item.getString('id') ?? '',
									problemDescription: item.getString('problemDescription') ?? '',
									locationName: item.getString('locationName') ?? '',
									createTime: item.getString('createTime') ?? '',
									status: item.getString('status') ?? ''
								}
								this.monthlyRecords.push(record)
							}
						}
					},
					fail: (error) => {
						console.log('加载月检记录失败:', error)
					}
				})
			},
			
			// 根据状态返回中文描述
			getStatusText(status: string): string {
				if (status == "0") return '待整改'
				if (status == "1") return '已整改'
				if (status == "2") return '已复查'
				return '未知'
			},
			
			getStatusClass(status: string): string {
				if (status == "0") return 'status-pending'
				if (status == "1") return 'status-completed'
				if (status == "2") return 'status-accepted'
				return 'status-unknown'
			},
			
			// 根据任务状态返回中文描述（0-待整改 1-已整改 2-已审核）
			getTaskStatusText(status: string): string {
				if (status == "0") return '待整改'
				if (status == "1") return '已整改'
				if (status == "2") return '已审核'
				return '未知'
			},
			
			getTaskStatusClass(status: string): string {
				if (status == "0") return 'status-pending'
				if (status == "1") return 'status-processing'
				if (status == "2") return 'status-completed'
				return 'status-unknown'
			},

			// 格式化任务时间范围(inspectionStartTime/EndTime 转为短格式 'MM-dd ~ MM-dd')
			formatTaskDateRange(t: UTSJSONObject): string {
				const start = t.getString('inspectionStartTime') ?? ''
				const end = t.getString('inspectionEndTime') ?? ''
				const sliceMD = (s: string): string => {
			// 仅显示日期部分 '2026-08-01 00:00:00' -> '08-01'
					if (s == '') return ''
					const m = s.match(/^(\d{4})-(\d{2})-(\d{2})/)
					if (m == null) return s
					return `${m[2]}-${m[3]}`
				}
				const s = sliceMD(start)
				const e = sliceMD(end)
				if (s != '' && e != '' && s != e) return `${s} ~ ${e}`
				return s != '' ? s : e
			},
			
			goToPendingIssues() {
				const now = new Date()
				const y = now.getFullYear()
				const m = now.getMonth() + 1
				const d = now.getDate()
				const mm = m < 10 ? ('0' + m) : ('' + m)
				const dd = d < 10 ? ('0' + d) : ('' + d)
				const today = `${y}-${mm}-${dd}`
				uni.navigateTo({
					url: `/pages/record/record?status=0&monthly=true&deadlineFrom=${today}`
				})
			},
			
			goToCompletedIssues() {
				uni.navigateTo({
					url: '/pages/record/record?status=1&monthly=true'
				})
			},
			
			goToMonthlyReport() {
				uni.navigateTo({
					url: '/pages/statistics/statistics'
				})
			},
			
			goToDelayedRecord() {
				const now = new Date()
				const y = now.getFullYear()
				const m = now.getMonth() + 1
				const d = now.getDate()
				const mm = m < 10 ? ('0' + m) : ('' + m)
				const dd = d < 10 ? ('0' + d) : ('' + d)
				const today = `${y}-${mm}-${dd}`
				uni.navigateTo({
					url: `/pages/record/record?status=0&monthly=true&delayed=true&deadlineBefore=${today}`
				})
			},
			
			goToRecords() {
				uni.showToast({
					title: '加载中',
					icon: 'none'
				})
			},
			
			goToAddRecord() {
				this.openTaskPicker()
			},
			openTaskPicker() {
				const token = uni.getStorageSync('token')

			// 替代 Web TaskSelectDialog 弹窗：跳转到任务选择页 /monthly-inspection-task/page
			// 如果走接口 /notifications/department/{deptId}/tasks 拿数据，前端处理有 403 风险；改为跳页查完整数据
				if (this.taskPickerLoaded && !this.taskPickerLoading) {
					this.showTaskPickerModal = true
					return
				}
				this.taskPickerLoading = true
				const url = getApiUrl(`/monthly-inspection-task/page?current=1&size=100`)
				console.log('请求月检任务列表URL:', url)

				uni.request({
					url: url,
					method: 'GET',
					header: { 'Authorization': `Bearer ${token}` },
					success: (res) => {
						console.log('月检任务列表请求成功:', res)
						const list = [] as Array<UTSJSONObject>
						if (res.statusCode === 200) {
							const body = res.data as UTSJSONObject
							const pageData = body.getJSON('data')
							const records = (pageData != null ? pageData.getArray('records') : null) as Array<UTSJSONObject> | null
							const arr = records != null ? records : ([] as Array<UTSJSONObject>)
						console.log('任务通知数组:', arr.length, '条')
							for (let i = 0; i < arr.length; i++) {
								const item = arr[i]
							console.log('任务信息:', item.getString('taskNo'), '状态:', item.getString('status'))
								list.push(item)
							}
							console.log('月检任务列表长度:', list.length)
						} else {
							console.log('月检任务列表请求失败, 状态码:', res.statusCode)
							this.handleAuthFailure(res.statusCode)
						}
						this.taskPickerList = list
						this.taskPickerLoaded = true
						this.showTaskPickerModal = true
						this.taskPickerLoading = false
					},
					fail: (error) => {
						console.log('加载月检任务列表失败:', error)
						this.taskPickerLoading = false
						this.taskPickerList = []
						this.showTaskPickerModal = true
					}
				})
			},
			closeTaskPicker() {
				this.showTaskPickerModal = false
			},
			pickTaskAndGo(item: UTSJSONObject) {
				const taskNo = item.getString('taskNo') ?? ''
				if (taskNo == '') return
				// 与 Web 端 handleTaskSelectConfirm 一致：直接复用任务列表已返回的时间字段校验录入期，
				// 无需再请求 /monthly-inspection-task/task-no/{taskNo}（该详情在 task-record 页会再加载一次）
				const startStr = item.getString('inspectionStartTime') ?? ''
				const endStr = item.getString('inspectionEndTime') ?? ''
				if (startStr == '' || endStr == '') {
					uni.showToast({ title: '任务时间信息缺失', icon: 'none' })
					return
				}
				const parseDate = (s: string): Date => {
					// 日期字符串 '2026-08-01 00:00:00' 需先把空格换成 T 再 parse
					return new Date(s.replace(' ', 'T'))
				}
				const now = new Date()
				const inPeriod = now >= parseDate(startStr) && now <= parseDate(endStr)
				if (!inPeriod) {
					uni.showToast({ title: '不在检查时间范围内', icon: 'none', duration: 2000 })
					return
				}
				uni.navigateTo({ url: `/pages/monthly/task-record?taskId=${taskNo}` })
				this.showTaskPickerModal = false
			},
			
			goToReviewedRecords() {
				uni.navigateTo({
					url: '/pages/record/record?status=2&monthly=true'
				})
			},
			
			loadNotifications() {
				const token = uni.getStorageSync('token')
				console.log('开始加载系统通知')

			// 初始化调用：拿部门ID、走任务选择页API拿任务ID、获取用户信息拿ID
				uni.request({
					url: getApiUrl('/notifications/user/notifications'),
					method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
						console.log('通知请求响应:', res)
						if (res.statusCode === 200) {
							const data = res.data as Array<UTSJSONObject>
						console.log('系统通知数组:', data.length, '条')
							this.notifications = []
							let unreadCount = 0
							for (let i = 0; i < data.length; i++) {
								const item = data[i]
								const notification: Notification = {
									id: item.getString('id') ?? '',
									taskId: item.getString('taskId') ?? '',
									taskNo: item.getString('taskNo') ?? '',
									title: item.getString('title') ?? '',
									content: item.getString('content') ?? '',
									createTime: item.getString('createTime') ?? '',
									isRead: item.getBoolean('isRead') ?? false
								}
								this.notifications.push(notification)
								if (!notification.isRead) {
									unreadCount++
								}
							}
							this.notificationCount = unreadCount
							console.log('系统通知未读数:', this.notificationCount)
						} else {
							console.log('通知请求失败, 状态码:', res.statusCode)
						}
					},
					fail: (error) => {
						console.log('加载系统通知失败:', error)
					}
				})
				this.loadTaskNotifications()
			},

			// 重置任务通知状态
			loadTaskNotifications() {
				const token = uni.getStorageSync('token')

			// 与 Web 端一致(admin/src/api/notification.js getTaskNotifications)：任务通知统一走 /notifications/tasks，
			// 由后端从 token 解析当前用户并按其部门过滤；不再在客户端按 isAdmin 分支请求 department/tasks，
			// 避免管理员看到越权的全部门数据、也消除 /notifications/department/{id}/tasks 的 403 风险
				
			// 无部门用户由后端 /notifications/tasks 返回空列表，无需前端预判跳过
				
			// 拼接任务通知URL：与 Web getTaskNotifications 一致，走 /notifications/tasks
				const url = getApiUrl(`/notifications/tasks`)
				
				uni.request({
					url: url,
					method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
						console.log('月检任务通知请求成功:', res)
						if (res.statusCode === 200) {
							const data = res.data as Array<UTSJSONObject>
							console.log('任务通知数组:', data.length, '条')
							this.taskNotifications = []
							for (let i = 0; i < data.length; i++) {
								const item = data[i]
								const taskNotification: TaskNotification = {
									id: item.getString('id') ?? '',
									taskId: item.getString('taskId') ?? '',
									taskNo: item.getString('taskNo') ?? '',
									title: item.getString('title') ?? '',
									content: item.getString('content') ?? '',
									createTime: item.getString('createTime') ?? '',
									status: item.getString('status') ?? '',
									inspectionMonth: item.getString('inspectionMonth') ?? ''
								}
								this.taskNotifications.push(taskNotification)
								console.log('任务通知详情:', taskNotification)
							}
						}
						else {
							console.log('月检任务通知请求失败, 状态码:', res.statusCode)
							this.handleAuthFailure(res.statusCode)
						}
					},
					fail: (error) => {
						console.log('加载月检任务通知失败:', error)
					}
				})
			},
			
			// 切换通知分类 tab
			switchNotificationTab(tab: string) {
				this.activeNotificationTab = tab
				if (tab === 'tasks') {
				// 切换时主动拉取最新数据，避免缓存
					this.loadTaskNotifications()
				}
			},
			
			// 点击任务通知跳转
			refreshTaskNotifications() {
				this.loadTaskNotifications()
				uni.showToast({
						title: '月检任务',
					icon: 'success',
					duration: 1500
				})
			},
			
			// 点击任务通知跳转
			handleTaskNotificationClick(taskNotification: TaskNotification) {
				// 拼装跳转参数：任务ID、部门ID、任务名称
				uni.navigateTo({
					url: `/pages/monthly/task-record?taskId=${taskNotification.taskNo}`
				})

				this.hideNotifications()
			},

			showNotifications() {
				this.showNotificationModal = true
			},
			
			hideNotifications() {
				this.showNotificationModal = false
			},
			
			handleNotificationClick(notification: Notification) {
				// 未读则标记为已读
				this.markNotificationAsRead(notification.id)

				// 标记为已读
				this.updateNotificationCount()

				// 拼装跳转参数：任务ID、部门ID、任务名称
				uni.navigateTo({
					url: `/pages/monthly/task-record?taskId=${notification.taskNo}`
				})

				this.hideNotifications()
			},
			
			// 标记通知已读(后端接口)
			markNotificationAsRead(notificationId: string) {
				const token = uni.getStorageSync('token')

				if (notificationId == null || notificationId == '') {
					return
				}

				uni.request({
					url: getApiUrl(`/notifications/read/${notificationId}`),
					method: 'PUT',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
						console.log('标记通知已读响应:', res)
					},
					fail: (error) => {
						console.log('标记通知已读失败:', error)
					}
				})
			},

			updateNotificationCount() {
				let unreadCount = 0
				for (let i = 0; i < this.notifications.length; i++) {
					if (!this.notifications[i].isRead) {
						unreadCount++
					}
				}
				this.notificationCount = unreadCount
			},
			
			goToProfile() {
				uni.switchTab({
					url: '/pages/profile/profile'
				})
			},
			
			markAllAsRead() {
				const token = uni.getStorageSync('token')

				// 全部已读API：把当前可见未读通知全部标记为已读(token是用户登录态ID)
				uni.request({
					url: getApiUrl('/notifications/read-all'),
					method: 'PUT',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
						console.log('全部已读响应:', res)
					// 遍历本地通知列表更新状态
						for (let i = 0; i < this.notifications.length; i++) {
							this.notifications[i].isRead = true
						}
						this.notificationCount = 0
					},
					fail: (error) => {
						console.log('全部已读失败:', error)
					}
				})
			},
			
			// 初始化容器高度
			initContainerHeight() {
				const systemInfo = uni.getSystemInfoSync()
				this.containerHeight = systemInfo.windowHeight
			},

		// 是否下拉刷新中
			onRefresh() {
				this.isRefreshing = true
			// 拉取统计数据
				this.loadMonthlyRecords()
				this.loadNotifications()
			// 如果是下拉刷新
					const rt = this.refreshTimer
					if (rt !== null) { clearTimeout(rt) }
					this.refreshTimer = setTimeout(() => {
						this.refreshTimer = null
						this.isRefreshing = false
					}, 1000)
			},
			
			// 通知任务列表
			onRefreshRestore() {
				this.isRefreshing = false
			},
			
		// WebSocket 相关逻辑
			// P0-Fix: WebSocket 连接已迁移到全局 wsClient(@/utils/ws-client.uts)
			// 此处仅保留占位方法,避免破坏调用;实际逻辑见 wsClient 实例
			connectWebSocket() { /* noop: use global wsClient */ },
			sendStompConnect(_token: string, _userId: string) { /* noop */ },
			subscribeToNotifications(_userId: string) { /* noop */ },
			handleWebSocketMessage(_data: string) { /* noop */ },
			handleNewNotification(_notificationData: UTSJSONObject) { /* noop */ },
			disconnectWebSocket() { /* noop: global wsClient keeps connection */ },
			handleWebSocketError() { /* noop */ },
			attemptReconnect() { /* noop */ },
		// P0-Fix: 完全卸载通知 store 最旧数据,通知弹窗组件
			syncNotificationsFromStore() {
				try {
					// 跨模块 getter 返回类型在 UTS 中会退化为 Any?,需显式断言为 NotificationItem[]
					const storeList = notificationStore.list as NotificationItem[]
					const result: Notification[] = []
					let unread = 0
					for (let i = 0; i < storeList.length; i++) {
						const s = storeList[i]
						const n: Notification = {
							id: s.id,
							taskId: s.taskId ?? '',
							taskNo: s.taskNo ?? '',
							title: s.title,
							content: s.content,
							createTime: s.createTime,
							isRead: s.isRead
						}
						result.push(n)
						if (!s.isRead) unread++
					}
					this.notifications = result
					this.notificationCount = unread
				} catch (e) { /* ignore */ }
			}
		}
}
</script>

<style>
