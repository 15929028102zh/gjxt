		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
	}
	
	.notification-badge {
		position: absolute;
		top: -6rpx;
		right: -6rpx;
		min-width: 32rpx;
		height: 32rpx;
		background: #ff4757;
		border-radius: 16rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 3rpx solid #ffffff;
		box-shadow: 0 2rpx 8rpx rgba(255, 71, 87, 0.3);
		z-index: 4;
		padding: 0 6rpx;
	}
	
	.badge-text {
		font-size: 18rpx;
		color: #ffffff;
		font-weight: 700;
		line-height: 1;
		text-align: center;
		white-space: nowrap;
	}
	
	.user-avatar {
		width: 100rpx;
		height: 100rpx;
		border-radius: 50rpx;
		background-color: #eff6ff;
		overflow: hidden;
		border: 3rpx solid #dbeafe;
		box-shadow: 0 6rpx 20rpx rgba(30, 64, 175, 0.12);
		z-index: 2;
		position: relative;
		transition: all 0.3s ease;
	}

	.user-avatar:active {
		transform: scale(0.95);
	}

	.avatar-image {
		width: 100rpx;
		height: 100rpx;
		border-radius: 50rpx;
	}

	.avatar-placeholder {
		color: #1e40af;
		font-size: 28rpx;
		font-weight: 700;
	}

	.avatar {
		width: 50px;
		height: 50px;
		border-radius: 25px;
		background-color: #ddd;
	}

	.stats-container {
		display: flex;
		justify-content: space-between;
		margin-bottom: 30rpx;
	}

	.stats-card {
		flex: 1;
		background: linear-gradient(135deg, #ffffff 0%, #f1f5f9 100%);
		border-radius: 20rpx;
		padding: 32rpx 20rpx;
		text-align: center;
		position: relative;
		box-shadow: 0 8rpx 24rpx rgba(30, 64, 175, 0.08);
		overflow: hidden;
		margin: 0 8rpx;
		border: 1rpx solid rgba(255, 255, 255, 0.8);
	}

	.stats-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
