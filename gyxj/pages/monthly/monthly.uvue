<template>
	<scroll-view 
		class="container" 
		scroll-y="true" 
		:scroll-top="scrollTop" 
		:style="{height: containerHeight + 'px'}" 
		enable-back-to-top="true"
		refresher-enabled="true"
		:refresher-triggered="isRefreshing"
		refresher-default-style="black"
		refresher-background="#f5f5f5"
		@refresherrefresh="onRefresh"
		@refresherrestore="onRefreshRestore"
	>
		<!-- 顶部欢迎区域 -->
		<view class="header">
			<view class="welcome">
				<text class="greeting">欢迎回来，{{userName}}</text>
				<text class="app-name">{{currentDate}}</text>
				<!-- 通知图标放在欢迎区域右上角 -->
				<view class="notification-icon-wrapper" @click="showNotifications">
					<text class="icon-bell">🔔</text>
					<view v-if="notificationCount > 0" class="notification-badge">
						<text class="badge-text">{{notificationCount > 99 ? '99+' : notificationCount}}</text>
					</view>
				</view>
			</view>
			<view class="header-right">
				<view class="user-avatar" @click="goToProfile">
					<image v-if="userInfo != null && (userInfo.getString('avatar') ?? '') != ''" 
						   class="avatar-image" 
						   :src="userInfo.getString('avatar') ?? ''" 
						   mode="aspectFill">
					</image>
					<text v-else class="avatar-placeholder">{{userName.charAt(0)}}</text>
				</view>
			</view>
		</view>
		
		<!-- 统计卡片 -->
		<view class="stats-container">
			<view class="stats-card" @click="goToPendingIssues">
				<text class="stats-number">{{statistics.monthlyPending}}</text>
				<text class="stats-label">本月待整改</text>
				<text class="stats-icon">⚠️</text>
			</view>
			<view class="stats-card" @click="goToCompletedIssues">
				<text class="stats-number">{{statistics.monthlyCompleted}}</text>
				<text class="stats-label">本月已整改</text>
				<text class="stats-icon">✅</text>
			</view>
			<view class="stats-card" @click="goToMonthlyReport">
				<text class="stats-number">{{statistics.monthlyTotal}}</text>
				<text class="stats-label">本月总记录</text>
				<text class="stats-icon">📊</text>
			</view>
		</view>
		
		<!-- 月度趋势图 -->
		<view class="trend-section">
			<text class="section-title">月度趋势</text>
			<view class="trend-chart">
				<view class="chart-placeholder">
					<text class="placeholder-text">月度趋势图</text>
					<text class="placeholder-desc">显示本月问题发现与整改趋势</text>
				</view>
			</view>
		</view>
		
		<!-- 快捷功能 -->
		<view class="quick-actions">
			<text class="section-title">快捷功能</text>
			<view class="actions-grid">
				<view class="action-item" @click="goToAddRecord">
					<view class="action-icon">➕</view>
					<text class="action-text">新增记录</text>
				</view>
				<view class="action-item" @click="goToMonthlyReport">
					<view class="action-icon">📊</view>
					<text class="action-text">月度报告</text>
				</view>
				<view class="action-item" @click="goToPendingIssues">
					<view class="action-icon">⚠️</view>
					<text class="action-text">待整改问题</text>
				</view>
				<view class="action-item" @click="goToCompletedIssues">
					<view class="action-icon">✅</view>
					<text class="action-text">已整改问题</text>
				</view>
			</view>
		</view>
		
		<!-- 本月记录 -->
		<view class="recent-records">
			<view class="section-header">
				<text class="section-title">本月记录</text>
				<text class="more-text" @click="goToRecords">查看更多</text>
			</view>
			<view class="records-list">
				<view class="record-item" v-for="record in monthlyRecords" :key="record.id">
					<view class="record-info">
						<text class="record-title">{{record.problemDescription}}</text>
						<text class="record-meta">{{record.locationName}} · {{record.createTime}}</text>
					</view>
					<view class="record-status" :class="getStatusClass(record.status)">
						<text>{{getStatusText(record.status)}}</text>
					</view>
				</view>
				<view v-if="monthlyRecords.length === 0" class="empty-state">
					<text class="empty-text">本月暂无记录</text>
				</view>
			</view>
		</view>
		
		<!-- 通知弹窗 -->
		<view v-if="showNotificationModal" class="notification-modal" @click="hideNotifications">
			<view class="notification-content" @click.stop>
				<view class="notification-header">
					<text class="notification-title">通知消息</text>
					<view class="notification-actions">
						<text class="mark-all-read" @click="markAllAsRead">全部已读</text>
					</view>
				</view>
				<view class="notification-list">
					<view v-if="notifications.length === 0" class="empty-notifications">
						<text class="empty-text">暂无通知</text>
					</view>
					<view v-for="notification in notifications" :key="notification.id" 
						  class="notification-item" 
						  :class="{unread: !notification.isRead}"
						  @click="handleNotificationClick(notification)">
						<view class="notification-dot" v-if="!notification.isRead"></view>
						<view class="notification-info">
							<text class="notification-item-title">{{notification.title}}</text>
							<text class="notification-item-content">{{notification.content}}</text>
							<text class="notification-time">{{notification.createTime}}</text>
						</view>
						<text class="notification-arrow">›</text>
					</view>
				</view>
			</view>
		</view>
	</scroll-view>
</template>

<script lang="uts">
	import { getApiUrl } from '@/config/api.uts'
	type MonthlyRecord = {
		id: string,
		problemDescription: string,
		locationName: string,
		createTime: string,
		status: string
	}

	type MonthlyStatistics = {
		monthlyPending: number,
		monthlyCompleted: number,
		monthlyTotal: number
	}

	type Notification = {
		id: string,
		taskId: string,
		taskNo: string,
		title: string,
		content: string,
		createTime: string,
		isRead: boolean
	}

	export default {
		data() {
				return {
					userInfo: {} as UTSJSONObject,
					userName: '用户', // 简化的用户姓名变量
					currentDate: '',
					statistics: {
						monthlyPending: 0,
						monthlyCompleted: 0,
						monthlyTotal: 0
					} as MonthlyStatistics,
					monthlyRecords: [] as MonthlyRecord[],
					notifications: [] as Notification[],
					notificationCount: 0,
					showNotificationModal: false,
					// 滚动相关
					scrollTop: 0,
					containerHeight: 0,
					// 下拉刷新相关
					isRefreshing: false
				}
			},
		onLoad(options: OnLoadOptions) {
			this.checkLogin()
			this.initData()
			this.initContainerHeight()
			this.loadStatistics()
			this.loadMonthlyRecords()
			this.loadNotifications()
		},
		methods: {
			checkLogin() {
				const token = uni.getStorageSync('token')
				if (token == null || token == '') {
					uni.reLaunch({
						url: '/pages/login/login'
					})
					return
				}
				const userInfoStr = uni.getStorageSync('userInfo') as string
				if (userInfoStr != null && userInfoStr != '') {
					this.userInfo = JSON.parse(userInfoStr) as UTSJSONObject
					// 设置用户名
					const realName = this.userInfo.getString('realName') ?? ''
					this.userName = realName != '' ? realName : '用户'
				} else {
					this.userInfo = {} as UTSJSONObject
					this.userName = '用户'
				}
			},
			
			initData() {
				const now = new Date()
				const year = now.getFullYear()
				const month = (now.getMonth() + 1).toString()
				const formattedMonth = month.length == 1 ? `0${month}` : month
				this.currentDate = `${year}年${formattedMonth}月`
			},
			
			loadStatistics() {
				const token = uni.getStorageSync('token')
				uni.request({
					url: getApiUrl('/statistics/overview'),
					method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
						const response = res.data as UTSJSONObject
						if (res.statusCode == 200 && (response.getNumber('code') ?? 0) == 200) {
							const data = response.getJSON('data') as UTSJSONObject
							// 暂时使用原有接口数据，后续可调整
							this.statistics = {
								monthlyPending: data.getNumber('totalTasks') ?? 0,
								monthlyCompleted: data.getNumber('todayRecords') ?? 0,
								monthlyTotal: data.getNumber('monthRecords') ?? 0
							}
						}
					},
					fail: (error) => {
						console.log('加载统计数据失败:', error)
					}
				})
			},
			
			loadMonthlyRecords() {
				const token = uni.getStorageSync('token')
				uni.request({
					url: getApiUrl('/inspection-record/page?pageNum=1&pageSize=10'),
					method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
						const response = res.data as UTSJSONObject
						if (res.statusCode == 200 && (response.getNumber('code') ?? 0) == 200) {
							const data = response.getJSON('data') as UTSJSONObject
							const records = data.getArray('records') as Array<UTSJSONObject>
							this.monthlyRecords = []
							for (let i = 0; i < records.length; i++) {
								const item = records[i]
								const record: MonthlyRecord = {
									id: item.getString('id') ?? '',
									problemDescription: item.getString('problemDescription') ?? '',
									locationName: item.getString('locationName') ?? '',
									createTime: item.getString('createTime') ?? '',
									status: item.getString('status') ?? ''
								}
								this.monthlyRecords.push(record)
							}
						}
					},
					fail: (error) => {
						console.log('加载月度记录失败:', error)
					}
				})
			},
			
			getStatusText(status: string): string {
				if (status == "0") return '待整改'
				if (status == "1") return '已整改'
				if (status == "2") return '已复查'
				return '未知'
			},
			
			getStatusClass(status: string): string {
				if (status == "0") return 'status-pending'
				if (status == "1") return 'status-completed'
				if (status == "2") return 'status-accepted'
				return 'status-unknown'
			},
			
			goToPendingIssues() {
				uni.navigateTo({
					url: '/pages/record/record?status=0'
				})
			},
			
			goToCompletedIssues() {
				uni.navigateTo({
					url: '/pages/record/record?status=1'
				})
			},
			
			goToMonthlyReport() {
				uni.navigateTo({
					url: '/pages/statistics/statistics'
				})
			},
			
			goToRecords() {
				uni.switchTab({
					url: '/pages/record/record'
				})
			},
			
			goToAddRecord() {
				uni.navigateTo({
					url: '/pages/record/add'
				})
			},
			
			loadNotifications() {
				const token = uni.getStorageSync('token')
				const userId = this.userInfo.getString('id') ?? ''
				uni.request({
					url: getApiUrl(`/monthly-inspection-task/user/${userId}`),
					method: 'GET',
					header: {
						'Authorization': `Bearer ${token}`
					},
					success: (res) => {
						const response = res.data as UTSJSONObject
						if (res.statusCode == 200 && (response.getNumber('code') ?? 0) == 200) {
							const data = response.getArray('data') as Array<UTSJSONObject>
							this.notifications = []
							let unreadCount = 0
							for (let i = 0; i < data.length; i++) {
								const item = data[i]
								const notification: Notification = {
									id: item.getString('id') ?? '',
									taskId: item.getString('taskId') ?? '',
									taskNo: item.getString('taskNo') ?? '',
									title: `月检任务通知 - ${item.getString('taskNo')}`,
									content: `您有新的月检任务需要处理，任务编号：${item.getString('taskNo')}`,
									createTime: item.getString('createTime') ?? '',
									isRead: false
								}
								this.notifications.push(notification)
								if (!notification.isRead) {
									unreadCount++
								}
							}
							this.notificationCount = unreadCount
						}
					},
					fail: (error) => {
						console.log('加载通知失败:', error)
					}
				})
			},
			
			showNotifications() {
				this.showNotificationModal = true
			},
			
			hideNotifications() {
				this.showNotificationModal = false
			},
			
			handleNotificationClick(notification: Notification) {
				// 标记为已读
				notification.isRead = true
				this.updateNotificationCount()
				
				// 跳转到月检任务录入页面，传递任务信息
				uni.navigateTo({
					url: `/pages/monthly/task-record?taskNo=${notification.taskNo}`
				})
				
				this.hideNotifications()
			},
			
			updateNotificationCount() {
				let unreadCount = 0
				for (let i = 0; i < this.notifications.length; i++) {
					if (!this.notifications[i].isRead) {
						unreadCount++
					}
				}
				this.notificationCount = unreadCount
			},
			
			goToProfile() {
				uni.switchTab({
					url: '/pages/profile/profile'
				})
			},
			
			markAllAsRead() {
				for (let i = 0; i < this.notifications.length; i++) {
					this.notifications[i].isRead = true
				}
				this.notificationCount = 0
			},
			
			// 初始化容器高度
			initContainerHeight() {
				const systemInfo = uni.getSystemInfoSync()
				this.containerHeight = systemInfo.windowHeight
			},
			
			// 下拉刷新
			onRefresh() {
				this.isRefreshing = true
				// 重新加载数据
				this.loadStatistics()
				this.loadMonthlyRecords()
				this.loadNotifications()
				// 模拟刷新延迟
				setTimeout(() => {
					this.isRefreshing = false
				}, 1000)
			},
			
			// 刷新恢复
			onRefreshRestore() {
				this.isRefreshing = false
			}
		}
	}
</script>

<style>
	.container {
		padding: 30rpx;
		padding-bottom: 150rpx;
		background: linear-gradient(180deg, #f8fafc 0%, #e2e8f0 100%);
		box-sizing: border-box;
		min-height: 100vh;
	}
	
	.header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 30rpx 25rpx;
		background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
		border-radius: 24rpx;
		margin-bottom: 30rpx;
		box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.3);
		position: relative;
		overflow: hidden;
	}
	
	.header::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="25" cy="25" r="1" fill="white" fill-opacity="0.1"/><circle cx="75" cy="75" r="1" fill="white" fill-opacity="0.1"/><circle cx="50" cy="10" r="0.5" fill="white" fill-opacity="0.1"/><circle cx="10" cy="60" r="0.5" fill="white" fill-opacity="0.1"/><circle cx="90" cy="40" r="0.5" fill="white" fill-opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
		pointer-events: none;
	}
	
	.header::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="25" cy="25" r="1" fill="white" fill-opacity="0.1"/><circle cx="75" cy="75" r="1" fill="white" fill-opacity="0.1"/><circle cx="50" cy="10" r="0.5" fill="white" fill-opacity="0.1"/><circle cx="10" cy="60" r="0.5" fill="white" fill-opacity="0.1"/><circle cx="90" cy="40" r="0.5" fill="white" fill-opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
		pointer-events: none;
	}
	
	.header-right {
		display: flex;
		align-items: flex-start;
		gap: 15rpx;
		z-index: 2;
		position: relative;
		margin-top: 30rpx;
	}
	
	.welcome {
		display: flex;
		flex-direction: column;
		flex: 1;
		z-index: 2;
		position: relative;
		padding-right: 140rpx;
	}
	
	.greeting {
		color: rgba(105, 72, 72, 0.95);
		font-size: 32rpx;
		font-weight: 600;
		margin-bottom: 8rpx;
		letter-spacing: 0.5rpx;
		text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
	}
	
	.app-name {
		color: rgba(105, 72, 72, 0.95);
		font-size: 26rpx;
		font-weight: 400;
		letter-spacing: 0.3rpx;
	}
	
	.notification-icon-wrapper {
		position: absolute;
		top: 15rpx;
		right: 15rpx;
		width: 70rpx;
		height: 70rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.2);
		border-radius: 50%;
		backdrop-filter: blur(10rpx);
		border: 2rpx solid rgba(255, 255, 255, 0.3);
		transition: all 0.3s ease;
		z-index: 3;
	}
	
	.notification-icon-wrapper:active {
		transform: scale(0.95);
		background: rgba(255, 255, 255, 0.3);
	}
	
	.icon-bell {
		font-size: 32rpx;
		color: rgba(255, 255, 255, 0.9);
		display: flex;
		align-items: center;
		justify-content: center;
