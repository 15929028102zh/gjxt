		background: linear-gradient(90deg, #1e40af, #0ea5e9);
	}

	.stats-number {
		font-size: 48rpx;
		font-weight: 700;
		color: #0a2540;
		margin-bottom: 8rpx;
	}

	.stats-label {
		font-size: 26rpx;
		color: #1e293b;
		font-weight: 600;
		margin-bottom: 8rpx;
	}

	.stats-icon {
		font-size: 36rpx;
		position: absolute;
		top: 20rpx;
		right: 20rpx;
		opacity: 0.18;
	}

	.action-buttons {
		margin-bottom: 30rpx;
		display: flex;
		flex-direction: row;
		justify-content: space-between;
