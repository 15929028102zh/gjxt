		height: 50px;
		border-radius: 25px;
		background-color: #ddd;
	}
	
	.stats-container {
		display: flex;
		justify-content: space-between;
		margin-bottom: 30px;
	}
	
	.stats-card {
		flex: 1;
		background: #fff;
		border-radius: 12px;
		padding: 20px 15px;
		margin: 0 5px;
		text-align: center;
		position: relative;
		box-shadow: 0 2px 8px rgba(0,0,0,0.1);
	}
	
	.stats-number {
		font-size: 24px;
		font-weight: bold;
		color: #007AFF;
		margin-bottom: 8px;
	}
	
	.stats-label {
		font-size: 14px;
		color: #666;
		margin-bottom: 8px;
	}
	
	.stats-icon {
		font-size: 20px;
		position: absolute;
		top: 15px;
		right: 15px;
	}
	
	.trend-section {
		margin-bottom: 30px;
	}
	
	.trend-chart {
		background: #fff;
		border-radius: 12px;
		padding: 20px;
		box-shadow: 0 2px 8px rgba(0,0,0,0.1);
	}
	
	.chart-placeholder {
