		box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.15), 0 0 0 1rpx rgba(255, 255, 255, 0.1);
		z-index: 2;
		position: relative;
		transition: all 0.3s ease;
	}
	
	.user-avatar:active {
		transform: scale(0.95);
	}
	
	.avatar-image {
		width: 100rpx;
		height: 100rpx;
