<template>
  <scroll-view class="container" scroll-y="true" :style="{height: containerHeight + 'px'}">
    <view v-if="loading" class="loading-state"><text>加载中...</text></view>
    <view v-else-if="detail != null" class="content">
      <!-- 问题信息（与月检 AddDialog 字段统一） -->
      <view class="section">
        <text class="title">问题信息</text>
        <view class="field"><text class="label">问题描述</text><text class="value">{{detail.problemDescription}}</text></view>
        <view class="field"><text class="label">专业类别</text><text class="value">{{detail.professionalTypeName}}</text></view>
        <view class="field"><text class="label">基本模块</text><text class="value">{{detail.moduleName}}</text></view>
        <view class="field"><text class="label">责任要素</text><text class="value">{{detail.responsibilityName}}</text></view>
        <view class="field"><text class="label">检查内容</text><text class="value">{{detail.issueName}}</text></view>
        <view class="field"><text class="label">性质界定</text><text class="value">{{detail.qualityName}}</text></view>
        <view class="field"><text class="label">性质界定是否人工修改</text><text class="value">{{detail.natureModified === 1 ? '是(已修改)' : '否(未修改)'}}</text></view>
        <view class="field"><text class="label">扣分值</text><text class="value">{{getDeductionScore(detail.qualityName)}}</text></view>
        <view class="field"><text class="label">发现位置</text><text class="value">{{detail.location}}</text></view>
        <view class="field"><text class="label">检查单位</text><text class="value">{{displayValue(detail.checkUnitName)}}</text></view>
        <view class="field"><text class="label">受检单位</text><text class="value">{{displayValue(detail.departmentName)}}</text></view>
        <view class="field"><text class="label">检查人</text><text class="value">{{detail.inspector}}</text></view>
        <view class="field"><text class="label">整改期限</text><text class="value">{{detail.rectificationDeadline}}</text></view>
      </view>

      <view class="section" v-if="problemImages.length > 0">
        <text class="title">问题图片（{{problemImages.length}}张）</text>
        <view class="image-list">
          <view class="image-item" v-for="(img, i) in problemImages" :key="i">
            <image :src="convertToHttpUrl(img)" mode="aspectFill" class="image" @click="previewProblemImage(i)"></image>
          </view>
        </view>
      </view>

      <!-- 整改信息:责任人/责任单位(可多选,对齐 Web SearchableSelect multiple) -->
      <view class="section">
        <text class="title">整改信息</text>
        <view class="form-item">
          <text class="form-label-left">责任人</text>
          <view class="custom-picker-full" @click="showPersonPicker" :class="{disabled: userOptions.length === 0}">
            <text class="picker-text-full" :class="{placeholder: responsiblePersonArr.length === 0}">{{responsiblePersonArr.length > 0 ? responsiblePersonArr.join('、') : '请选择责任人（可多选）'}}</text>
          </view>
        </view>
        <view class="form-item">
          <text class="form-label-left">责任单位</text>
          <view class="custom-picker-full" @click="showUnitPicker" :class="{disabled: deptOptionsList.length === 0}">
            <text class="picker-text-full" :class="{placeholder: responsibleUnitArr.length === 0}">{{responsibleUnitArr.length > 0 ? responsibleUnitArr.join('、') : '请选择责任单位（可多选）'}}</text>
          </view>
        </view>
        <!-- 整改人（当前登录用户，只读，确认整改时写库） -->
        <view class="form-item">
          <text class="form-label-left">整改人</text>
          <view class="custom-picker-full disabled">
            <text class="picker-text-full">{{currentUserName !== '' ? currentUserName : '当前登录用户'}}</text>
          </view>
        </view>
      </view>

      <!-- 整改建议 -->
      <view class="section">
        <text class="title">整改建议</text>
        <textarea class="textarea" v-model="rectificationSuggestion" placeholder="请填写整改建议/措施" maxlength="500"></textarea>
      </view>

      <!-- 整改效果 -->
      <view class="section">
        <text class="title">整改效果</text>
        <textarea class="textarea" v-model="rectificationEffect" placeholder="请填写整改完成后的实际效果" maxlength="500"></textarea>
      </view>

      <!-- 整改图片 -->
      <view class="section">
        <text class="title">整改图片（最多3张，已选{{rectificationImages.length}}张）</text>
        <view class="image-list">
          <view class="image-item" v-for="(img, i) in rectificationImages" :key="i">
            <image :src="convertToHttpUrl(img)" mode="aspectFill" class="image" @click="previewImage(i)"></image>
            <view class="delete" @click="removeImage(i)"><text>×</text></view>
          </view>
          <view v-if="rectificationImages.length < 3" class="add" @click="chooseImage">
            <text class="add-icon">+</text>
            <text class="add-text">添加图片</text>
          </view>
        </view>
      </view>

      <!-- 保存按钮常驻(对齐 Web RectificationConfirmDialog footer：保存无条件显示，走 update 接口不改状态)；
           确认整改按钮仍按公示期 + deptType 门控 -->
      <view class="footer footer-actions">
        <button class="btn-save" :class="{'btn-save-only': !isRectifyVisible()}" @click="handleSave" :disabled="saving">{{saving ? '处理中...' : '保存'}}</button>
        <button v-if="isRectifyVisible()" class="btn-confirm" @click="submitRectify" :disabled="saving">{{saving ? '提交中...' : '确认整改'}}</button>
      </view>
      <view v-if="!isRectifyVisible()" class="footer footer-locked">
        <text class="locked-text">
          {{taskPhase === 0 ? '加载任务阶段中...' : taskPhase < 4 ? '公示期尚未结束,暂不可确认整改(可先保存)' : '当前部门类型无整改权限'}}
        </text>
      </view>
    </view>
    <view v-else class="error"><text>记录不存在或已删除</text></view>

    <!-- 责任人选择弹窗（多选） -->
    <view v-if="showPersonPopup" class="popup-overlay" @click="hidePersonPicker">
      <view class="popup-content" @click.stop>
        <view class="popup-header">
          <text class="popup-title">选择责任人（可多选）</text>
          <text class="popup-close" @click="hidePersonPicker">×</text>
        </view>
        <view class="popup-search">
          <input class="search-input" v-model="personSearchKeyword" placeholder="搜索责任人..." />
        </view>
        <scroll-view class="popup-list" scroll-y="true">
          <view v-if="userOptions.length === 0" class="popup-loading"><text class="loading-text">加载中...</text></view>
          <view v-else-if="filteredUserOptions.length === 0" class="popup-empty"><text class="empty-text">暂无匹配的人员</text></view>
          <view v-else v-for="(item, index) in filteredUserOptions" :key="(item as OptionItem).id"
            :class="['popup-item', responsiblePersonArr.indexOf((item as OptionItem).name) !== -1 ? 'popup-item-selected' : '']"
            @click="togglePerson(item)">
            <text class="popup-item-text">{{(item as OptionItem).name}}</text>
            <text v-if="responsiblePersonArr.indexOf((item as OptionItem).name) !== -1" class="popup-item-check">✓</text>
          </view>
        </scroll-view>
        <view class="popup-footer">
          <text class="popup-btn popup-btn-cancel" @click="hidePersonPicker">取消</text>
          <text class="popup-btn popup-btn-confirm" @click="confirmPersonPicker">确定（{{responsiblePersonArr.length}}）</text>
        </view>
      </view>
    </view>

    <!-- 责任单位选择弹窗（多选） -->
    <view v-if="showUnitPopup" class="popup-overlay" @click="hideUnitPicker">
      <view class="popup-content" @click.stop>
        <view class="popup-header">
          <text class="popup-title">选择责任单位（可多选）</text>
          <text class="popup-close" @click="hideUnitPicker">×</text>
        </view>
        <view class="popup-search">
          <input class="search-input" v-model="unitSearchKeyword" placeholder="搜索部门..." />
        </view>
        <scroll-view class="popup-list" scroll-y="true">
          <view v-if="deptOptionsList.length === 0" class="popup-loading"><text class="loading-text">加载中...</text></view>
          <view v-else-if="filteredDeptOptions.length === 0" class="popup-empty"><text class="empty-text">暂无匹配的部门</text></view>
          <view v-else v-for="(item, index) in filteredDeptOptions" :key="(item as OptionItem).id"
            :class="['popup-item', responsibleUnitArr.indexOf((item as OptionItem).name) !== -1 ? 'popup-item-selected' : '']"
            @click="toggleUnit(item)">
            <text class="popup-item-text">{{(item as OptionItem).name}}</text>
            <text v-if="responsibleUnitArr.indexOf((item as OptionItem).name) !== -1" class="popup-item-check">✓</text>
          </view>
        </scroll-view>
        <view class="popup-footer">
          <text class="popup-btn popup-btn-cancel" @click="hideUnitPicker">取消</text>
          <text class="popup-btn popup-btn-confirm" @click="confirmUnitPicker">确定（{{responsibleUnitArr.length}}）</text>
        </view>
      </view>
    </view>
  </scroll-view>
</template>

<script lang="uts">
  import { getApiUrl, apiConfig } from '@/config/api.uts'
  import { resolveCurrentDept, getCachedUserInfo, CurrentDept } from '@/utils/user.uts'

  // V3:当前用户类型(对齐 Web:整改按钮只看 deptType,与 admin 无关)
  type CurrentUser = {
    deptId: string
    deptName: string
    deptType: number | null  // 0=运行部门 1=管理部门 null=无部门(如管理员)
  }

  // 多选下拉选项(对齐 task-record.uvue 的 picker 实现)
  type OptionItem = {
    id: string
    name: string
  }

  type RecordDetail = {
    id: string
    problemDescription: string
    location: string
    responsibleUnit: string
    responsiblePerson: string
    qualityName: string
    checkUnitName: string
    natureModified: number
    professionalTypeName: string
    departmentName: string
    inspector: string
    rectificationEffect: string
    rectificationSuggestion: string
    rectificationImages: string
    photos: string
    responsibilityName: string
    issueName: string
    moduleName: string
    rectificationDeadline: string
    // V3:用于拉 task 详情计算 phase
    taskId: string
  }

  export default {
    data() {
      return {
        id: '',
        detail: null as RecordDetail | null,
        rectificationSuggestion: '',
        rectificationEffect: '',
        rectificationImages: [] as string[],
        problemImages: [] as string[],
        loading: true,
        saving: false,
        containerHeight: 0,
        // V3:当前用户(用于部门类型判断)
        currentUser: { deptId: '', deptName: '', deptType: null } as CurrentUser,
        // 整改人：当前登录用户姓名（只读）
        currentUserName: '',
        // V3:任务期阶段 0=未知 1=录入前 2=录入中 3=公示期 4=公示期后
        taskPhase: 0,
        taskPublicityEndTime: '',
        // 责任人/责任单位(可多选,对齐 Web SearchableSelect multiple)
        responsiblePersonArr: [] as string[],
        responsibleUnitArr: [] as string[],
        // 下拉选项与弹窗状态
        userOptions: [] as OptionItem[],
        deptOptionsList: [] as OptionItem[],
        showPersonPopup: false,
        showUnitPopup: false,
        personSearchKeyword: '',
        unitSearchKeyword: ''
      }
    },
    onLoad(options: UTSJSONObject) {
      this.id = options.getString('id') ?? ''
      this.loadDetail().then(() => {
        // V3:详情加载完成后,拉当前用户 + 任务 phase(用于按钮可见性判断)
        this.loadCurrentUser()
        this.loadTaskPhase()
      })
    },
    onReady() {
      this.initContainerHeight()
    },
    computed: {
      // 过滤后的责任人选项(按姓名)
      filteredUserOptions(): OptionItem[] {
        if (this.personSearchKeyword == '') return this.userOptions
        return this.userOptions.filter(item => item.name.toLowerCase().includes(this.personSearchKeyword.toLowerCase()))
      },
      // 过滤后的责任单位选项(按部门名)
      filteredDeptOptions(): OptionItem[] {
        if (this.unitSearchKeyword == '') return this.deptOptionsList
        return this.deptOptionsList.filter(item => item.name.toLowerCase().includes(this.unitSearchKeyword.toLowerCase()))
      }
    },
    methods: {
      initContainerHeight() {
        uni.getSystemInfo({
          success: (res) => { this.containerHeight = res.windowHeight }
        })
      },
      convertToHttpUrl(path: string): string {
        if (path == null || path == '') return ''
        if (path.startsWith('http://') || path.startsWith('https://')) return path
        return `${apiConfig.baseUrl}/api${path}`
      },
      getDeductionScore(qualityName: string): string {
        if (qualityName === '观察') return '1'
        if (qualityName === '一般') return '3'
        if (qualityName === '重要') return '5'
        return '-'
      },
      displayValue(v: string): string {
        return v !== '' && v != null ? v : '暂无'
      },
      loadDetail(): Promise<void> {
        return new Promise((resolve) => {
          const token = uni.getStorageSync('token')
          uni.request({
            url: getApiUrl(`/monthly-inspection-record/${this.id}`),
            method: 'GET',
            header: { 'Authorization': `Bearer ${token}` },
            success: (res) => {
              const data = res.data as UTSJSONObject
              if (res.statusCode === 200 && (data.getNumber('code') ?? 0) === 200) {
                const d = data.getJSON('data') as UTSJSONObject | null
                if (d != null) {
                  this.detail = {
                    id: d!!.getString('id') ?? '',
                    problemDescription: d!!.getString('problemDescription') ?? '',
                    location: d!!.getString('location') ?? '',
                    responsibleUnit: d!!.getString('responsibleUnit') ?? '',
                    responsiblePerson: d!!.getString('responsiblePerson') ?? '',
                    qualityName: d!!.getString('qualityName') ?? '',
                    checkUnitName: d!!.getString('checkUnitName') ?? '',
                    natureModified: d!!.getNumber('natureModified') ?? 0,
                    professionalTypeName: d!!.getString('professionalTypeName') ?? '',
                    departmentName: d!!.getString('departmentName') ?? '',
                    inspector: d!!.getString('inspector') ?? '',
                    rectificationEffect: d!!.getString('rectificationEffect') ?? '',
                    rectificationSuggestion: d!!.getString('rectificationSuggestion') ?? '',
                    rectificationImages: d!!.getString('rectificationImages') ?? '',
                    photos: d!!.getString('photos') ?? '',
                    responsibilityName: d!!.getString('responsibilityName') ?? '',
                    issueName: d!!.getString('issueName') ?? '',
                    moduleName: d!!.getString('moduleName') ?? '',
                    rectificationDeadline: d!!.getString('rectificationDeadline') ?? '',
                    taskId: d!!.getString('taskId') ?? ''
                  }
                  if (this.detail.photos != null && this.detail.photos.trim() !== '') {
                    this.problemImages = this.processImageUrls(this.detail.photos)
                  }
                  // 责任人/单位回显(「、」/逗号分隔字符串 -> 数组,对齐 Web splitMulti)
                  this.responsiblePersonArr = this.splitMulti(this.detail.responsiblePerson)
                  this.responsibleUnitArr = this.splitMulti(this.detail.responsibleUnit)
                }
              } else {
                uni.showToast({ title: data.getString('message') ?? '加载失败', icon: 'none' })
              }
              this.loading = false
              resolve()
            },
            fail: (_) => {
              this.loading = false
              uni.showToast({ title: '网络错误', icon: 'none' })
              resolve()
            }
          })
        })
      },
      // V3:加载当前用户(取 deptType 用于判断整改按钮可见性)
      // resolveCurrentDept 先刷新服务端 userInfo 再取部门类型，避免用登录时的旧 deptId 快照判定角色
      loadCurrentUser() {
        resolveCurrentDept().then((dept: CurrentDept) => {
          this.currentUser = { deptId: dept.deptId, deptName: dept.deptName, deptType: dept.deptType }
          // 整改人取当前登录用户真实姓名
          const info = getCachedUserInfo()
          this.currentUserName = info.getString('realName') ?? info.getString('username') ?? ''
        })
      },
      // V3:从 taskId 拉任务,计算当前阶段(公示期前/中/后)
      loadTaskPhase() {
        if (this.detail == null) return
        const token = uni.getStorageSync('token')
        uni.request({
          url: getApiUrl(`/monthly-inspection-task/${this.detail.taskId ?? ''}`),
          method: 'GET',
          header: { 'Authorization': `Bearer ${token}` },
          success: (res) => {
            const data = res.data as UTSJSONObject
            if (res.statusCode !== 200 || (data.getNumber('code') ?? 0) !== 200) return
            const t = data.getJSON('data')
            if (t == null) return
            const tObj = t as UTSJSONObject
            const pubStartStr = tObj.getString('publicityStartTime') ?? ''
            const pubEndStr = tObj.getString('publicityEndTime') ?? ''
            this.taskPublicityEndTime = pubEndStr
            const now = new Date()
            const parseDt = (s: string): Date | null => {
              if (s == null || s == '') return null
              return new Date(s.replace(' ', 'T'))
            }
            const pubStart = parseDt(pubStartStr)
            const pubEnd = parseDt(pubEndStr)
            if (pubStart == null || pubEnd == null) { this.taskPhase = 0; return }
            if (now < pubStart) this.taskPhase = 2       // 公示期前
            else if (now <= pubEnd) this.taskPhase = 3  // 公示期内
            else this.taskPhase = 4                    // 公示期后
          }
        })
      },
      // V3:整改按钮可见性 — 公示期后 AND deptType !== 1(对齐 Web showRectificationButton)
      isRectifyVisible(): boolean {
        if (this.taskPhase !== 4) return false
        return this.currentUser.deptType !== 1
      },
      processImageUrls(imageUrls: string): string[] {
        if (imageUrls == null || imageUrls.trim() === '') {
          return []
        }
        try {
          const trimmed = imageUrls.trim()
          if (trimmed.startsWith('[') && trimmed.endsWith(']')) {
            const parsed = JSON.parse(trimmed) as string[]
            const result: string[] = []
            for (let i = 0; i < parsed.length; i++) {
              const u = parsed[i]
              if (u != null && u.trim() !== '') {
                result.push(u)
              }
            }
            return result
          }
        } catch (_) {}
        const parts = imageUrls.split(',')
        const res: string[] = []
        for (let i = 0; i < parts.length; i++) {
          const u = parts[i].trim()
          if (u !== '') res.push(u)
        }
        return res
      },
      previewProblemImage(i: number) {
        const urls = this.problemImages.map((u) => this.convertToHttpUrl(u))
        uni.previewImage({ current: i, urls })
      },
      chooseImage() {
        if (this.rectificationImages.length >= 3) {
          uni.showToast({ title: '最多3张', icon: 'none' }); return
        }
        uni.chooseImage({
          count: 3 - this.rectificationImages.length,
          sourceType: ['camera', 'album'],
          success: (res) => {
            const token = uni.getStorageSync('token')
            res.tempFilePaths.forEach((p) => {
              uni.uploadFile({
                url: getApiUrl('/upload/image'),
                filePath: p,
                name: 'file',
                header: { 'Authorization': `Bearer ${token}` },
                success: (upRes) => {
                  try {
                    const result = JSON.parse(upRes.data) as UTSJSONObject
                    if (upRes.statusCode === 200 && (result.getNumber('code') ?? 0) === 200) {
                      const dataObj = result.getJSON('data')
                      const url = dataObj?.getString('filePath') ?? ''
                      if (url != '') this.rectificationImages.push(url)
                    } else {
                      uni.showToast({ title: result.getString('message') ?? '上传失败', icon: 'none' })
                    }
                  } catch (_) { uni.showToast({ title: '上传失败', icon: 'none' }) }
                },
                fail: (_) => { uni.showToast({ title: '上传失败', icon: 'none' }) }
              })
            })
          }
        })
      },
      removeImage(i: number) { this.rectificationImages.splice(i, 1) },
      previewImage(i: number) {
        uni.previewImage({ current: i, urls: this.rectificationImages.map((u) => this.convertToHttpUrl(u)) })
      },
      // ===== 责任人/责任单位多选(对齐 Web RectificationConfirmDialog) =====
      // 「、」/逗号分隔字符串 -> 数组(空值返回 [])
      splitMulti(value: string): string[] {
        if (value == null || value == '') return [] as string[]
        const parts = value.replace(/，/g, '、').replace(/,/g, '、').split('、')
        const res: string[] = []
        for (let i = 0; i < parts.length; i++) {
          const s = parts[i].trim()
          if (s != '') res.push(s)
        }
        return res
      },
      // 数组 -> 「、」拼接字符串
      joinMulti(arr: string[]): string {
        const res: string[] = []
        for (let i = 0; i < arr.length; i++) {
          const s = arr[i]
          if (s != null && s.trim() != '') res.push(s)
        }
        return res.join('、')
      },
      // 加载责任人选项(用户列表,取 realName)
      loadUserOptions() {
        const token = uni.getStorageSync('token')
        uni.request({
          url: getApiUrl('/user/list'),
          method: 'GET',
          header: { 'Authorization': `Bearer ${token}` },
          success: (res) => {
            const respdata = res.data as UTSJSONObject
            if ((respdata.getNumber('code') ?? 0) === 200) {
              const records = respdata.getArray('data') as UTSJSONObject[] | null
              const options: OptionItem[] = []
              if (records != null) {
                for (let i = 0; i < records.length; i++) {
                  const u = records[i]
                  const name = (u != null ? (u.getString('realName') ?? u.getString('username') ?? '') : '')
                  if (name != '') options.push({ id: (i + 1).toString(), name: name } as OptionItem)
                }
              }
              this.userOptions = options
            }
          },
          fail: (error) => { console.error('加载责任人列表失败:', error) }
        })
      },
      // 加载责任单位选项(全部部门,取 deptName,对齐 Web getDeptList)
      loadDeptOptionsList() {
        const token = uni.getStorageSync('token')
        uni.request({
          url: getApiUrl('/dept/list'),
          method: 'GET',
          header: { 'Authorization': `Bearer ${token}` },
          success: (res) => {
            const respdata = res.data as UTSJSONObject
            if ((respdata.getNumber('code') ?? 0) === 200) {
              const list = respdata.getArray('data') as UTSJSONObject[] | null
              const options: OptionItem[] = []
              if (list != null) {
                for (let i = 0; i < list.length; i++) {
                  const dp = list[i]
                  const id = dp != null ? (dp.getString('id') ?? '') : ''
                  const name = dp != null ? (dp.getString('deptName') ?? '') : ''
                  if (id != '' && name != '') options.push({ id: id, name: name } as OptionItem)
                }
              }
              this.deptOptionsList = options
            }
          },
          fail: (error) => { console.error('加载责任单位列表失败:', error) }
        })
      },
      showPersonPicker() {
        if (this.userOptions.length === 0) this.loadUserOptions()
        this.showPersonPopup = true
      },
      hidePersonPicker() {
        this.showPersonPopup = false
        this.personSearchKeyword = ''
      },
      togglePerson(item: OptionItem) {
        const idx = this.responsiblePersonArr.indexOf(item.name)
        if (idx === -1) this.responsiblePersonArr.push(item.name)
        else this.responsiblePersonArr.splice(idx, 1)
      },
      confirmPersonPicker() { this.hidePersonPicker() },
      showUnitPicker() {
        if (this.deptOptionsList.length === 0) this.loadDeptOptionsList()
        this.showUnitPopup = true
      },
      hideUnitPicker() {
        this.showUnitPopup = false
        this.unitSearchKeyword = ''
      },
      toggleUnit(item: OptionItem) {
        const idx = this.responsibleUnitArr.indexOf(item.name)
        if (idx === -1) this.responsibleUnitArr.push(item.name)
        else this.responsibleUnitArr.splice(idx, 1)
      },
      confirmUnitPicker() { this.hideUnitPicker() },
      // 保存草稿:仅保存现有数据,不变更记录状态(对齐 Web handleSave,走通用 update 接口)
      handleSave() {
        if (this.saving) return
        let nm = 0
        if (this.detail != null) { nm = this.detail!!.natureModified }
        this.saving = true
        const token = uni.getStorageSync('token')
        const payload = {
          id: this.id,
          responsiblePerson: this.joinMulti(this.responsiblePersonArr),
          responsibleUnit: this.joinMulti(this.responsibleUnitArr),
          rectificationSuggestion: this.rectificationSuggestion,
          rectificationEffect: this.rectificationEffect,
          rectificationImages: this.rectificationImages.join(','),
          // 回传原值,避免后端把 nature_modified 兜底重置为 0
          natureModified: nm
        }
        uni.request({
          url: getApiUrl('/monthly-inspection-record'),
          method: 'PUT',
          header: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          data: payload,
          success: (res) => {
            const resp = res.data as UTSJSONObject
            if (res.statusCode === 200 && (resp.getNumber('code') ?? 0) === 200) {
              uni.showToast({ title: '保存成功,状态未变更', icon: 'none' })
            } else {
              uni.showToast({ title: resp.getString('message') ?? '保存失败', icon: 'none' })
            }
            this.saving = false
          },
          fail: (_) => { this.saving = false; uni.showToast({ title: '网络错误', icon: 'none' }) }
        })
      },
      submitRectify() {
        if (this.saving) return
        if (this.rectificationSuggestion.trim() == '') {
          uni.showToast({ title: '请填写整改建议', icon: 'none' }); return
        }
        if (this.rectificationEffect.trim() == '') {
          uni.showToast({ title: '请填写整改效果', icon: 'none' }); return
        }
        this.saving = true
        const token = uni.getStorageSync('token')
        const data = {
          rectificationSuggestion: this.rectificationSuggestion,
          rectificationEffect: this.rectificationEffect,
          rectificationImages: this.rectificationImages.join(','),
          // 责任人/单位多选,「、」拼接(对齐 Web joinMulti)
          responsibleUnit: this.joinMulti(this.responsibleUnitArr),
          responsiblePerson: this.joinMulti(this.responsiblePersonArr),
          // 整改人（当前登录用户）
          rectifierName: this.currentUserName
        }
        uni.request({
          url: getApiUrl(`/monthly-inspection-record/${this.id}/rectify`),
          method: 'PUT',
          header: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          data: data,
          success: (res) => {
            const resp = res.data as UTSJSONObject
            if (res.statusCode === 200 && (resp.getNumber('code') ?? 0) === 200) {
              uni.showToast({ title: '整改确认成功', icon: 'success' })
              setTimeout(function(){ uni.navigateBack() }, 1200)
            } else {
              uni.showToast({ title: resp.getString('message') ?? '提交失败', icon: 'none' })
            }
            this.saving = false
          },
          fail: (_) => { this.saving = false; uni.showToast({ title: '网络错误', icon: 'none' }) }
        })
      }
    }
  }
</script>

<style>
  .container { background: #f1f5f9 }
  .loading-state, .error { padding: 20px; text-align: center; color: #475569 }
  .content { padding: 24rpx 32rpx }
  .section { background: #ffffff; border-radius: 20rpx; padding: 32rpx; margin-bottom: 28rpx; box-shadow: 0 8rpx 24rpx rgba(30, 64, 175, 0.08); border-top: 4rpx solid #1e40af }
  .title { font-size: 32rpx; font-weight: 600; color: #1e40af; margin-bottom: 24rpx; padding-left: 16rpx; border-left: 6rpx solid #2563eb }
  .field { margin-bottom: 20rpx; display: flex; justify-content: space-between; padding: 8rpx 0 }
  .label { font-size: 28rpx; color: #475569 }
  .value { font-size: 28rpx; color: #0f172a; text-align: right; max-width: 480px; font-weight: 500 }
  /* V3:责任人/责任单位可编辑样式 */
  .field-edit { margin-bottom: 20rpx; display: flex; align-items: center; padding: 8rpx 0 }
  .field-edit .label { width: 180rpx; flex-shrink: 0; color: #475569 }
  .readonly-field { margin-bottom: 20rpx; display: flex; align-items: flex-start; padding: 12rpx; background: #eff6ff; border-radius: 12rpx }
  .readonly-field .label { min-width: 176rpx; flex-shrink: 0; color: #2563eb; font-weight: 500 }
  .readonly-field .value { text-align: left; flex: 1; word-break: break-all; color: #0f172a }
  .textarea { width: 100%; min-height: 200rpx; padding: 24rpx; border: 2rpx solid #dbeafe; border-radius: 12rpx; background: #ffffff; font-size: 28rpx; color: #0f172a }
  .textarea:focus { border-color: #2563eb; background: #eff6ff }
  /* V3:责任人/责任单位单行编辑框 */
  .textarea-mini { flex: 1; min-height: 80rpx; padding: 16rpx 20rpx; border: 2rpx solid #dbeafe; border-radius: 12rpx; background: #ffffff; font-size: 28rpx; color: #0f172a }
  .textarea-mini:focus { border-color: #2563eb; background: #eff6ff }
  /* V3:锁定状态 footer */
  .footer-locked { text-align: center; padding: 40rpx 30rpx }
  .locked-text { font-size: 28rpx; color: #94a3b8 }
  .image-list { display: flex; flex-wrap: wrap }
  .image-list .image-item { margin: 10rpx }
  .image-list .add { margin: 10rpx }
  .image-list .no-image { margin: 10rpx }
  .image-item { position: relative; width: 200rpx; height: 200rpx }
  .image { width: 100%; height: 100%; border-radius: 16rpx; border: 2rpx solid #dbeafe }
  .delete { position: absolute; top: -12rpx; right: -12rpx; width: 44rpx; height: 44rpx; background: #dc2626; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #ffffff; font-weight: 600 }
  .add { width: 200rpx; height: 200rpx; border: 4rpx dashed #2563eb; border-radius: 16rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #eff6ff }
  .add-icon { font-size: 44rpx; color: #2563eb; font-weight: 600 }
  .add-text { font-size: 24rpx; color: #2563eb; margin-top: 8rpx }
  .no-image { font-size: 24rpx; color: #94a3b8 }
  .footer { background: #ffffff; padding: 30rpx; border-radius: 20rpx; box-shadow: 0 8rpx 24rpx rgba(30, 64, 175, 0.08) }
  .submit { width: 100%; padding: 24rpx; background: #1e40af; color: #ffffff; border: none; border-radius: 16rpx; font-size: 32rpx; font-weight: 600 }
  .submit::after { color: #ffffff; border: none }
  .submit[disabled] { background: #94a3b8 }
  .submit[disabled]::after { color: #ffffff }
  /* 整改信息:多选下拉触发器 */
  .form-item { margin-bottom: 24rpx }
  .form-label-left { font-size: 28rpx; color: #475569; margin-bottom: 12rpx; font-weight: 500; text-align: left }
  .custom-picker-full { width: 100%; padding: 24rpx; border: 2rpx solid #e2e8f0; border-radius: 12rpx; background-color: #ffffff; min-height: 88rpx; display: flex; align-items: center }
  .custom-picker-full.disabled { background: #f1f5f9; border-color: #e2e8f0; opacity: 0.6 }
  .picker-text-full { font-size: 28rpx; color: #0f172a; width: 100%; text-align: left }
  .picker-text-full.placeholder { color: #94a3b8 }
  /* 底部双按钮(保存草稿 + 确认整改) */
  .footer-actions { display: flex; flex-direction: row }
  .btn-save { flex: 1; padding: 24rpx; background: #64748b; color: #ffffff; border: none; border-radius: 16rpx; font-size: 30rpx; font-weight: 600; margin-right: 20rpx }
    .btn-save-only { margin-right: 0 }
  .btn-confirm { flex: 1; padding: 24rpx; background: #1e40af; color: #ffffff; border: none; border-radius: 16rpx; font-size: 30rpx; font-weight: 600 }
  .btn-save[disabled] { background: #94a3b8 }
  .btn-confirm[disabled] { background: #94a3b8 }
  .btn-save::after { border: none }
  .btn-confirm::after { border: none }
  /* 多选弹窗(复用 task-record 已验证的 .popup-* 样式:fixed + 100%宽高 + z-index 9999) */
  .popup-overlay { position: fixed !important; top: 0 !important; left: 0 !important; width: 100% !important; height: 100% !important; background-color: rgba(10, 37, 64, 0.55); display: flex; align-items: center; justify-content: center; z-index: 9999 !important; pointer-events: auto }
  .popup-content { width: 90% !important; max-width: 600rpx; max-height: 900rpx; background-color: #ffffff; border-radius: 24rpx; overflow: hidden; box-shadow: 0 24rpx 64rpx rgba(10, 37, 64, 0.35); position: relative; z-index: 10000 }
  .popup-header { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 32rpx; border-bottom: 2rpx solid #e2e8f0; background: linear-gradient(135deg, #0a2540 0%, #1e40af 100%); position: relative; color: #ffffff }
  .popup-title { font-size: 30rpx; font-weight: 700; color: #ffffff; letter-spacing: 1rpx }
  .popup-close { font-size: 44rpx; color: rgba(255, 255, 255, 0.85); font-weight: 300; width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; border-radius: 30rpx }
  .popup-search { padding: 24rpx 32rpx; border-bottom: 2rpx solid #e2e8f0; background-color: #f8fafc }
  .search-input { width: 100%; height: 72rpx; padding: 0 24rpx; border: 2rpx solid #dbeafe; border-radius: 36rpx; font-size: 28rpx; background-color: #ffffff; color: #0f172a }
  /* 必须预留 header(~118)+search(~122)+footer(~98) 的高度：
     .popup-content 为 max-height:900rpx + overflow:hidden，若列表 max-height 过大(如700rpx)，
     责任人一次拉几百人时列表顶满 → 总高超 900rpx → footer(确定/取消)被 overflow:hidden 裁掉 → 选完关不掉。
     900 - 338 ≈ 562rpx 可用，取 520rpx 留安全余量(与 task-record.uvue 一致)。 */
  .popup-list { max-height: 520rpx; overflow-y: auto }
  .popup-empty { padding: 80rpx 32rpx; text-align: center }
  .popup-loading { display: flex; justify-content: center; align-items: center; padding: 80rpx 32rpx }
  .empty-text { font-size: 28rpx; color: #94a3b8 }
  .loading-text { font-size: 28rpx; color: #94a3b8 }
  .popup-item { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 32rpx; border-bottom: 2rpx solid #f1f5f9 }
  .popup-item-selected { background-color: #dbeafe; border-left: 8rpx solid #1e40af; padding-left: 24rpx }
  .popup-item-text { font-size: 28rpx; color: #0f172a; font-weight: 500 }
  .popup-item-check { font-size: 36rpx; color: #1e40af; font-weight: bold }
  .popup-footer { display: flex; border-top: 2rpx solid #e2e8f0; background-color: #f8fafc }
  .popup-btn { flex: 1; padding: 28rpx 0; text-align: center; font-size: 28rpx; font-weight: 500 }
  .popup-btn-cancel { color: #475569; border-right: 2rpx solid #e2e8f0 }
  .popup-btn-confirm { color: #1e40af; font-weight: 700 }
</style>